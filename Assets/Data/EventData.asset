%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b32f6a3624d839448e95fa7da7588b8, type: 3}
  m_Name: EventData
  m_EditorClassIdentifier: Assembly-CSharp::EventData_SO
  eventDataList:
  - eventID: Event_00
    eventDialogueList:
    - characterID: 1
      dialogueText: "\u524D\u9762\u662F\u65E7\u5893\u56ED\uFF0C\u4F60\u4E5F\u662F\u53BB\u770B\u4EBA\u7684\u5417\uFF1F"
    - characterID: 0
      dialogueText: "...\u662F"
    - characterID: 1
      dialogueText: "\u8FD9\u7247\u53D8\u6210\u8352\u539F\u4E4B\u540E\uFF0C\u6765\u8FD9\u7684\u4EBA\u5012\u662F\u6CA1\u5C11\u554A."
    - characterID: 0
      dialogueText: "\u60A8\u662F......\u5B88\u5893\u4EBA?"
    - characterID: 1
      dialogueText: "\u7B97\u662F\u5427\uFF0C\u7ED9\u6211\u5973\u513F\u5B88\u5B88\u5C38\uFF0C\u8FD9\u8F88\u5B50\u4E5F\u5C31\u8FD9\u6837\u4E86\u3002"
    - characterID: 0
      dialogueText: ......
    - characterID: 1
      dialogueText: "\u4E2B\u5934\u4EE5\u524D\u7B97\u662F\uFF0C\u8FD9\u91CC\u7684\u770B\u5B88\u3002"
    - characterID: 1
      dialogueText: "\u5979\u8EB2\u8FC7\u4E86\u90A3\u5E74\u7684\u75C5\u6BD2\u7206\u53D1\uFF0C\u6CA1\u67D3\u4E0A\u90A3\u4E2A\u517D\u5316\u75C5\u6BD2\u3002"
    - characterID: 0
      dialogueText: "...\u5979\u600E\u4E48\u4E86\u3002"
    - characterID: 1
      dialogueText: "\u4F60\u4E5F\u77E5\u9053\uFF0C\u8FD9\u5E74\u5934\uFF0C\u6B63\u5E38\u7684\u5FC3\u810F\u53EF\u662F\u7A00\u7F55\u7269\uFF0C\u90A3\u53EF\u662F\u6CA1\u611F\u67D3\u75C5\u6BD2\u7684\u3002"
    - characterID: 1
      dialogueText: "\u7136\u540E\u90A3\u4E9B\u8BE5\u6B7B\u7684....\u5443..."
  - eventID: Event_01
    eventDialogueList:
    - characterID: 0
      dialogueText: "\u8001\u4EBA\u5BB6\u60A8\u600E\u4E48\u4E86?"
    - characterID: 1
      dialogueText: "......\u5FC3\u810F\u95EE\u9898\u53D1\u4F5C\u4E86...\u517D\u5316\u7684....\u8001\u6BDB\u75C5\u4E86.."
    - characterID: 0
      dialogueText: "\u522B\u8BF4\u8BDD\uFF0C\u6211\u5E2E\u60A8\u770B\u770B\u3002"
    - characterID: 1
      dialogueText: "\u4F60....\u4F60\u4F1A\u770B\u75C5?...\u7A00\u5947.."
    - characterID: 0
      dialogueText: "...\u6211\u624B\u4E0A\u6709\u4E9B\u5DE5\u5177\u53EF\u4EE5\u5E2E\u5FD9."
    - characterID: 0
      dialogueText: "\u60A8\u7684\u5FC3\u8DF3\u5F88\u4E71\uFF0C\u9700\u8981\u7A33\u5B9A\u4E0B\u6765\uFF0C\u6211\u4F1A\u5E2E\u60A8\u8C03\u6574"
    - characterID: 1
      dialogueText: "\u597D\u2026\u2026\u6211\u542C\u4F60\u7684\u2026\u2026"
  - eventID: Event_02
    eventDialogueList:
    - characterID: 1
      dialogueText: "\u5B69\u5B50\uFF0C\u771F\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u8C22\u4F60\u3002"
    - characterID: 0
      dialogueText: "....\u6CA1\u4E8B\u3002"
    - characterID: 1
      dialogueText: "\u6765\u770B\u671B\u8C01\u7684\uFF1F"
    - characterID: 0
      dialogueText: ......
    - characterID: 1
      dialogueText: "\u6CA1\u4E8B\uFF0C\u4F24\u5FC3\u4E8B\u4E0D\u613F\u610F\u8BF4\u5F88\u6B63\u5E38\uFF0C\u6765\u8FD9\u7684\u4EBA\u591A\u5C11\u90FD\u6709\u96BE\u5904\u3002"
    - characterID: 1
      dialogueText: "\u603B\u4E4B\u6CE8\u610F\u5B89\u5168\uFF0C\u8352\u539F\u4E0A\u50CF\u5B69\u5B50\u4F60\u8FD9\u6837\u7684\u6B63\u5E38\u4EBA\u53EF\u4E0D\u591A..."
    - characterID: 1
      dialogueText: "\u4ED6\u4EEC\u90A3\u4E9B\u8BE5\u6B7B\u7684\u53EF\u76EF\u7740\u5F88\u6B7B\uFF0C\u50CF\u4F60\u8FD9\u6837\u6CA1\u5F97\u8FC7\u75C5\u6BD2\u7684\u4EBA..."
    - characterID: 1
      dialogueText: "\u5509...."
    - characterID: 0
      dialogueText: "\u55EF.."
  - eventID: Event_03
    eventDialogueList: []
  - eventID: Event_04
    eventDialogueList:
    - characterID: 0
      dialogueText: "\u2026\u2026"
    - characterID: 0
      dialogueText: "\u8FD9\u662F\u4F60\u6700\u559C\u6B22\u7684\u82B1"
    - characterID: 0
      dialogueText: "\u6211\u8BB0\u5F97\u4F60\u66FE\u7ECF\u548C\u6211\u8BF4...\u4F60\u6700\u559C\u6B22\u5B83\u4EEC\u4E86"
    - characterID: 0
      dialogueText: "\u79CD\u5B83\u4EEC\u82B1\u4E86\u5F88\u591A\u5F88\u591A\u65F6\u95F4.."
    - characterID: 0
      dialogueText: "\u6211\u597D\u60F3\u4F60..."
  - eventID: Event_05
    eventDialogueList:
    - characterID: 0
      dialogueText: "......\u5173\u4E8E\u7559\u4E0B\u7684\u90A3\u4EFD\u8BB0\u5F55"
    - characterID: 0
      dialogueText: "\u6211\u5176\u5B9E\u4E00\u76F4\u6709\u51E0\u4E2A\u95EE\u9898"
    - characterID: 0
      dialogueText: "\u4E3A\u4EC0\u4E48\u8981\u628A\u6211......."
    - characterID: 0
      dialogueText: "\u7B49\u4E0B....\u5443......"
    - characterID: 0
      dialogueText: "\u6211....."
