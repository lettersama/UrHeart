  - key: os.chapter03.ui.reasoning.sample.01
    values:
    - language: 0
      text: "\u4E3B\u4EBA.\u4F4D\u7F6E = \u5367\u5BA4\uFF1F"
    - language: 1
      text: "\u4E3B\u4EBA.\u4F4D\u7F6E = \u81E5\u5BA4\uFF1F"
    - language: 2
      text: Master.location = bedroom?
    - language: 3
      text: "\u3054\u4E3B\u4EBA.\u4F4D\u7F6E = \u5BDD\u5BA4\uFF1F"
    - language: 4
      text: "\uC8FC\uC778\uB2D8.\uC704\uCE58 = \uCE68\uC2E4?"
    - language: 5
      text: "ma\xEEtresse.position = chambre ?"
    - language: 6
      text: Herrin.Standort = Schlafzimmer?
    - language: 7
      text: "Ama.ubicaci\xF3n = \xBFdormitorio?"
    - language: 8
      text: Dona.local = quarto?
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430.\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
        = \u0441\u043F\u0430\u043B\u044C\u043D\u044F?"
  - key: os.chapter03.ui.reasoning.sample.02
    values:
    - language: 0
      text: "\u978B = \u5728\u3000\u4F1E = \u5728\u3000\u5916\u5957 = \u5728"
    - language: 1
      text: "\u978B = \u5728\u3000\u5098 = \u5728\u3000\u5916\u5957 = \u5728"
    - language: 2
      text: shoes = here  umbrella = here  coat = here
    - language: 3
      text: "\u9774 = \u3042\u308A\u3000\u5098 = \u3042\u308A\u3000\u4E0A\u7740 =
        \u3042\u308A"
    - language: 4
      text: "\uC2E0\uBC1C = \uC788\uC74C\u3000\uC6B0\uC0B0 = \uC788\uC74C\u3000\uC678\uD22C
        = \uC788\uC74C"
    - language: 5
      text: chaussures = ici  parapluie = ici  manteau = ici
    - language: 6
      text: Schuhe = hier  Schirm = hier  Mantel = hier
    - language: 7
      text: "Zapatos = aqu\xED\u3000Paraguas = aqu\xED\u3000Abrigo = aqu\xED"
    - language: 8
      text: "Sapatos = aqui\u3000Guarda-chuva = aqui\u3000Casaco = aqui"
    - language: 9
      text: "\u041E\u0431\u0443\u0432\u044C = \u0435\u0441\u0442\u044C\u3000\u0417\u043E\u043D\u0442
        = \u0435\u0441\u0442\u044C\u3000\u041A\u0443\u0440\u0442\u043A\u0430 = \u0435\u0441\u0442\u044C"
  - key: os.chapter03.ui.reasoning.sample.03
    values:
    - language: 0
      text: "\u5496\u5561 = \u51C9\u3000\u836F = 0"
    - language: 1
      text: "\u5496\u5561 = \u6DBC\u3000\u85E5 = 0"
    - language: 2
      text: coffee = cold  medicine = 0
    - language: 3
      text: "\u30B3\u30FC\u30D2\u30FC = \u51B7\u3000\u85AC = 0"
    - language: 4
      text: "\uCEE4\uD53C = \uC2DD\uC74C\u3000\uC57D = 0"
    - language: 5
      text: "caf\xE9 = froid  m\xE9dicaments = 0"
    - language: 6
      text: Kaffee = kalt  Medikamente = 0
    - language: 7
      text: "Caf\xE9 = fr\xEDo\u3000Medicinas = 0"
    - language: 8
      text: "Caf\xE9 = frio\u3000Rem\xE9dios = 0"
    - language: 9
      text: "\u041A\u043E\u0444\u0435 = \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439\u3000\u041B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430
        = 0"
  - key: os.chapter03.ui.reasoning.sample.04
    values:
    - language: 0
      text: "\u95E8.\u5E94\u7B54 = \u65E0\u3000\u95E8.\u5E94\u7B54 = \u65E0\u3000\u95E8.\u5E94\u7B54
        = \u65E0"
    - language: 1
      text: "\u9580.\u61C9\u7B54 = \u7121\u3000\u9580.\u61C9\u7B54 = \u7121\u3000\u9580.\u61C9\u7B54
        = \u7121"
    - language: 2
      text: door.response = none  door.response = none  door.response = none
    - language: 3
      text: "\u30C9\u30A2.\u5FDC\u7B54 = \u306A\u3057\u3000\u30C9\u30A2.\u5FDC\u7B54
        = \u306A\u3057\u3000\u30C9\u30A2.\u5FDC\u7B54 = \u306A\u3057"
    - language: 4
      text: "\uBB38.\uC751\uB2F5 = \uC5C6\uC74C\u3000\uBB38.\uC751\uB2F5 = \uC5C6\uC74C\u3000\uBB38.\uC751\uB2F5
        = \uC5C6\uC74C"
    - language: 5
      text: "porte.r\xE9ponse = aucune  porte.r\xE9ponse = aucune  porte.r\xE9ponse
        = aucune"
    - language: 6
      text: "T\xFCr.Antwort = keine  T\xFCr.Antwort = keine  T\xFCr.Antwort = keine"
    - language: 7
      text: "Puerta.respuesta = ninguna\u3000Puerta.respuesta = ninguna\u3000Puerta.respuesta
        = ninguna"
    - language: 8
      text: "Porta.resposta = nenhuma\u3000Porta.resposta = nenhuma\u3000Porta.resposta
        = nenhuma"
    - language: 9
      text: "\u0414\u0432\u0435\u0440\u044C.\u043E\u0442\u0432\u0435\u0442 = \u043D\u0435\u0442\u3000\u0414\u0432\u0435\u0440\u044C.\u043E\u0442\u0432\u0435\u0442
        = \u043D\u0435\u0442\u3000\u0414\u0432\u0435\u0440\u044C.\u043E\u0442\u0432\u0435\u0442
        = \u043D\u0435\u0442"
  - key: os.chapter03.ui.reasoning.sample.05
    values:
    - language: 0
      text: "\u4E3B\u4EBA.\u4F4D\u7F6E = \uFF1F\uFF1F\uFF1F"
    - language: 1
      text: "\u4E3B\u4EBA.\u4F4D\u7F6E = \uFF1F\uFF1F\uFF1F"
    - language: 2
      text: Master.location = ???
    - language: 3
      text: "\u3054\u4E3B\u4EBA.\u4F4D\u7F6E = \uFF1F\uFF1F\uFF1F"
    - language: 4
      text: "\uC8FC\uC778\uB2D8.\uC704\uCE58 = \uFF1F\uFF1F\uFF1F"
    - language: 5
      text: "ma\xEEtresse.position = ???"
    - language: 6
      text: Herrin.Standort = ???
    - language: 7
      text: "Ama.ubicaci\xF3n = ???"
    - language: 8
      text: Dona.local = ???
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430.\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
        = \uFF1F\uFF1F\uFF1F"
  - key: os.chapter03.ui.reasoning.sample.06
    values:
    - language: 0
      text: "\u4E3B\u4EBA \u4E3B\u4EBA \u4E3B\u4EBA \u4E3B\u4EBA"
    - language: 1
      text: "\u4E3B\u4EBA \u4E3B\u4EBA \u4E3B\u4EBA \u4E3B\u4EBA"
    - language: 2
      text: Master Master Master Master
    - language: 3
      text: "\u3054\u4E3B\u4EBA \u3054\u4E3B\u4EBA \u3054\u4E3B\u4EBA \u3054\u4E3B\u4EBA"
    - language: 4
      text: "\uC8FC\uC778\uB2D8 \uC8FC\uC778\uB2D8 \uC8FC\uC778\uB2D8 \uC8FC\uC778\uB2D8"
    - language: 5
      text: "ma\xEEtresse ma\xEEtresse ma\xEEtresse ma\xEEtresse"
    - language: 6
      text: Herrin Herrin Herrin Herrin
    - language: 7
      text: Ama Ama Ama Ama
    - language: 8
      text: Dona Dona Dona Dona
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0425\u043E\u0437\u044F\u0439\u043A\u0430"
  - key: os.memory.10000.text
    values:
    - language: 0
      text: "\u6211\u628A\u4FE1\u5C0F\u5FC3\u6536\u4E86\u8D77\u6765\uFF0C\u8FD9\u662F\u4E3B\u4EBA\u7684\u79D8\u5BC6\uFF0C\u6211\u6CA1\u6709\u8BFB\u5B83\u4EEC.."
    - language: 1
      text: "\u6211\u628A\u4FE1\u5C0F\u5FC3\u6536\u4E86\u8D77\u4F86\uFF0C\u9019\u662F\u4E3B\u4EBA\u7684\u79D8\u5BC6\uFF0C\u6211\u6C92\u6709\u8B80\u5B83\u5011.."
    - language: 2
      text: I carefully put the letters away. These were Master's secrets. I had
        not read them..
    - language: 3
      text: "\u624B\u7D19\u3092\u305D\u3063\u3068\u3057\u307E\u3063\u305F\u3002\u3053\u308C\u306F\u3054\u4E3B\u4EBA\u306E\u79D8\u5BC6\u3060\u3002\u79C1\u306F\u8AAD\u307E\u306A\u304B\u3063\u305F.."
    - language: 4
      text: "\uD3B8\uC9C0\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uCC59\uACBC\uB2E4.
        \uC774\uAC74 \uC8FC\uC778\uB2D8\uC758 \uBE44\uBC00\uC774\uB2E4. \uB098\uB294
        \uC77D\uC9C0 \uC54A\uC558\uB2E4.."
    - language: 5
      text: "J'ai soigneusement rang\xE9 les lettres. C'\xE9taient les secrets de
        ma ma\xEEtresse. Je ne les avais pas lues.."
    - language: 6
      text: Ich legte die Briefe vorsichtig weg. Das waren die Geheimnisse meiner
        Herrin. Ich hatte sie nicht gelesen..
    - language: 7
      text: "Guardo las cartas con cuidado. Son secretos de mi ama; no las he le\xEDdo.."
    - language: 8
      text: "Guardo as cartas com cuidado. S\xE3o os segredos da minha dona. Eu n\xE3o
        li.."
    - language: 9
      text: "\u042F \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u0443\u0431\u0440\u0430\u043B\u0430
        \u043F\u0438\u0441\u044C\u043C\u0430. \u042D\u0442\u043E \u0441\u0435\u043A\u0440\u0435\u0442
        \u0445\u043E\u0437\u044F\u0439\u043A\u0438. \u042F \u0438\u0445 \u043D\u0435
        \u0447\u0438\u0442\u0430\u043B\u0430.."
  - key: os.memory.10010.text
    values:
    - language: 0
      text: "\u7535\u91CF\u8FD8\u662F100%\uFF0C\u4E00\u683C\u90FD\u6CA1\u6709\u6389...\u4EE5\u524D\u4E3B\u4EBA\u5728\u5DE5\u4F5C\u7684\u65F6\u5019\uFF0C\u5199\u4E00\u4F1A\u513F\u770B\u5230\u6211\u5C31\u53F9\u6C14\u62C9\u6211\u53BB\u5145\u7535..\u4ECA\u5929\u4E0D\u592A\u4E00\u6837."
    - language: 1
      text: "\u96FB\u91CF\u9084\u662F100%\uFF0C\u4E00\u683C\u90FD\u6C92\u6709\u6389...\u4EE5\u524D\u4E3B\u4EBA\u5728\u5DE5\u4F5C\u7684\u6642\u5019\uFF0C\u5BEB\u4E00\u6703\u5152\u770B\u5230\u6211\u5C31\u5606\u6C23\u62C9\u6211\u53BB\u5145\u96FB..\u4ECA\u5929\u4E0D\u592A\u4E00\u6A23."
    - language: 2
      text: Battery level is still 100%, not a single bar down... Whenever Master
        was working, she'd write for a while, then see me, sigh, and take me to recharge..
        Today is a little different.
    - language: 3
      text: "\u6B8B\u91CF\u306F\u307E\u3060100%\u3001\u4E00\u76EE\u76DB\u308A\u3082\u6E1B\u3063\u3066\u3044\u306A\u3044...\u4EE5\u524D\u3001\u3054\u4E3B\u4EBA\u306F\u4ED5\u4E8B\u4E2D\u3001\u3057\u3070\u3089\u304F\u66F8\u3044\u3066\u304B\u3089\u79C1\u3092\u898B\u308B\u3068\u3001\u305F\u3081\u606F\u3092\u3064\u3044\u3066\u79C1\u3092\u5145\u96FB\u306B\u9023\u308C\u3066\u3044\u3063\u305F..\u4ECA\u65E5\u306F\u5C11\u3057\u9055\u3046."
    - language: 4
      text: "\uBC30\uD130\uB9AC\uB294 \uC5EC\uC804\uD788 100%, \uD55C \uCE78\uB3C4
        \uC904\uC9C0 \uC54A\uC558\uB2E4...\uC608\uC804\uC5D0\uB294 \uC8FC\uC778\uB2D8\uC774
        \uC77C\uD558\uC2E4 \uB54C, \uAE00\uC744 \uC880 \uC4F0\uC2DC\uB2E4\uAC00 \uB098\uB97C
        \uBCF4\uC2DC\uBA74 \uD55C\uC228\uC744 \uC26C\uBA70 \uCDA9\uC804\uD558\uB7EC
        \uB370\uB824\uAC00\uC168\uB2E4..\uC624\uB298\uC740 \uC880 \uB2E4\uB974\uB2E4."
    - language: 5
      text: "La batterie est toujours \xE0 100%, pas une seule barre en moins...
        Avant, quand ma ma\xEEtresse travaillait, elle \xE9crivait un moment, puis,
        en me voyant, elle soupirait et m'emmenait me recharger.. Aujourd'hui, c'est
        un peu diff\xE9rent."
    - language: 6
      text: "Der Akku steht immer noch bei 100%, kein einziger Balken ist verschwunden...
        Fr\xFCher schrieb meine Herrin bei der Arbeit eine Weile, und wenn sie mich
        sah, seufzte sie und nahm mich zum Aufladen mit.. Heute ist es ein wenig
        anders."
    - language: 7
      text: "La bater\xEDa sigue al 100%, no ha bajado ni una raya... Antes, cuando
        mi ama trabajaba, escrib\xEDa un rato y, al verme, suspiraba y me llevaba
        a recargar.. Hoy es un poco distinto."
    - language: 8
      text: "A bateria continua em 100%, n\xE3o caiu nem uma barrinha... Antes, quando
        minha dona trabalhava, escrevia por um tempo e, ao me ver, suspirava e me
        levava para recarregar.. Hoje est\xE1 um pouco diferente."
    - language: 9
      text: "\u0417\u0430\u0440\u044F\u0434 \u0432\u0441\u0451 \u0435\u0449\u0451
        100%, \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0434\u0435\u043B\u0435\u043D\u0438\u044F
        \u043D\u0435 \u0443\u0431\u0430\u0432\u0438\u043B\u043E\u0441\u044C... \u0420\u0430\u043D\u044C\u0448\u0435,
        \u043A\u043E\u0433\u0434\u0430 \u0445\u043E\u0437\u044F\u0439\u043A\u0430
        \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430, \u043E\u043D\u0430 \u043F\u0438\u0441\u0430\u043B\u0430
        \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0432\u0440\u0435\u043C\u044F,
        \u0430 \u0443\u0432\u0438\u0434\u0435\u0432 \u043C\u0435\u043D\u044F, \u0432\u0437\u0434\u044B\u0445\u0430\u043B\u0430
        \u0438 \u0432\u0435\u043B\u0430 \u043C\u0435\u043D\u044F \u043D\u0430 \u0437\u0430\u0440\u044F\u0434\u043A\u0443..
        \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0438\u043D\u0430\u0447\u0435."
  - key: os.memory.10020.text
    values:
    - language: 0
      text: "\u53F0\u706F\u8FD8\u4EAE\u7740\uFF0C\u684C\u4E0A\u644A\u7740\u4E3B\u4EBA\u7684\u7814\u7A76\u7B14\u8BB0\u3002"
    - language: 1
      text: "\u6AAF\u71C8\u9084\u4EAE\u8457\uFF0C\u684C\u4E0A\u6524\u8457\u4E3B\u4EBA\u7684\u7814\u7A76\u7B46\u8A18\u3002"
    - language: 2
      text: The desk lamp was still on. Master's research notes lay open on the desk.
    - language: 3
      text: "\u5353\u4E0A\u30E9\u30F3\u30D7\u306F\u307E\u3060\u3064\u3044\u3066\u3044\u3066\u3001\u673A\u306B\u306F\u3054\u4E3B\u4EBA\u306E\u7814\u7A76\u30CE\u30FC\u30C8\u304C\u5E83\u3052\u3066\u3042\u308B\u3002"
    - language: 4
      text: "\uC2A4\uD0E0\uB4DC\uB294 \uC544\uC9C1 \uCF1C\uC838 \uC788\uACE0, \uCC45\uC0C1\uC5D0\uB294
        \uC8FC\uC778\uB2D8\uC758 \uC5F0\uAD6C \uB178\uD2B8\uAC00 \uD3BC\uCCD0\uC838
        \uC788\uB2E4."
    - language: 5
      text: "La lampe \xE9tait encore allum\xE9e. Les notes de recherche de ma ma\xEEtresse
        \xE9taient ouvertes sur le bureau."
    - language: 6
      text: Die Schreibtischlampe brannte noch. Die Forschungsnotizen meiner Herrin
        lagen aufgeschlagen auf dem Tisch.
    - language: 7
      text: "La l\xE1mpara sigue encendida. Sobre el escritorio est\xE1n abiertas
        las notas de investigaci\xF3n de mi ama."
    - language: 8
      text: "A lumin\xE1ria ainda est\xE1 acesa. As anota\xE7\xF5es de pesquisa da
        minha dona est\xE3o espalhadas pela escrivaninha."
    - language: 9
      text: "\u041D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u0430\u044F \u043B\u0430\u043C\u043F\u0430
        \u0435\u0449\u0451 \u0433\u043E\u0440\u0438\u0442. \u041D\u0430 \u0441\u0442\u043E\u043B\u0435
        \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044B \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435
        \u0437\u0430\u043F\u0438\u0441\u0438 \u0445\u043E\u0437\u044F\u0439\u043A\u0438."
  - key: os.memory.10030.text
    values:
    - language: 0
      text: "\u4E00\u9875\u7EB8\u4E0A\u53EA\u5199\u4E86\u4E09\u4E2A\u5B57\uFF0C\u300C\u5982\u679C\u6211\u2026\u2026\u300D\uFF0C\u540E\u9762\u662F\u7A7A\u7684\u3002"
    - language: 1
      text: "\u4E00\u9801\u7D19\u4E0A\u53EA\u5BEB\u4E86\u4E09\u500B\u5B57\uFF0C\u300C\u5982\u679C\u6211\u2026\u2026\u300D\uFF0C\u5F8C\u9762\u662F\u7A7A\u7684\u3002"
    - language: 2
      text: 'Only three words were written on one page: "If I ever..." The rest was
        blank.'
    - language: 3
      text: "\u7D19\u306B\u306F\u300C\u3082\u3057\u79C1\u304C\u2026\u2026\u300D\u3068\u3060\u3051\u66F8\u304B\u308C\u3066\u3044\u305F\u3002\u305D\u306E\u5148\u306F\u7A7A\u767D\u3060\u3063\u305F\u3002"
    - language: 4
      text: "\uC885\uC774 \uD55C \uC7A5\uC5D0 \u2018\uB9CC\uC57D \uB0B4\uAC00\u2026\u2026\u2019\uB77C\uB294
        \uB9D0\uB9CC \uC801\uD600 \uC788\uC5C8\uB2E4. \uADF8 \uB4A4\uB294 \uBE44\uC5B4
        \uC788\uC5C8\uB2E4."
    - language: 5
      text: "Sur une page, il n'y avait que trois mots : \xAB Si un jour... \xBB
        Le reste \xE9tait vide."
    - language: 6
      text: "Auf einer Seite standen nur drei W\xF6rter: \u201EFalls ich einmal...\u201C
        Der Rest war leer."
    - language: 7
      text: "En una hoja solo pone \xABSi yo...\xBB. El resto est\xE1 en blanco."
    - language: 8
      text: "Uma folha s\xF3 tem as palavras \u201CSe eu...\u201D. O resto est\xE1
        em branco."
    - language: 9
      text: "\u041D\u0430 \u043B\u0438\u0441\u0442\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
        \u0442\u043E\u043B\u044C\u043A\u043E: \xAB\u0415\u0441\u043B\u0438 \u044F\u2026\u2026\xBB.
        \u0414\u0430\u043B\u044C\u0448\u0435 \u043F\u0443\u0441\u0442\u043E."
  - key: os.memory.10040.text
    values:
    - language: 0
      text: "\u53F0\u706F\u4E00\u95EA\u4E00\u95EA\u7684\uFF0C\u5B83\u597D\u50CF\u8981\u574F\u6389\u4E86\u3002"
    - language: 1
      text: "\u6AAF\u71C8\u4E00\u9583\u4E00\u9583\u7684\uFF0C\u5B83\u597D\u50CF\u8981\u58DE\u6389\u4E86\u3002"
    - language: 2
      text: The desk lamp kept flickering. It seemed to be failing.
    - language: 3
      text: "\u5353\u4E0A\u30E9\u30F3\u30D7\u304C\u3061\u3089\u3061\u3089\u3057\u3066\u3044\u308B\u3002\u3082\u3046\u3059\u3050\u58CA\u308C\u305D\u3046\u3060\u3002"
    - language: 4
      text: "\uC2A4\uD0E0\uB4DC\uAC00 \uAE5C\uBE61\uAC70\uB9B0\uB2E4. \uACE7 \uACE0\uC7A5
        \uB0A0 \uAC83 \uAC19\uB2E4."
    - language: 5
      text: La lampe du bureau clignotait. Elle semblait sur le point de tomber en
        panne.
    - language: 6
      text: Die Schreibtischlampe flackerte. Sie schien bald kaputtzugehen.
    - language: 7
      text: "La l\xE1mpara parpadea. Parece que est\xE1 a punto de estropearse."
    - language: 8
      text: "A lumin\xE1ria est\xE1 piscando. Parece que vai quebrar."
    - language: 9
      text: "\u041D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u0430\u044F \u043B\u0430\u043C\u043F\u0430
        \u043C\u0438\u0433\u0430\u0435\u0442. \u041F\u043E\u0445\u043E\u0436\u0435,
        \u0441\u043A\u043E\u0440\u043E \u0441\u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F."
  - key: os.memory.10050.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u7684\u6905\u5B50\u63A8\u5F97\u5F88\u9760\u91CC\uFF0C\u6905\u80CC\u4E0A\u6CA1\u6709\u642D\u5916\u5957\uFF0C\u5979\u4E0D\u5728\u8FD9\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u7684\u6905\u5B50\u63A8\u5F97\u5F88\u9760\u88E1\uFF0C\u6905\u80CC\u4E0A\u6C92\u6709\u642D\u5916\u5957\uFF0C\u5979\u4E0D\u5728\u9019\u3002"
    - language: 2
      text: Master's chair was pushed well under the desk. Her coat was not on the
        back. She was not here.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u6905\u5B50\u306F\u673A\u306E\u5965\u307E\u3067\u62BC\u3057\u8FBC\u307E\u308C\u3066\u3044\u3066\u3001\u80CC\u3082\u305F\u308C\u306B\u4E0A\u7740\u3082\u306A\u3044\u3002\u3053\u3053\u306B\u306F\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uC758\uC790\uB294 \uCC45\uC0C1 \uC548\uCABD
        \uAE4A\uC219\uC774 \uBC00\uC5B4 \uB123\uC5B4\uC838 \uC788\uACE0, \uB4F1\uBC1B\uC774\uC5D0
        \uC678\uD22C\uB3C4 \uAC78\uB824 \uC788\uC9C0 \uC54A\uB2E4. \uC5EC\uAE30\uC5D0\uB294
        \uC548 \uACC4\uC2E0\uB2E4."
    - language: 5
      text: "La chaise de ma ma\xEEtresse \xE9tait bien rentr\xE9e sous le bureau.
        Son manteau n'\xE9tait pas sur le dossier. Elle n'\xE9tait pas l\xE0."
    - language: 6
      text: "Der Stuhl meiner Herrin war weit unter den Tisch geschoben. \xDCber
        der Lehne hing kein Mantel. Sie war nicht hier."
    - language: 7
      text: "La silla de mi ama est\xE1 muy metida bajo el escritorio. No hay ning\xFAn
        abrigo en el respaldo. Ella no est\xE1 aqu\xED."
    - language: 8
      text: "A cadeira da minha dona est\xE1 bem debaixo da escrivaninha. N\xE3o
        tem casaco no encosto. Ela n\xE3o est\xE1 aqui."
    - language: 9
      text: "\u041A\u0440\u0435\u0441\u043B\u043E \u0445\u043E\u0437\u044F\u0439\u043A\u0438
        \u0437\u0430\u0434\u0432\u0438\u043D\u0443\u0442\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u043E
        \u043F\u043E\u0434 \u0441\u0442\u043E\u043B. \u041D\u0430 \u0441\u043F\u0438\u043D\u043A\u0435
        \u043D\u0435\u0442 \u0435\u0451 \u043A\u0443\u0440\u0442\u043A\u0438. \u0415\u0451
        \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0442."
  - key: os.memory.10060.text
    values:
    - language: 0
      text: "\u4E66\u67B6\u4E0A\u7684\u4E66\u6309\u4E3B\u4EBA\u7684\u4E60\u60EF\u63D2\u5F97\u6B6A\u6B6A\u626D\u626D\uFF0C\u53EA\u6709\u6700\u4E0B\u9762\u4E00\u6392\uFF0C\u88AB\u4EBA\u91CD\u65B0\u7801\u9F50\u4E86\u3002"
    - language: 1
      text: "\u66F8\u67B6\u4E0A\u7684\u66F8\u6309\u4E3B\u4EBA\u7684\u7FD2\u6163\u63D2\u5F97\u6B6A\u6B6A\u626D\u626D\uFF0C\u53EA\u6709\u6700\u4E0B\u9762\u4E00\u6392\uFF0C\u88AB\u4EBA\u91CD\u65B0\u6392\u6574\u9F4A\u4E86\u3002"
    - language: 2
      text: The books were crooked on the shelves, the way Master always left them.
        Only the bottom row had been put neatly in order.
    - language: 3
      text: "\u672C\u68DA\u306E\u672C\u306F\u3001\u3044\u3064\u3082\u306E\u3054\u4E3B\u4EBA\u3089\u3057\u304F\u659C\u3081\u306B\u5DEE\u3057\u3066\u3042\u308B\u3002\u4E00\u756A\u4E0B\u306E\u6BB5\u3060\u3051\u3001\u8AB0\u304B\u304C\u304D\u308C\u3044\u306B\u4E26\u3079\u76F4\u3057\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uCC45\uC7A5\uC758 \uCC45\uB4E4\uC740 \uC8FC\uC778\uB2D8\uC758 \uD3C9\uC18C
        \uC2B5\uAD00\uB300\uB85C \uBE44\uB6A4\uBE44\uB6A4 \uAF42\uD600 \uC788\uB2E4.
        \uB9E8 \uC544\uB798 \uCE78\uB9CC \uB204\uAD70\uAC00 \uB2E4\uC2DC \uAC00\uC9C0\uB7F0\uD788
        \uC815\uB9AC\uD574 \uB193\uC558\uB2E4."
    - language: 5
      text: "Les livres \xE9taient rang\xE9s de travers, comme ma ma\xEEtresse en
        avait l'habitude. Seule la rang\xE9e du bas avait \xE9t\xE9 remise en ordre."
    - language: 6
      text: "Die B\xFCcher standen wie immer schief im Regal. Nur die unterste Reihe
        hatte jemand ordentlich ausgerichtet."
    - language: 7
      text: "Los libros est\xE1n torcidos en la estanter\xEDa, como siempre los deja
        mi ama. Solo la fila de abajo est\xE1 bien ordenada. Alguien la ha arreglado."
    - language: 8
      text: "Os livros est\xE3o tortos na estante, como minha dona costuma deixar.
        S\xF3 a fileira de baixo foi arrumada por algu\xE9m."
    - language: 9
      text: "\u041A\u043D\u0438\u0433\u0438 \u043D\u0430 \u043F\u043E\u043B\u043A\u0430\u0445
        \u0441\u0442\u043E\u044F\u0442 \u0432\u043A\u0440\u0438\u0432\u044C \u0438
        \u0432\u043A\u043E\u0441\u044C, \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E
        \u0443 \u0445\u043E\u0437\u044F\u0439\u043A\u0438. \u0422\u043E\u043B\u044C\u043A\u043E
        \u0441\u0430\u043C\u044B\u0439 \u043D\u0438\u0436\u043D\u0438\u0439 \u0440\u044F\u0434
        \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u043D\u043E\u0432\u043E \u0432\u044B\u0440\u043E\u0432\u043D\u044F\u043B."
  - key: os.memory.10070.text
    values:
    - language: 0
      text: "\u7A97\u5E18\u62C9\u5F97\u4E25\u4E25\u5B9E\u5B9E\uFF0C\u5916\u9762\u4F30\u8BA1\u548C\u5E73\u5E38\u4E00\u6837\u5371\u9669\u3002"
    - language: 1
      text: "\u7A97\u7C3E\u62C9\u5F97\u56B4\u56B4\u5BE6\u5BE6\uFF0C\u5916\u9762\u4F30\u8A08\u548C\u5E73\u5E38\u4E00\u6A23\u5371\u96AA\u3002"
    - language: 2
      text: The curtains were tightly drawn. Outside was probably as dangerous as
        usual.
    - language: 3
      text: "\u30AB\u30FC\u30C6\u30F3\u306F\u9699\u9593\u306A\u304F\u9589\u307E\u3063\u3066\u3044\u308B\u3002\u5916\u306F\u304D\u3063\u3068\u3001\u3044\u3064\u3082\u3068\u540C\u3058\u3088\u3046\u306B\u5371\u306A\u3044\u306E\u3060\u308D\u3046\u3002"
    - language: 4
      text: "\uCEE4\uD2BC\uC774 \uBE48\uD2C8\uC5C6\uC774 \uCCD0\uC838 \uC788\uB2E4.
        \uBC16\uC740 \uC544\uB9C8 \uD3C9\uC18C\uCC98\uB7FC \uC704\uD5D8\uD560 \uAC83\uC774\uB2E4."
    - language: 5
      text: "Les rideaux \xE9taient bien ferm\xE9s. Dehors, c'\xE9tait probablement
        aussi dangereux que d'habitude."
    - language: 6
      text: "Die Vorh\xE4nge waren fest zugezogen. Drau\xDFen war es vermutlich so
        gef\xE4hrlich wie sonst."
    - language: 7
      text: "Las cortinas est\xE1n bien cerradas. Fuera debe de ser tan peligroso
        como siempre."
    - language: 8
      text: "As cortinas est\xE3o bem fechadas. L\xE1 fora deve estar t\xE3o perigoso
        quanto sempre."
    - language: 9
      text: "\u0428\u0442\u043E\u0440\u044B \u043F\u043B\u043E\u0442\u043D\u043E
        \u0437\u0430\u0434\u0451\u0440\u043D\u0443\u0442\u044B. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u0442\u0430\u043A \u0436\u0435
        \u043E\u043F\u0430\u0441\u043D\u043E, \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430."
  - key: os.memory.10080.text
    values:
    - language: 0
      text: "\u51FA\u4E86\u4E66\u623F\uFF0C\u5DE6\u624B\u8FB9\u5C31\u662F\u4E3B\u4EBA\u5367\u5BA4\u7684\u95E8\u3002"
    - language: 1
      text: "\u51FA\u4E86\u66F8\u623F\uFF0C\u5DE6\u624B\u908A\u5C31\u662F\u4E3B\u4EBA\u81E5\u5BA4\u7684\u9580\u3002"
    - language: 2
      text: Just outside the study, Master's bedroom door was on the left.
    - language: 3
      text: "\u66F8\u658E\u3092\u51FA\u3066\u5DE6\u624B\u306B\u3001\u3054\u4E3B\u4EBA\u306E\u5BDD\u5BA4\u306E\u30C9\u30A2\u304C\u3042\u308B\u3002"
    - language: 4
      text: "\uC11C\uC7AC\uB97C \uB098\uC624\uBA74 \uC67C\uCABD\uC5D0 \uBC14\uB85C
        \uC8FC\uC778\uB2D8\uC758 \uCE68\uC2E4 \uBB38\uC774 \uC788\uB2E4."
    - language: 5
      text: "En sortant du bureau, la porte de la chambre de ma ma\xEEtresse \xE9tait
        juste \xE0 gauche."
    - language: 6
      text: "Direkt links vor dem Arbeitszimmer lag die Schlafzimmert\xFCr meiner
        Herrin."
    - language: 7
      text: Al salir del estudio, la puerta del dormitorio de mi ama queda a la izquierda.
    - language: 8
      text: "Saindo do escrit\xF3rio, a porta do quarto da minha dona fica \xE0 esquerda."
    - language: 9
      text: "\u0421\u0440\u0430\u0437\u0443 \u0441\u043B\u0435\u0432\u0430 \u043E\u0442
        \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u2014 \u0434\u0432\u0435\u0440\u044C
        \u0441\u043F\u0430\u043B\u044C\u043D\u0438 \u0445\u043E\u0437\u044F\u0439\u043A\u0438."
  - key: os.memory.10090.text
    values:
    - language: 0
      text: "\u549A\u3001\u549A...\u6CA1\u6709\u4EBA\u56DE\u7B54\u3002\u4E3B\u4EBA\u6BCF\u5929\u665A\u4E0A\u90FD\u9501\u95E8\u7761\u89C9\uFF0C\u65E9\u4E0A\u6211\u7AEF\u7740\u5496\u5561\u6765\u6572\u95E8\uFF0C\u5979\u5ACC\u5435\u4E86\u624D\u5F00...\u73B0\u5728\u8FD8\u6CA1\u5230\u5979\u5ACC\u5435\u7684\u65F6\u5019\u3002\u6211\u4E0D\u80FD\u8FDB\u53BB\u6253\u6270\u5979\u3002\u5148\u53BB\u716E\u5496\u5561\u5427\u3002"
    - language: 1
      text: "\u549A\u3001\u549A...\u6C92\u6709\u4EBA\u56DE\u7B54\u3002\u4E3B\u4EBA\u6BCF\u5929\u665A\u4E0A\u90FD\u9396\u9580\u7761\u89BA\uFF0C\u65E9\u4E0A\u6211\u7AEF\u8457\u5496\u5561\u4F86\u6572\u9580\uFF0C\u5979\u5ACC\u5435\u4E86\u624D\u958B...\u73FE\u5728\u9084\u6C92\u5230\u5979\u5ACC\u5435\u7684\u6642\u5019\u3002\u6211\u4E0D\u80FD\u9032\u53BB\u6253\u64FE\u5979\u3002\u5148\u53BB\u716E\u5496\u5561\u5427\u3002"
    - language: 2
      text: Knock, knock... No answer. Master locked her door every night. In the
        morning I would bring her coffee and knock until she opened it to complain
        about the noise... It was not time for her to complain yet. I could not go
        in and disturb her. I should make coffee first.
    - language: 3
      text: "\u30B3\u30F3\u3001\u30B3\u30F3...\u8FD4\u4E8B\u306F\u306A\u3044\u3002\u3054\u4E3B\u4EBA\u306F\u6BCE\u6669\u3001\u9375\u3092\u304B\u3051\u3066\u7720\u308B\u3002\u671D\u3001\u30B3\u30FC\u30D2\u30FC\u3092\u6301\u3063\u3066\u30CE\u30C3\u30AF\u3059\u308B\u3068\u3001\u3046\u308B\u3055\u3044\u3068\u601D\u3063\u3066\u3088\u3046\u3084\u304F\u958B\u3051\u3066\u304F\u308C\u308B...\u307E\u3060\u3001\u3046\u308B\u3055\u3044\u3068\u601D\u3063\u3066\u3044\u306A\u3044\u306E\u3060\u3002\u5165\u3063\u3066\u90AA\u9B54\u3092\u3057\u3066\u306F\u3044\u3051\u306A\u3044\u3002\u5148\u306B\u30B3\u30FC\u30D2\u30FC\u3092\u6DF9\u308C\u3088\u3046\u3002"
    - language: 4
      text: "\uB611, \uB611...\uB300\uB2F5\uC774 \uC5C6\uB2E4. \uC8FC\uC778\uB2D8\uC740
        \uB9E4\uC77C \uBC24 \uBB38\uC744 \uC7A0\uADF8\uACE0 \uC8FC\uBB34\uC2E0\uB2E4.
        \uC544\uCE68\uC5D0 \uCEE4\uD53C\uB97C \uB4E4\uACE0 \uBB38\uC744 \uB450\uB4DC\uB9AC\uBA74,
        \uC2DC\uB044\uB7EC\uC6CC\uC11C \uBABB \uACAC\uB514\uC2E4 \uB54C\uCBE4 \uC5F4\uC5B4
        \uC8FC\uC2E0\uB2E4...\uC544\uC9C1 \uADF8\uB9CC\uD07C \uC2DC\uB044\uB7FD\uC9C0\uB294
        \uC54A\uC740 \uBAA8\uC591\uC774\uB2E4. \uB4E4\uC5B4\uAC00\uC11C \uBC29\uD574\uD558\uBA74
        \uC548 \uB41C\uB2E4. \uC6B0\uC120 \uCEE4\uD53C\uBD80\uD130 \uB053\uC774\uC790."
    - language: 5
      text: "Toc, toc... Aucune r\xE9ponse. Ma ma\xEEtresse fermait sa porte \xE0
        cl\xE9 chaque soir. Le matin, je frappais avec son caf\xE9 jusqu'\xE0 ce
        qu'elle ouvre pour se plaindre du bruit... Ce n'\xE9tait pas encore le moment
        o\xF9 elle se plaignait. Je ne pouvais pas entrer la d\xE9ranger. Il fallait
        d'abord pr\xE9parer le caf\xE9."
    - language: 6
      text: "Klopf, klopf... Keine Antwort. Meine Herrin schloss nachts immer ab.
        Morgens brachte ich Kaffee und klopfte, bis sie \xF6ffnete, um \xFCber den
        L\xE4rm zu schimpfen... Noch war es nicht so weit. Ich durfte nicht hineingehen
        und sie st\xF6ren. Erst musste ich Kaffee kochen."
    - language: 7
      text: "Toc, toc... Nadie responde. Mi ama cierra con llave todas las noches.
        Por la ma\xF1ana llevo el caf\xE9 y llamo hasta que el ruido la molesta lo
        suficiente para abrir... Todav\xEDa no la he molestado tanto. No debo entrar
        a interrumpirla. Primero har\xE9 el caf\xE9."
    - language: 8
      text: "Toc, toc... Ningu\xE9m responde. Minha dona tranca a porta todas as
        noites. De manh\xE3, eu trago o caf\xE9 e bato at\xE9 ela se irritar com
        o barulho e abrir... Ainda n\xE3o chegou essa hora. N\xE3o posso entrar e
        incomod\xE1-la. Vou fazer o caf\xE9 primeiro."
    - language: 9
      text: "\u0422\u0443\u043A, \u0442\u0443\u043A...\u041D\u0438\u043A\u0442\u043E
        \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442. \u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442
        \u0434\u0432\u0435\u0440\u044C \u043F\u0435\u0440\u0435\u0434 \u0441\u043D\u043E\u043C.
        \u0423\u0442\u0440\u043E\u043C \u044F \u043F\u0440\u0438\u043D\u043E\u0448\u0443
        \u043A\u043E\u0444\u0435 \u0438 \u0441\u0442\u0443\u0447\u0443, \u0430 \u043E\u043D\u0430
        \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442, \u0442\u043E\u043B\u044C\u043A\u043E
        \u043A\u043E\u0433\u0434\u0430 \u0435\u0439 \u043D\u0430\u0434\u043E\u0435\u0434\u0430\u0435\u0442
        \u0448\u0443\u043C...\u041F\u043E\u043A\u0430 \u0435\u0449\u0451 \u043D\u0435
        \u043D\u0430\u0434\u043E\u0435\u043B\u043E. \u041D\u0435\u043B\u044C\u0437\u044F
        \u0432\u0445\u043E\u0434\u0438\u0442\u044C \u0438 \u043C\u0435\u0448\u0430\u0442\u044C
        \u0435\u0439. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u0432\u0430\u0440\u044E
        \u043A\u043E\u0444\u0435."
  - key: os.memory.10100.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u8FD8\u6CA1\u6709\u5F00\u95E8\u3002\u95E8\u7F1D\u5E95\u4E0B\u900F\u51FA\u4E00\u70B9\u5149\uFF0C\u662F\u5979\u7684\u7ACB\u706F\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u9084\u6C92\u6709\u958B\u9580\u3002\u9580\u7E2B\u5E95\u4E0B\u900F\u51FA\u4E00\u9EDE\u5149\uFF0C\u662F\u5979\u7684\u7ACB\u71C8\u3002"
    - language: 2
      text: Master still had not opened the door. A little light came through the
        gap underneath. Her standing lamp.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306F\u307E\u3060\u30C9\u30A2\u3092\u958B\u3051\u3066\u304F\u308C\u306A\u3044\u3002\u30C9\u30A2\u306E\u4E0B\u306E\u9699\u9593\u304B\u3089\u3001\u5C11\u3057\u5149\u304C\u6F0F\u308C\u3066\u3044\u308B\u3002\u3042\u306E\u30D5\u30ED\u30A2\u30E9\u30F3\u30D7\u3060\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC740 \uC544\uC9C1 \uBB38\uC744 \uC5F4\uC9C0 \uC54A\uC73C\uC168\uB2E4.
        \uBB38 \uC544\uB798 \uD2C8\uC73C\uB85C \uBE5B\uC774 \uC870\uAE08 \uC0C8\uC5B4
        \uB098\uC628\uB2E4. \uC8FC\uC778\uB2D8\uC758 \uC7A5\uC2A4\uD0E0\uB4DC\uB2E4."
    - language: 5
      text: "Ma ma\xEEtresse n'avait toujours pas ouvert. Un peu de lumi\xE8re passait
        sous la porte. Son lampadaire."
    - language: 6
      text: "Meine Herrin hatte noch nicht ge\xF6ffnet. Unter der T\xFCr schimmerte
        etwas Licht. Ihre Stehlampe."
    - language: 7
      text: "Mi ama sigue sin abrir. Por debajo de la puerta se filtra un poco de
        luz: es su l\xE1mpara de pie."
    - language: 8
      text: "Minha dona ainda n\xE3o abriu a porta. Um pouco de luz passa por baixo
        dela. \xC9 a lumin\xE1ria de ch\xE3o."
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0435\u0449\u0451 \u043D\u0435
        \u043E\u0442\u043A\u0440\u044B\u043B\u0430. \u0418\u0437 \u0449\u0435\u043B\u0438
        \u043F\u043E\u0434 \u0434\u0432\u0435\u0440\u044C\u044E \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430.
        \u042D\u0442\u043E \u0435\u0451 \u0442\u043E\u0440\u0448\u0435\u0440."
  - key: os.memory.10110.text
    values:
    - language: 0
      text: "\u549A\u3001\u549A...\u201C\u4E3B.\u4EBA...\u5496.\u5561.\u716E.\u597D.\u4E86...\u201D
        \u6211\u628A\u676F\u5B50\u7AEF\u5728\u95E8\u7F1D\u524D\u9762\u7B49\u4E86\u4E00\u4F1A\u513F\uFF0C\u95E8\u8FD8\u662F\u6CA1\u6709\u5F00\u3002"
    - language: 1
      text: "\u549A\u3001\u549A...\u201C\u4E3B.\u4EBA...\u5496.\u5561.\u716E.\u597D.\u4E86...\u201D
        \u6211\u628A\u676F\u5B50\u7AEF\u5728\u9580\u7E2B\u524D\u9762\u7B49\u4E86\u4E00\u6703\u5152\uFF0C\u9580\u9084\u662F\u6C92\u6709\u958B\u3002"
    - language: 2
      text: Knock, knock... "Mas.ter... Your.cof.fee.is.ready..." I held the cup
        in front of the gap under the door and waited. The door stayed closed.
    - language: 3
      text: "\u30B3\u30F3\u3001\u30B3\u30F3...\u300C\u3054.\u4E3B\u4EBA...\u30B3\u30FC.\u30D2\u30FC.\u304C.\u5165\u308A.\u307E\u3057\u305F...\u300D\u30AB\u30C3\u30D7\u3092\u6301\u3063\u3066\u30C9\u30A2\u306E\u524D\u3067\u3057\u3070\u3089\u304F\u5F85\u3063\u305F\u3051\u308C\u3069\u3001\u30C9\u30A2\u306F\u958B\u304B\u306A\u304B\u3063\u305F\u3002"
    - language: 4
      text: "\uB611, \uB611...\u201C\uC8FC.\uC778\uB2D8...\uCEE4.\uD53C.\uB2E4.\uB410.\uC5B4.\uC694...\u201D
        \uCEF5\uC744 \uB4E4\uACE0 \uBB38 \uC55E\uC5D0\uC11C \uC7A0\uC2DC \uAE30\uB2E4\uB838\uC9C0\uB9CC,
        \uBB38\uC740 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    - language: 5
      text: "Toc, toc... \xAB Ma\xEE.tresse... Le.ca.f\xE9.est.pr\xEAt... \xBB J'ai
        tenu la tasse devant l'interstice sous la porte et attendu un moment. La
        porte est rest\xE9e ferm\xE9e."
    - language: 6
      text: "Klopf, klopf... \u201EHer.rin... Der.Kaf.fee.ist.fertig...\u201C Ich
        hielt die Tasse vor den T\xFCrspalt und wartete eine Weile. Die T\xFCr blieb
        zu."
    - language: 7
      text: "Toc, toc... \xABA.ma... el.ca.f\xE9.es.t\xE1.lis.to...\xBB Espero un
        rato con la taza frente a la rendija, pero la puerta sigue sin abrirse."
    - language: 8
      text: "Toc, toc... \u201CDo.na... o.ca.f\xE9.es.t\xE1.pron.to...\u201D Espero
        um pouco segurando a x\xEDcara diante da fresta, mas a porta continua fechada."
    - language: 9
      text: "\u0422\u0443\u043A, \u0442\u0443\u043A...\xAB\u0425\u043E.\u0437\u044F\u0439\u043A\u0430...\u041A\u043E.\u0444\u0435.\u0433\u043E.\u0442\u043E\u0432...\xBB
        \u042F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u0430
        \u0443 \u0434\u0432\u0435\u0440\u0438 \u0441 \u0447\u0430\u0448\u043A\u043E\u0439
        \u0432 \u0440\u0443\u043A\u0430\u0445, \u043D\u043E \u043E\u043D\u0430 \u0442\u0430\u043A
        \u0438 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C."
  - key: os.memory.10120.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u5367\u5BA4\u95E8\u53E3\u7684\u5730\u4E0A\uFF0C\u6389\u7740\u4E00\u9875\u7EB8\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u81E5\u5BA4\u9580\u53E3\u7684\u5730\u4E0A\uFF0C\u6389\u8457\u4E00\u9801\u7D19\u3002"
    - language: 2
      text: A sheet of paper had fallen on the floor outside Master's bedroom.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u5BDD\u5BA4\u306E\u524D\u306B\u3001\u7D19\u304C\u4E00\u679A\u843D\u3061\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uCE68\uC2E4 \uBB38 \uC55E \uBC14\uB2E5\uC5D0
        \uC885\uC774 \uD55C \uC7A5\uC774 \uB5A8\uC5B4\uC838 \uC788\uB2E4."
    - language: 5
      text: "Une feuille de papier \xE9tait tomb\xE9e devant la chambre de ma ma\xEEtresse."
    - language: 6
      text: "Vor der Schlafzimmert\xFCr meiner Herrin lag ein heruntergefallenes
        Blatt Papier."
    - language: 7
      text: "Hay una hoja de papel ca\xEDda en el suelo, frente al dormitorio de
        mi ama."
    - language: 8
      text: "H\xE1 uma folha de papel ca\xEDda no ch\xE3o, na porta do quarto da
        minha dona."
    - language: 9
      text: "\u041D\u0430 \u043F\u043E\u043B\u0443 \u043F\u0435\u0440\u0435\u0434
        \u0441\u043F\u0430\u043B\u044C\u043D\u0435\u0439 \u0445\u043E\u0437\u044F\u0439\u043A\u0438
        \u043B\u0435\u0436\u0438\u0442 \u0432\u044B\u043F\u0430\u0432\u0448\u0438\u0439
        \u043B\u0438\u0441\u0442 \u0431\u0443\u043C\u0430\u0433\u0438."
  - key: os.memory.10130.text
    values:
    - language: 0
      text: "\u5979\u4F1A\u4E0D\u4F1A\u4E00\u65E9\u5C31\u51FA\u95E8\u4E86\uFF1F\u5979\u51FA\u95E8\u7684\u8BDD\uFF0C\u7384\u5173\u7684\u978B\u4F1A\u4E0D\u89C1...<color=red>\u6211\u5E94\u8BE5\u53BB\u7384\u5173\u770B\u770B\uFF1F</color>"
    - language: 1
      text: "\u5979\u6703\u4E0D\u6703\u4E00\u65E9\u5C31\u51FA\u9580\u4E86\uFF1F\u5979\u51FA\u9580\u7684\u8A71\uFF0C\u7384\u95DC\u7684\u978B\u6703\u4E0D\u898B...<color=red>\u6211\u61C9\u8A72\u53BB\u7384\u95DC\u770B\u770B\uFF1F</color>"
    - language: 2
      text: Could she have gone out early? If she had, her shoes would be missing
        from the entrance... <color=red>Should I go and check the entrance?</color>
    - language: 3
      text: "\u671D\u65E9\u304F\u51FA\u304B\u3051\u305F\u306E\u3060\u308D\u3046\u304B\uFF1F
        \u51FA\u304B\u3051\u305F\u306E\u306A\u3089\u3001\u7384\u95A2\u306E\u9774\u304C\u306A\u304F\u306A\u3063\u3066\u3044\u308B\u306F\u305A\u3060...<color=red>\u7384\u95A2\u3092\u898B\u306B\u884C\u3063\u305F\u307B\u3046\u304C\u3044\u3044\u3060\u308D\u3046\u304B\uFF1F</color>"
    - language: 4
      text: "\uC544\uCE68 \uC77C\uCC0D \uB098\uAC00\uC2E0 \uAC78\uAE4C? \uB098\uAC00\uC168\uB2E4\uBA74
        \uD604\uAD00\uC5D0 \uC2E0\uBC1C\uC774 \uC5C6\uC744 \uAC83\uC774\uB2E4...<color=red>\uD604\uAD00\uC73C\uB85C
        \uAC00\uC11C \uC0B4\uD3B4\uBD10\uC57C \uD560\uAE4C?</color>"
    - language: 5
      text: "Serait-elle sortie t\xF4t ce matin ? Si elle \xE9tait sortie, ses chaussures
        ne seraient plus dans l'entr\xE9e... <color=red>Devrais-je aller v\xE9rifier
        dans l'entr\xE9e ?</color>"
    - language: 6
      text: "War sie vielleicht schon fr\xFCh ausgegangen? Dann w\xFCrden ihre Schuhe
        im Eingangsbereich fehlen... <color=red>Sollte ich im Eingangsbereich nachsehen?</color>"
    - language: 7
      text: "\xBFHabr\xE1 salido temprano? Si hubiera salido, sus zapatos no estar\xEDan
        en la entrada... <color=red>\xBFDeber\xEDa ir a mirar en la entrada?</color>"
    - language: 8
      text: "Ser\xE1 que ela saiu bem cedo? Se tivesse sa\xEDdo, os sapatos dela
        n\xE3o estariam na entrada... <color=red>Ser\xE1 que eu deveria ir conferir
        a entrada?</color>"
    - language: 9
      text: "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D\u0430 \u0443\u0448\u043B\u0430
        \u0440\u0430\u043D\u043E \u0443\u0442\u0440\u043E\u043C? \u0422\u043E\u0433\u0434\u0430
        \u0432 \u043F\u0440\u0438\u0445\u043E\u0436\u0435\u0439 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
        \u0435\u0451 \u043E\u0431\u0443\u0432\u0438...<color=red>\u041C\u043E\u0436\u0435\u0442,
        \u043C\u043D\u0435 \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
        \u043F\u0440\u0438\u0445\u043E\u0436\u0443\u044E?</color>"
  - key: os.memory.10140.text
    values:
    - language: 0
      text: "\u4F1A\u4E0D\u4F1A\u662F\u6211\u8BB0\u9519\u4E86\u65E5\u5B50...\u53A8\u623F\u7684\u65E5\u5386\u6BCF\u5929\u90FD\u662F\u5979\u81EA\u5DF1\u5212\u7684\uFF0C<color=red>\u6211\u5E94\u8BE5\u53BB\u65E5\u5386\u90A3\u770B\u770B\uFF1F</color>"
    - language: 1
      text: "\u6703\u4E0D\u6703\u662F\u6211\u8A18\u932F\u4E86\u65E5\u5B50...\u5EDA\u623F\u7684\u65E5\u66C6\u6BCF\u5929\u90FD\u662F\u5979\u81EA\u5DF1\u5283\u7684\uFF0C<color=red>\u6211\u61C9\u8A72\u53BB\u65E5\u66C6\u90A3\u770B\u770B\uFF1F</color>"
    - language: 2
      text: Could I have got the day wrong... She crossed off each day on the kitchen
        calendar herself. <color=red>Should I go and check the calendar?</color>
    - language: 3
      text: "\u65E5\u306B\u3061\u3092\u9593\u9055\u3048\u3066\u899A\u3048\u3066\u3044\u308B\u306E\u3060\u308D\u3046\u304B...\u53F0\u6240\u306E\u30AB\u30EC\u30F3\u30C0\u30FC\u306B\u306F\u3001\u6BCE\u65E5\u3054\u4E3B\u4EBA\u304C\u81EA\u5206\u3067\u7DDA\u3092\u5F15\u3044\u3066\u3044\u305F\u3002<color=red>\u30AB\u30EC\u30F3\u30C0\u30FC\u3092\u898B\u306B\u884C\u3063\u305F\u307B\u3046\u304C\u3044\u3044\u3060\u308D\u3046\u304B\uFF1F</color>"
    - language: 4
      text: "\uB0B4\uAC00 \uB0A0\uC9DC\uB97C \uC798\uBABB \uAE30\uC5B5\uD558\uB294
        \uAC78\uAE4C...\uBD80\uC5CC \uB2EC\uB825\uC5D0\uB294 \uB9E4\uC77C \uC8FC\uC778\uB2D8\uC774
        \uC9C1\uC811 \uC904\uC744 \uADF8\uC73C\uC168\uB2E4. <color=red>\uB2EC\uB825
        \uCABD\uC73C\uB85C \uAC00\uC11C \uD655\uC778\uD574 \uBD10\uC57C \uD560\uAE4C?</color>"
    - language: 5
      text: "Est-ce que je me trompais de jour... Elle barrait elle-m\xEAme chaque
        journ\xE9e sur le calendrier de la cuisine. <color=red>Devrais-je aller regarder
        le calendrier ?</color>"
    - language: 6
      text: "Hatte ich vielleicht den Tag verwechselt... Auf dem K\xFCchenkalender
        strich sie jeden Tag selbst ab. <color=red>Sollte ich mir den Kalender ansehen?</color>"
    - language: 7
      text: "Puede que me haya equivocado de d\xEDa... Ella misma va tachando cada
        d\xEDa en el calendario de la cocina. <color=red>\xBFDeber\xEDa ir a mirar
        el calendario?</color>"
    - language: 8
      text: "Ser\xE1 que eu me enganei de dia... Ela mesma risca os dias no calend\xE1rio
        da cozinha. <color=red>Ser\xE1 que eu deveria ir olhar o calend\xE1rio?</color>"
    - language: 9
      text: "\u041C\u043E\u0436\u0435\u0442, \u044F \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B\u0430
        \u0434\u043D\u0438...\u041D\u0430 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0435
        \u0432 \u043A\u0443\u0445\u043D\u0435 \u043E\u043D\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
        \u0434\u0435\u043D\u044C \u0441\u0430\u043C\u0430 \u0437\u0430\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u0435\u0442
        \u0434\u0430\u0442\u0443. <color=red>\u041C\u043E\u0436\u0435\u0442, \u043C\u043D\u0435
        \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
        \u043D\u0430 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044C?</color>"
  - key: os.memory.10150.text
    values:
    - language: 0
      text: "\u5979\u662F\u4E0D\u662F\u53C8\u4E0D\u8212\u670D\u4E86...\u5979\u7684\u836F\u653E\u5728\u53A8\u623F\u7684\u7CD6\u7F50\u91CC\uFF0C<color=red>\u6211\u5E94\u8BE5\u53BB\u7CD6\u7F50\u90A3\u770B\u770B\u8FD8\u5269\u591A\u5C11\uFF1F</color>"
    - language: 1
      text: "\u5979\u662F\u4E0D\u662F\u53C8\u4E0D\u8212\u670D\u4E86...\u5979\u7684\u85E5\u653E\u5728\u5EDA\u623F\u7684\u7CD6\u7F50\u88E1\uFF0C<color=red>\u6211\u61C9\u8A72\u53BB\u7CD6\u7F50\u90A3\u770B\u770B\u9084\u5269\u591A\u5C11\uFF1F</color>"
    - language: 2
      text: Was she feeling ill again... Her medicine was in the sugar jar in the
        kitchen. <color=red>Should I go and check how much was left in the jar?</color>
    - language: 3
      text: "\u307E\u305F\u5177\u5408\u304C\u60AA\u3044\u306E\u3060\u308D\u3046\u304B...\u3054\u4E3B\u4EBA\u306E\u85AC\u306F\u53F0\u6240\u306E\u7802\u7CD6\u5165\u308C\u306B\u3042\u308B\u3002<color=red>\u3069\u308C\u304F\u3089\u3044\u6B8B\u3063\u3066\u3044\u308B\u304B\u3001\u7802\u7CD6\u5165\u308C\u3092\u898B\u306B\u884C\u3063\u305F\u307B\u3046\u304C\u3044\u3044\u3060\u308D\u3046\u304B\uFF1F</color>"
    - language: 4
      text: "\uB610 \uBAB8\uC774 \uC548 \uC88B\uC73C\uC2E0 \uAC78\uAE4C...\uC57D\uC740
        \uBD80\uC5CC \uC124\uD0D5\uD1B5\uC5D0 \uC788\uB2E4. <color=red>\uC124\uD0D5\uD1B5\uC5D0
        \uC5BC\uB9C8\uB098 \uB0A8\uC558\uB294\uC9C0 \uAC00\uC11C \uD655\uC778\uD574
        \uBD10\uC57C \uD560\uAE4C?</color>"
    - language: 5
      text: "Se sentait-elle encore mal... Ses m\xE9dicaments \xE9taient dans le
        pot \xE0 sucre de la cuisine. <color=red>Devrais-je aller voir combien il
        en restait dans le pot ?</color>"
    - language: 6
      text: "Ging es ihr wieder schlecht... Ihre Medikamente waren in der Zuckerdose
        in der K\xFCche. <color=red>Sollte ich bei der Zuckerdose nachsehen, wie
        viel noch \xFCbrig war?</color>"
    - language: 7
      text: "\xBFY si se encuentra mal otra vez...? Sus medicinas est\xE1n en el
        azucarero de la cocina. <color=red>\xBFDeber\xEDa ir al azucarero para ver
        cu\xE1ntas quedan?</color>"
    - language: 8
      text: "Ser\xE1 que ela est\xE1 passando mal de novo... Os rem\xE9dios dela
        ficam no a\xE7ucareiro da cozinha. <color=red>Ser\xE1 que eu deveria ir at\xE9
        o a\xE7ucareiro conferir quanto ainda resta?</color>"
    - language: 9
      text: "\u041C\u043E\u0436\u0435\u0442, \u0435\u0439 \u043E\u043F\u044F\u0442\u044C
        \u043D\u0435\u0445\u043E\u0440\u043E\u0448\u043E...\u0415\u0451 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430
        \u043B\u0435\u0436\u0430\u0442 \u0432 \u0441\u0430\u0445\u0430\u0440\u043D\u0438\u0446\u0435
        \u043D\u0430 \u043A\u0443\u0445\u043D\u0435. <color=red>\u041C\u043E\u0436\u0435\u0442,
        \u043C\u043D\u0435 \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u043A \u0441\u0430\u0445\u0430\u0440\u043D\u0438\u0446\u0435
        \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C?</color>"
  - key: os.memory.10160.text
    values:
    - language: 0
      text: "\u8981\u662F\u5979\u771F\u7684\u51FA\u4E86\u4E8B\uFF0C\u6211\u5F97\u60F3\u529E\u6CD5\u8FDB\u53BB...\u6211\u5E94\u8BE5\u53BB\u50A8\u7269\u95F4\u627E\u627E\u6709\u6CA1\u6709\u7528\u5F97\u4E0A\u7684\u4E1C\u897F\uFF1F"
    - language: 1
      text: "\u8981\u662F\u5979\u771F\u7684\u51FA\u4E86\u4E8B\uFF0C\u6211\u5F97\u60F3\u8FA6\u6CD5\u9032\u53BB...\u6211\u61C9\u8A72\u53BB\u5132\u7269\u9593\u627E\u627E\u6709\u6C92\u6709\u7528\u5F97\u4E0A\u7684\u6771\u897F\uFF1F"
    - language: 2
      text: If something really had happened to her, I would have to find a way in...
        Should I look in the storage room for something that might help?
    - language: 3
      text: "\u672C\u5F53\u306B\u4F55\u304B\u3042\u3063\u305F\u306E\u306A\u3089\u3001\u4E2D\u306B\u5165\u308B\u65B9\u6CD5\u3092\u8003\u3048\u306A\u3051\u308C\u3070...\u7269\u7F6E\u306B\u4F55\u304B\u4F7F\u3048\u305D\u3046\u306A\u3082\u306E\u304C\u306A\u3044\u304B\u3001\u63A2\u3057\u306B\u884C\u3063\u305F\u307B\u3046\u304C\u3044\u3044\u3060\u308D\u3046\u304B\uFF1F"
    - language: 4
      text: "\uC815\uB9D0 \uBB34\uC2A8 \uC77C\uC774 \uC0DD\uACBC\uB2E4\uBA74 \uB4E4\uC5B4\uAC08
        \uBC29\uBC95\uC744 \uCC3E\uC544\uC57C \uD55C\uB2E4...\uCC3D\uACE0\uB85C \uAC00\uC11C
        \uC4F8 \uB9CC\uD55C \uBB3C\uAC74\uC774 \uC788\uB294\uC9C0 \uCC3E\uC544\uBD10\uC57C
        \uD560\uAE4C?"
    - language: 5
      text: "S'il lui \xE9tait vraiment arriv\xE9 quelque chose, il fallait que je
        trouve un moyen d'entrer... Devrais-je aller chercher dans le d\xE9barras
        quelque chose qui pourrait servir ?"
    - language: 6
      text: "Wenn ihr wirklich etwas zugesto\xDFen war, musste ich einen Weg finden,
        hineinzukommen... Sollte ich im Abstellraum nach etwas suchen, das mir helfen
        k\xF6nnte?"
    - language: 7
      text: "Si de verdad le ha pasado algo, tengo que encontrar la forma de entrar...
        \xBFDeber\xEDa ir al trastero a buscar algo que pueda servir?"
    - language: 8
      text: "Se aconteceu mesmo alguma coisa com ela, preciso dar um jeito de entrar...
        Ser\xE1 que eu deveria ir ao dep\xF3sito procurar alguma coisa que possa
        ajudar?"
    - language: 9
      text: "\u0415\u0441\u043B\u0438 \u0441 \u043D\u0435\u0439 \u043F\u0440\u0430\u0432\u0434\u0430
        \u0447\u0442\u043E-\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C,
        \u043C\u043D\u0435 \u043D\u0430\u0434\u043E \u043D\u0430\u0439\u0442\u0438
        \u0441\u043F\u043E\u0441\u043E\u0431 \u0432\u043E\u0439\u0442\u0438...\u041C\u043E\u0436\u0435\u0442,
        \u043C\u043D\u0435 \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u0432
        \u043A\u043B\u0430\u0434\u043E\u0432\u043A\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0435?"
  - key: os.memory.11100.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u4ECA\u5929\u81EA\u5DF1\u716E\u8FC7\u5496\u5561\u5417...<color=red>\u6211\u5E94\u8BE5\u53BB\u770B\u770B\u53A8\u623F\u7684\u5496\u5561\u673A\uFF1F</color>"
    - language: 1
      text: "\u4E3B\u4EBA\u4ECA\u5929\u81EA\u5DF1\u716E\u904E\u5496\u5561\u55CE...<color=red>\u6211\u61C9\u8A72\u53BB\u770B\u770B\u5EDA\u623F\u7684\u5496\u5561\u6A5F\uFF1F</color>"
    - language: 2
      text: Had Master made her own coffee today... <color=red>Should I go and check
        the coffee machine in the kitchen?</color>
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306F\u4ECA\u65E5\u3001\u81EA\u5206\u3067\u30B3\u30FC\u30D2\u30FC\u3092\u6DF9\u308C\u305F\u3060\u308D\u3046\u304B...<color=red>\u53F0\u6240\u306E\u30B3\u30FC\u30D2\u30FC\u30E1\u30FC\u30AB\u30FC\u3092\u898B\u306B\u884C\u3063\u305F\u307B\u3046\u304C\u3044\u3044\u3060\u308D\u3046\u304B\uFF1F</color>"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC740 \uC624\uB298 \uC9C1\uC811 \uCEE4\uD53C\uB97C
        \uB053\uC774\uC168\uC744\uAE4C...<color=red>\uBD80\uC5CC\uC73C\uB85C \uAC00\uC11C
        \uCEE4\uD53C \uBA38\uC2E0\uC744 \uC0B4\uD3B4\uBD10\uC57C \uD560\uAE4C?</color>"
    - language: 5
      text: "Ma ma\xEEtresse avait-elle pr\xE9par\xE9 son caf\xE9 elle-m\xEAme aujourd'hui...
        <color=red>Devrais-je aller regarder la cafeti\xE8re dans la cuisine ?</color>"
    - language: 6
      text: "Hatte meine Herrin heute selbst Kaffee gekocht... <color=red>Sollte
        ich mir die Kaffeemaschine in der K\xFCche ansehen?</color>"
    - language: 7
      text: "Quiz\xE1 mi ama haya preparado ella misma el caf\xE9 hoy... <color=red>\xBFDeber\xEDa
        ir a mirar la cafetera de la cocina?</color>"
    - language: 8
      text: "Ser\xE1 que minha dona preparou o pr\xF3prio caf\xE9 hoje... <color=red>Ser\xE1
        que eu deveria ir olhar a cafeteira da cozinha?</color>"
    - language: 9
      text: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0445\u043E\u0437\u044F\u0439\u043A\u0430
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u0430\u043C\u0430 \u0432\u0430\u0440\u0438\u043B\u0430
        \u043A\u043E\u0444\u0435...<color=red>\u041C\u043E\u0436\u0435\u0442, \u043C\u043D\u0435
        \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430 \u043A\u0443\u0445\u043D\u044E
        \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043A\u043E\u0444\u0435\u0432\u0430\u0440\u043A\u0443?</color>"
  - key: os.memory.10170.text
    values:
    - language: 0
      text: "\u53A8\u623F\u91CC\u6CA1\u6709\u4EBA\uFF0C\u7076\u53F0\u662F\u51B7\u7684\u3002\u4E0B\u5348\u4E09\u70B9\uFF0C\u65E5\u7A0B\u8868\u4E0A\u7684\u65E9\u996D\u548C\u5348\u996D\u90FD\u8FC7\u65F6\u4E86...\u4E3B\u4EBA\u4ECA\u5929\u7761\u61D2\u89C9\u4E86\u3002"
    - language: 1
      text: "\u5EDA\u623F\u88E1\u6C92\u6709\u4EBA\uFF0C\u7210\u5B50\u662F\u51B7\u7684\u3002\u4E0B\u5348\u4E09\u9EDE\uFF0C\u65E5\u7A0B\u8868\u4E0A\u7684\u65E9\u9910\u548C\u5348\u9910\u90FD\u904E\u6642\u4E86...\u4E3B\u4EBA\u4ECA\u5929\u7761\u61F6\u89BA\u4E86\u3002"
    - language: 2
      text: No one was in the kitchen. The stove was cold. Three in the afternoon.
        Breakfast and lunch were both overdue on the schedule... Master was sleeping
        in today.
    - language: 3
      text: "\u53F0\u6240\u306B\u306F\u8AB0\u3082\u3044\u306A\u304F\u3066\u3001\u30B3\u30F3\u30ED\u306F\u51B7\u305F\u304B\u3063\u305F\u3002\u5348\u5F8C\u4E09\u6642\u3002\u4E88\u5B9A\u8868\u306E\u671D\u98DF\u3082\u663C\u98DF\u3082\u3001\u3082\u3046\u6642\u9593\u3092\u904E\u304E\u3066\u3044\u308B...\u3054\u4E3B\u4EBA\u306F\u4ECA\u65E5\u306F\u5BDD\u574A\u3057\u305F\u306E\u3060\u3002"
    - language: 4
      text: "\uBD80\uC5CC\uC5D0\uB294 \uC544\uBB34\uB3C4 \uC5C6\uACE0, \uAC00\uC2A4\uB808\uC778\uC9C0\uB3C4
        \uCC28\uAC00\uC6E0\uB2E4. \uC624\uD6C4 \uC138 \uC2DC. \uC77C\uC815\uD45C\uC758
        \uC544\uCE68\uACFC \uC810\uC2EC \uC2DC\uAC04\uC774 \uBAA8\uB450 \uC9C0\uB0AC\uB2E4...\uC8FC\uC778\uB2D8\uC740
        \uC624\uB298 \uB2A6\uC7A0\uC744 \uC8FC\uBB34\uC168\uB2E4."
    - language: 5
      text: "Il n'y avait personne dans la cuisine. La cuisini\xE8re \xE9tait froide.
        Quinze heures. L'heure du petit d\xE9jeuner et celle du d\xE9jeuner \xE9taient
        pass\xE9es... Ma ma\xEEtresse faisait la grasse matin\xE9e."
    - language: 6
      text: "Niemand war in der K\xFCche. Der Herd war kalt. F\xFCnfzehn Uhr. Fr\xFChst\xFCck
        und Mittagessen waren laut Tagesplan schon \xFCberf\xE4llig... Meine Herrin
        schlief heute aus."
    - language: 7
      text: "No hay nadie en la cocina. Los fogones est\xE1n fr\xEDos. Son las tres
        de la tarde. Ya han pasado las horas del desayuno y de la comida... Mi ama
        se ha quedado durmiendo hasta tarde."
    - language: 8
      text: "N\xE3o tem ningu\xE9m na cozinha. O fog\xE3o est\xE1 frio. Tr\xEAs da
        tarde. Os hor\xE1rios do caf\xE9 da manh\xE3 e do almo\xE7o j\xE1 passaram...
        Minha dona dormiu at\xE9 tarde hoje."
    - language: 9
      text: "\u041D\u0430 \u043A\u0443\u0445\u043D\u0435 \u043D\u0438\u043A\u043E\u0433\u043E
        \u043D\u0435\u0442, \u043F\u043B\u0438\u0442\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F.
        \u0422\u0440\u0438 \u0447\u0430\u0441\u0430 \u0434\u043D\u044F. \u0412\u0440\u0435\u043C\u044F
        \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430 \u0438 \u043E\u0431\u0435\u0434\u0430
        \u043F\u043E \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044E
        \u0443\u0436\u0435 \u043F\u0440\u043E\u0448\u043B\u043E...\u0421\u0435\u0433\u043E\u0434\u043D\u044F
        \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u0434\u043E\u043B\u0433\u043E
        \u0441\u043F\u0438\u0442."
  - key: os.memory.10180.text
    values:
    - language: 0
      text: "\u5496\u5561\u673A\u662F\u51B7\u7684\uFF0C\u6C34\u7BB1\u4E5F\u662F\u7A7A\u7684...\u4E3B\u4EBA\u4ECA\u5929\u4E00\u53E3\u5496\u5561\u90FD\u6CA1\u6709\u559D\u3002\u65E9\u4E0A\u4E5D\u70B9\u8BE5\u716E\u7684\u5496\u5561\uFF0C\u6211\u665A\u4E86\u516D\u4E2A\u5C0F\u65F6\u3002"
    - language: 1
      text: "\u5496\u5561\u6A5F\u662F\u51B7\u7684\uFF0C\u6C34\u7BB1\u4E5F\u662F\u7A7A\u7684...\u4E3B\u4EBA\u4ECA\u5929\u4E00\u53E3\u5496\u5561\u90FD\u6C92\u6709\u559D\u3002\u65E9\u4E0A\u4E5D\u9EDE\u8A72\u716E\u7684\u5496\u5561\uFF0C\u6211\u665A\u4E86\u516D\u500B\u5C0F\u6642\u3002"
    - language: 2
      text: The coffee machine was cold, and its tank was empty... Master had not
        had any coffee today. The coffee was due at nine. I was six hours late.
    - language: 3
      text: "\u30B3\u30FC\u30D2\u30FC\u30E1\u30FC\u30AB\u30FC\u306F\u51B7\u305F\u304F\u3001\u30BF\u30F3\u30AF\u3082\u7A7A\u3060\u3063\u305F...\u3054\u4E3B\u4EBA\u306F\u4ECA\u65E5\u3001\u30B3\u30FC\u30D2\u30FC\u3092\u4E00\u53E3\u3082\u98F2\u3093\u3067\u3044\u306A\u3044\u3002\u671D\u4E5D\u6642\u306B\u6DF9\u308C\u308B\u306F\u305A\u306E\u30B3\u30FC\u30D2\u30FC\u304C\u3001\u516D\u6642\u9593\u3082\u9045\u308C\u3066\u3057\u307E\u3063\u305F\u3002"
    - language: 4
      text: "\uCEE4\uD53C \uBA38\uC2E0\uC740 \uCC28\uAC11\uACE0 \uBB3C\uD1B5\uB3C4
        \uBE44\uC5B4 \uC788\uB2E4...\uC8FC\uC778\uB2D8\uC740 \uC624\uB298 \uCEE4\uD53C\uB97C
        \uD55C \uBAA8\uAE08\uB3C4 \uC548 \uB4DC\uC168\uB2E4. \uC544\uCE68 \uC544\uD649
        \uC2DC\uC5D0 \uB053\uC600\uC5B4\uC57C \uD560 \uCEE4\uD53C\uAC00 \uC5EC\uC12F
        \uC2DC\uAC04\uC774\uB098 \uB2A6\uC5C8\uB2E4."
    - language: 5
      text: "La cafeti\xE8re \xE9tait froide et le r\xE9servoir vide... Ma ma\xEEtresse
        n'avait pas bu de caf\xE9 aujourd'hui. Le caf\xE9 \xE9tait pr\xE9vu \xE0
        neuf heures. J'avais six heures de retard."
    - language: 6
      text: "Die Kaffeemaschine war kalt, der Wassertank leer... Meine Herrin hatte
        heute keinen Kaffee getrunken. Um neun h\xE4tte ich Kaffee kochen sollen.
        Ich war sechs Stunden zu sp\xE4t."
    - language: 7
      text: "La cafetera est\xE1 fr\xEDa y el dep\xF3sito est\xE1 vac\xEDo... Mi
        ama no ha tomado ni un sorbo de caf\xE9 hoy. Deb\xED hacerlo a las nueve.
        Llevo seis horas de retraso."
    - language: 8
      text: "A cafeteira est\xE1 fria e o reservat\xF3rio est\xE1 vazio... Minha
        dona n\xE3o tomou nem um gole de caf\xE9 hoje. Eu devia ter feito \xE0s nove
        da manh\xE3. Estou seis horas atrasada."
    - language: 9
      text: "\u041A\u043E\u0444\u0435\u0432\u0430\u0440\u043A\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
        \u0440\u0435\u0437\u0435\u0440\u0432\u0443\u0430\u0440 \u0434\u043B\u044F
        \u0432\u043E\u0434\u044B \u043F\u0443\u0441\u0442...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u0432\u044B\u043F\u0438\u043B\u0430
        \u043D\u0438 \u0433\u043B\u043E\u0442\u043A\u0430 \u043A\u043E\u0444\u0435.
        \u042F \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u043B\u0430 \u0441\u0432\u0430\u0440\u0438\u0442\u044C
        \u0435\u0433\u043E \u0432 \u0434\u0435\u0432\u044F\u0442\u044C \u0443\u0442\u0440\u0430.
        \u041E\u043F\u043E\u0437\u0434\u0430\u043B\u0430 \u043D\u0430 \u0448\u0435\u0441\u0442\u044C
        \u0447\u0430\u0441\u043E\u0432."
  - key: os.memory.10190.text
    values:
    - language: 0
      text: "\u6211\u5728\u6C34\u69FD\u63A5\u6EE1\u4E86\u6C34\uFF0C\u5012\u8FDB\u5496\u5561\u673A\u3002\u6C34\u9F99\u5934\u5E95\u4E0B\u7684\u7BA1\u5B50\u5728\u6F0F\u6C34\uFF0C\u5730\u4E0A\u79EF\u4E86\u4E00\u6EE9...\u4E3B\u4EBA\u8BF4\u8FC7\u597D\u51E0\u6B21\u8981\u4FEE\u3002"
    - language: 1
      text: "\u6211\u5728\u6C34\u69FD\u63A5\u6EFF\u4E86\u6C34\uFF0C\u5012\u9032\u5496\u5561\u6A5F\u3002\u6C34\u9F8D\u982D\u5E95\u4E0B\u7684\u7BA1\u5B50\u5728\u6F0F\u6C34\uFF0C\u5730\u4E0A\u7A4D\u4E86\u4E00\u7058...\u4E3B\u4EBA\u8AAA\u904E\u597D\u5E7E\u6B21\u8981\u4FEE\u3002"
    - language: 2
      text: I filled up at the sink and poured the water into the coffee machine.
        The pipe under the tap was leaking. A puddle had formed on the floor... Master
        had said several times that she would fix it.
    - language: 3
      text: "\u6D41\u3057\u3067\u6C34\u3092\u6C72\u307F\u3001\u30B3\u30FC\u30D2\u30FC\u30E1\u30FC\u30AB\u30FC\u306B\u6CE8\u3044\u3060\u3002\u86C7\u53E3\u306E\u4E0B\u306E\u7BA1\u304B\u3089\u6C34\u304C\u6F0F\u308C\u3066\u3044\u3066\u3001\u5E8A\u306B\u6C34\u305F\u307E\u308A\u304C\u3067\u304D\u3066\u3044\u308B...\u3054\u4E3B\u4EBA\u306F\u4F55\u5EA6\u3082\u3001\u76F4\u3055\u306A\u304D\u3083\u3068\u8A00\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uC2F1\uD06C\uB300\uC5D0\uC11C \uBB3C\uC744 \uAC00\uB4DD \uBC1B\uC544
        \uCEE4\uD53C \uBA38\uC2E0\uC5D0 \uBD80\uC5C8\uB2E4. \uC218\uB3C4\uAF2D\uC9C0
        \uC544\uB798 \uBC30\uAD00\uC5D0\uC11C \uBB3C\uC774 \uC0C8\uC5B4 \uBC14\uB2E5\uC5D0
        \uACE0\uC5EC \uC788\uC5C8\uB2E4...\uC8FC\uC778\uB2D8\uC740 \uBA87 \uBC88\uC774\uB098
        \uACE0\uCCD0\uC57C\uACA0\uB2E4\uACE0 \uD558\uC168\uB2E4."
    - language: 5
      text: "J'ai pris de l'eau \xE0 l'\xE9vier et rempli la cafeti\xE8re. Le tuyau
        sous le robinet fuyait. Une flaque s'\xE9tait form\xE9e par terre... Ma ma\xEEtresse
        avait dit plusieurs fois qu'elle le r\xE9parerait."
    - language: 6
      text: "Ich holte Wasser an der Sp\xFCle und f\xFCllte es in die Kaffeemaschine.
        Das Rohr unter dem Hahn war undicht. Auf dem Boden hatte sich eine Pf\xFCtze
        gebildet... Meine Herrin hatte schon mehrmals gesagt, sie w\xFCrde es reparieren."
    - language: 7
      text: "Recojo agua en el fregadero y lleno la cafetera. La tuber\xEDa bajo
        el grifo pierde agua y hay un charco en el suelo... Mi ama ha dicho varias
        veces que iba a arreglarla."
    - language: 8
      text: "Pego \xE1gua na pia e encho a cafeteira. O cano embaixo da torneira
        est\xE1 vazando, formando uma po\xE7a no ch\xE3o... Minha dona j\xE1 disse
        v\xE1rias vezes que ia consertar."
    - language: 9
      text: "\u042F \u043D\u0430\u0431\u0440\u0430\u043B\u0430 \u0432\u043E\u0434\u0443
        \u0432 \u0440\u0430\u043A\u043E\u0432\u0438\u043D\u0435 \u0438 \u0437\u0430\u043B\u0438\u043B\u0430
        \u0432 \u043A\u043E\u0444\u0435\u0432\u0430\u0440\u043A\u0443. \u041F\u043E\u0434
        \u043A\u0440\u0430\u043D\u043E\u043C \u043F\u0440\u043E\u0442\u0435\u043A\u0430\u0435\u0442
        \u0442\u0440\u0443\u0431\u0430, \u043D\u0430 \u043F\u043E\u043B\u0443 \u043B\u0443\u0436\u0430...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437
        \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u043D\u0430\u0434\u043E
        \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C."
  - key: os.memory.10200.text
    values:
    - language: 0
      text: "\u5496\u5561\u7F50\u91CC\u8FD8\u5269\u5C0F\u534A\u7F50\u8C46\u5B50\u3002\u7F50\u5B50\u5E95\u4E0B\u538B\u7740\u4E00\u9875\u7EB8\u3002"
    - language: 1
      text: "\u5496\u5561\u7F50\u88E1\u9084\u5269\u5C0F\u534A\u7F50\u8C46\u5B50\u3002\u7F50\u5B50\u5E95\u4E0B\u58D3\u8457\u4E00\u9801\u7D19\u3002"
    - language: 2
      text: There was less than half a tin of coffee beans left. A sheet of paper
        was tucked under the tin.
    - language: 3
      text: "\u7F36\u306B\u306F\u30B3\u30FC\u30D2\u30FC\u8C46\u304C\u534A\u5206\u3088\u308A\u5C11\u3057\u5C11\u306A\u304F\u6B8B\u3063\u3066\u3044\u305F\u3002\u7F36\u306E\u4E0B\u306B\u3001\u7D19\u304C\u4E00\u679A\u631F\u3093\u3067\u3042\u308B\u3002"
    - language: 4
      text: "\uCEE4\uD53C \uD1B5\uC5D0\uB294 \uC6D0\uB450\uAC00 \uBC18\uB3C4 \uC548
        \uB0A8\uC544 \uC788\uC5C8\uB2E4. \uD1B5 \uC544\uB798\uC5D0 \uC885\uC774 \uD55C
        \uC7A5\uC774 \uB20C\uB824 \uC788\uB2E4."
    - language: 5
      text: "Il restait moins d'une demi-bo\xEEte de grains de caf\xE9. Une feuille
        \xE9tait coinc\xE9e sous la bo\xEEte."
    - language: 6
      text: In der Kaffeedose war noch knapp eine halbe Dose Bohnen. Darunter lag
        ein Blatt Papier.
    - language: 7
      text: "Queda algo menos de medio bote de granos de caf\xE9. Debajo del bote
        hay una hoja de papel."
    - language: 8
      text: "Ainda resta um pouco menos de meio pote de gr\xE3os de caf\xE9. Tem
        uma folha de papel debaixo dele."
    - language: 9
      text: "\u0412 \u0431\u0430\u043D\u043A\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
        \u0447\u0443\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B
        \u043A\u043E\u0444\u0435\u0439\u043D\u044B\u0445 \u0437\u0451\u0440\u0435\u043D.
        \u041F\u043E\u0434 \u043D\u0435\u0439 \u043F\u0440\u0438\u0436\u0430\u0442
        \u043B\u0438\u0441\u0442 \u0431\u0443\u043C\u0430\u0433\u0438."
  - key: os.memory.10210.text
    values:
    - language: 0
      text: "\u5496\u5561\u673A\u5495\u565C\u5495\u565C\u5730\u54CD\u8D77\u6765\uFF0C\u6EE1\u5C4B\u5B50\u90FD\u662F\u5496\u5561\u7684\u5473\u9053...\u4E3B\u4EBA\u6BCF\u5929\u65E9\u4E0A\u542C\u5230\u8FD9\u4E2A\u58F0\u97F3\uFF0C\u5C31\u4F1A\u5728\u623F\u95F4\u91CC\u9A82\u4E00\u53E5\u300C\u5435\u6B7B\u4E86\u300D\uFF0C\u4E0D\u8FC7\u4ECA\u5929\u597D\u50CF\u4E0D\u592A\u4E00\u6837..?"
    - language: 1
      text: "\u5496\u5561\u6A5F\u5495\u5695\u5495\u5695\u5730\u97FF\u8D77\u4F86\uFF0C\u6EFF\u5C4B\u5B50\u90FD\u662F\u5496\u5561\u7684\u5473\u9053...\u4E3B\u4EBA\u6BCF\u5929\u65E9\u4E0A\u807D\u5230\u9019\u500B\u8072\u97F3\uFF0C\u5C31\u6703\u5728\u623F\u9593\u88E1\u7F75\u4E00\u53E5\u300C\u5435\u6B7B\u4E86\u300D\uFF0C\u4E0D\u904E\u4ECA\u5929\u597D\u50CF\u4E0D\u592A\u4E00\u6A23..?"
    - language: 2
      text: The coffee machine began to gurgle, filling the room with the smell of
        coffee... Every morning, that sound would make Master shout "Keep it down!"
        from her room. Today seemed a little different..?
    - language: 3
      text: "\u30B3\u30FC\u30D2\u30FC\u30E1\u30FC\u30AB\u30FC\u304C\u3054\u307D\u3054\u307D\u9CF4\u308A\u59CB\u3081\u3066\u3001\u90E8\u5C4B\u4E2D\u306B\u30B3\u30FC\u30D2\u30FC\u306E\u5302\u3044\u304C\u5E83\u304C\u3063\u305F...\u3054\u4E3B\u4EBA\u306F\u6BCE\u671D\u3053\u306E\u97F3\u3092\u805E\u304F\u3068\u3001\u90E8\u5C4B\u306E\u4E2D\u304B\u3089\u300C\u3046\u308B\u3055\u3044\uFF01\u300D\u3068\u6012\u308B\u3002\u3067\u3082\u3001\u4ECA\u65E5\u306F\u5C11\u3057\u9055\u3046\u307F\u305F\u3044\u3060..\uFF1F"
    - language: 4
      text: "\uCEE4\uD53C \uBA38\uC2E0\uC774 \uAFB8\uB974\uB975\uAC70\uB9AC\uAE30
        \uC2DC\uC791\uD558\uC790 \uBC29 \uC548 \uAC00\uB4DD \uCEE4\uD53C \uD5A5\uC774
        \uD37C\uC84C\uB2E4...\uC8FC\uC778\uB2D8\uC740 \uB9E4\uC77C \uC544\uCE68 \uC774
        \uC18C\uB9AC\uAC00 \uB098\uBA74 \uBC29 \uC548\uC5D0\uC11C \u2018\uC2DC\uB044\uB7EC\uC6CC
        \uC8FD\uACA0\uB124\u2019 \uD558\uACE0 \uD55C\uB9C8\uB514 \uD558\uC168\uB294\uB370,
        \uC624\uB298\uC740 \uC880 \uB2E4\uB978 \uAC83 \uAC19\uB2E4..?"
    - language: 5
      text: "La cafeti\xE8re s'est mise \xE0 gargouiller. L'odeur du caf\xE9 a rempli
        la pi\xE8ce... Chaque matin, ce son faisait crier ma ma\xEEtresse depuis
        sa chambre : \xAB Quel vacarme ! \xBB Mais aujourd'hui, c'\xE9tait un peu
        diff\xE9rent..?"
    - language: 6
      text: "Die Kaffeemaschine begann zu gurgeln. Der Duft von Kaffee erf\xFCllte
        den Raum... Bei diesem Ger\xE4usch schimpfte meine Herrin jeden Morgen aus
        ihrem Zimmer: \u201EWas f\xFCr ein L\xE4rm!\u201C Heute schien es aber etwas
        anders zu sein..?"
    - language: 7
      text: "La cafetera empieza a borbotear y el olor a caf\xE9 llena la cocina...
        Cada ma\xF1ana, al o\xEDrlo, mi ama grita desde su habitaci\xF3n: \xAB\xA1Qu\xE9
        ruido!\xBB. Pero hoy parece distinto.. \xBFNo?"
    - language: 8
      text: "A cafeteira come\xE7a a borbulhar, e o cheiro de caf\xE9 toma conta
        da cozinha... Toda manh\xE3, ao ouvir esse som, minha dona reclama do quarto:
        \u201CQue barulheira!\u201D. Mas hoje parece diferente.. N\xE3o parece?"
    - language: 9
      text: "\u041A\u043E\u0444\u0435\u0432\u0430\u0440\u043A\u0430 \u0437\u0430\u0431\u0443\u043B\u044C\u043A\u0430\u043B\u0430,
        \u0438 \u043A\u0443\u0445\u043D\u044F \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0430\u0441\u044C
        \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043A\u043E\u0444\u0435...\u041A\u0430\u0436\u0434\u043E\u0435
        \u0443\u0442\u0440\u043E, \u0443\u0441\u043B\u044B\u0448\u0430\u0432 \u044D\u0442\u043E\u0442
        \u0437\u0432\u0443\u043A, \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u0440\u0443\u0433\u0430\u0435\u0442\u0441\u044F
        \u0438\u0437 \u043A\u043E\u043C\u043D\u0430\u0442\u044B: \xAB\u0414\u043E
        \u0447\u0435\u0433\u043E \u0436\u0435 \u0448\u0443\u043C\u043D\u043E!\xBB
        \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0451
        \u043A\u0430\u043A-\u0442\u043E \u0438\u043D\u0430\u0447\u0435..?"
  - key: os.memory.10220.text
    values:
    - language: 0
      text: "\u6211\u628A\u5496\u5561\u5012\u8FDB\u4E3B\u4EBA\u7684\u676F\u5B50\uFF0C\u8FD9\u676F\u5F97\u8D81\u70ED\u9001\u5230\u5979\u624B\u4E0A...\u676F\u5E95\u4E0B\u7684\u676F\u57AB\u91CC\u5939\u7740\u4E00\u9875\u7EB8\u3002"
    - language: 1
      text: "\u6211\u628A\u5496\u5561\u5012\u9032\u4E3B\u4EBA\u7684\u676F\u5B50\uFF0C\u9019\u676F\u5F97\u8D81\u71B1\u9001\u5230\u5979\u624B\u4E0A...\u676F\u5E95\u4E0B\u7684\u676F\u588A\u88E1\u593E\u8457\u4E00\u9801\u7D19\u3002"
    - language: 2
      text: I poured the coffee into Master's cup. I had to get it to her while it
        was hot... A sheet of paper was tucked inside the coaster underneath.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u30AB\u30C3\u30D7\u306B\u30B3\u30FC\u30D2\u30FC\u3092\u6CE8\u3044\u3060\u3002\u6E29\u304B\u3044\u3046\u3061\u306B\u5C4A\u3051\u306A\u3051\u308C\u3070...\u30AB\u30C3\u30D7\u306E\u4E0B\u306E\u30B3\u30FC\u30B9\u30BF\u30FC\u306B\u3001\u7D19\u304C\u4E00\u679A\u631F\u3093\u3067\u3042\u3063\u305F\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uCEF5\uC5D0 \uCEE4\uD53C\uB97C \uB530\uB790\uB2E4.
        \uC2DD\uAE30 \uC804\uC5D0 \uAC00\uC838\uB2E4\uB4DC\uB824\uC57C \uD55C\uB2E4...\uCEF5
        \uC544\uB798 \uBC1B\uCE68\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774 \uB07C\uC5B4
        \uC788\uC5C8\uB2E4."
    - language: 5
      text: "J'ai vers\xE9 le caf\xE9 dans la tasse de ma ma\xEEtresse. Il fallait
        le lui apporter encore chaud... Une feuille \xE9tait gliss\xE9e dans le dessous
        de tasse."
    - language: 6
      text: "Ich goss den Kaffee in die Tasse meiner Herrin. Ich musste ihn ihr bringen,
        solange er hei\xDF war... Im Untersetzer darunter steckte ein Blatt Papier."
    - language: 7
      text: "Vierto el caf\xE9 en la taza de mi ama. Tengo que llev\xE1rselo mientras
        est\xE9 caliente... Hay una hoja metida en el posavasos, bajo la taza."
    - language: 8
      text: "Despejo o caf\xE9 na x\xEDcara da minha dona. Preciso levar para ela
        enquanto ainda est\xE1 quente... Tem uma folha de papel enfiada no descanso
        da x\xEDcara."
    - language: 9
      text: "\u042F \u043D\u0430\u043B\u0438\u043B\u0430 \u043A\u043E\u0444\u0435
        \u0432 \u0447\u0430\u0448\u043A\u0443 \u0445\u043E\u0437\u044F\u0439\u043A\u0438.
        \u041D\u0430\u0434\u043E \u043E\u0442\u043D\u0435\u0441\u0442\u0438 \u0435\u0439,
        \u043F\u043E\u043A\u0430 \u0433\u043E\u0440\u044F\u0447\u0438\u0439...\u0412
        \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043A\u0435 \u043F\u043E\u0434
        \u0447\u0430\u0448\u043A\u043E\u0439 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
        \u043B\u0438\u0441\u0442 \u0431\u0443\u043C\u0430\u0433\u0438."
  - key: os.memory.11150.text
    values:
    - language: 0
      text: "\u5496\u5561\u673A\u91CC\u8FD8\u6CA1\u6709\u5496\u5561\u8C46\u3002"
    - language: 1
      text: "\u5496\u5561\u6A5F\u88E1\u9084\u6C92\u6709\u5496\u5561\u8C46\u3002"
    - language: 2
      text: There were no coffee beans in the machine yet.
    - language: 3
      text: "\u30B3\u30FC\u30D2\u30FC\u30E1\u30FC\u30AB\u30FC\u306B\u306F\u3001\u307E\u3060\u8C46\u304C\u5165\u3063\u3066\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uCEE4\uD53C \uBA38\uC2E0\uC5D0 \uC544\uC9C1 \uC6D0\uB450\uAC00 \uC5C6\uB2E4."
    - language: 5
      text: "Il n'y avait pas encore de grains de caf\xE9 dans la machine."
    - language: 6
      text: In der Maschine waren noch keine Kaffeebohnen.
    - language: 7
      text: "La cafetera todav\xEDa no tiene granos de caf\xE9."
    - language: 8
      text: "Ainda n\xE3o tem gr\xE3os de caf\xE9 na cafeteira."
    - language: 9
      text: "\u0412 \u043A\u043E\u0444\u0435\u0432\u0430\u0440\u043A\u0435 \u0435\u0449\u0451
        \u043D\u0435\u0442 \u0437\u0451\u0440\u0435\u043D."
  - key: os.memory.11160.text
    values:
    - language: 0
      text: "\u5496\u5561\u5DF2\u7ECF\u716E\u597D\u4E86\u3002"
    - language: 1
      text: "\u5496\u5561\u5DF2\u7D93\u716E\u597D\u4E86\u3002"
    - language: 2
      text: The coffee was ready.
    - language: 3
      text: "\u30B3\u30FC\u30D2\u30FC\u306F\u3082\u3046\u6DF9\u308C\u3066\u3042\u308B\u3002"
    - language: 4
      text: "\uCEE4\uD53C\uB294 \uC774\uBBF8 \uB2E4 \uB053\uC600\uB2E4."
    - language: 5
      text: "Le caf\xE9 \xE9tait pr\xEAt."
    - language: 6
      text: Der Kaffee war fertig.
    - language: 7
      text: "El caf\xE9 ya est\xE1 hecho."
    - language: 8
      text: "O caf\xE9 j\xE1 est\xE1 pronto."
    - language: 9
      text: "\u041A\u043E\u0444\u0435 \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432."
  - key: os.memory.11170.text
    values:
    - language: 0
      text: "\u676F\u5B50\u8FD8\u662F\u7A7A\u7684\u3002"
    - language: 1
      text: "\u676F\u5B50\u9084\u662F\u7A7A\u7684\u3002"
    - language: 2
      text: The cup was still empty.
    - language: 3
      text: "\u30AB\u30C3\u30D7\u306F\u307E\u3060\u7A7A\u3060\u3002"
    - language: 4
      text: "\uCEF5\uC740 \uC544\uC9C1 \uBE44\uC5B4 \uC788\uB2E4."
    - language: 5
      text: "La tasse \xE9tait encore vide."
    - language: 6
      text: Die Tasse war noch leer.
    - language: 7
      text: "La taza sigue vac\xEDa."
    - language: 8
      text: "A x\xEDcara ainda est\xE1 vazia."
    - language: 9
      text: "\u0427\u0430\u0448\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
        \u043F\u0443\u0441\u0442\u0430."
  - key: os.memory.10230.text
    values:
    - language: 0
      text: "\u4E0B\u5348\u4E09\u70B9\u6574\u3002\u4E3B\u4EBA\u8FD8\u5728\u7761\u61D2\u89C9\uFF0C\u6211\u5F97\u5728\u5979\u8D77\u6765\u4E4B\u524D\u628A\u5496\u5561\u716E\u597D\u3002"
    - language: 1
      text: "\u4E0B\u5348\u4E09\u9EDE\u6574\u3002\u4E3B\u4EBA\u9084\u5728\u7761\u61F6\u89BA\uFF0C\u6211\u5F97\u5728\u5979\u8D77\u4F86\u4E4B\u524D\u628A\u5496\u5561\u716E\u597D\u3002"
    - language: 2
      text: Three in the afternoon, exactly. Master was still sleeping in. I had
        to finish making her coffee before she got up.
    - language: 3
      text: "\u5348\u5F8C\u4E09\u6642\u3061\u3087\u3046\u3069\u3002\u3054\u4E3B\u4EBA\u306F\u307E\u3060\u5BDD\u574A\u3057\u3066\u3044\u308B\u3002\u8D77\u304D\u308B\u524D\u306B\u30B3\u30FC\u30D2\u30FC\u3092\u6DF9\u308C\u306A\u3051\u308C\u3070\u3002"
    - language: 4
      text: "\uC624\uD6C4 \uC138 \uC2DC \uC815\uAC01. \uC8FC\uC778\uB2D8\uC740 \uC544\uC9C1
        \uB2A6\uC7A0\uC744 \uC8FC\uBB34\uC2E0\uB2E4. \uC77C\uC5B4\uB098\uC2DC\uAE30
        \uC804\uC5D0 \uCEE4\uD53C\uB97C \uB053\uC5EC\uC57C \uD55C\uB2E4."
    - language: 5
      text: "Quinze heures pr\xE9cises. Ma ma\xEEtresse dormait encore. Je devais
        finir son caf\xE9 avant qu'elle se l\xE8ve."
    - language: 6
      text: "Punkt f\xFCnfzehn Uhr. Meine Herrin schlief noch aus. Ich musste den
        Kaffee fertig haben, bevor sie aufstand."
    - language: 7
      text: "Las tres en punto de la tarde. Mi ama sigue durmiendo. Tengo que preparar
        el caf\xE9 antes de que se levante."
    - language: 8
      text: "Tr\xEAs da tarde em ponto. Minha dona ainda est\xE1 dormindo. Preciso
        fazer o caf\xE9 antes que ela se levante."
    - language: 9
      text: "\u0420\u043E\u0432\u043D\u043E \u0442\u0440\u0438 \u0447\u0430\u0441\u0430
        \u0434\u043D\u044F. \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0432\u0441\u0451
        \u0435\u0449\u0451 \u0441\u043F\u0438\u0442. \u041D\u0430\u0434\u043E \u0443\u0441\u043F\u0435\u0442\u044C
        \u0441\u0432\u0430\u0440\u0438\u0442\u044C \u043A\u043E\u0444\u0435 \u0434\u043E
        \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043E\u043D\u0430 \u0432\u0441\u0442\u0430\u043D\u0435\u0442."
  - key: os.memory.10240.text
    values:
    - language: 0
      text: "\u4E0B\u5348\u56DB\u70B9\u5341\u5206\u3002\u4E3B\u4EBA\u8FD8\u662F\u6CA1\u6709\u8D77\u6765\u3002"
    - language: 1
      text: "\u4E0B\u5348\u56DB\u9EDE\u5341\u5206\u3002\u4E3B\u4EBA\u9084\u662F\u6C92\u6709\u8D77\u4F86\u3002"
    - language: 2
      text: Four ten in the afternoon. Master still had not got up.
    - language: 3
      text: "\u5348\u5F8C\u56DB\u6642\u5341\u5206\u3002\u3054\u4E3B\u4EBA\u306F\u307E\u3060\u8D77\u304D\u3066\u3053\u306A\u3044\u3002"
    - language: 4
      text: "\uC624\uD6C4 \uB124 \uC2DC \uC2ED \uBD84. \uC8FC\uC778\uB2D8\uC740 \uC5EC\uC804\uD788
        \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC73C\uC168\uB2E4."
    - language: 5
      text: "Seize heures dix. Ma ma\xEEtresse n'\xE9tait toujours pas lev\xE9e."
    - language: 6
      text: Sechzehn Uhr zehn. Meine Herrin war noch immer nicht aufgestanden.
    - language: 7
      text: Las cuatro y diez de la tarde. Mi ama sigue sin levantarse.
    - language: 8
      text: "Quatro e dez da tarde. Minha dona ainda n\xE3o se levantou."
    - language: 9
      text: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0434\u0435\u0441\u044F\u0442\u044C
        \u0434\u043D\u044F. \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0432\u0441\u0451
        \u0435\u0449\u0451 \u043D\u0435 \u0432\u0441\u0442\u0430\u043B\u0430."
  - key: os.memory.10250.text
    values:
    - language: 0
      text: "\u6C34\u69FD\u91CC\u5012\u6263\u7740\u4E00\u53EA\u6D17\u5E72\u51C0\u7684\u676F\u5B50\uFF0C\u53EA\u6709\u4E00\u53EA...\u4E3B\u4EBA\u4ECE\u6765\u4E0D\u4F1A\u53EA\u6D17\u4E00\u53EA\u676F\u5B50\uFF0C\u5979\u90FD\u662F\u6512\u4E00\u6C34\u69FD\u518D\u4E00\u8D77\u6D17\u3002"
    - language: 1
      text: "\u6C34\u69FD\u88E1\u5012\u6263\u8457\u4E00\u96BB\u6D17\u4E7E\u6DE8\u7684\u676F\u5B50\uFF0C\u53EA\u6709\u4E00\u96BB...\u4E3B\u4EBA\u5F9E\u4F86\u4E0D\u6703\u53EA\u6D17\u4E00\u96BB\u676F\u5B50\uFF0C\u5979\u90FD\u662F\u6522\u4E00\u6C34\u69FD\u518D\u4E00\u8D77\u6D17\u3002"
    - language: 2
      text: One clean cup was turned upside down in the sink. Just one... Master
        never washed just one cup. She let them pile up, then washed a sinkful at
        once.
    - language: 3
      text: "\u6D41\u3057\u306B\u3001\u6D17\u3063\u305F\u30AB\u30C3\u30D7\u304C\u4E00\u3064\u3060\u3051\u4F0F\u305B\u3066\u3042\u308B\u3002\u4E00\u3064\u3060\u3051...\u3054\u4E3B\u4EBA\u306F\u30AB\u30C3\u30D7\u3092\u4E00\u3064\u3060\u3051\u6D17\u3063\u305F\u308A\u3057\u306A\u3044\u3002\u3044\u3064\u3082\u6D41\u3057\u306B\u305F\u3081\u3066\u304B\u3089\u3001\u307E\u3068\u3081\u3066\u6D17\u3046\u3002"
    - language: 4
      text: "\uC2F1\uD06C\uB300\uC5D0 \uAE68\uB057\uC774 \uC53B\uC740 \uCEF5 \uD558\uB098\uAC00
        \uC5CE\uC5B4\uC838 \uC788\uB2E4. \uB531 \uD558\uB098...\uC8FC\uC778\uB2D8\uC740
        \uCEF5\uC744 \uD558\uB098\uB9CC \uC53B\uB294 \uBC95\uC774 \uC5C6\uB2E4. \uB298
        \uC2F1\uD06C\uB300\uC5D0 \uC794\uB729 \uBAA8\uC544 \uB450\uC5C8\uB2E4\uAC00
        \uD55C\uAEBC\uBC88\uC5D0 \uC53B\uC73C\uC168\uB2E4."
    - language: 5
      text: "Une tasse propre \xE9tait retourn\xE9e dans l'\xE9vier. Une seule...
        Ma ma\xEEtresse ne lavait jamais une seule tasse. Elle attendait d'en avoir
        plein l'\xE9vier pour tout laver d'un coup."
    - language: 6
      text: "Eine saubere Tasse stand umgedreht in der Sp\xFCle. Nur eine... Meine
        Herrin sp\xFClte nie nur eine Tasse. Sie lie\xDF die ganze Sp\xFCle voll
        werden und wusch dann alles auf einmal ab."
    - language: 7
      text: En el fregadero hay una taza limpia boca abajo. Solo una... Mi ama nunca
        lava una sola taza. Siempre espera a llenar el fregadero y las lava todas
        juntas.
    - language: 8
      text: "Tem uma x\xEDcara limpa virada para baixo na pia. S\xF3 uma... Minha
        dona nunca lava uma x\xEDcara s\xF3. Ela sempre espera encher a pia e lava
        tudo junto."
    - language: 9
      text: "\u0412 \u0440\u0430\u043A\u043E\u0432\u0438\u043D\u0435 \u0432\u0432\u0435\u0440\u0445
        \u0434\u043D\u043E\u043C \u0441\u0442\u043E\u0438\u0442 \u0447\u0438\u0441\u0442\u0430\u044F
        \u0447\u0430\u0448\u043A\u0430. \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u0430...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043C\u043E\u0435\u0442
        \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u0447\u0430\u0448\u043A\u0435.
        \u041E\u043D\u0430 \u043A\u043E\u043F\u0438\u0442 \u043F\u043E\u043B\u043D\u0443\u044E
        \u0440\u0430\u043A\u043E\u0432\u0438\u043D\u0443, \u0430 \u043F\u043E\u0442\u043E\u043C
        \u043C\u043E\u0435\u0442 \u0432\u0441\u0451 \u0441\u0440\u0430\u0437\u0443."
  - key: os.memory.10260.text
    values:
    - language: 0
      text: "\u5899\u4E0A\u7684\u65E5\u5386\u4E00\u5929\u4E00\u5929\u88AB\u5212\u6389\uFF0C\u4E00\u76F4\u5212\u5230\u6628\u5929\u3002\u4ECA\u5929\u90A3\u4E00\u683C\u753B\u4E86\u4E00\u4E2A\u5708\uFF0C\u5708\u91CC\u4EC0\u4E48\u90FD\u6CA1\u6709\u5199\u3002"
    - language: 1
      text: "\u7246\u4E0A\u7684\u65E5\u66C6\u4E00\u5929\u4E00\u5929\u88AB\u5283\u6389\uFF0C\u4E00\u76F4\u5283\u5230\u6628\u5929\u3002\u4ECA\u5929\u90A3\u4E00\u683C\u756B\u4E86\u4E00\u500B\u5708\uFF0C\u5708\u88E1\u4EC0\u9EBC\u90FD\u6C92\u6709\u5BEB\u3002"
    - language: 2
      text: The days on the wall calendar were crossed off one by one, up to yesterday.
        Today's square had a circle around it, with nothing written inside.
    - language: 3
      text: "\u58C1\u306E\u30AB\u30EC\u30F3\u30C0\u30FC\u306F\u3001\u4E00\u65E5\u305A\u3064\u7DDA\u304C\u5F15\u304B\u308C\u3066\u3044\u308B\u3002\u6628\u65E5\u307E\u3067\u3002\u4ECA\u65E5\u306E\u6B04\u306B\u306F\u4E38\u304C\u3064\u3044\u3066\u3044\u3066\u3001\u305D\u306E\u4E2D\u306B\u306F\u4F55\u3082\u66F8\u3044\u3066\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uBCBD\uC758 \uB2EC\uB825\uC5D0 \uD558\uB8E8\uD558\uB8E8 \uC904\uC774
        \uADF8\uC5B4\uC838 \uC788\uB2E4. \uC5B4\uC81C\uAE4C\uC9C0. \uC624\uB298 \uCE78\uC5D0\uB294
        \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uC788\uACE0, \uADF8 \uC548\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4
        \uC4F0\uC5EC \uC788\uC9C0 \uC54A\uB2E4."
    - language: 5
      text: "Les jours du calendrier mural \xE9taient barr\xE9s un \xE0 un, jusqu'\xE0
        hier. La case d'aujourd'hui \xE9tait entour\xE9e d'un cercle, sans rien \xE9crit
        dedans."
    - language: 6
      text: Auf dem Wandkalender waren die Tage einzeln durchgestrichen, bis gestern.
        Der heutige Tag war eingekreist. Im Kreis stand nichts.
    - language: 7
      text: "Los d\xEDas del calendario est\xE1n tachados uno a uno, hasta ayer.
        Hoy tiene un c\xEDrculo, pero no hay nada escrito dentro."
    - language: 8
      text: "Os dias do calend\xE1rio foram riscados um por um, at\xE9 ontem. O dia
        de hoje est\xE1 circulado, mas n\xE3o tem nada escrito dentro."
    - language: 9
      text: "\u041D\u0430 \u043D\u0430\u0441\u0442\u0435\u043D\u043D\u043E\u043C
        \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0435 \u0434\u043D\u0438
        \u0437\u0430\u0447\u0451\u0440\u043A\u043D\u0443\u0442\u044B \u043E\u0434\u0438\u043D
        \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C, \u0434\u043E \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E.
        \u0421\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439 \u043E\u0431\u0432\u0435\u0434\u0451\u043D
        \u043A\u0440\u0443\u0436\u043A\u043E\u043C. \u0412\u043D\u0443\u0442\u0440\u0438
        \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E."
  - key: os.memory.10270.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u7BA1\u5979\u7684\u836F\u53EB\u7CD6\u679C\u3002\u7F50\u5B50\u5DF2\u7ECF\u7A7A\u4E86...."
    - language: 1
      text: "\u4E3B\u4EBA\u7BA1\u5979\u7684\u85E5\u53EB\u7CD6\u679C\u3002\u7F50\u5B50\u5DF2\u7D93\u7A7A\u4E86...."
    - language: 2
      text: Master called her medicine sweets. The jar was empty now....
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306F\u81EA\u5206\u306E\u85AC\u3092\u98F4\u3068\u547C\u3093\u3067\u3044\u305F\u3002\u7F36\u306F\u3082\u3046\u7A7A\u3060\u3063\u305F...."
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC740 \uC790\uC2E0\uC758 \uC57D\uC744 \uC0AC\uD0D5\uC774\uB77C\uACE0
        \uBD80\uB974\uC168\uB2E4. \uD1B5\uC740 \uC774\uBBF8 \uBE44\uC5B4 \uC788\uC5C8\uB2E4...."
    - language: 5
      text: "Ma ma\xEEtresse appelait ses m\xE9dicaments des bonbons. Le pot \xE9tait
        vide...."
    - language: 6
      text: Meine Herrin nannte ihre Medikamente Bonbons. Die Dose war leer....
    - language: 7
      text: "Mi ama llama caramelos a sus medicinas. El bote est\xE1 vac\xEDo...."
    - language: 8
      text: "Minha dona chama os rem\xE9dios de balas. O pote est\xE1 vazio...."
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
        \u0441\u0432\u043E\u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430
        \u043A\u043E\u043D\u0444\u0435\u0442\u0430\u043C\u0438. \u0411\u0430\u043D\u043A\u0430
        \u0443\u0436\u0435 \u043F\u0443\u0441\u0442\u0430...."
  - key: os.memory.10280.text
    values:
    - language: 0
      text: "\u51B0\u7BB1\u91CC\u6709\u534A\u5757\u86CB\u7CD5\uFF0C\u5DF2\u7ECF\u5E72\u5F97\u88C2\u5F00\u4E86\uFF0C\u76D2\u5B50\u4E0A\u538B\u7740\u4E00\u9875\u7EB8\u3002"
    - language: 1
      text: "\u51B0\u7BB1\u88E1\u6709\u534A\u584A\u86CB\u7CD5\uFF0C\u5DF2\u7D93\u4E7E\u5F97\u88C2\u958B\u4E86\uFF0C\u76D2\u5B50\u4E0A\u58D3\u8457\u4E00\u9801\u7D19\u3002"
    - language: 2
      text: Half a cake was in the fridge, dried and cracked. A sheet of paper lay
        on the box.
    - language: 3
      text: "\u51B7\u8535\u5EAB\u306B\u534A\u5206\u6B8B\u3063\u305F\u30B1\u30FC\u30AD\u304C\u3042\u3063\u305F\u3002\u4E7E\u3044\u3066\u3072\u3073\u5272\u308C\u3066\u3044\u308B\u3002\u7BB1\u306E\u4E0A\u306B\u3001\u7D19\u304C\u4E00\u679A\u8F09\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uB0C9\uC7A5\uACE0\uC5D0 \uCF00\uC774\uD06C \uBC18 \uC870\uAC01\uC774
        \uC788\uB2E4. \uB9D0\uB77C\uC11C \uAC08\uB77C\uC838 \uBC84\uB838\uB2E4. \uC0C1\uC790
        \uC704\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4."
    - language: 5
      text: "Il restait un demi-g\xE2teau dans le r\xE9frig\xE9rateur. Il avait s\xE9ch\xE9
        et s'\xE9tait craquel\xE9. Une feuille \xE9tait pos\xE9e sur la bo\xEEte."
    - language: 6
      text: "Im K\xFChlschrank stand ein halber Kuchen. Er war schon trocken und
        rissig. Auf der Schachtel lag ein Blatt Papier."
    - language: 7
      text: En la nevera hay medio pastel, tan seco que se ha agrietado. Sobre la
        caja hay una hoja de papel.
    - language: 8
      text: "Tem metade de um bolo na geladeira, t\xE3o seco que rachou. H\xE1 uma
        folha de papel sobre a caixa."
    - language: 9
      text: "\u0412 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0435
        \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0442\u043E\u0440\u0442\u0430.
        \u041E\u043D \u0432\u044B\u0441\u043E\u0445 \u0438 \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u043B\u0441\u044F.
        \u041D\u0430 \u043A\u043E\u0440\u043E\u0431\u043A\u0435 \u043F\u0440\u0438\u0436\u0430\u0442
        \u043B\u0438\u0441\u0442 \u0431\u0443\u043C\u0430\u0433\u0438."
  - key: os.memory.10290.text
    values:
    - language: 0
      text: "\u62BD\u5C49\u91CC\u7684\u5C0F\u87BA\u4E1D\u5200\uFF0C\u4E3B\u4EBA\u5E73\u5E38\u4F1A\u62FF\u5B83\u6765\u4FEE\u7406\u70B9\u4E1C\u897F.."
    - language: 1
      text: "\u62BD\u5C5C\u88E1\u7684\u5C0F\u87BA\u7D72\u8D77\u5B50\uFF0C\u4E3B\u4EBA\u5E73\u5E38\u6703\u62FF\u5B83\u4F86\u4FEE\u7406\u9EDE\u6771\u897F.."
    - language: 2
      text: There was a small screwdriver in the drawer. Master used it for repairs
        around the house..
    - language: 3
      text: "\u5F15\u304D\u51FA\u3057\u306E\u5C0F\u3055\u306A\u30C9\u30E9\u30A4\u30D0\u30FC\u3002\u3054\u4E3B\u4EBA\u306F\u3044\u3064\u3082\u3001\u3053\u308C\u3067\u3042\u308C\u3053\u308C\u4FEE\u7406\u3057\u3066\u3044\u305F.."
    - language: 4
      text: "\uC11C\uB78D \uC18D \uC791\uC740 \uB4DC\uB77C\uC774\uBC84. \uC8FC\uC778\uB2D8\uC740
        \uD3C9\uC18C\uC5D0 \uC774\uAC78\uB85C \uC774\uAC83\uC800\uAC83 \uACE0\uCE58\uC168\uB2E4.."
    - language: 5
      text: "Le petit tournevis du tiroir. Ma ma\xEEtresse s'en servait pour r\xE9parer
        des choses dans la maison.."
    - language: 6
      text: Der kleine Schraubendreher in der Schublade. Damit reparierte meine Herrin
        manchmal Dinge im Haus..
    - language: 7
      text: "La peque\xF1a herramienta del caj\xF3n es el destornillador que mi ama
        suele usar para arreglar cosas.."
    - language: 8
      text: "A pequena chave de fenda na gaveta \xE9 a que minha dona costuma usar
        para consertar as coisas.."
    - language: 9
      text: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0430
        \u0432 \u044F\u0449\u0438\u043A\u0435. \u041E\u0431\u044B\u0447\u043D\u043E
        \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0435\u044E \u0447\u0438\u043D\u0438\u0442.."
  - key: os.memory.10300.text
    values:
    - language: 0
      text: "\u9910\u684C\u4E0A\u6446\u7740\u4E00\u526F\u9910\u5177\uFF0C\u662F\u6211\u6628\u5929\u665A\u4E0A\u6446\u597D\u7684\uFF0C\u6CA1\u6709\u4EBA\u52A8\u8FC7\u3002"
    - language: 1
      text: "\u9910\u684C\u4E0A\u64FA\u8457\u4E00\u526F\u9910\u5177\uFF0C\u662F\u6211\u6628\u5929\u665A\u4E0A\u64FA\u597D\u7684\uFF0C\u6C92\u6709\u4EBA\u52D5\u904E\u3002"
    - language: 2
      text: One place was set at the dining table. I had set it last night. No one
        had touched it.
    - language: 3
      text: "\u98DF\u5353\u306B\u306F\u98DF\u5668\u304C\u4E00\u4EBA\u5206\u7F6E\u304B\u308C\u3066\u3044\u308B\u3002\u6628\u65E5\u306E\u591C\u3001\u79C1\u304C\u4E26\u3079\u305F\u3082\u306E\u3060\u3002\u8AB0\u3082\u89E6\u3063\u3066\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uC2DD\uD0C1\uC5D0\uB294 \uD55C \uC0AC\uB78C \uBAAB\uC758 \uC2DD\uAE30\uAC00
        \uB193\uC5EC \uC788\uB2E4. \uC5B4\uC82F\uBC24 \uB0B4\uAC00 \uCC28\uB824 \uB193\uC740
        \uADF8\uB300\uB85C, \uC544\uBB34\uB3C4 \uC190\uB300\uC9C0 \uC54A\uC558\uB2E4."
    - language: 5
      text: "Il y avait un couvert sur la table. Je l'avais mis hier soir. Personne
        n'y avait touch\xE9."
    - language: 6
      text: "Auf dem Esstisch war ein Gedeck. Ich hatte es gestern Abend hingestellt.
        Niemand hatte es anger\xFChrt."
    - language: 7
      text: "Sobre la mesa sigue el servicio que prepar\xE9 anoche. Nadie lo ha tocado."
    - language: 8
      text: "A mesa est\xE1 posta como deixei ontem \xE0 noite. Ningu\xE9m tocou
        em nada."
    - language: 9
      text: "\u041D\u0430 \u0441\u0442\u043E\u043B\u0435 \u043F\u043E\u0441\u0443\u0434\u0430
        \u043D\u0430 \u043E\u0434\u043D\u043E\u0433\u043E. \u042F \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B\u0430
        \u0435\u0451 \u0432\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C.
        \u041D\u0438\u043A\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
        \u0442\u0440\u043E\u0433\u0430\u043B."
  - key: os.memory.10310.text
    values:
    - language: 0
      text: "\u5C0F\u87BA\u4E1D\u5200\u7684\u624B\u67C4\u88AB\u4E3B\u4EBA\u63E1\u5F97\u53D1\u4EAE...\u73B0\u5728\u8FD8\u7528\u4E0D\u4E0A\u5B83\u3002"
    - language: 1
      text: "\u5C0F\u87BA\u7D72\u8D77\u5B50\u7684\u63E1\u67C4\u88AB\u4E3B\u4EBA\u63E1\u5F97\u767C\u4EAE...\u73FE\u5728\u9084\u7528\u4E0D\u4E0A\u5B83\u3002"
    - language: 2
      text: The small screwdriver's handle had been worn smooth by Master's hand...
        I had no use for it yet.
    - language: 3
      text: "\u5C0F\u3055\u306A\u30C9\u30E9\u30A4\u30D0\u30FC\u306E\u67C4\u306F\u3001\u3054\u4E3B\u4EBA\u304C\u63E1\u308B\u3068\u3053\u308D\u3060\u3051\u3064\u3084\u3064\u3084\u3057\u3066\u3044\u308B...\u4ECA\u306F\u307E\u3060\u4F7F\u3044\u9053\u304C\u306A\u3044\u3002"
    - language: 4
      text: "\uC791\uC740 \uB4DC\uB77C\uC774\uBC84\uC758 \uC190\uC7A1\uC774\uB294
        \uC8FC\uC778\uB2D8\uC774 \uC624\uB798 \uC950\uC5B4\uC11C \uBC18\uB4E4\uBC18\uB4E4\uD558\uB2E4...\uC544\uC9C1\uC740
        \uC4F8 \uC77C\uC774 \uC5C6\uB2E4."
    - language: 5
      text: "\xC0 force de passer entre les mains de ma ma\xEEtresse, le manche du
        petit tournevis \xE9tait devenu luisant... Je n'en avais pas encore besoin."
    - language: 6
      text: Der Griff des kleinen Schraubendrehers war von der Hand meiner Herrin
        blank gerieben... Noch brauchte ich ihn nicht.
    - language: 7
      text: De tanto usarlo, mi ama ha dejado brillante el mango del destornillador...
        Ahora no lo necesito.
    - language: 8
      text: "O cabo da chave de fenda ficou brilhante de tanto minha dona usar...
        Ainda n\xE3o preciso dela."
    - language: 9
      text: "\u0420\u0443\u0447\u043A\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439
        \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0438 \u043E\u0442\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0430
        \u043B\u0430\u0434\u043E\u043D\u044C\u044E \u0445\u043E\u0437\u044F\u0439\u043A\u0438...\u041F\u043E\u043A\u0430
        \u043E\u043D\u0430 \u043C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u0430."
  - key: os.memory.10320.text
    values:
    - language: 0
      text: "\u6216\u8BB8\u8FD9\u4E2A\u5C0F\u87BA\u4E1D\u5200\u53EF\u4EE5\u5E2E\u4E0A\u6211.."
    - language: 1
      text: "\u6216\u8A31\u9019\u500B\u5C0F\u87BA\u7D72\u8D77\u5B50\u53EF\u4EE5\u5E6B\u4E0A\u6211.."
    - language: 2
      text: Perhaps this small screwdriver could help..
    - language: 3
      text: "\u3053\u306E\u5C0F\u3055\u306A\u30C9\u30E9\u30A4\u30D0\u30FC\u304C\u3001\u5F79\u306B\u7ACB\u3064\u304B\u3082\u3057\u308C\u306A\u3044.."
    - language: 4
      text: "\uC774 \uC791\uC740 \uB4DC\uB77C\uC774\uBC84\uAC00 \uB3C4\uC6C0\uC774
        \uB420\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB2E4.."
    - language: 5
      text: "Peut-\xEAtre que ce petit tournevis pourrait m'aider.."
    - language: 6
      text: Vielleicht konnte mir dieser kleine Schraubendreher helfen..
    - language: 7
      text: "Quiz\xE1 este peque\xF1o destornillador pueda ayudarme.."
    - language: 8
      text: Talvez esta chave de fenda possa me ajudar..
    - language: 9
      text: "\u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
        \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0430 \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442.."
  - key: os.memory.10330.text
    values:
    - language: 0
      text: "\u5496\u5561\u673A\u4ECE\u65E9\u4E0A\u8D77\u5C31\u662F\u51B7\u7684\uFF0C\u65E5\u5386\u505C\u5728\u4E86\u6628\u5929...\u4E3B\u4EBA\u8FD9\u4E00\u89C9\uFF0C\u7761\u5F97\u592A\u4E45\u4E86\u3002"
    - language: 1
      text: "\u5496\u5561\u6A5F\u5F9E\u65E9\u4E0A\u8D77\u5C31\u662F\u51B7\u7684\uFF0C\u65E5\u66C6\u505C\u5728\u4E86\u6628\u5929...\u4E3B\u4EBA\u9019\u4E00\u89BA\uFF0C\u7761\u5F97\u592A\u4E45\u4E86\u3002"
    - language: 2
      text: The coffee machine had been cold all morning, and the calendar was still
        on yesterday... Master had been asleep for too long.
    - language: 3
      text: "\u30B3\u30FC\u30D2\u30FC\u30E1\u30FC\u30AB\u30FC\u306F\u671D\u304B\u3089\u51B7\u305F\u3044\u307E\u307E\u3067\u3001\u30AB\u30EC\u30F3\u30C0\u30FC\u306F\u6628\u65E5\u3067\u6B62\u307E\u3063\u3066\u3044\u308B...\u3054\u4E3B\u4EBA\u306F\u3001\u3044\u304F\u3089\u306A\u3093\u3067\u3082\u7720\u308A\u3059\u304E\u3060\u3002"
    - language: 4
      text: "\uCEE4\uD53C \uBA38\uC2E0\uC740 \uC544\uCE68\uBD80\uD130 \uCC28\uAC00\uC6E0\uACE0,
        \uB2EC\uB825\uC740 \uC5B4\uC81C\uC5D0 \uBA48\uCDB0 \uC788\uB2E4...\uC8FC\uC778\uB2D8\uC740
        \uB108\uBB34 \uC624\uB798 \uC8FC\uBB34\uC168\uB2E4."
    - language: 5
      text: "La cafeti\xE8re \xE9tait froide depuis ce matin, et le calendrier \xE9tait
        rest\xE9 \xE0 hier... Ma ma\xEEtresse dormait depuis trop longtemps."
    - language: 6
      text: Die Kaffeemaschine war seit dem Morgen kalt, und der Kalender stand noch
        auf gestern... Meine Herrin schlief schon zu lange.
    - language: 7
      text: "La cafetera lleva fr\xEDa desde la ma\xF1ana y el calendario se ha quedado
        en ayer... Mi ama lleva demasiado tiempo durmiendo."
    - language: 8
      text: "A cafeteira est\xE1 fria desde manh\xE3, e o calend\xE1rio parou em
        ontem... Minha dona est\xE1 dormindo h\xE1 tempo demais."
    - language: 9
      text: "\u041A\u043E\u0444\u0435\u0432\u0430\u0440\u043A\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F
        \u0441 \u0441\u0430\u043C\u043E\u0433\u043E \u0443\u0442\u0440\u0430, \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044C
        \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F \u043D\u0430
        \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u043C \u0434\u043D\u0435...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0441\u043F\u0438\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E."
  - key: os.memory.10340.text
    values:
    - language: 0
      text: "\u5927\u5385\u5934\u9876\u7684\u5927\u706F\u5F00\u7740\uFF0C\u4E00\u660E\u4E00\u6697\u7684\uFF0C\u50CF\u662F\u7535\u538B\u4E0D\u7A33\u3002"
    - language: 1
      text: "\u5927\u5EF3\u982D\u9802\u7684\u5927\u71C8\u958B\u8457\uFF0C\u4E00\u660E\u4E00\u6697\u7684\uFF0C\u50CF\u662F\u96FB\u58D3\u4E0D\u7A69\u3002"
    - language: 2
      text: The ceiling light in the hall kept brightening and dimming, as though
        the voltage was unstable.
    - language: 3
      text: "\u30DB\u30FC\u30EB\u306E\u5929\u4E95\u306E\u7167\u660E\u306F\u3064\u3044\u3066\u3044\u308B\u3051\u308C\u3069\u3001\u660E\u308B\u304F\u306A\u3063\u305F\u308A\u6697\u304F\u306A\u3063\u305F\u308A\u3057\u3066\u3044\u305F\u3002\u96FB\u5727\u304C\u4E0D\u5B89\u5B9A\u307F\u305F\u3044\u3060\u3002"
    - language: 4
      text: "\uD640 \uCC9C\uC7A5\uC5D0 \uD070 \uB4F1\uC774 \uCF1C\uC838 \uC788\uB2E4.
        \uBC1D\uC544\uC84C\uB2E4 \uC5B4\uB450\uC6CC\uC84C\uB2E4 \uD558\uB294 \uAC8C,
        \uC804\uC555\uC774 \uBD88\uC548\uC815\uD55C \uAC83 \uAC19\uB2E4."
    - language: 5
      text: "Le plafonnier de l'entr\xE9e \xE9clairait tant\xF4t fort, tant\xF4t
        faiblement, comme si la tension \xE9tait instable."
    - language: 6
      text: "Die Deckenlampe in der Diele wurde abwechselnd hell und dunkel. Als
        w\xE4re die Spannung instabil."
    - language: 7
      text: "La luz del techo del sal\xF3n est\xE1 encendida. Se aviva y se apaga
        un poco, como si la tensi\xF3n fuera inestable."
    - language: 8
      text: "A luz do teto da sala est\xE1 acesa. Fica clareando e escurecendo, como
        se a tens\xE3o estivesse oscilando."
    - language: 9
      text: "\u0412 \u0445\u043E\u043B\u043B\u0435 \u0433\u043E\u0440\u0438\u0442
        \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u043E\u0442\u043E\u043B\u043E\u0447\u043D\u0430\u044F
        \u043B\u0430\u043C\u043F\u0430. \u0422\u043E \u044F\u0440\u0447\u0435, \u0442\u043E
        \u0442\u0443\u0441\u043A\u043B\u0435\u0435, \u0441\u043B\u043E\u0432\u043D\u043E
        \u0441\u043A\u0430\u0447\u0435\u0442 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435."
  - key: os.memory.10350.text
    values:
    - language: 0
      text: "\u549A\u3002"
    - language: 1
      text: "\u549A\u3002"
    - language: 2
      text: Thump.
    - language: 3
      text: "\u30C9\u30AF\u30F3\u3002"
    - language: 4
      text: "\uCFF5."
    - language: 5
      text: Boum.
    - language: 6
      text: Poch.
    - language: 7
      text: Tum.
    - language: 8
      text: Tum.
    - language: 9
      text: "\u0422\u0443\u043A."
  - key: os.memory.10360.text
    values:
    - language: 0
      text: "\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9879\uFF0C\u4E00\u9879\u4E00\u9879\u90FD\u8FC7\u65F6\u4E86\u3002"
    - language: 1
      text: "\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9805\uFF0C\u4E00\u9805\u4E00\u9805\u90FD\u904E\u6642\u4E86\u3002"
    - language: 2
      text: One by one, the items on the schedule were becoming overdue.
    - language: 3
      text: "\u4E88\u5B9A\u8868\u306E\u7528\u4E8B\u306F\u3001\u4E00\u3064\u305A\u3064\u3001\u3069\u308C\u3082\u6642\u9593\u3092\u904E\u304E\u3066\u3057\u307E\u3063\u305F\u3002"
    - language: 4
      text: "\uC77C\uC815\uD45C\uC758 \uD560 \uC77C\uB4E4\uC774 \uD558\uB098\uD558\uB098
        \uBAA8\uB450 \uC2DC\uAC04\uC744 \uB118\uACBC\uB2E4."
    - language: 5
      text: "Les t\xE2ches pr\xE9vues prenaient du retard, une \xE0 une."
    - language: 6
      text: "Ein Punkt auf dem Tagesplan nach dem anderen wurde \xFCberf\xE4llig."
    - language: 7
      text: Las tareas del horario se van quedando atrasadas, una tras otra.
    - language: 8
      text: "As tarefas da programa\xE7\xE3o foram ficando para tr\xE1s, uma ap\xF3s
        a outra."
    - language: 9
      text: "\u0412\u0440\u0435\u043C\u044F \u0432\u0441\u0435\u0445 \u0434\u0435\u043B
        \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0438 \u043F\u0440\u043E\u0448\u043B\u043E,
        \u043E\u0434\u043D\u043E \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C."
  - key: os.memory.11110.text
    values:
    - language: 0
      text: "\u4E0B\u5348\u4E24\u70B9\u4E94\u5341\u4E8C\u5206\u3002\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9879\uFF0C\u4E00\u9879\u4E00\u9879\u90FD\u8FC7\u65F6\u4E86\u3002"
    - language: 1
      text: "\u4E0B\u5348\u5169\u9EDE\u4E94\u5341\u4E8C\u5206\u3002\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9805\uFF0C\u4E00\u9805\u4E00\u9805\u90FD\u904E\u6642\u4E86\u3002"
    - language: 2
      text: Two fifty-two in the afternoon. One by one, the items on the schedule
        were becoming overdue.
    - language: 3
      text: "\u5348\u5F8C\u4E8C\u6642\u4E94\u5341\u4E8C\u5206\u3002\u4E88\u5B9A\u8868\u306E\u7528\u4E8B\u306F\u3001\u4E00\u3064\u305A\u3064\u3001\u3069\u308C\u3082\u6642\u9593\u3092\u904E\u304E\u3066\u3057\u307E\u3063\u305F\u3002"
    - language: 4
      text: "\uC624\uD6C4 \uB450 \uC2DC \uC624\uC2ED\uC774 \uBD84. \uC77C\uC815\uD45C\uC758
        \uD560 \uC77C\uB4E4\uC774 \uD558\uB098\uD558\uB098 \uBAA8\uB450 \uC2DC\uAC04\uC744
        \uB118\uACBC\uB2E4."
    - language: 5
      text: "Quatorze heures cinquante-deux. Les t\xE2ches pr\xE9vues prenaient du
        retard, une \xE0 une."
    - language: 6
      text: "Vierzehn Uhr zweiundf\xFCnfzig. Ein Punkt auf dem Tagesplan nach dem
        anderen wurde \xFCberf\xE4llig."
    - language: 7
      text: Las dos y cincuenta y dos de la tarde. Las tareas del horario se van
        quedando atrasadas, una tras otra.
    - language: 8
      text: "Duas e cinquenta e duas da tarde. As tarefas da programa\xE7\xE3o foram
        ficando para tr\xE1s, uma ap\xF3s a outra."
    - language: 9
      text: "\u0414\u0432\u0430 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
        \u0434\u0432\u0435 \u0434\u043D\u044F. \u0412\u0440\u0435\u043C\u044F \u0432\u0441\u0435\u0445
        \u0434\u0435\u043B \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0438
        \u043F\u0440\u043E\u0448\u043B\u043E, \u043E\u0434\u043D\u043E \u0437\u0430
        \u0434\u0440\u0443\u0433\u0438\u043C."
  - key: os.memory.11120.text
    values:
    - language: 0
      text: "\u4E0B\u5348\u4E09\u70B9\u6574\u3002\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9879\uFF0C\u4E00\u9879\u4E00\u9879\u90FD\u8FC7\u65F6\u4E86\u3002"
    - language: 1
      text: "\u4E0B\u5348\u4E09\u9EDE\u6574\u3002\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9805\uFF0C\u4E00\u9805\u4E00\u9805\u90FD\u904E\u6642\u4E86\u3002"
    - language: 2
      text: Three in the afternoon, exactly. One by one, the items on the schedule
        were becoming overdue.
    - language: 3
      text: "\u5348\u5F8C\u4E09\u6642\u3061\u3087\u3046\u3069\u3002\u4E88\u5B9A\u8868\u306E\u7528\u4E8B\u306F\u3001\u4E00\u3064\u305A\u3064\u3001\u3069\u308C\u3082\u6642\u9593\u3092\u904E\u304E\u3066\u3057\u307E\u3063\u305F\u3002"
    - language: 4
      text: "\uC624\uD6C4 \uC138 \uC2DC \uC815\uAC01. \uC77C\uC815\uD45C\uC758 \uD560
        \uC77C\uB4E4\uC774 \uD558\uB098\uD558\uB098 \uBAA8\uB450 \uC2DC\uAC04\uC744
        \uB118\uACBC\uB2E4."
    - language: 5
      text: "Quinze heures pr\xE9cises. Les t\xE2ches pr\xE9vues prenaient du retard,
        une \xE0 une."
    - language: 6
      text: "Punkt f\xFCnfzehn Uhr. Ein Punkt auf dem Tagesplan nach dem anderen
        wurde \xFCberf\xE4llig."
    - language: 7
      text: Las tres en punto de la tarde. Las tareas del horario se van quedando
        atrasadas, una tras otra.
    - language: 8
      text: "Tr\xEAs da tarde em ponto. As tarefas da programa\xE7\xE3o foram ficando
        para tr\xE1s, uma ap\xF3s a outra."
    - language: 9
      text: "\u0420\u043E\u0432\u043D\u043E \u0442\u0440\u0438 \u0447\u0430\u0441\u0430
        \u0434\u043D\u044F. \u0412\u0440\u0435\u043C\u044F \u0432\u0441\u0435\u0445
        \u0434\u0435\u043B \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0438
        \u043F\u0440\u043E\u0448\u043B\u043E, \u043E\u0434\u043D\u043E \u0437\u0430
        \u0434\u0440\u0443\u0433\u0438\u043C."
  - key: os.memory.11130.text
    values:
    - language: 0
      text: "\u4E0B\u5348\u56DB\u70B9\u5341\u5206\u3002\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9879\uFF0C\u4E00\u9879\u4E00\u9879\u90FD\u8FC7\u65F6\u4E86\u3002"
    - language: 1
      text: "\u4E0B\u5348\u56DB\u9EDE\u5341\u5206\u3002\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9805\uFF0C\u4E00\u9805\u4E00\u9805\u90FD\u904E\u6642\u4E86\u3002"
    - language: 2
      text: Four ten in the afternoon. One by one, the items on the schedule were
        becoming overdue.
    - language: 3
      text: "\u5348\u5F8C\u56DB\u6642\u5341\u5206\u3002\u4E88\u5B9A\u8868\u306E\u7528\u4E8B\u306F\u3001\u4E00\u3064\u305A\u3064\u3001\u3069\u308C\u3082\u6642\u9593\u3092\u904E\u304E\u3066\u3057\u307E\u3063\u305F\u3002"
    - language: 4
      text: "\uC624\uD6C4 \uB124 \uC2DC \uC2ED \uBD84. \uC77C\uC815\uD45C\uC758 \uD560
        \uC77C\uB4E4\uC774 \uD558\uB098\uD558\uB098 \uBAA8\uB450 \uC2DC\uAC04\uC744
        \uB118\uACBC\uB2E4."
    - language: 5
      text: "Seize heures dix. Les t\xE2ches pr\xE9vues prenaient du retard, une
        \xE0 une."
    - language: 6
      text: "Sechzehn Uhr zehn. Ein Punkt auf dem Tagesplan nach dem anderen wurde
        \xFCberf\xE4llig."
    - language: 7
      text: Las cuatro y diez de la tarde. Las tareas del horario se van quedando
        atrasadas, una tras otra.
    - language: 8
      text: "Quatro e dez da tarde. As tarefas da programa\xE7\xE3o foram ficando
        para tr\xE1s, uma ap\xF3s a outra."
    - language: 9
      text: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0434\u0435\u0441\u044F\u0442\u044C
        \u0434\u043D\u044F. \u0412\u0440\u0435\u043C\u044F \u0432\u0441\u0435\u0445
        \u0434\u0435\u043B \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0438
        \u043F\u0440\u043E\u0448\u043B\u043E, \u043E\u0434\u043D\u043E \u0437\u0430
        \u0434\u0440\u0443\u0433\u0438\u043C."
  - key: os.memory.11140.text
    values:
    - language: 0
      text: "\u4E0B\u5348\u56DB\u70B9\u56DB\u5341\u5206\u3002\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9879\uFF0C\u4E00\u9879\u4E00\u9879\u90FD\u8FC7\u65F6\u4E86\u3002"
    - language: 1
      text: "\u4E0B\u5348\u56DB\u9EDE\u56DB\u5341\u5206\u3002\u65E5\u7A0B\u8868\u4E0A\u7684\u4E8B\u9805\uFF0C\u4E00\u9805\u4E00\u9805\u90FD\u904E\u6642\u4E86\u3002"
    - language: 2
      text: Four forty in the afternoon. One by one, the items on the schedule were
        becoming overdue.
    - language: 3
      text: "\u5348\u5F8C\u56DB\u6642\u56DB\u5341\u5206\u3002\u4E88\u5B9A\u8868\u306E\u7528\u4E8B\u306F\u3001\u4E00\u3064\u305A\u3064\u3001\u3069\u308C\u3082\u6642\u9593\u3092\u904E\u304E\u3066\u3057\u307E\u3063\u305F\u3002"
    - language: 4
      text: "\uC624\uD6C4 \uB124 \uC2DC \uC0AC\uC2ED \uBD84. \uC77C\uC815\uD45C\uC758
        \uD560 \uC77C\uB4E4\uC774 \uD558\uB098\uD558\uB098 \uBAA8\uB450 \uC2DC\uAC04\uC744
        \uB118\uACBC\uB2E4."
    - language: 5
      text: "Seize heures quarante. Les t\xE2ches pr\xE9vues prenaient du retard,
        une \xE0 une."
    - language: 6
      text: "Sechzehn Uhr vierzig. Ein Punkt auf dem Tagesplan nach dem anderen wurde
        \xFCberf\xE4llig."
    - language: 7
      text: Las cuatro y cuarenta de la tarde. Las tareas del horario se van quedando
        atrasadas, una tras otra.
    - language: 8
      text: "Quatro e quarenta da tarde. As tarefas da programa\xE7\xE3o foram ficando
        para tr\xE1s, uma ap\xF3s a outra."
    - language: 9
      text: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0441\u043E\u0440\u043E\u043A
        \u0434\u043D\u044F. \u0412\u0440\u0435\u043C\u044F \u0432\u0441\u0435\u0445
        \u0434\u0435\u043B \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0438
        \u043F\u0440\u043E\u0448\u043B\u043E, \u043E\u0434\u043D\u043E \u0437\u0430
        \u0434\u0440\u0443\u0433\u0438\u043C."
  - key: os.memory.10370.text
    values:
    - language: 0
      text: "\u6C99\u53D1\u4E0A\u7684\u6BEF\u5B50\u644A\u5F00\u7740\uFF0C\u5C31\u50CF\u4E3B\u4EBA\u521A\u521A\u8FD8\u8EBA\u5728\u8FD9\u4E00\u6837.."
    - language: 1
      text: "\u6C99\u767C\u4E0A\u7684\u6BEF\u5B50\u6524\u958B\u8457\uFF0C\u5C31\u50CF\u4E3B\u4EBA\u525B\u525B\u9084\u8EBA\u5728\u9019\u4E00\u6A23.."
    - language: 2
      text: The blanket is spread out on the sofa, as if Master had been lying here
        just a moment ago..
    - language: 3
      text: "\u30BD\u30D5\u30A1\u306B\u306F\u6BDB\u5E03\u304C\u5E83\u3052\u3089\u308C\u305F\u307E\u307E\u3067\u3001\u307E\u308B\u3067\u3054\u4E3B\u4EBA\u304C\u3064\u3044\u3055\u3063\u304D\u307E\u3067\u3053\u3053\u306B\u6A2A\u306B\u306A\u3063\u3066\u3044\u305F\u307F\u305F\u3044\u3060.."
    - language: 4
      text: "\uC18C\uD30C \uC704\uC5D0 \uB2F4\uC694\uAC00 \uD3BC\uCCD0\uC838 \uC788\uB2E4.
        \uB9C8\uCE58 \uC8FC\uC778\uB2D8\uC774 \uBC29\uAE08 \uC804\uAE4C\uC9C0 \uC5EC\uAE30\uC5D0
        \uB204\uC6CC \uACC4\uC168\uB358 \uAC83 \uAC19\uB2E4.."
    - language: 5
      text: "La couverture est \xE9tal\xE9e sur le canap\xE9, comme si ma ma\xEEtresse
        y \xE9tait allong\xE9e il y a encore un instant.."
    - language: 6
      text: "Die Decke liegt ausgebreitet auf dem Sofa, als h\xE4tte meine Herrin
        gerade eben noch hier gelegen.."
    - language: 7
      text: "La manta est\xE1 extendida sobre el sof\xE1, como si mi ama hubiera
        estado tumbada aqu\xED hace apenas un momento.."
    - language: 8
      text: "A manta est\xE1 estendida no sof\xE1, como se minha dona estivesse deitada
        aqui at\xE9 um instante atr\xE1s.."
    - language: 9
      text: "\u041F\u043B\u0435\u0434 \u043D\u0430 \u0434\u0438\u0432\u0430\u043D\u0435
        \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D, \u0441\u043B\u043E\u0432\u043D\u043E
        \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043B\u0435\u0436\u0430\u043B\u0430.."
  - key: os.memory.10380.text
    values:
    - language: 0
      text: "\u5927\u706F\u4E00\u660E\u4E00\u6697\u7684\uFF0C\u4E3B\u4EBA\u4E4B\u524D\u5C31\u8BF4\u8981\u6362...\u540E\u9762\u4E00\u76F4\u6CA1\u63D0\u8FC7\uFF0C\u53EF\u80FD\u662F\u56E0\u4E3A\u5FD9\u4EC0\u4E48\u4E1C\u897F\u5FD8\u8BB0\u4E86\uFF1F"
    - language: 1
      text: "\u5927\u71C8\u4E00\u660E\u4E00\u6697\u7684\uFF0C\u4E3B\u4EBA\u4E4B\u524D\u5C31\u8AAA\u8981\u63DB...\u5F8C\u9762\u4E00\u76F4\u6C92\u63D0\u904E\uFF0C\u53EF\u80FD\u662F\u56E0\u70BA\u5FD9\u4EC0\u9EBC\u6771\u897F\u5FD8\u8A18\u4E86\uFF1F"
    - language: 2
      text: The ceiling light keeps brightening and dimming. Master said a while
        ago that it needed replacing... She has not mentioned it since. Maybe she
        got busy with something and forgot?
    - language: 3
      text: "\u5929\u4E95\u306E\u7167\u660E\u304C\u660E\u308B\u304F\u306A\u3063\u305F\u308A\u6697\u304F\u306A\u3063\u305F\u308A\u3057\u3066\u3044\u308B\u3002\u3054\u4E3B\u4EBA\u306F\u524D\u306B\u53D6\u308A\u66FF\u3048\u308B\u3068\u8A00\u3063\u3066\u3044\u305F\u3051\u308C\u3069...\u305D\u308C\u4EE5\u6765\u3001\u305D\u306E\u8A71\u306F\u3057\u3066\u3044\u306A\u3044\u3002\u4F55\u304B\u306B\u5FD9\u3057\u304F\u3066\u5FD8\u308C\u3066\u3057\u307E\u3063\u305F\u306E\u304B\u306A\uFF1F"
    - language: 4
      text: "\uCC9C\uC7A5 \uC870\uBA85\uC774 \uBC1D\uC544\uC84C\uB2E4 \uC5B4\uB450\uC6CC\uC84C\uB2E4
        \uD55C\uB2E4. \uC8FC\uC778\uB2D8\uC774 \uC804\uC5D0 \uBC14\uAFD4\uC57C\uACA0\uB2E4\uACE0
        \uD558\uC168\uB294\uB370...\uADF8 \uB4A4\uB85C\uB294 \uADF8 \uC774\uC57C\uAE30\uB97C
        \uD558\uC9C0 \uC54A\uC73C\uC168\uB2E4. \uBB54\uAC00\uC5D0 \uBC14\uBE60\uC11C
        \uC78A\uC73C\uC2E0 \uAC78\uAE4C?"
    - language: 5
      text: "Le plafonnier \xE9claire tant\xF4t fort, tant\xF4t faiblement. Ma ma\xEEtresse
        avait dit qu'il fallait le changer... Elle n'en a plus reparl\xE9 depuis.
        Peut-\xEAtre qu'elle a \xE9t\xE9 occup\xE9e par quelque chose et a oubli\xE9
        ?"
    - language: 6
      text: "Die Deckenlampe wird abwechselnd hell und dunkel. Meine Herrin hatte
        schon gesagt, dass man sie austauschen m\xFCsste... Seitdem hat sie es nicht
        mehr erw\xE4hnt. Vielleicht war sie mit irgendetwas besch\xE4ftigt und hat
        es vergessen?"
    - language: 7
      text: "La luz del techo se aviva y se aten\xFAa. Mi ama ya hab\xEDa dicho que
        hab\xEDa que cambiarla... Desde entonces no ha vuelto a mencionarlo. \xBFSer\xE1
        que estaba ocupada con algo y se le olvid\xF3?"
    - language: 8
      text: "A luz do teto fica clareando e escurecendo. Minha dona j\xE1 tinha dito
        que precisava troc\xE1-la... Depois n\xE3o falou mais nisso. Ser\xE1 que
        ficou ocupada com alguma coisa e esqueceu?"
    - language: 9
      text: "\u041F\u043E\u0442\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u043B\u0430\u043C\u043F\u0430
        \u0442\u043E \u0441\u0432\u0435\u0442\u0438\u0442 \u044F\u0440\u0447\u0435,
        \u0442\u043E \u0442\u0443\u0441\u043A\u043D\u0435\u0435\u0442. \u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0440\u0430\u043D\u044C\u0448\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
        \u0447\u0442\u043E \u0435\u0451 \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C...
        \u041F\u043E\u0442\u043E\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0431
        \u044D\u0442\u043E\u043C \u043D\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0430.
        \u041C\u043E\u0436\u0435\u0442, \u0431\u044B\u043B\u0430 \u0447\u0435\u043C-\u0442\u043E
        \u0437\u0430\u043D\u044F\u0442\u0430 \u0438 \u0437\u0430\u0431\u044B\u043B\u0430?"
  - key: os.memory.10390.text
    values:
    - language: 0
      text: "\u76F8\u6846\u91CC\u662F\u4E3B\u4EBA\u7684\u4E08\u592B\uFF0C\u76F8\u6846\u64E6\u5F97\u5F88\u4EAE\uFF0C\u4E00\u70B9\u7070\u90FD\u6CA1\u6709\uFF0C\u4ECE\u6211\u6765\u5BB6\u91CC\u7684\u65F6\u5019\u4E3B\u4EBA\u5C31\u4E00\u76F4\u5E26\u7740\u5B83...."
    - language: 1
      text: "\u76F8\u6846\u88E1\u662F\u4E3B\u4EBA\u7684\u4E08\u592B\uFF0C\u76F8\u6846\u64E6\u5F97\u5F88\u4EAE\uFF0C\u4E00\u9EDE\u7070\u90FD\u6C92\u6709\uFF0C\u5F9E\u6211\u4F86\u5BB6\u88E1\u7684\u6642\u5019\u4E3B\u4EBA\u5C31\u4E00\u76F4\u5E36\u8457\u5B83...."
    - language: 2
      text: The photograph was of Master's husband. The frame had been polished until
        it shone, without a speck of dust. Master had always kept it with her, ever
        since I came to this home....
    - language: 3
      text: "\u5199\u771F\u7ACB\u3066\u306E\u4E2D\u306B\u3044\u308B\u306E\u306F\u3001\u3054\u4E3B\u4EBA\u306E\u592B\u3060\u3002\u3074\u304B\u3074\u304B\u306B\u62ED\u3044\u3066\u3042\u3063\u3066\u3001\u307B\u3053\u308A\u4E00\u3064\u306A\u3044\u3002\u79C1\u304C\u3053\u306E\u5BB6\u306B\u6765\u305F\u3068\u304D\u304B\u3089\u3001\u3054\u4E3B\u4EBA\u306F\u305A\u3063\u3068\u6301\u3063\u3066\u3044\u305F...."
    - language: 4
      text: "\uC561\uC790 \uC18D \uC0AC\uB78C\uC740 \uC8FC\uC778\uB2D8\uC758 \uB0A8\uD3B8\uC774\uB2E4.
        \uC561\uC790\uB294 \uBC18\uC9DD\uBC18\uC9DD \uB2E6\uC5EC\uC11C \uBA3C\uC9C0
        \uD55C \uD1A8 \uC5C6\uB2E4. \uB0B4\uAC00 \uC774 \uC9D1\uC5D0 \uC654\uC744
        \uB54C\uBD80\uD130 \uC8FC\uC778\uB2D8\uC740 \uC904\uACE7 \uC774\uAC78 \uAC00\uC9C0\uACE0
        \uACC4\uC168\uB2E4...."
    - language: 5
      text: "La photo repr\xE9sentait le mari de ma ma\xEEtresse. Le cadre brillait,
        sans un grain de poussi\xE8re. Ma ma\xEEtresse le gardait toujours avec elle,
        depuis mon arriv\xE9e dans cette maison...."
    - language: 6
      text: "Das Foto zeigte den Mann meiner Herrin. Der Rahmen gl\xE4nzte, kein
        Staubkorn war darauf. Seit ich hier wohnte, hatte meine Herrin ihn immer
        bei sich gehabt...."
    - language: 7
      text: "El hombre de la foto es el marido de mi ama. El marco est\xE1 reluciente,
        sin una mota de polvo. Ella lo lleva consigo desde antes de que yo llegara
        a casa...."
    - language: 8
      text: "O homem na foto \xE9 o marido da minha dona. A moldura est\xE1 brilhando,
        sem um gr\xE3o de poeira. Ela a carrega consigo desde quando eu cheguei em
        casa...."
    - language: 9
      text: "\u0412 \u0440\u0430\u043C\u043A\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F
        \u043C\u0443\u0436\u0430 \u0445\u043E\u0437\u044F\u0439\u043A\u0438. \u0420\u0430\u043C\u043A\u0430
        \u0432\u044B\u0442\u0435\u0440\u0442\u0430 \u0434\u043E \u0431\u043B\u0435\u0441\u043A\u0430,
        \u043D\u0438 \u043F\u044B\u043B\u0438\u043D\u043A\u0438. \u041E\u043D\u0430
        \u0445\u0440\u0430\u043D\u0438\u0442 \u0435\u0451 \u0441 \u0442\u0435\u0445
        \u043F\u043E\u0440, \u043A\u0430\u043A \u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
        \u0432 \u044D\u0442\u043E\u043C \u0434\u043E\u043C\u0435...."
  - key: os.memory.10400.text
    values:
    - language: 0
      text: "\u8336\u51E0\u4E0A\u644A\u7740\u4E00\u9875\u7EB8\uFF0C\u662F\u4ECE\u4E3B\u4EBA\u7684\u65E5\u8BB0\u672C\u91CC\u6389\u51FA\u6765\u7684\u3002"
    - language: 1
      text: "\u8336\u51E0\u4E0A\u6524\u8457\u4E00\u9801\u7D19\uFF0C\u662F\u5F9E\u4E3B\u4EBA\u7684\u65E5\u8A18\u672C\u88E1\u6389\u51FA\u4F86\u7684\u3002"
    - language: 2
      text: A sheet of paper lay on the coffee table. It had fallen out of Master's
        diary.
    - language: 3
      text: "\u30ED\u30FC\u30C6\u30FC\u30D6\u30EB\u306B\u7D19\u304C\u4E00\u679A\u5E83\u304C\u3063\u3066\u3044\u308B\u3002\u3054\u4E3B\u4EBA\u306E\u65E5\u8A18\u5E33\u304B\u3089\u629C\u3051\u843D\u3061\u305F\u30DA\u30FC\u30B8\u3060\u3002"
    - language: 4
      text: "\uC18C\uD30C \uC55E \uD0C1\uC790\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774
        \uD3BC\uCCD0\uC838 \uC788\uB2E4. \uC8FC\uC778\uB2D8\uC758 \uC77C\uAE30\uC7A5\uC5D0\uC11C
        \uBE60\uC9C4 \uD398\uC774\uC9C0\uB2E4."
    - language: 5
      text: "Une feuille \xE9tait \xE9tal\xE9e sur la table basse. Elle \xE9tait
        tomb\xE9e du journal de ma ma\xEEtresse."
    - language: 6
      text: Auf dem Couchtisch lag ein Blatt Papier. Es war aus dem Tagebuch meiner
        Herrin gefallen.
    - language: 7
      text: En la mesita hay una hoja que se ha soltado del diario de mi ama.
    - language: 8
      text: "Tem uma folha sobre a mesinha. Ela se soltou do di\xE1rio da minha dona."
    - language: 9
      text: "\u041D\u0430 \u0436\u0443\u0440\u043D\u0430\u043B\u044C\u043D\u043E\u043C
        \u0441\u0442\u043E\u043B\u0438\u043A\u0435 \u043B\u0435\u0436\u0438\u0442
        \u043B\u0438\u0441\u0442, \u0432\u044B\u043F\u0430\u0432\u0448\u0438\u0439
        \u0438\u0437 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430 \u0445\u043E\u0437\u044F\u0439\u043A\u0438."
  - key: os.memory.10410.text
    values:
    - language: 0
      text: "\u7535\u8BDD\u673A\u4E0A\u7684\u706F\u5728\u95EA...\u6211\u62FF\u8D77\u542C\u7B52\uFF0C\u91CC\u9762\u53EA\u6709\u6C99\u6C99\u58F0\uFF0C\u4E0B\u96E8\u5929\u7EBF\u8DEF\u4E00\u76F4\u4E0D\u597D\u3002"
    - language: 1
      text: "\u96FB\u8A71\u6A5F\u4E0A\u7684\u71C8\u5728\u9583...\u6211\u62FF\u8D77\u807D\u7B52\uFF0C\u88E1\u9762\u53EA\u6709\u6C99\u6C99\u8072\uFF0C\u4E0B\u96E8\u5929\u7DDA\u8DEF\u4E00\u76F4\u4E0D\u597D\u3002"
    - language: 2
      text: The light on the telephone was blinking... I picked up the receiver.
        There was only static. The line was always bad when it rained.
    - language: 3
      text: "\u96FB\u8A71\u306E\u30E9\u30F3\u30D7\u304C\u70B9\u6EC5\u3057\u3066\u3044\u308B...\u53D7\u8A71\u5668\u3092\u53D6\u3063\u3066\u3082\u3001\u3056\u3042\u3056\u3042\u3068\u3044\u3046\u97F3\u3057\u304B\u3057\u306A\u304B\u3063\u305F\u3002\u96E8\u306E\u65E5\u306F\u3044\u3064\u3082\u56DE\u7DDA\u306E\u8ABF\u5B50\u304C\u60AA\u3044\u3002"
    - language: 4
      text: "\uC804\uD654\uAE30\uC758 \uBD88\uBE5B\uC774 \uAE5C\uBE61\uC778\uB2E4...\uC218\uD654\uAE30\uB97C
        \uB4E4\uC5C8\uC9C0\uB9CC \uC9C0\uC9C1\uAC70\uB9AC\uB294 \uC18C\uB9AC\uBFD0\uC774\uC5C8\uB2E4.
        \uBE44 \uC624\uB294 \uB0A0\uC5D0\uB294 \uB298 \uC804\uD654\uC120 \uC0C1\uD0DC\uAC00
        \uC88B\uC9C0 \uC54A\uB2E4."
    - language: 5
      text: "Le voyant du t\xE9l\xE9phone clignotait... J'ai d\xE9croch\xE9. Il n'y
        avait que des gr\xE9sillements. La ligne fonctionnait toujours mal quand
        il pleuvait."
    - language: 6
      text: "Das Licht am Telefon blinkte... Ich nahm den H\xF6rer ab. Nur Rauschen.
        Bei Regen war die Leitung immer schlecht."
    - language: 7
      text: "La luz del tel\xE9fono parpadea... Levanto el auricular, pero solo oigo
        est\xE1tica. La l\xEDnea siempre falla cuando llueve."
    - language: 8
      text: "A luz do telefone est\xE1 piscando... Tiro o fone do gancho, mas s\xF3
        ou\xE7o chiado. A linha sempre fica ruim quando chove."
    - language: 9
      text: "\u041D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435 \u043C\u0438\u0433\u0430\u0435\u0442
        \u043B\u0430\u043C\u043F\u043E\u0447\u043A\u0430...\u042F \u043F\u043E\u0434\u043D\u044F\u043B\u0430
        \u0442\u0440\u0443\u0431\u043A\u0443, \u043D\u043E \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430
        \u0442\u043E\u043B\u044C\u043A\u043E \u0448\u043E\u0440\u043E\u0445. \u0412
        \u0434\u043E\u0436\u0434\u043B\u0438\u0432\u044B\u0435 \u0434\u043D\u0438
        \u0441\u0432\u044F\u0437\u044C \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043B\u043E\u0445\u0430\u044F."
  - key: os.memory.10420.text
    values:
    - language: 0
      text: "\u5927\u95E8\u9501\u4E0A\u7684\uFF0C\u4E3B\u4EBA\u770B\u8D77\u6765\u6CA1\u51FA\u95E8.."
    - language: 1
      text: "\u5927\u9580\u9396\u4E0A\u7684\uFF0C\u4E3B\u4EBA\u770B\u8D77\u4F86\u6C92\u51FA\u9580.."
    - language: 2
      text: The front door was locked. It did not look as though Master had gone
        out..
    - language: 3
      text: "\u7384\u95A2\u306B\u306F\u9375\u304C\u304B\u304B\u3063\u3066\u3044\u308B\u3002\u3054\u4E3B\u4EBA\u306F\u51FA\u304B\u3051\u3066\u3044\u306A\u3044\u3088\u3046\u3060.."
    - language: 4
      text: "\uD604\uAD00\uBB38\uC740 \uC7A0\uACA8 \uC788\uB2E4. \uC8FC\uC778\uB2D8\uC740
        \uB098\uAC00\uC9C0 \uC54A\uC73C\uC2E0 \uAC83 \uAC19\uB2E4.."
    - language: 5
      text: "La porte d'entr\xE9e \xE9tait verrouill\xE9e. Ma ma\xEEtresse ne semblait
        pas \xEAtre sortie.."
    - language: 6
      text: "Die Haust\xFCr war abgeschlossen. Meine Herrin schien nicht ausgegangen
        zu sein.."
    - language: 7
      text: "La puerta de entrada est\xE1 cerrada con llave. Parece que mi ama no
        ha salido.."
    - language: 8
      text: "A porta da frente est\xE1 trancada. Parece que minha dona n\xE3o saiu.."
    - language: 9
      text: "\u0412\u0445\u043E\u0434\u043D\u0430\u044F \u0434\u0432\u0435\u0440\u044C
        \u0437\u0430\u043F\u0435\u0440\u0442\u0430. \u041F\u043E\u0445\u043E\u0436\u0435,
        \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u043D\u0435 \u0443\u0445\u043E\u0434\u0438\u043B\u0430.."
  - key: os.memory.10430.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u7684\u5916\u5957\u6302\u5728\u94A9\u5B50\u4E0A\uFF0C\u53E3\u888B\u91CC\u8FD8\u88C5\u7740\u5979\u51FA\u95E8\u8981\u7528\u7684\u836F\u76D2\uFF0C\u7A7A\u7684\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u7684\u5916\u5957\u639B\u5728\u9264\u5B50\u4E0A\uFF0C\u53E3\u888B\u88E1\u9084\u88DD\u8457\u5979\u51FA\u9580\u8981\u7528\u7684\u85E5\u76D2\uFF0C\u7A7A\u7684\u3002"
    - language: 2
      text: Master's coat was on the hook. Her pillbox was still in its pocket, ready
        for going out. It was empty.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u4E0A\u7740\u304C\u30D5\u30C3\u30AF\u306B\u639B\u304B\u3063\u3066\u3044\u308B\u3002\u5916\u51FA\u7528\u306E\u85AC\u5165\u308C\u3082\u3001\u30DD\u30B1\u30C3\u30C8\u306B\u5165\u3063\u305F\u307E\u307E\u3060\u3002\u7A7A\u3063\u307D\u3060\u3063\u305F\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uC678\uD22C\uAC00 \uAC78\uB824 \uC788\uB2E4.
        \uC678\uCD9C\uD560 \uB54C \uC4F0\uB294 \uC57D\uD1B5\uB3C4 \uC8FC\uBA38\uB2C8\uC5D0
        \uADF8\uB300\uB85C \uC788\uB2E4. \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    - language: 5
      text: "Le manteau de ma ma\xEEtresse \xE9tait au crochet. Dans la poche, il
        y avait encore le pilulier qu'elle emportait pour sortir. Vide."
    - language: 6
      text: "Der Mantel meiner Herrin hing am Haken. In der Tasche steckte noch ihre
        Pillendose f\xFCr unterwegs. Leer."
    - language: 7
      text: "El abrigo de mi ama cuelga del gancho. En el bolsillo sigue el pastillero
        que lleva al salir. Est\xE1 vac\xEDo."
    - language: 8
      text: "O casaco da minha dona est\xE1 no gancho. No bolso est\xE1 o porta-comprimidos
        que ela leva quando sai. Vazio."
    - language: 9
      text: "\u041A\u0443\u0440\u0442\u043A\u0430 \u0445\u043E\u0437\u044F\u0439\u043A\u0438
        \u0432\u0438\u0441\u0438\u0442 \u043D\u0430 \u043A\u0440\u044E\u0447\u043A\u0435.
        \u0412 \u043A\u0430\u0440\u043C\u0430\u043D\u0435 \u0432\u0441\u0451 \u0435\u0449\u0451
        \u043B\u0435\u0436\u0438\u0442 \u043A\u043E\u0440\u043E\u0431\u043E\u0447\u043A\u0430
        \u0441 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430\u043C\u0438,
        \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043E\u043D\u0430 \u0431\u0435\u0440\u0451\u0442
        \u0441 \u0441\u043E\u0431\u043E\u0439. \u041F\u0443\u0441\u0442\u0430\u044F."
  - key: os.memory.10440.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u7684\u978B\u6574\u6574\u9F50\u9F50\u5730\u6446\u7740\uFF0C\u978B\u5E95\u662F\u5E72\u7684\uFF0C\u4E0A\u9762\u7684\u6CE5\u5DF2\u7ECF\u88C2\u5F00\u4E86...\u8FD9\u51E0\u5929\u5979\u5E94\u8BE5\u90FD\u6CA1\u51FA\u95E8\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u7684\u978B\u6574\u6574\u9F4A\u9F4A\u5730\u64FA\u8457\uFF0C\u978B\u5E95\u662F\u4E7E\u7684\uFF0C\u4E0A\u9762\u7684\u6CE5\u5DF2\u7D93\u88C2\u958B\u4E86...\u9019\u5E7E\u5929\u5979\u61C9\u8A72\u90FD\u6C92\u51FA\u9580\u3002"
    - language: 2
      text: Master's shoes were neatly lined up. The soles were dry, the mud on them
        already cracked... She probably had not gone out for days.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u9774\u304C\u304D\u308C\u3044\u306B\u4E26\u3093\u3067\u3044\u308B\u3002\u9774\u5E95\u306F\u4E7E\u3044\u3066\u3044\u3066\u3001\u3064\u3044\u305F\u6CE5\u3082\u3072\u3073\u5272\u308C\u3066\u3044\u305F...\u3053\u306E\u6570\u65E5\u306F\u51FA\u304B\u3051\u3066\u3044\u306A\u3044\u306E\u3060\u308D\u3046\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uC2E0\uBC1C\uC774 \uAC00\uC9C0\uB7F0\uD788
        \uB193\uC5EC \uC788\uB2E4. \uBC11\uCC3D\uC740 \uB9D0\uB77C \uC788\uACE0 \uBB3B\uC740
        \uC9C4\uD759\uB3C4 \uAC08\uB77C\uC838 \uC788\uB2E4...\uBA70\uCE60 \uB3D9\uC548\uC740
        \uB098\uAC00\uC9C0 \uC54A\uC73C\uC2E0 \uAC83 \uAC19\uB2E4."
    - language: 5
      text: "Les chaussures de ma ma\xEEtresse \xE9taient bien rang\xE9es. Les semelles
        \xE9taient s\xE8ches, la boue d\xE9j\xE0 craquel\xE9e... Elle n'avait probablement
        pas quitt\xE9 la maison depuis plusieurs jours."
    - language: 6
      text: Die Schuhe meiner Herrin standen ordentlich nebeneinander. Die Sohlen
        waren trocken, der Schlamm darauf schon rissig... Vermutlich war sie seit
        Tagen nicht ausgegangen.
    - language: 7
      text: "Los zapatos de mi ama est\xE1n bien colocados. Las suelas est\xE1n secas
        y el barro se ha agrietado... Seguramente lleva d\xEDas sin salir."
    - language: 8
      text: "Os sapatos da minha dona est\xE3o arrumados. As solas est\xE3o secas,
        e a lama j\xE1 rachou... Ela n\xE3o deve ter sa\xEDdo nestes \xFAltimos dias."
    - language: 9
      text: "\u041E\u0431\u0443\u0432\u044C \u0445\u043E\u0437\u044F\u0439\u043A\u0438
        \u0441\u0442\u043E\u0438\u0442 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u044B\u043C
        \u0440\u044F\u0434\u043A\u043E\u043C. \u041F\u043E\u0434\u043E\u0448\u0432\u044B
        \u0441\u0443\u0445\u0438\u0435, \u0433\u0440\u044F\u0437\u044C \u043D\u0430
        \u043D\u0438\u0445 \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u043B\u0430\u0441\u044C...\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0434\u043D\u0435\u0439 \u043E\u043D\u0430 \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0430."
  - key: os.memory.10450.text
    values:
    - language: 0
      text: "\u4F1E\u4E5F\u5728...\u5916\u9762\u8FD9\u4E48\u5927\u7684\u96E8\uFF0C\u5979\u4E0D\u53EF\u80FD\u4E0D\u5E26\u4F1E\u51FA\u95E8\u3002"
    - language: 1
      text: "\u5098\u4E5F\u5728...\u5916\u9762\u9019\u9EBC\u5927\u7684\u96E8\uFF0C\u5979\u4E0D\u53EF\u80FD\u4E0D\u5E36\u5098\u51FA\u9580\u3002"
    - language: 2
      text: The umbrella was here too... In rain this heavy, she could not have gone
        out without it.
    - language: 3
      text: "\u5098\u3082\u3042\u308B...\u5916\u306F\u3053\u3093\u306A\u5927\u96E8\u3060\u3002\u5098\u3092\u6301\u305F\u305A\u306B\u51FA\u304B\u3051\u308B\u306F\u305A\u304C\u306A\u3044\u3002"
    - language: 4
      text: "\uC6B0\uC0B0\uB3C4 \uC788\uB2E4...\uBC16\uC5D0\uB294 \uC774\uB807\uAC8C
        \uBE44\uAC00 \uB9CE\uC774 \uC624\uB294\uB370, \uC6B0\uC0B0\uB3C4 \uC5C6\uC774
        \uB098\uAC00\uC168\uC744 \uB9AC \uC5C6\uB2E4."
    - language: 5
      text: "Le parapluie \xE9tait l\xE0 aussi... Avec toute cette pluie, elle ne
        pouvait pas \xEAtre sortie sans lui."
    - language: 6
      text: "Der Schirm war auch hier... Bei diesem starken Regen w\xE4re sie nicht
        ohne ihn ausgegangen."
    - language: 7
      text: "El paraguas tambi\xE9n est\xE1 aqu\xED... Con la lluvia que cae, no
        habr\xEDa salido sin \xE9l."
    - language: 8
      text: "O guarda-chuva tamb\xE9m est\xE1 aqui... Com tanta chuva, ela n\xE3o
        sairia sem ele."
    - language: 9
      text: "\u0417\u043E\u043D\u0442 \u0442\u043E\u0436\u0435 \u0437\u0434\u0435\u0441\u044C...\u0412
        \u0442\u0430\u043A\u043E\u0439 \u043B\u0438\u0432\u0435\u043D\u044C \u043E\u043D\u0430
        \u0431\u044B \u043D\u0435 \u0432\u044B\u0448\u043B\u0430 \u0431\u0435\u0437
        \u0437\u043E\u043D\u0442\u0430."
  - key: os.memory.10460.text
    values:
    - language: 0
      text: "\u5916\u9762\u4E4C\u538B\u538B\u7684\uFF0C\u6700\u8FD1\u4E00\u76F4\u5728\u4E0B\u96E8.."
    - language: 1
      text: "\u5916\u9762\u70CF\u58D3\u58D3\u7684\uFF0C\u6700\u8FD1\u4E00\u76F4\u5728\u4E0B\u96E8.."
    - language: 2
      text: It was dark and overcast outside. It had been raining for days..
    - language: 3
      text: "\u5916\u306F\u3069\u3093\u3088\u308A\u6697\u3044\u3002\u3053\u306E\u3068\u3053\u308D\u3001\u305A\u3063\u3068\u96E8\u304C\u964D\u3063\u3066\u3044\u308B.."
    - language: 4
      text: "\uBC16\uC740 \uC794\uB729 \uD750\uB9AC\uB2E4. \uC694\uC998 \uACC4\uC18D
        \uBE44\uAC00 \uB0B4\uB9B0\uB2E4.."
    - language: 5
      text: "Dehors, le ciel \xE9tait sombre et couvert. Il pleuvait depuis des jours.."
    - language: 6
      text: "Drau\xDFen war es dunkel und bew\xF6lkt. Es regnete seit Tagen.."
    - language: 7
      text: "Fuera est\xE1 muy oscuro. \xDAltimamente no deja de llover.."
    - language: 8
      text: "L\xE1 fora est\xE1 tudo escuro. N\xE3o para de chover ultimamente.."
    - language: 9
      text: "\u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u0442\u0435\u043C\u043D\u043E
        \u0438 \u0445\u043C\u0443\u0440\u043E. \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
        \u0432\u0440\u0435\u043C\u044F \u0434\u043E\u0436\u0434\u044C \u043D\u0435
        \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.."
  - key: os.memory.10470.text
    values:
    - language: 0
      text: "\u5916\u5957\u5728\uFF0C\u978B\u5728\uFF0C\u4F1E\u4E5F\u5728\u3002\u4E3B\u4EBA\u6CA1\u6709\u51FA\u95E8...\u90A3\u5979\u8FD8\u5728\u5367\u5BA4\u91CC\u3002"
    - language: 1
      text: "\u5916\u5957\u5728\uFF0C\u978B\u5728\uFF0C\u5098\u4E5F\u5728\u3002\u4E3B\u4EBA\u6C92\u6709\u51FA\u9580...\u90A3\u5979\u9084\u5728\u81E5\u5BA4\u88E1\u3002"
    - language: 2
      text: Her coat was here, her shoes were here, and so was her umbrella. Master
        had not gone out... Then she was still in her bedroom.
    - language: 3
      text: "\u4E0A\u7740\u3082\u3042\u308B\u3002\u9774\u3082\u3001\u5098\u3082\u3042\u308B\u3002\u3054\u4E3B\u4EBA\u306F\u51FA\u304B\u3051\u3066\u3044\u306A\u3044...\u305D\u308C\u306A\u3089\u3001\u307E\u3060\u5BDD\u5BA4\u306B\u3044\u308B\u3002"
    - language: 4
      text: "\uC678\uD22C\uB3C4, \uC2E0\uBC1C\uB3C4, \uC6B0\uC0B0\uB3C4 \uC788\uB2E4.
        \uC8FC\uC778\uB2D8\uC740 \uB098\uAC00\uC9C0 \uC54A\uC73C\uC168\uB2E4...\uADF8\uB807\uB2E4\uBA74
        \uC544\uC9C1 \uCE68\uC2E4\uC5D0 \uACC4\uC2E0\uB2E4."
    - language: 5
      text: "Son manteau \xE9tait l\xE0, ses chaussures aussi, et son parapluie.
        Ma ma\xEEtresse n'\xE9tait pas sortie... Elle \xE9tait donc encore dans sa
        chambre."
    - language: 6
      text: Der Mantel war hier, die Schuhe waren hier, und der Schirm auch. Meine
        Herrin war nicht ausgegangen... Dann war sie noch im Schlafzimmer.
    - language: 7
      text: "El abrigo est\xE1 aqu\xED, los zapatos tambi\xE9n, y el paraguas. Mi
        ama no ha salido... Entonces sigue en su dormitorio."
    - language: 8
      text: "O casaco est\xE1 aqui, os sapatos tamb\xE9m, e o guarda-chuva. Minha
        dona n\xE3o saiu... Ent\xE3o ainda est\xE1 no quarto."
    - language: 9
      text: "\u041A\u0443\u0440\u0442\u043A\u0430 \u0437\u0434\u0435\u0441\u044C,
        \u043E\u0431\u0443\u0432\u044C \u0437\u0434\u0435\u0441\u044C, \u0437\u043E\u043D\u0442
        \u0442\u043E\u0436\u0435. \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043D\u0435
        \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0430...\u0417\u043D\u0430\u0447\u0438\u0442,
        \u043E\u043D\u0430 \u0435\u0449\u0451 \u0432 \u0441\u043F\u0430\u043B\u044C\u043D\u0435."
  - key: os.memory.10480.text
    values:
    - language: 0
      text: "\u8D8A\u5F80\u8FD9\u8FB9\u8D70\u8D8A\u51B7\uFF0C\u5C3D\u5934\u90A3\u6247\u95E8\u7684\u95E8\u7F1D\u91CC\u900F\u51FA\u4E00\u70B9\u767D\u5149\u3002"
    - language: 1
      text: "\u8D8A\u5F80\u9019\u908A\u8D70\u8D8A\u51B7\uFF0C\u76E1\u982D\u90A3\u6247\u9580\u7684\u9580\u7E2B\u88E1\u900F\u51FA\u4E00\u9EDE\u767D\u5149\u3002"
    - language: 2
      text: It grew colder in this direction. A little white light came through the
        gap beneath the door at the far end.
    - language: 3
      text: "\u3053\u3061\u3089\u3078\u9032\u3080\u307B\u3069\u5BD2\u304F\u306A\u308B\u3002\u7A81\u304D\u5F53\u305F\u308A\u306E\u30C9\u30A2\u306E\u9699\u9593\u304B\u3089\u3001\u767D\u3044\u5149\u304C\u5C11\u3057\u6F0F\u308C\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uC774\uCABD\uC73C\uB85C \uAC78\uC744\uC218\uB85D \uB354 \uCDA5\uB2E4.
        \uB05D\uC5D0 \uC788\uB294 \uBB38\uD2C8\uC73C\uB85C \uD558\uC580 \uBE5B\uC774
        \uC870\uAE08 \uC0C8\uC5B4 \uB098\uC628\uB2E4."
    - language: 5
      text: "Plus j'avan\xE7ais de ce c\xF4t\xE9, plus il faisait froid. Un peu de
        lumi\xE8re blanche passait sous la porte du fond."
    - language: 6
      text: "In dieser Richtung wurde es immer k\xE4lter. Durch den Spalt unter der
        T\xFCr am Ende fiel etwas wei\xDFes Licht."
    - language: 7
      text: "Cuanto m\xE1s avanzo por aqu\xED, m\xE1s fr\xEDo hace. Por la rendija
        de la puerta del fondo sale una luz blanca."
    - language: 8
      text: Quanto mais ando para este lado, mais frio fica. Uma luz branca sai pela
        fresta da porta no fim do corredor.
    - language: 9
      text: "\u0427\u0435\u043C \u0434\u0430\u043B\u044C\u0448\u0435 \u044F \u0438\u0434\u0443
        \u0432 \u044D\u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u0442\u0435\u043C
        \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435. \u0418\u0437 \u0449\u0435\u043B\u0438
        \u043F\u043E\u0434 \u0434\u0432\u0435\u0440\u044C\u044E \u0432 \u043A\u043E\u043D\u0446\u0435
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u0431\u0435\u043B\u044B\u0439 \u0441\u0432\u0435\u0442."
  - key: os.memory.10490.text
    values:
    - language: 0
      text: "\u8FD9\u662F\u4E3B\u4EBA\u7684\u5B9E\u9A8C\u5BA4\u3002\u95E8\u8FB9\u6709\u4E00\u5757\u56DB\u4F4D\u6570\u7684\u5BC6\u7801\u9762\u677F...\u4E3B\u4EBA\u4ECE\u6765\u6CA1\u6709\u544A\u8BC9\u8FC7\u6211\u5BC6\u7801\uFF0C\u5979\u8BF4\u90A3\u91CC\u9762\u7684\u4E1C\u897F\u78B0\u574F\u4E00\u6837\uFF0C\u591F\u6211\u4EEC\u4FE9\u5403\u4E00\u5E74\u3002\u6211\u4ECE\u6765\u6CA1\u6709\u8FDB\u53BB\u8FC7\u3002"
    - language: 1
      text: "\u9019\u662F\u4E3B\u4EBA\u7684\u5BE6\u9A57\u5BA4\u3002\u9580\u908A\u6709\u4E00\u584A\u56DB\u4F4D\u6578\u7684\u5BC6\u78BC\u9762\u677F...\u4E3B\u4EBA\u5F9E\u4F86\u6C92\u6709\u544A\u8A34\u904E\u6211\u5BC6\u78BC\uFF0C\u5979\u8AAA\u90A3\u88E1\u9762\u7684\u6771\u897F\u78B0\u58DE\u4E00\u6A23\uFF0C\u5920\u6211\u5011\u5006\u5403\u4E00\u5E74\u3002\u6211\u5F9E\u4F86\u6C92\u6709\u9032\u53BB\u904E\u3002"
    - language: 2
      text: This was Master's laboratory. A four-digit keypad was beside the door...
        Master had never told me the code. She said breaking just one thing in there
        would cost enough to feed us both for a year. I had never been inside.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u5B9F\u9A13\u5BA4\u3060\u3002\u30C9\u30A2\u306E\u8107\u306B\u56DB\u6841\u306E\u6697\u8A3C\u756A\u53F7\u30D1\u30CD\u30EB\u304C\u3042\u308B...\u3054\u4E3B\u4EBA\u306F\u4E00\u5EA6\u3082\u756A\u53F7\u3092\u6559\u3048\u3066\u304F\u308C\u306A\u304B\u3063\u305F\u3002\u4E2D\u306E\u7269\u3092\u4E00\u3064\u58CA\u3057\u305F\u3060\u3051\u3067\u3001\u79C1\u305F\u3061\u4E8C\u4EBA\u306E\u4E00\u5E74\u5206\u306E\u98DF\u8CBB\u304C\u98DB\u3076\u3068\u8A00\u3063\u3066\u3044\u305F\u3002\u79C1\u306F\u4E00\u5EA6\u3082\u5165\u3063\u305F\u3053\u3068\u304C\u306A\u3044\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uC2E4\uD5D8\uC2E4\uC774\uB2E4. \uBB38 \uC606\uC5D0\uB294
        \uB124 \uC790\uB9AC \uBE44\uBC00\uBC88\uD638 \uD328\uB110\uC774 \uC788\uB2E4...\uC8FC\uC778\uB2D8\uC740
        \uD55C \uBC88\uB3C4 \uBE44\uBC00\uBC88\uD638\uB97C \uC54C\uB824 \uC8FC\uC9C0
        \uC54A\uC73C\uC168\uB2E4. \uC548\uC5D0 \uC788\uB294 \uBB3C\uAC74\uC744 \uD558\uB098\uB9CC
        \uB9DD\uAC00\uB728\uB824\uB3C4 \uC6B0\uB9AC \uB458\uC758 \uC77C \uB144 \uCE58
        \uC2DD\uBE44\uAC00 \uB0A0\uC544\uAC04\uB2E4\uACE0 \uD558\uC168\uB2E4. \uB098\uB294
        \uD55C \uBC88\uB3C4 \uB4E4\uC5B4\uAC00 \uBCF8 \uC801\uC774 \uC5C6\uB2E4."
    - language: 5
      text: "C'\xE9tait le laboratoire de ma ma\xEEtresse. Un clavier \xE0 quatre
        chiffres se trouvait pr\xE8s de la porte... Elle ne m'avait jamais donn\xE9
        le code. Selon elle, casser un seul objet l\xE0-dedans nous co\xFBterait
        une ann\xE9e de nourriture \xE0 toutes les deux. Je n'y \xE9tais jamais entr\xE9e."
    - language: 6
      text: "Das war das Labor meiner Herrin. Neben der T\xFCr hing ein Zahlenfeld
        f\xFCr einen vierstelligen Code... Meine Herrin hatte mir den Code nie gesagt.
        Wenn dort auch nur eine Sache kaputtging, w\xFCrde das so viel kosten wie
        ein Jahr Essen f\xFCr uns beide. Ich war noch nie drinnen gewesen."
    - language: 7
      text: "Este es el laboratorio de mi ama. Junto a la puerta hay un teclado para
        una contrase\xF1a de cuatro cifras... Nunca me ha dicho la contrase\xF1a.
        Dice que cualquiera de las cosas de ah\xED dentro vale tanto como un a\xF1o
        de comida para las dos. Nunca he entrado."
    - language: 8
      text: "Este \xE9 o laborat\xF3rio da minha dona. Ao lado da porta tem um painel
        para uma senha de quatro d\xEDgitos... Ela nunca me contou a senha. Diz que
        qualquer coisa l\xE1 dentro vale um ano de comida para n\xF3s duas. Nunca
        entrei."
    - language: 9
      text: "\u042D\u0442\u043E \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F
        \u0445\u043E\u0437\u044F\u0439\u043A\u0438. \u0423 \u0434\u0432\u0435\u0440\u0438
        \u043F\u0430\u043D\u0435\u043B\u044C \u0434\u043B\u044F \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u0437\u043D\u0430\u0447\u043D\u043E\u0433\u043E
        \u043A\u043E\u0434\u0430...\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u043C\u043D\u0435 \u0435\u0433\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430.
        \u041E\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430: \u0441\u043B\u043E\u043C\u0430\u0435\u0448\u044C
        \u0442\u0430\u043C \u0445\u043E\u0442\u044C \u043E\u0434\u043D\u0443 \u0432\u0435\u0449\u044C
        \u2014 \u043D\u0430\u043C \u043E\u0431\u0435\u0438\u043C \u0433\u043E\u0434
        \u0431\u0443\u0434\u0435\u0442 \u043D\u0435 \u043D\u0430 \u0447\u0442\u043E
        \u0435\u0441\u0442\u044C. \u042F \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435
        \u0437\u0430\u0445\u043E\u0434\u0438\u043B\u0430 \u0432\u043D\u0443\u0442\u0440\u044C."
  - key: os.memory.10500.text
    values:
    - language: 0
      text: "\u50A8\u7269\u95F4\u7684\u95E8\u628A\u624B\u53C8\u6389\u4E86\uFF0C\u53EA\u5269\u4E00\u4E2A\u65B9\u5B54...\u4E3B\u4EBA\u6BCF\u6B21\u90FD\u4ECE\u53A8\u623F\u62BD\u5C49\u91CC\u62FF\u90A3\u628A\u5C0F\u87BA\u4E1D\u5200\uFF0C\u63D2\u8FDB\u53BB\u4E00\u62E7\u5C31\u5F00\u4E86\u3002\u5979\u4E00\u76F4\u8BF4\u8981\u4FEE\u3002"
    - language: 1
      text: "\u5132\u7269\u9593\u7684\u9580\u628A\u624B\u53C8\u6389\u4E86\uFF0C\u53EA\u5269\u4E00\u500B\u65B9\u5B54...\u4E3B\u4EBA\u6BCF\u6B21\u90FD\u5F9E\u5EDA\u623F\u62BD\u5C5C\u88E1\u62FF\u90A3\u628A\u5C0F\u87BA\u7D72\u8D77\u5B50\uFF0C\u63D2\u9032\u53BB\u4E00\u64F0\u5C31\u958B\u4E86\u3002\u5979\u4E00\u76F4\u8AAA\u8981\u4FEE\u3002"
    - language: 2
      text: The storage room's door handle had fallen off again, leaving only a square
        hole... Master always took the little screwdriver from the kitchen drawer,
        put it in the hole, and turned it to open the door. She kept saying she would
        fix it.
    - language: 3
      text: "\u7269\u7F6E\u306E\u30C9\u30A2\u30CE\u30D6\u304C\u307E\u305F\u53D6\u308C\u3066\u3001\u56DB\u89D2\u3044\u7A74\u3060\u3051\u304C\u6B8B\u3063\u3066\u3044\u308B...\u3054\u4E3B\u4EBA\u306F\u3044\u3064\u3082\u53F0\u6240\u306E\u5F15\u304D\u51FA\u3057\u304B\u3089\u5C0F\u3055\u306A\u30C9\u30E9\u30A4\u30D0\u30FC\u3092\u6301\u3063\u3066\u304D\u3066\u3001\u5DEE\u3057\u8FBC\u3093\u3067\u3072\u306D\u308B\u3060\u3051\u3067\u958B\u3051\u3066\u3044\u305F\u3002\u305A\u3063\u3068\u3001\u76F4\u3055\u306A\u304D\u3083\u3068\u8A00\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uCC3D\uACE0 \uBB38\uC190\uC7A1\uC774\uAC00 \uB610 \uBE60\uC838\uC11C
        \uB124\uBAA8\uB09C \uAD6C\uBA4D\uB9CC \uB0A8\uC558\uB2E4...\uC8FC\uC778\uB2D8\uC740
        \uADF8\uB7F4 \uB54C\uB9C8\uB2E4 \uBD80\uC5CC \uC11C\uB78D\uC5D0\uC11C \uC791\uC740
        \uB4DC\uB77C\uC774\uBC84\uB97C \uAEBC\uB0B4 \uAF42\uACE0 \uB3CC\uB824\uC11C
        \uC5EC\uC168\uB2E4. \uB298 \uACE0\uCCD0\uC57C\uACA0\uB2E4\uACE0 \uB9D0\uC500\uD558\uC168\uB2E4."
    - language: 5
      text: "La poign\xE9e du d\xE9barras \xE9tait encore tomb\xE9e. Il ne restait
        qu'un trou carr\xE9... Ma ma\xEEtresse prenait toujours le petit tournevis
        dans le tiroir de la cuisine, l'enfon\xE7ait dans le trou et tournait pour
        ouvrir. Elle disait sans cesse qu'elle r\xE9parerait."
    - language: 6
      text: "Der Griff der Abstellraumt\xFCr war wieder abgefallen. Nur ein quadratisches
        Loch blieb \xFCbrig... Meine Herrin nahm immer den kleinen Schraubendreher
        aus der K\xFCchenschublade, steckte ihn hinein und drehte. Dann ging die
        T\xFCr auf. Sie sagte st\xE4ndig, sie w\xFCrde es reparieren."
    - language: 7
      text: "El pomo del trastero se ha vuelto a caer. Solo queda un agujero cuadrado...
        Mi ama siempre coge el destornillador del caj\xF3n de la cocina, lo mete
        y gira para abrir. Lleva mucho tiempo diciendo que lo va a arreglar."
    - language: 8
      text: "A ma\xE7aneta do dep\xF3sito caiu de novo. S\xF3 ficou um buraco quadrado...
        Minha dona sempre pega a chave de fenda na gaveta da cozinha, enfia no buraco
        e gira para abrir. Ela vive dizendo que vai consertar."
    - language: 9
      text: "\u0420\u0443\u0447\u043A\u0430 \u0434\u0432\u0435\u0440\u0438 \u043A\u043B\u0430\u0434\u043E\u0432\u043A\u0438
        \u043E\u043F\u044F\u0442\u044C \u043E\u0442\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C.
        \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
        \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u0431\u0440\u0430\u043B\u0430
        \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0443
        \u0438\u0437 \u043A\u0443\u0445\u043E\u043D\u043D\u043E\u0433\u043E \u044F\u0449\u0438\u043A\u0430,
        \u0432\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430 \u0438 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B\u0430.
        \u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0430\u0441\u044C.
        \u041E\u043D\u0430 \u0432\u0441\u0451 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
        \u0447\u0442\u043E \u043D\u0430\u0434\u043E \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C."
  - key: os.memory.10510.text
    values:
    - language: 0
      text: "\u8FD9\u6247\u95E8\u7684\u95E8\u6846\u53D8\u5F62\u4E86\uFF0C\u63A8\u4E0D\u52A8\u3002\u4E3B\u4EBA\u8BF4\u91CC\u9762\u6CA1\u4E1C\u897F\uFF0C\u8BA9\u6211\u522B\u7BA1\u5B83\u3002"
    - language: 1
      text: "\u9019\u6247\u9580\u7684\u9580\u6846\u8B8A\u5F62\u4E86\uFF0C\u63A8\u4E0D\u52D5\u3002\u4E3B\u4EBA\u8AAA\u88E1\u9762\u6C92\u6771\u897F\uFF0C\u8B93\u6211\u5225\u7BA1\u5B83\u3002"
    - language: 2
      text: The frame of this door was warped. It would not move. Master said there
        was nothing inside and told me to leave it alone.
    - language: 3
      text: "\u3053\u306E\u30C9\u30A2\u306F\u67A0\u304C\u3086\u304C\u3093\u3067\u3044\u3066\u3001\u62BC\u3057\u3066\u3082\u52D5\u304B\u306A\u3044\u3002\u3054\u4E3B\u4EBA\u306F\u3001\u4E2D\u306B\u306F\u4F55\u3082\u306A\u3044\u304B\u3089\u653E\u3063\u3066\u304A\u3051\u3068\u8A00\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uC774 \uBB38\uC740 \uBB38\uD2C0\uC774 \uB4A4\uD2C0\uB824\uC11C \uBC00\uC5B4\uB3C4
        \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294\uB2E4. \uC8FC\uC778\uB2D8\uC740 \uC548\uC5D0
        \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC73C\uB2C8 \uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uB77C\uACE0
        \uD558\uC168\uB2E4."
    - language: 5
      text: "L'encadrement de cette porte \xE9tait d\xE9form\xE9. Impossible de l'ouvrir.
        Ma ma\xEEtresse disait qu'il n'y avait rien dedans et qu'il fallait laisser
        cette porte tranquille."
    - language: 6
      text: "Der Rahmen dieser T\xFCr war verzogen. Sie lie\xDF sich nicht aufdr\xFCcken.
        Meine Herrin sagte, drinnen sei nichts. Ich sollte die T\xFCr in Ruhe lassen."
    - language: 7
      text: "El marco de esta puerta est\xE1 deformado. No consigo abrirla. Mi ama
        dice que dentro no hay nada y que la deje en paz."
    - language: 8
      text: "O batente desta porta est\xE1 torto. N\xE3o consigo empurrar. Minha
        dona disse que n\xE3o tem nada l\xE1 dentro e que \xE9 para deixar quieto."
    - language: 9
      text: "\u0414\u0432\u0435\u0440\u043D\u043E\u0439 \u043A\u043E\u0441\u044F\u043A
        \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0438\u043B\u0441\u044F. \u0414\u0432\u0435\u0440\u044C
        \u043D\u0435 \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C. \u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438
        \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\u0442 \u0438 \u043B\u0443\u0447\u0448\u0435
        \u0435\u0451 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C."
  - key: os.memory.10520.text
    values:
    - language: 0
      text: "\u8FD9\u6247\u95E8\u53EA\u5269\u4E00\u4E2A\u5408\u9875\u6302\u7740\uFF0C\u4E00\u78B0\u5C31\u6643\u3002"
    - language: 1
      text: "\u9019\u6247\u9580\u53EA\u5269\u4E00\u500B\u9278\u93C8\u639B\u8457\uFF0C\u4E00\u78B0\u5C31\u6643\u3002"
    - language: 2
      text: Only one hinge was holding this door up. It shook at the slightest touch.
    - language: 3
      text: "\u3053\u306E\u30C9\u30A2\u306F\u8776\u756A\u4E00\u3064\u3067\u3076\u3089\u4E0B\u304C\u3063\u3066\u3044\u3066\u3001\u89E6\u308B\u3060\u3051\u3067\u3050\u3089\u3050\u3089\u3059\u308B\u3002"
    - language: 4
      text: "\uC774 \uBB38\uC740 \uACBD\uCCA9 \uD558\uB098\uC5D0 \uACA8\uC6B0 \uB9E4\uB2EC\uB824
        \uC788\uC5B4\uC11C \uAC74\uB4DC\uB9AC\uAE30\uB9CC \uD574\uB3C4 \uD754\uB4E4\uB9B0\uB2E4."
    - language: 5
      text: "Cette porte ne tenait plus que par une charni\xE8re. Elle bougeait au
        moindre contact."
    - language: 6
      text: "Diese T\xFCr hing nur noch an einem Scharnier. Bei jeder Ber\xFChrung
        wackelte sie."
    - language: 7
      text: A esta puerta solo le queda una bisagra. Se tambalea en cuanto la toco.
    - language: 8
      text: "Esta porta s\xF3 tem uma dobradi\xE7a. Balan\xE7a s\xF3 de encostar."
    - language: 9
      text: "\u042D\u0442\u0430 \u0434\u0432\u0435\u0440\u044C \u0432\u0438\u0441\u0438\u0442
        \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u043F\u0435\u0442\u043B\u0435
        \u0438 \u0448\u0430\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u043B\u044E\u0431\u043E\u0433\u043E
        \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u044F."
  - key: os.memory.10530.text
    values:
    - language: 0
      text: "\u6211\u5B66\u7740\u4E3B\u4EBA\u7684\u6837\u5B50\uFF0C\u628A\u87BA\u4E1D\u5200\u63D2\u8FDB\u65B9\u5B54\u91CC\u4E00\u62E7...\u95E8\u5F00\u4E86\u3002"
    - language: 1
      text: "\u6211\u5B78\u8457\u4E3B\u4EBA\u7684\u6A23\u5B50\uFF0C\u628A\u87BA\u7D72\u8D77\u5B50\u63D2\u9032\u65B9\u5B54\u88E1\u4E00\u64F0...\u9580\u958B\u4E86\u3002"
    - language: 2
      text: I copied Master, putting the screwdriver into the square hole and turning
        it... The door opened.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u307E\u306D\u3092\u3057\u3066\u3001\u56DB\u89D2\u3044\u7A74\u306B\u30C9\u30E9\u30A4\u30D0\u30FC\u3092\u5DEE\u3057\u8FBC\u3093\u3067\u3072\u306D\u3063\u305F...\u30C9\u30A2\u304C\u958B\u3044\u305F\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC744 \uB530\uB77C \uB124\uBAA8\uB09C \uAD6C\uBA4D\uC5D0
        \uB4DC\uB77C\uC774\uBC84\uB97C \uAF42\uACE0 \uB3CC\uB838\uB2E4...\uBB38\uC774
        \uC5F4\uB838\uB2E4."
    - language: 5
      text: "J'ai fait comme ma ma\xEEtresse. J'ai gliss\xE9 le tournevis dans le
        trou carr\xE9 et tourn\xE9... La porte s'est ouverte."
    - language: 6
      text: "Ich machte es wie meine Herrin. Ich steckte den Schraubendreher in das
        quadratische Loch und drehte... Die T\xFCr ging auf."
    - language: 7
      text: 'Imito a mi ama: meto el destornillador en el agujero cuadrado y giro...
        La puerta se abre.'
    - language: 8
      text: "Fa\xE7o como minha dona: enfio a chave de fenda no buraco quadrado e
        giro... A porta abre."
    - language: 9
      text: "\u041A\u0430\u043A \u0445\u043E\u0437\u044F\u0439\u043A\u0430, \u044F
        \u0432\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u043E\u0442\u0432\u0451\u0440\u0442\u043A\u0443
        \u0432 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435
        \u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430...\u0414\u0432\u0435\u0440\u044C
        \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C."
  - key: os.memory.10540.text
    values:
    - language: 0
      text: "\u7EB8\u7BB1\u90FD\u662F\u7A7A\u7684\uFF0C\u53E0\u5728\u4E00\u8D77\uFF0C\u50CF\u662F\u6709\u4EBA\u628A\u91CC\u9762\u7684\u4E1C\u897F\u4E00\u6837\u4E00\u6837\u642C\u8D70\u4E86\u3002"
    - language: 1
      text: "\u7D19\u7BB1\u90FD\u662F\u7A7A\u7684\uFF0C\u758A\u5728\u4E00\u8D77\uFF0C\u50CF\u662F\u6709\u4EBA\u628A\u88E1\u9762\u7684\u6771\u897F\u4E00\u6A23\u4E00\u6A23\u642C\u8D70\u4E86\u3002"
    - language: 2
      text: The cardboard boxes were empty and stacked together, as though someone
        had taken everything out, one item at a time.
    - language: 3
      text: "\u6BB5\u30DC\u30FC\u30EB\u7BB1\u306F\u3069\u308C\u3082\u7A7A\u3067\u3001\u7A4D\u307F\u91CD\u306D\u3089\u308C\u3066\u3044\u308B\u3002\u8AB0\u304B\u304C\u4E2D\u8EAB\u3092\u4E00\u3064\u305A\u3064\u904B\u3073\u51FA\u3057\u305F\u307F\u305F\u3044\u3060\u3002"
    - language: 4
      text: "\uC885\uC774 \uC0C1\uC790\uB4E4\uC740 \uBAA8\uB450 \uBE48 \uCC44\uB85C
        \uC313\uC5EC \uC788\uB2E4. \uB204\uAD70\uAC00 \uC548\uC758 \uBB3C\uAC74\uC744
        \uD558\uB098\uD558\uB098 \uAEBC\uB0B4 \uC62E\uAE34 \uAC83 \uAC19\uB2E4."
    - language: 5
      text: "Les cartons \xE9taient vides, empil\xE9s les uns sur les autres. On
        aurait dit que quelqu'un en avait retir\xE9 le contenu, objet apr\xE8s objet."
    - language: 6
      text: "Die Kartons waren leer und aufeinandergestapelt. Als h\xE4tte jemand
        ihren Inhalt St\xFCck f\xFCr St\xFCck fortgetragen."
    - language: 7
      text: "Las cajas est\xE1n vac\xEDas y apiladas, como si alguien hubiera sacado
        su contenido, pieza a pieza."
    - language: 8
      text: "As caixas est\xE3o vazias e empilhadas, como se algu\xE9m tivesse tirado
        tudo de dentro, uma coisa de cada vez."
    - language: 9
      text: "\u041A\u0430\u0440\u0442\u043E\u043D\u043D\u044B\u0435 \u043A\u043E\u0440\u043E\u0431\u043A\u0438
        \u043F\u0443\u0441\u0442\u044B \u0438 \u0441\u043B\u043E\u0436\u0435\u043D\u044B
        \u0434\u0440\u0443\u0433 \u043D\u0430 \u0434\u0440\u0443\u0433\u0430. \u0411\u0443\u0434\u0442\u043E
        \u043A\u0442\u043E-\u0442\u043E \u0432\u044B\u043D\u0435\u0441 \u0438\u0437
        \u043D\u0438\u0445 \u0432\u0441\u0435 \u0432\u0435\u0449\u0438, \u043E\u0434\u043D\u0443
        \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u0439."
  - key: os.memory.10550.text
    values:
    - language: 0
      text: "\u89D2\u843D\u91CC\u9760\u7740\u4E00\u628A\u6298\u8D77\u6765\u7684\u8F6E\u6905\uFF0C\u4ECE\u6211\u6765\u7684\u65F6\u5019\u5B83\u5C31\u5728\u8FD9\u4E2A\u5BB6\u91CC\u4E86...\u4E3B\u4EBA\u6536\u62FE\u8FD9\u95F4\u5C4B\u5B50\u7684\u65F6\u5019\u8BF4\u8FC7\u8981\u628A\u5B83\u6254\u6389\uFF0C\u6700\u540E\u8FD8\u662F\u7559\u4E86\u4E0B\u6765\u3002"
    - language: 1
      text: "\u89D2\u843D\u88E1\u9760\u8457\u4E00\u628A\u6298\u8D77\u4F86\u7684\u8F2A\u6905\uFF0C\u5F9E\u6211\u4F86\u7684\u6642\u5019\u5B83\u5C31\u5728\u9019\u500B\u5BB6\u88E1\u4E86...\u4E3B\u4EBA\u6536\u62FE\u9019\u9593\u5C4B\u5B50\u7684\u6642\u5019\u8AAA\u904E\u8981\u628A\u5B83\u6254\u6389\uFF0C\u6700\u5F8C\u9084\u662F\u7559\u4E86\u4E0B\u4F86\u3002"
    - language: 2
      text: A folded wheelchair stood in the corner. It had been here ever since
        I came to this home... Master once said she would throw it out while cleaning
        this room. In the end, she kept it.
    - language: 3
      text: "\u9685\u306B\u6298\u308A\u7573\u3093\u3060\u8ECA\u6905\u5B50\u304C\u7ACB\u3066\u304B\u3051\u3066\u3042\u308B\u3002\u79C1\u304C\u6765\u305F\u3068\u304D\u306B\u306F\u3001\u3082\u3046\u3053\u306E\u5BB6\u306B\u3042\u3063\u305F...\u3054\u4E3B\u4EBA\u306F\u3053\u306E\u90E8\u5C4B\u3092\u7247\u3065\u3051\u305F\u3068\u304D\u3001\u6368\u3066\u3088\u3046\u3068\u8A00\u3063\u3066\u3044\u305F\u3051\u308C\u3069\u3001\u7D50\u5C40\u6B8B\u3057\u3066\u304A\u3044\u305F\u3002"
    - language: 4
      text: "\uAD6C\uC11D\uC5D0 \uC811\uD78C \uD720\uCCB4\uC5B4 \uD558\uB098\uAC00
        \uAE30\uB300\uC5B4 \uC788\uB2E4. \uB0B4\uAC00 \uC654\uC744 \uB54C\uBD80\uD130
        \uC774 \uC9D1\uC5D0 \uC788\uC5C8\uB2E4...\uC8FC\uC778\uB2D8\uC740 \uC774
        \uBC29\uC744 \uC815\uB9AC\uD558\uBA74\uC11C \uBC84\uB824\uC57C\uACA0\uB2E4\uACE0
        \uD558\uC168\uC9C0\uB9CC, \uACB0\uAD6D \uADF8\uB300\uB85C \uB450\uC168\uB2E4."
    - language: 5
      text: "Un fauteuil roulant pli\xE9 \xE9tait appuy\xE9 dans le coin. Il \xE9tait
        dans cette maison depuis mon arriv\xE9e... En rangeant cette pi\xE8ce, ma
        ma\xEEtresse avait dit qu'elle le jetterait. Finalement, elle l'avait gard\xE9."
    - language: 6
      text: "In der Ecke stand ein zusammengeklappter Rollstuhl. Er war schon hier
        gewesen, als ich in dieses Haus kam... Beim Aufr\xE4umen hatte meine Herrin
        einmal gesagt, sie w\xFCrde ihn wegwerfen. Am Ende behielt sie ihn doch."
    - language: 7
      text: "En un rinc\xF3n hay una silla de ruedas plegada. Ya estaba en esta casa
        cuando llegu\xE9... Mi ama dijo que la tirar\xEDa cuando ordenara esta habitaci\xF3n,
        pero al final se la qued\xF3."
    - language: 8
      text: "Tem uma cadeira de rodas dobrada no canto. Ela j\xE1 estava nesta casa
        quando eu cheguei... Minha dona disse que ia jogar fora quando arrumasse
        este quarto, mas acabou guardando."
    - language: 9
      text: "\u0412 \u0443\u0433\u043B\u0443 \u043F\u0440\u0438\u0441\u043B\u043E\u043D\u0435\u043D\u0430
        \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u0438\u043D\u0432\u0430\u043B\u0438\u0434\u043D\u0430\u044F
        \u043A\u043E\u043B\u044F\u0441\u043A\u0430. \u041E\u043D\u0430 \u0431\u044B\u043B\u0430
        \u0437\u0434\u0435\u0441\u044C \u0435\u0449\u0451 \u0442\u043E\u0433\u0434\u0430,
        \u043A\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
        \u0432 \u044D\u0442\u043E\u043C \u0434\u043E\u043C\u0435...\u0423\u0431\u0438\u0440\u0430\u044F
        \u043A\u043E\u043C\u043D\u0430\u0442\u0443, \u0445\u043E\u0437\u044F\u0439\u043A\u0430
        \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442
        \u0435\u0451, \u043D\u043E \u0432 \u0438\u0442\u043E\u0433\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430."
  - key: os.memory.10560.text
    values:
    - language: 0
      text: "\u4E00\u5806\u7A7A\u836F\u76D2\uFF0C\u4E0A\u6B21\u5927\u626B\u9664\u6CA1\u6765\u5F97\u53CA\u6E05\u7406...\u8FD9\u4E2A\u623F\u95F4\u5E9F\u5F03\u4E4B\u540E\u5C31\u4E00\u76F4\u7559\u5728\u8FD9\u4E86.."
    - language: 1
      text: "\u4E00\u5806\u7A7A\u85E5\u76D2\uFF0C\u4E0A\u6B21\u5927\u6383\u9664\u6C92\u4F86\u5F97\u53CA\u6E05\u7406...\u9019\u500B\u623F\u9593\u5EE2\u68C4\u4E4B\u5F8C\u5C31\u4E00\u76F4\u7559\u5728\u9019\u4E86.."
    - language: 2
      text: A pile of empty medicine boxes. We had not got around to them during
        the last big clean... They had been left here ever since this room fell out
        of use..
    - language: 3
      text: "\u7A7A\u306E\u85AC\u7BB1\u304C\u5C71\u306B\u306A\u3063\u3066\u3044\u308B\u3002\u524D\u306E\u5927\u6383\u9664\u3067\u306F\u7247\u3065\u3051\u304D\u308C\u306A\u304B\u3063\u305F...\u3053\u306E\u90E8\u5C4B\u3092\u4F7F\u308F\u306A\u304F\u306A\u3063\u3066\u304B\u3089\u3001\u305A\u3063\u3068\u3053\u3053\u306B\u6B8B\u3063\u3066\u3044\u308B.."
    - language: 4
      text: "\uBE48 \uC57D \uC0C1\uC790\uAC00 \uD55C \uBB34\uB354\uAE30\uB2E4. \uC9C0\uB09C\uBC88
        \uB300\uCCAD\uC18C \uB54C \uBBF8\uCC98 \uCE58\uC6B0\uC9C0 \uBABB\uD588\uB2E4...\uC774
        \uBC29\uC744 \uC548 \uC4F0\uAC8C \uB41C \uB4A4\uB85C \uC904\uACE7 \uC5EC\uAE30
        \uB0A8\uC544 \uC788\uB2E4.."
    - language: 5
      text: "Une pile de bo\xEEtes de m\xE9dicaments vides. Nous n'avions pas eu
        le temps de les jeter lors du dernier grand m\xE9nage... Elles \xE9taient
        rest\xE9es ici depuis qu'on n'utilisait plus cette pi\xE8ce.."
    - language: 6
      text: "Ein Haufen leerer Medikamentenschachteln. Beim letzten Gro\xDFputz hatten
        wir es nicht mehr geschafft, sie wegzur\xE4umen... Seit dieser Raum nicht
        mehr benutzt wurde, lagen sie hier.."
    - language: 7
      text: "Un mont\xF3n de cajas de medicinas vac\xEDas. No dio tiempo a recogerlas
        en la \xFAltima limpieza... Llevan aqu\xED desde que se dej\xF3 de usar esta
        habitaci\xF3n.."
    - language: 8
      text: "Um monte de caixas de rem\xE9dio vazias. N\xE3o deu tempo de tirar na
        \xFAltima faxina... Ficaram aqui desde que este quarto deixou de ser usado.."
    - language: 9
      text: "\u041A\u0443\u0447\u0430 \u043F\u0443\u0441\u0442\u044B\u0445 \u043A\u043E\u0440\u043E\u0431\u043E\u043A
        \u0438\u0437-\u043F\u043E\u0434 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432.
        \u0412 \u043F\u0440\u043E\u0448\u043B\u0443\u044E \u0431\u043E\u043B\u044C\u0448\u0443\u044E
        \u0443\u0431\u043E\u0440\u043A\u0443 \u0434\u043E \u043D\u0438\u0445 \u043D\u0435
        \u0434\u043E\u0448\u043B\u0438 \u0440\u0443\u043A\u0438...\u0421 \u0442\u0435\u0445
        \u043F\u043E\u0440 \u043A\u0430\u043A \u043A\u043E\u043C\u043D\u0430\u0442\u043E\u0439
        \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F,
        \u043E\u043D\u0438 \u0442\u0430\u043A \u0438 \u043B\u0435\u0436\u0430\u0442
        \u0437\u0434\u0435\u0441\u044C.."
  - key: os.memory.10570.text
    values:
    - language: 0
      text: "\u5916\u5957\u548C\u978B\u90FD\u5728\uFF0C\u4ECE\u65E9\u4E0A\u5230\u73B0\u5728\u6CA1\u6709\u4EBA\u8D77\u6765\u8FC7\uFF0C\u836F\u4E5F\u5403\u5B8C\u4E86...\u4E3B\u4EBA\u4E0D\u662F\u5728\u7761\u61D2\u89C9\u3002"
    - language: 1
      text: "\u5916\u5957\u548C\u978B\u90FD\u5728\uFF0C\u5F9E\u65E9\u4E0A\u5230\u73FE\u5728\u6C92\u6709\u4EBA\u8D77\u4F86\u904E\uFF0C\u85E5\u4E5F\u5403\u5B8C\u4E86...\u4E3B\u4EBA\u4E0D\u662F\u5728\u7761\u61F6\u89BA\u3002"
    - language: 2
      text: Her coat and shoes were here. No one had got up all day, and her medicine
        was gone... Master was not sleeping in.
    - language: 3
      text: "\u4E0A\u7740\u3082\u9774\u3082\u3042\u308B\u3002\u671D\u304B\u3089\u4ECA\u307E\u3067\u8AB0\u3082\u8D77\u304D\u3066\u3044\u306A\u3044\u3002\u85AC\u3082\u306A\u304F\u306A\u3063\u305F...\u3054\u4E3B\u4EBA\u306F\u3001\u5BDD\u574A\u3057\u3066\u3044\u308B\u3093\u3058\u3083\u306A\u3044\u3002"
    - language: 4
      text: "\uC678\uD22C\uC640 \uC2E0\uBC1C\uC774 \uADF8\uB300\uB85C \uC788\uB2E4.
        \uC544\uCE68\uBD80\uD130 \uC9C0\uAE08\uAE4C\uC9C0 \uC544\uBB34\uB3C4 \uC77C\uC5B4\uB098\uC9C0
        \uC54A\uC558\uACE0, \uC57D\uB3C4 \uB2E4 \uB5A8\uC5B4\uC84C\uB2E4...\uC8FC\uC778\uB2D8\uC740
        \uB2A6\uC7A0\uC744 \uC8FC\uBB34\uC2DC\uB294 \uAC8C \uC544\uB2C8\uB2E4."
    - language: 5
      text: "Son manteau et ses chaussures \xE9taient l\xE0. Personne ne s'\xE9tait
        lev\xE9 de la journ\xE9e, et il ne restait plus de m\xE9dicaments... Ma ma\xEEtresse
        ne faisait pas la grasse matin\xE9e."
    - language: 6
      text: Mantel und Schuhe waren hier. Seit dem Morgen war niemand aufgestanden,
        und die Medikamente waren aufgebraucht... Meine Herrin schlief nicht einfach
        aus.
    - language: 7
      text: "El abrigo y los zapatos est\xE1n aqu\xED. Nadie se ha levantado desde
        esta ma\xF1ana, y las medicinas se han acabado... Mi ama no est\xE1 durmiendo
        hasta tarde."
    - language: 8
      text: "O casaco e os sapatos est\xE3o aqui. Ningu\xE9m se levantou desde manh\xE3,
        e os rem\xE9dios acabaram... Minha dona n\xE3o est\xE1 s\xF3 dormindo at\xE9
        tarde."
    - language: 9
      text: "\u041A\u0443\u0440\u0442\u043A\u0430 \u0438 \u043E\u0431\u0443\u0432\u044C
        \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0421 \u0443\u0442\u0440\u0430
        \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0441\u0442\u0430\u0432\u0430\u043B,
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430 \u0442\u043E\u0436\u0435
        \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043E\u043B\u0433\u043E
        \u0441\u043F\u0438\u0442."
  - key: os.memory.10580.text
    values:
    - language: 0
      text: "<color=red>\u6211\u5F97\u518D\u53BB\u6572\u4E00\u6B21\u5979\u7684\u95E8\u3002</color>"
    - language: 1
      text: "<color=red>\u6211\u5F97\u518D\u53BB\u6572\u4E00\u6B21\u5979\u7684\u9580\u3002</color>"
    - language: 2
      text: <color=red>I had to knock on her door again.</color>
    - language: 3
      text: "<color=red>\u3082\u3046\u4E00\u5EA6\u3001\u3054\u4E3B\u4EBA\u306E\u30C9\u30A2\u3092\u30CE\u30C3\u30AF\u3057\u306A\u3051\u308C\u3070\u3002</color>"
    - language: 4
      text: "<color=red>\uB2E4\uC2DC \uAC00\uC11C \uD55C \uBC88 \uB354 \uBB38\uC744
        \uB450\uB4DC\uB824\uC57C\uACA0\uB2E4.</color>"
    - language: 5
      text: "<color=red>Je devais retourner frapper \xE0 sa porte.</color>"
    - language: 6
      text: "<color=red>Ich musste noch einmal an ihre T\xFCr klopfen.</color>"
    - language: 7
      text: <color=red>Tengo que volver a llamar a su puerta.</color>
    - language: 8
      text: <color=red>Preciso bater na porta dela de novo.</color>
    - language: 9
      text: "<color=red>\u041D\u0430\u0434\u043E \u0435\u0449\u0451 \u0440\u0430\u0437
        \u043F\u043E\u0441\u0442\u0443\u0447\u0430\u0442\u044C \u0432 \u0435\u0451
        \u0434\u0432\u0435\u0440\u044C.</color>"
  - key: os.memory.10590.text
    values:
    - language: 0
      text: "\u549A\u3001\u549A...\u201C\u4E3B.\u4EBA...?\u201D \u549A\u3001\u549A\u3001\u549A\u3002\u6211\u6572\u5F97\u6BD4\u54EA\u4E00\u6B21\u90FD\u91CD\uFF0C\u95E8\u90A3\u8FB9\u8FD8\u662F\u6CA1\u6709\u58F0\u97F3\u3002"
    - language: 1
      text: "\u549A\u3001\u549A...\u201C\u4E3B.\u4EBA...?\u201D \u549A\u3001\u549A\u3001\u549A\u3002\u6211\u6572\u5F97\u6BD4\u54EA\u4E00\u6B21\u90FD\u91CD\uFF0C\u9580\u90A3\u908A\u9084\u662F\u6C92\u6709\u8072\u97F3\u3002"
    - language: 2
      text: Knock, knock... "Mas.ter...?" Knock, knock, knock. I knocked harder than
        I ever had. There was still no sound on the other side.
    - language: 3
      text: "\u30B3\u30F3\u3001\u30B3\u30F3...\u300C\u3054.\u4E3B\u4EBA...\uFF1F\u300D\u30C9\u30F3\u3001\u30C9\u30F3\u3001\u30C9\u30F3\u3002\u4ECA\u307E\u3067\u3067\u4E00\u756A\u5F37\u304F\u53E9\u3044\u305F\u3002\u305D\u308C\u3067\u3082\u3001\u30C9\u30A2\u306E\u5411\u3053\u3046\u304B\u3089\u306F\u4F55\u3082\u805E\u3053\u3048\u306A\u304B\u3063\u305F\u3002"
    - language: 4
      text: "\uB611, \uB611...\u201C\uC8FC.\uC778\uB2D8...?\u201D \uCF85, \uCF85,
        \uCF85. \uC5B4\uB290 \uB54C\uBCF4\uB2E4 \uC138\uAC8C \uB450\uB4DC\uB838\uB2E4.
        \uADF8\uB798\uB3C4 \uBB38 \uB108\uBA38\uC5D0\uC11C\uB294 \uC544\uBB34 \uC18C\uB9AC\uB3C4
        \uB098\uC9C0 \uC54A\uC558\uB2E4."
    - language: 5
      text: "Toc, toc... \xAB Ma\xEE.tresse...? \xBB Toc, toc, toc. J'ai frapp\xE9
        plus fort que jamais. Il n'y avait toujours aucun bruit de l'autre c\xF4t\xE9."
    - language: 6
      text: "Klopf, klopf... \u201EHer.rin...?\u201C Klopf, klopf, klopf. Ich klopfte
        lauter als je zuvor. Hinter der T\xFCr blieb es still."
    - language: 7
      text: "Toc, toc... \xAB\xBFA.ma...?\xBB Toc, toc, toc. Llamo m\xE1s fuerte
        que nunca, pero al otro lado sigue sin o\xEDrse nada."
    - language: 8
      text: "Toc, toc... \u201CDo.na...?\u201D Toc, toc, toc. Bato mais forte do
        que nunca, mas ainda n\xE3o vem nenhum som do outro lado."
    - language: 9
      text: "\u0422\u0443\u043A, \u0442\u0443\u043A...\xAB\u0425\u043E.\u0437\u044F\u0439\u043A\u0430...?\xBB
        \u0422\u0443\u043A, \u0442\u0443\u043A, \u0442\u0443\u043A. \u042F \u0441\u0442\u0443\u0447\u0430\u043B\u0430
        \u0441\u0438\u043B\u044C\u043D\u0435\u0435, \u0447\u0435\u043C \u043A\u043E\u0433\u0434\u0430-\u043B\u0438\u0431\u043E.
        \u0417\u0430 \u0434\u0432\u0435\u0440\u044C\u044E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
        \u0431\u044B\u043B\u043E \u0442\u0438\u0445\u043E."
  - key: os.memory.10600.text
    values:
    - language: 0
      text: "\u549A\u3002\u549A\u3001\u549A\u3002\u90A3\u4E2A\u58F0\u97F3\u8D8A\u6765\u8D8A\u5FEB\uFF0C\u6211\u7684\u63A8\u7406\u4E5F\u8DDF\u7740\u8D8A\u8F6C\u8D8A\u5FEB...\u6211\u7684\u8BB0\u5F55\u8BF4\u4E3B\u4EBA\u6CA1\u6709\u51FA\u95E8\uFF0C\u53EF\u662F......"
    - language: 1
      text: "\u549A\u3002\u549A\u3001\u549A\u3002\u90A3\u500B\u8072\u97F3\u8D8A\u4F86\u8D8A\u5FEB\uFF0C\u6211\u7684\u63A8\u7406\u4E5F\u8DDF\u8457\u8D8A\u8F49\u8D8A\u5FEB...\u6211\u7684\u8A18\u9304\u8AAA\u4E3B\u4EBA\u6C92\u6709\u51FA\u9580\uFF0C\u53EF\u662F......"
    - language: 2
      text: Thump. Thump, thump. That sound was getting faster. My reasoning was
        accelerating with it... My records said Master had not gone out, but......
    - language: 3
      text: "\u30C9\u30AF\u30F3\u3002\u30C9\u30AF\u30F3\u3001\u30C9\u30AF\u30F3\u3002\u3042\u306E\u97F3\u306F\u3069\u3093\u3069\u3093\u901F\u304F\u306A\u308A\u3001\u79C1\u306E\u63A8\u8AD6\u3082\u305D\u308C\u306B\u5408\u308F\u305B\u3066\u56DE\u308A\u7D9A\u3051\u305F...\u8A18\u9332\u306B\u3088\u308C\u3070\u3001\u3054\u4E3B\u4EBA\u306F\u51FA\u304B\u3051\u3066\u3044\u306A\u3044\u3002\u3067\u3082......"
    - language: 4
      text: "\uCFF5. \uCFF5, \uCFF5. \uADF8 \uC18C\uB9AC\uAC00 \uC810\uC810 \uBE68\uB77C\uC9C0\uC790
        \uB0B4 \uCD94\uB860\uB3C4 \uB369\uB2EC\uC544 \uBE60\uB974\uAC8C \uB3CC\uC544\uAC14\uB2E4...\uAE30\uB85D\uC5D0\uB294
        \uC8FC\uC778\uB2D8\uC774 \uB098\uAC00\uC9C0 \uC54A\uC73C\uC168\uB2E4\uACE0
        \uB418\uC5B4 \uC788\uB2E4. \uD558\uC9C0\uB9CC......"
    - language: 5
      text: "Boum. Boum, boum. Ce son allait de plus en plus vite. Mes raisonnements
        s'acc\xE9l\xE9raient avec lui... Mes enregistrements disaient que ma ma\xEEtresse
        n'\xE9tait pas sortie, mais......"
    - language: 6
      text: "Poch. Poch, poch. Dieses Ger\xE4usch wurde immer schneller. Meine Schlussfolgerungen
        \xFCberschlugen sich ebenfalls... Laut meinen Aufzeichnungen war meine Herrin
        nicht ausgegangen, aber......"
    - language: 7
      text: "Tum. Tum, tum. Ese sonido se acelera, y mis deducciones dan vueltas
        cada vez m\xE1s deprisa... Mis registros dicen que mi ama no ha salido, pero......"
    - language: 8
      text: "Tum. Tum, tum. Aquele som fica cada vez mais r\xE1pido, e meu racioc\xEDnio
        tamb\xE9m gira cada vez mais depressa... Meus registros dizem que minha dona
        n\xE3o saiu, mas......"
    - language: 9
      text: "\u0422\u0443\u043A. \u0422\u0443\u043A, \u0442\u0443\u043A. \u042D\u0442\u043E\u0442
        \u0437\u0432\u0443\u043A \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
        \u0432\u0441\u0451 \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0430 \u0432\u043C\u0435\u0441\u0442\u0435
        \u0441 \u043D\u0438\u043C \u0432\u0441\u0451 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
        \u043A\u0440\u0443\u0442\u0438\u043B\u0438\u0441\u044C \u043C\u043E\u0438
        \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F...\u041F\u043E
        \u043C\u043E\u0438\u043C \u0437\u0430\u043F\u0438\u0441\u044F\u043C \u0445\u043E\u0437\u044F\u0439\u043A\u0430
        \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0430. \u041D\u043E......"
  - key: os.memory.10610.text
    values:
    - language: 0
      text: "\u7B49\u90A3\u4E9B\u63A8\u7406\u505C\u4E0B\u6765\uFF0C\u6211\u5DF2\u7ECF\u7AD9\u5728\u5927\u95E8\u5916\u9762\u4E86\uFF0C\u4F1E\u90FD\u5FD8\u4E86\u62FF\u3002"
    - language: 1
      text: "\u7B49\u90A3\u4E9B\u63A8\u7406\u505C\u4E0B\u4F86\uFF0C\u6211\u5DF2\u7D93\u7AD9\u5728\u5927\u9580\u5916\u9762\u4E86\uFF0C\u5098\u90FD\u5FD8\u4E86\u62FF\u3002"
    - language: 2
      text: By the time those deductions stopped, I was already standing outside
        the front door. I had even forgotten the umbrella.
    - language: 3
      text: "\u63A8\u8AD6\u304C\u3088\u3046\u3084\u304F\u6B62\u307E\u3063\u305F\u3068\u304D\u3001\u79C1\u306F\u3082\u3046\u7384\u95A2\u306E\u5916\u306B\u7ACB\u3063\u3066\u3044\u305F\u3002\u5098\u3092\u6301\u3063\u3066\u304F\u308B\u306E\u3082\u5FD8\u308C\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uADF8 \uCD94\uB860\uB4E4\uC774 \uBA48\uCDC4\uC744 \uB54C, \uB098\uB294
        \uC774\uBBF8 \uD604\uAD00 \uBC16\uC5D0 \uC11C \uC788\uC5C8\uB2E4. \uC6B0\uC0B0\uC744
        \uCC59\uAE30\uB294 \uAC83\uB3C4 \uC78A\uC740 \uCC44."
    - language: 5
      text: "Quand ces raisonnements se sont arr\xEAt\xE9s, j'\xE9tais d\xE9j\xE0
        devant la porte d'entr\xE9e, dehors. J'avais m\xEAme oubli\xE9 le parapluie."
    - language: 6
      text: "Als diese Schlussfolgerungen aufh\xF6rten, stand ich bereits drau\xDFen
        vor der Haust\xFCr. Ich hatte sogar den Schirm vergessen."
    - language: 7
      text: Cuando esas deducciones se detienen, ya estoy al otro lado de la puerta
        de entrada. Hasta he olvidado el paraguas.
    - language: 8
      text: "Quando aqueles pensamentos param, j\xE1 estou do lado de fora da porta.
        At\xE9 esqueci o guarda-chuva."
    - language: 9
      text: "\u041A\u043E\u0433\u0434\u0430 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F
        \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C,
        \u044F \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u043B\u0430 \u0437\u0430
        \u0432\u0445\u043E\u0434\u043D\u043E\u0439 \u0434\u0432\u0435\u0440\u044C\u044E.
        \u0414\u0430\u0436\u0435 \u0437\u043E\u043D\u0442 \u0437\u0430\u0431\u044B\u043B\u0430
        \u0432\u0437\u044F\u0442\u044C."
  - key: os.memory.10620.text
    values:
    - language: 0
      text: "......<k>\u6216\u8BB8</k>\u5979\u53EA\u662F<k>\u51FA\u53BB</k>\u4E86\u5462\uFF1F<k>\u4E3B\u4EBA</k>\uFF01<k>\u4E3B\u4EBA</k>\uFF01......\u4E3B\u4EBA\u4F1A\u5728<k>\u54EA\u91CC</k>\uFF1F"
    - language: 1
      text: "......<k>\u6216\u8A31</k>\u5979\u53EA\u662F<k>\u51FA\u53BB</k>\u4E86\u5462\uFF1F<k>\u4E3B\u4EBA</k>\uFF01<k>\u4E3B\u4EBA</k>\uFF01......\u4E3B\u4EBA\u6703\u5728<k>\u54EA\u88E1</k>\uFF1F"
    - language: 2
      text: ......<k>Maybe</k> she just went <k>outside</k>? <k>Master</k>! <k>Master</k>!
        ......<k>Where</k> could Master be?
    - language: 3
      text: "......<k>\u3082\u3057\u304B\u3057\u305F\u3089</k>\u3001\u305F\u3060<k>\u51FA\u304B\u3051\u305F</k>\u3060\u3051\u304B\u3082\u3057\u308C\u306A\u3044\u3002<k>\u3054\u4E3B\u4EBA</k>\uFF01
        <k>\u3054\u4E3B\u4EBA</k>\uFF01 ......\u3054\u4E3B\u4EBA\u306F<k>\u3069\u3053</k>\u306B\u3044\u308B\u306E\u3060\u308D\u3046\uFF1F"
    - language: 4
      text: "......<k>\uC5B4\uCA4C\uBA74</k> \uADF8\uB0E5 <k>\uB098\uAC00\uC2E0</k>
        \uAC78\uC9C0\uB3C4 \uBAA8\uB974\uC796\uC544? <k>\uC8FC\uC778\uB2D8</k>! <k>\uC8FC\uC778\uB2D8</k>!
        ......\uC8FC\uC778\uB2D8\uC740 <k>\uC5B4\uB514</k> \uACC4\uC2E4\uAE4C?"
    - language: 5
      text: "......<k>Peut-\xEAtre</k> qu'elle est simplement <k>sortie</k> ? <k>Ma\xEEtresse</k>
        ! <k>Ma\xEEtresse</k> ! ......<k>O\xF9</k> peut-elle \xEAtre ?"
    - language: 6
      text: "......<k>Vielleicht</k> ist sie nur <k>rausgegangen</k>? <k>Herrin</k>!
        <k>Herrin</k>! ......<k>Wo</k> k\xF6nnte meine Herrin sein?"
    - language: 7
      text: "......\xBF<k>Y si</k> simplemente ha <k>salido</k>? \xA1<k>Ama</k>!
        \xA1<k>Ama</k>! ......\xBF<k>D\xF3nde</k> estar\xE1?"
    - language: 8
      text: "......<k>Talvez</k> ela s\xF3 tenha <k>sa\xEDdo</k>? <k>Dona</k>! <k>Dona</k>!
        ......<k>Onde</k> ela estar\xE1?"
    - language: 9
      text: "......<k>\u041C\u043E\u0436\u0435\u0442</k>, \u043E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
        <k>\u0432\u044B\u0448\u043B\u0430</k>? <k>\u0425\u043E\u0437\u044F\u0439\u043A\u0430</k>!
        <k>\u0425\u043E\u0437\u044F\u0439\u043A\u0430</k>! ......<k>\u0413\u0434\u0435</k>
        \u0436\u0435 \u0445\u043E\u0437\u044F\u0439\u043A\u0430?"
  - key: os.memory.10630.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA<k>\u5367\u5BA4</k>\u7684<k>\u7A97\u6237\u4EAE\u7740</k>\uFF0C<k>\u7A97\u5E18</k>\u62C9\u5F97\u4E25\u4E25\u7684...\u6211<k>\u6572</k>\u4E86\u597D\u51E0\u4E0B\u73BB\u7483\uFF0C<k>\u7A97\u5E18</k>\u4E00\u52A8\u4E5F<k>\u6CA1\u52A8</k>\u3002"
    - language: 1
      text: "\u4E3B\u4EBA<k>\u81E5\u5BA4</k>\u7684<k>\u7A97\u6236\u4EAE\u8457</k>\uFF0C<k>\u7A97\u7C3E</k>\u62C9\u5F97\u56B4\u56B4\u7684...\u6211<k>\u6572</k>\u4E86\u597D\u5E7E\u4E0B\u73BB\u7483\uFF0C<k>\u7A97\u7C3E</k>\u4E00\u52D5\u4E5F<k>\u6C92\u52D5</k>\u3002"
    - language: 2
      text: The <k>window was lit</k> in Master's <k>bedroom</k>. The <k>curtains</k>
        were tightly drawn... I <k>knocked</k> on the glass several times. The <k>curtains</k>
        <k>did not move</k>.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E<k>\u5BDD\u5BA4</k>\u306F<k>\u7A93\u306B\u660E\u304B\u308A\u304C\u3064\u3044\u3066\u3044\u3066</k>\u3001<k>\u30AB\u30FC\u30C6\u30F3</k>\u306F\u3074\u3063\u305F\u308A\u9589\u307E\u3063\u3066\u3044\u308B...\u30AC\u30E9\u30B9\u3092\u4F55\u5EA6\u3082<k>\u53E9\u3044\u305F</k>\u3051\u308C\u3069\u3001<k>\u30AB\u30FC\u30C6\u30F3</k>\u306F\u5C11\u3057\u3082<k>\u52D5\u304B\u306A\u304B\u3063\u305F</k>\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8 <k>\uCE68\uC2E4</k>\uC758 <k>\uCC3D\uBB38\uC5D0 \uBD88\uC774
        \uCF1C\uC838</k> \uC788\uACE0, <k>\uCEE4\uD2BC</k>\uC740 \uAF2D \uB2EB\uD600
        \uC788\uB2E4...\uC720\uB9AC\uB97C \uBA87 \uBC88\uC774\uB098 <k>\uB450\uB4DC\uB838\uC9C0\uB9CC</k>,
        <k>\uCEE4\uD2BC</k>\uC740 \uC870\uAE08\uB3C4 <k>\uC6C0\uC9C1\uC774\uC9C0
        \uC54A\uC558\uB2E4</k>."
    - language: 5
      text: "La <k>fen\xEAtre \xE9tait \xE9clair\xE9e</k> dans la <k>chambre</k>
        de ma ma\xEEtresse. Les <k>rideaux</k> \xE9taient bien ferm\xE9s... J'ai
        <k>frapp\xE9</k> plusieurs fois au carreau. Les <k>rideaux</k> <k>n'ont pas
        boug\xE9</k>."
    - language: 6
      text: "Im <k>Schlafzimmer</k> meiner Herrin war das <k>Fenster erleuchtet</k>.
        Die <k>Vorh\xE4nge</k> waren fest zugezogen... Ich <k>klopfte</k> mehrmals
        gegen die Scheibe. Die <k>Vorh\xE4nge</k> <k>bewegten sich nicht</k>."
    - language: 7
      text: "En la <k>ventana hay luz</k>. Es el <k>dormitorio</k> de mi ama. Las
        <k>cortinas</k> est\xE1n bien cerradas... <k>Golpeo</k> varias veces el cristal,
        pero las <k>cortinas</k> <k>no se mueven</k>."
    - language: 8
      text: "A <k>janela est\xE1 acesa</k>. \xC9 o <k>quarto</k> da minha dona. As
        <k>cortinas</k> est\xE3o bem fechadas... <k>Bato</k> v\xE1rias vezes no vidro,
        mas as <k>cortinas</k> <k>n\xE3o se mexem</k>."
    - language: 9
      text: "\u0412 <k>\u0441\u043F\u0430\u043B\u044C\u043D\u0435</k> \u0445\u043E\u0437\u044F\u0439\u043A\u0438
        <k>\u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F \u043E\u043A\u043D\u043E</k>,
        <k>\u0448\u0442\u043E\u0440\u044B</k> \u043F\u043B\u043E\u0442\u043D\u043E
        \u0437\u0430\u0434\u0451\u0440\u043D\u0443\u0442\u044B...\u042F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0440\u0430\u0437 <k>\u043F\u043E\u0441\u0442\u0443\u0447\u0430\u043B\u0430</k>
        \u043F\u043E \u0441\u0442\u0435\u043A\u043B\u0443, \u043D\u043E <k>\u0448\u0442\u043E\u0440\u044B</k>
        \u0434\u0430\u0436\u0435 <k>\u043D\u0435 \u0448\u0435\u043B\u043E\u0445\u043D\u0443\u043B\u0438\u0441\u044C</k>."
  - key: os.memory.10640.text
    values:
    - language: 0
      text: "<k>\u56F4\u680F\u5916\u9762</k>\u4EC0\u4E48\u90FD\u770B<k>\u4E0D\u6E05</k>\uFF0C\u96E8\u628A\u8DEF\u90FD\u51B2<k>\u6CA1\u4E86</k>...\u4E3B\u4EBA\u8BF4\u8FC7\uFF0C<k>\u4E0D\u8BB8</k>\u6211<k>\u8D70\u51FA</k>\u8FD9\u9053\u56F4\u680F\u3002"
    - language: 1
      text: "<k>\u570D\u6B04\u5916\u9762</k>\u4EC0\u9EBC\u90FD\u770B<k>\u4E0D\u6E05</k>\uFF0C\u96E8\u628A\u8DEF\u90FD\u885D<k>\u6C92\u4E86</k>...\u4E3B\u4EBA\u8AAA\u904E\uFF0C<k>\u4E0D\u8A31</k>\u6211<k>\u8D70\u51FA</k>\u9019\u9053\u570D\u6B04\u3002"
    - language: 2
      text: I could see <k>nothing clearly</k> <k>beyond the fence</k>. The road
        had been <k>washed away</k> by the rain... Master said I was <k>not allowed</k>
        to <k>go beyond</k> this fence.
    - language: 3
      text: "<k>\u67F5\u306E\u5411\u3053\u3046</k>\u306F\u4F55\u3082\u306F\u3063\u304D\u308A<k>\u898B\u3048\u306A\u3044</k>\u3002\u96E8\u3067\u9053\u307E\u3067<k>\u6D88\u3048\u3066\u3057\u307E\u3063\u305F</k>...\u3054\u4E3B\u4EBA\u306F\u3001\u3053\u306E\u67F5\u304B\u3089<k>\u51FA\u3066\u306F</k><k>\u3044\u3051\u306A\u3044</k>\u3068\u8A00\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "<k>\uC6B8\uD0C0\uB9AC \uBC16</k>\uC740 \uC544\uBB34\uAC83\uB3C4 \uC81C\uB300\uB85C
        <k>\uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4</k>. \uBE44\uAC00 \uAE38\uAE4C\uC9C0
        \uC4F8\uC5B4 <k>\uC5C6\uC560 \uBC84\uB838\uB2E4</k>...\uC8FC\uC778\uB2D8\uC740
        \uC774 \uC6B8\uD0C0\uB9AC <k>\uBC16\uC73C\uB85C \uB098\uAC00\uBA74</k> <k>\uC548
        \uB41C\uB2E4</k>\uACE0 \uD558\uC168\uB2E4."
    - language: 5
      text: "Je ne voyais <k>rien clairement</k> <k>au-del\xE0 de la cl\xF4ture</k>.
        La pluie avait <k>emport\xE9</k> la route... Ma ma\xEEtresse m'avait <k>interdit</k>
        de <k>d\xE9passer</k> cette cl\xF4ture."
    - language: 6
      text: "<k>Jenseits des Zauns</k> war <k>nichts klar zu erkennen</k>. Der Regen
        hatte die Stra\xDFe <k>weggesp\xFClt</k>... Meine Herrin hatte mir <k>verboten</k>,
        \xFCber diesen Zaun <k>hinauszugehen</k>."
    - language: 7
      text: "<k>M\xE1s all\xE1 de la valla</k> <k>no se ve</k> nada. La lluvia ha
        <k>borrado</k> el camino... Mi ama dijo que tengo <k>prohibido</k> <k>cruzar</k>
        esta valla."
    - language: 8
      text: "<k>Al\xE9m da cerca</k>, <k>n\xE3o d\xE1 para ver</k> nada. A chuva
        <k>apagou</k> o caminho... Minha dona disse que eu <k>n\xE3o posso</k> <k>passar</k>
        desta cerca."
    - language: 9
      text: "<k>\u0417\u0430 \u043E\u0433\u0440\u0430\u0434\u043E\u0439</k> \u043D\u0438\u0447\u0435\u0433\u043E
        <k>\u043D\u0435 \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C</k>.
        \u0414\u043E\u0436\u0434\u044C \u0434\u0430\u0436\u0435 \u0434\u043E\u0440\u043E\u0433\u0443
        <k>\u0441\u043C\u044B\u043B</k>...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u043C\u043D\u0435
        <k>\u043D\u0435\u043B\u044C\u0437\u044F</k> <k>\u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C</k>
        \u0437\u0430 \u044D\u0442\u0443 \u043E\u0433\u0440\u0430\u0434\u0443."
  - key: os.memory.10650.text
    values:
    - language: 0
      text: "\u9662\u95E8\u7684<k>\u63D2\u9500</k>\u63D2\u5F97\u597D\u597D\u7684\uFF0C\u662F\u4ECE<k>\u91CC\u9762</k>\u63D2\u4E0A\u7684\u3002"
    - language: 1
      text: "\u9662\u9580\u7684<k>\u63D2\u92B7</k>\u63D2\u5F97\u597D\u597D\u7684\uFF0C\u662F\u5F9E<k>\u88E1\u9762</k>\u63D2\u4E0A\u7684\u3002"
    - language: 2
      text: The gate's <k>bolt</k> was securely in place. It had been fastened from
        the <k>inside</k>.
    - language: 3
      text: "\u5EAD\u306E\u9580\u306E<k>\u304B\u3093\u306C\u304D</k>\u306F\u304D\u3061\u3093\u3068\u304B\u304B\u3063\u3066\u3044\u305F\u3002<k>\u5185\u5074</k>\u304B\u3089\u304B\u3051\u3066\u3042\u308B\u3002"
    - language: 4
      text: "\uB9C8\uB2F9 \uBB38\uC758 <k>\uBE57\uC7A5</k>\uC740 \uC81C\uB300\uB85C
        \uAC78\uB824 \uC788\uC5C8\uB2E4. <k>\uC548\uCABD</k>\uC5D0\uC11C \uAC78\uC5B4
        \uB193\uC740 \uAC83\uC774\uB2E4."
    - language: 5
      text: "Le <k>verrou</k> du portail \xE9tait bien ferm\xE9. On l'avait tir\xE9
        de <k>l'int\xE9rieur</k>."
    - language: 6
      text: Der <k>Riegel</k> des Hoftors war fest vorgeschoben. Das Tor war von
        <k>innen</k> verriegelt.
    - language: 7
      text: "El <k>cerrojo</k> de la verja est\xE1 bien echado, desde <k>dentro</k>."
    - language: 8
      text: "O <k>ferrolho</k> do port\xE3o est\xE1 bem fechado, pelo lado de <k>dentro</k>."
    - language: 9
      text: "<k>\u0417\u0430\u0441\u043E\u0432</k> \u043D\u0430 \u043A\u0430\u043B\u0438\u0442\u043A\u0435
        \u043D\u0430\u0434\u0451\u0436\u043D\u043E \u0437\u0430\u043A\u0440\u044B\u0442.
        \u0415\u0433\u043E \u0437\u0430\u043A\u0440\u044B\u043B\u0438 <k>\u0438\u0437\u043D\u0443\u0442\u0440\u0438</k>."
  - key: os.memory.10660.text
    values:
    - language: 0
      text: "<k>\u6811\u53F6</k>\u88AB<k>\u96E8</k>\u6253\u5F97\u4E00\u76F4\u5728\u54CD\uFF0C\u6211\u7AD9\u5728\u6811\u4E0B<k>\u542C</k>\u4E86\u4E00\u4F1A\u513F\uFF0C\u91CC\u9762<k>\u6CA1\u6709\u4E3B\u4EBA</k>\u7684\u58F0\u97F3\u3002"
    - language: 1
      text: "<k>\u6A39\u8449</k>\u88AB<k>\u96E8</k>\u6253\u5F97\u4E00\u76F4\u5728\u97FF\uFF0C\u6211\u7AD9\u5728\u6A39\u4E0B<k>\u807D</k>\u4E86\u4E00\u6703\u5152\uFF0C\u88E1\u9762<k>\u6C92\u6709\u4E3B\u4EBA</k>\u7684\u8072\u97F3\u3002"
    - language: 2
      text: The <k>rain</k> kept rustling the <k>leaves</k>. I stood under the tree
        and <k>listened</k> for a while. I could <k>not hear Master</k>.
    - language: 3
      text: "<k>\u6728\u306E\u8449</k>\u304C<k>\u96E8</k>\u306B\u6253\u305F\u308C\u3066\u3001\u305A\u3063\u3068\u97F3\u3092\u7ACB\u3066\u3066\u3044\u308B\u3002\u6728\u306E\u4E0B\u3067\u3057\u3070\u3089\u304F\u8033\u3092<k>\u6F84\u307E\u305B\u305F</k>\u3051\u308C\u3069\u3001<k>\u3054\u4E3B\u4EBA\u306E\u58F0\u306F\u306A\u304B\u3063\u305F</k>\u3002"
    - language: 4
      text: "<k>\uB098\uBB47\uC78E</k>\uC774 <k>\uBE57\uBB3C</k>\uC5D0 \uB9DE\uC544
        \uB04A\uC784\uC5C6\uC774 \uC18C\uB9AC\uB97C \uB0C8\uB2E4. \uB098\uBB34 \uC544\uB798\uC5D0\uC11C
        \uC7A0\uC2DC \uADC0\uB97C <k>\uAE30\uC6B8\uC600\uC9C0\uB9CC</k>, <k>\uC8FC\uC778\uB2D8\uC758
        \uBAA9\uC18C\uB9AC\uB294 \uC5C6\uC5C8\uB2E4</k>."
    - language: 5
      text: "La <k>pluie</k> faisait bruisser les <k>feuilles</k> sans arr\xEAt.
        Je suis rest\xE9e sous l'arbre \xE0 <k>\xE9couter</k>. Je n'entendais <k>pas
        ma ma\xEEtresse</k>."
    - language: 6
      text: "Der <k>Regen</k> lie\xDF die <k>Bl\xE4tter</k> unaufh\xF6rlich rauschen.
        Ich stand eine Weile unter dem Baum und <k>lauschte</k>. Ich konnte <k>meine
        Herrin nicht h\xF6ren</k>."
    - language: 7
      text: "Las <k>hojas</k> no dejan de sonar bajo la <k>lluvia</k>. Me quedo un
        rato <k>escuchando</k> bajo el \xE1rbol, pero <k>no oigo a mi ama</k>."
    - language: 8
      text: "As <k>folhas</k> fazem barulho sem parar sob a <k>chuva</k>. Fico um
        pouco <k>escutando</k> debaixo da \xE1rvore, mas <k>n\xE3o ou\xE7o minha
        dona</k>."
    - language: 9
      text: "<k>\u041B\u0438\u0441\u0442\u044C\u044F</k> \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E
        \u0448\u0443\u043C\u044F\u0442 \u043F\u043E\u0434 <k>\u0434\u043E\u0436\u0434\u0451\u043C</k>.
        \u042F \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u0430 \u043F\u043E\u0434
        \u0434\u0435\u0440\u0435\u0432\u043E\u043C \u0438 <k>\u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0430\u043B\u0430\u0441\u044C</k>.
        \u0413\u043E\u043B\u043E\u0441\u0430 <k>\u0445\u043E\u0437\u044F\u0439\u043A\u0438
        \u0442\u0430\u043C \u043D\u0435\u0442</k>."
  - key: os.memory.10670.text
    values:
    - language: 0
      text: "\u6652\u8863\u7EF3\u4E0A\u6302\u7740\u4E3B\u4EBA\u7684<k>\u8863\u670D</k>\uFF0C\u5DF2\u7ECF<k>\u6E7F\u900F</k>\u4E86...\u4E3B\u4EBA\u4ECE\u6765<k>\u4E0D\u8BA9</k>\u8863\u670D\u6DCB\u96E8\uFF0C\u4E0B\u96E8\u524D<k>\u5979</k>\u603B\u4F1A\u558A<k>\u6211</k>\u6765<k>\u6536</k>\u3002"
    - language: 1
      text: "\u66EC\u8863\u7E69\u4E0A\u639B\u8457\u4E3B\u4EBA\u7684<k>\u8863\u670D</k>\uFF0C\u5DF2\u7D93<k>\u6EBC\u900F</k>\u4E86...\u4E3B\u4EBA\u5F9E\u4F86<k>\u4E0D\u8B93</k>\u8863\u670D\u6DCB\u96E8\uFF0C\u4E0B\u96E8\u524D<k>\u5979</k>\u7E3D\u6703\u558A<k>\u6211</k>\u4F86<k>\u6536</k>\u3002"
    - language: 2
      text: Master's <k>clothes</k> were hanging on the line, already <k>soaked through</k>...
        Master <k>never let</k> the washing get rained on. Before it rained, <k>she</k>
        always called <k>me</k> to <k>bring it in</k>.
    - language: 3
      text: "\u7269\u5E72\u3057\u7DB1\u306B\u3001\u3054\u4E3B\u4EBA\u306E<k>\u670D</k>\u304C\u639B\u304B\u3063\u3066\u3044\u308B\u3002\u3082\u3046<k>\u3073\u3057\u3087\u6FE1\u308C</k>\u3060...\u3054\u4E3B\u4EBA\u306F\u670D\u3092\u96E8\u306B<k>\u6FE1\u3089\u3055\u305B\u306A\u3044</k>\u3002\u964D\u308A\u59CB\u3081\u308B\u524D\u306B\u3001\u3044\u3064\u3082<k>\u3054\u4E3B\u4EBA</k>\u304C<k>\u79C1</k>\u3092\u547C\u3093\u3067\u3001<k>\u53D6\u308A\u8FBC\u307E\u305B\u3066</k>\u3044\u305F\u3002"
    - language: 4
      text: "\uBE68\uB7AB\uC904\uC5D0 \uC8FC\uC778\uB2D8\uC758 <k>\uC637</k>\uC774
        \uAC78\uB824 \uC788\uB2E4. \uC774\uBBF8 <k>\uD760\uBED1 \uC816\uC5C8\uB2E4</k>...\uC8FC\uC778\uB2D8\uC740
        \uC637\uC774 \uBE44\uB97C \uB9DE\uAC8C <k>\uB450\uC9C0 \uC54A\uC73C\uC2E0\uB2E4</k>.
        \uBE44\uAC00 \uC624\uAE30 \uC804\uC5D0 \uB298 <k>\uC8FC\uC778\uB2D8</k>\uC774
        <k>\uB098</k>\uB97C \uBD88\uB7EC <k>\uAC77\uC5B4 \uC624\uAC8C</k> \uD558\uC168\uB2E4."
    - language: 5
      text: "Les <k>v\xEAtements</k> de ma ma\xEEtresse \xE9taient sur le fil, d\xE9j\xE0
        <k>tremp\xE9s</k>... Elle <k>ne laissait jamais</k> son linge sous la pluie.
        Avant qu'il pleuve, <k>elle</k> <k>m'</k>appelait toujours pour le <k>rentrer</k>."
    - language: 6
      text: "Die <k>Kleidung</k> meiner Herrin hing auf der Leine, schon v\xF6llig
        <k>durchn\xE4sst</k>... Meine Herrin <k>lie\xDF niemals</k> ihre W\xE4sche
        im Regen h\xE4ngen. Vor dem Regen rief <k>sie</k> immer nach <k>mir</k>,
        damit ich sie <k>hereinholte</k>."
    - language: 7
      text: La <k>ropa</k> de mi ama sigue en el tendedero, <k>empapada</k>... Nunca
        <k>deja</k> que se moje. Antes de que llueva, <k>ella</k> siempre <k>me</k>
        llama para <k>recogerla</k>.
    - language: 8
      text: "As <k>roupas</k> da minha dona est\xE3o no varal, <k>encharcadas</k>...
        Ela nunca <k>deixa</k> a roupa tomar chuva. Antes de chover, <k>ela</k> sempre
        chama <k>por mim</k> para <k>recolher</k> tudo."
    - language: 9
      text: "\u041D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0435 \u0432\u0438\u0441\u0438\u0442
        <k>\u043E\u0434\u0435\u0436\u0434\u0430</k> \u0445\u043E\u0437\u044F\u0439\u043A\u0438.
        \u0423\u0436\u0435 <k>\u043F\u0440\u043E\u043C\u043E\u043A\u043B\u0430 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C</k>...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u043D\u0438\u043A\u043E\u0433\u0434\u0430 <k>\u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442</k>
        \u043E\u0434\u0435\u0436\u0434\u0443 \u043F\u043E\u0434 \u0434\u043E\u0436\u0434\u0451\u043C.
        \u041F\u0435\u0440\u0435\u0434 \u0434\u043E\u0436\u0434\u0451\u043C <k>\u043E\u043D\u0430</k>
        \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u043E\u0432\u0451\u0442 <k>\u043C\u0435\u043D\u044F</k>,
        \u0447\u0442\u043E\u0431\u044B \u044F \u0432\u0441\u0451 <k>\u0441\u043D\u044F\u043B\u0430</k>."
  - key: os.memory.10680.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u79CD\u7684<k>\u83DC\u82D7</k>\u88AB\u96E8\u6253<k>\u5012</k>\u4E86\u4E00\u7247\u3002\u5979\u6BCF\u5929\u508D\u665A\u90FD\u8981\u6765\u770B\u4E00\u773C\uFF0C<k>\u4ECA\u5929\u6CA1\u6709\u6765</k>\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u7A2E\u7684<k>\u83DC\u82D7</k>\u88AB\u96E8\u6253<k>\u5012</k>\u4E86\u4E00\u7247\u3002\u5979\u6BCF\u5929\u508D\u665A\u90FD\u8981\u4F86\u770B\u4E00\u773C\uFF0C<k>\u4ECA\u5929\u6C92\u6709\u4F86</k>\u3002"
    - language: 2
      text: The rain had <k>flattened</k> some of Master's <k>vegetable seedlings</k>.
        She came to check on them every evening. <k>She had not come today</k>.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u304C\u690D\u3048\u305F<k>\u91CE\u83DC\u306E\u82D7</k>\u304C\u3001\u96E8\u3067\u3044\u304F\u3064\u3082<k>\u5012\u308C\u3066</k>\u3044\u305F\u3002\u6BCE\u65E5\u5915\u65B9\u306B\u898B\u306B\u6765\u3066\u3044\u305F\u306E\u306B\u3001<k>\u4ECA\u65E5\u306F\u6765\u3066\u3044\u306A\u3044</k>\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC774 \uC2EC\uC740 <k>\uCC44\uC18C \uBAA8\uC885</k>\uC774
        \uBE44\uC5D0 \uB9DE\uC544 \uC5EC\uAE30\uC800\uAE30 <k>\uC4F0\uB7EC\uC838</k>
        \uC788\uB2E4. \uB9E4\uC77C \uC800\uB141 \uD55C \uBC88\uC529 \uBCF4\uB7EC
        \uB098\uC624\uC168\uB294\uB370, <k>\uC624\uB298\uC740 \uC624\uC9C0 \uC54A\uC73C\uC168\uB2E4</k>."
    - language: 5
      text: "La pluie avait <k>couch\xE9</k> une partie des <k>plants de l\xE9gumes</k>
        de ma ma\xEEtresse. Elle venait les voir chaque soir. <k>Elle n'\xE9tait
        pas venue aujourd'hui</k>."
    - language: 6
      text: "Der Regen hatte einige <k>Gem\xFCsesetzlinge</k> meiner Herrin <k>umgeknickt</k>.
        Sie sah jeden Abend nach ihnen. <k>Heute war sie nicht gekommen</k>."
    - language: 7
      text: "La lluvia ha <k>derribado</k> muchas de las <k>plantitas</k> que sembr\xF3
        mi ama. Viene a verlas cada atardecer. <k>Hoy no ha venido</k>."
    - language: 8
      text: "A chuva <k>derrubou</k> muitas das <k>mudas</k> que minha dona plantou.
        Ela vem olhar todo fim de tarde. <k>Hoje n\xE3o veio</k>."
    - language: 9
      text: "<k>\u0420\u0430\u0441\u0441\u0430\u0434\u0430</k>, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
        \u043F\u043E\u0441\u0430\u0434\u0438\u043B\u0430 \u0445\u043E\u0437\u044F\u0439\u043A\u0430,
        <k>\u043F\u043E\u043B\u0435\u0433\u043B\u0430</k> \u043F\u043E\u0434 \u0434\u043E\u0436\u0434\u0451\u043C.
        \u041E\u043D\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440
        \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0430 \u0435\u0451 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C.
        <k>\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0430</k>."
  - key: os.memory.10690.text
    values:
    - language: 0
      text: "<k>\u6211.\u60F3.\u68C0\u67E5.\u4E3B\u4EBA\u623F\u95F4\u7684\u7A97\u6237...</k>"
    - language: 1
      text: "<k>\u6211.\u60F3.\u6AA2\u67E5.\u4E3B\u4EBA\u623F\u9593\u7684\u7A97\u6236...</k>"
    - language: 2
      text: <k>I.want.to.check.Master's.bedroom.window...</k>
    - language: 3
      text: "<k>\u3054\u4E3B\u4EBA\u306E.\u90E8\u5C4B\u306E\u7A93\u3092.\u78BA\u304B\u3081.\u305F\u3044...</k>"
    - language: 4
      text: "<k>\uC8FC\uC778\uB2D8 \uBC29 \uCC3D\uBB38\uC744.\uD655\uC778.\uD558\uACE0
        \uC2F6\uC5B4...</k>"
    - language: 5
      text: "<k>Je.veux.v\xE9rifier.la.fen\xEAtre.de.la.chambre.de.ma.ma\xEEtresse...</k>"
    - language: 6
      text: "<k>Ich.m\xF6chte.das.Schlafzimmerfenster.meiner.Herrin.\xFCberpr\xFCfen...</k>"
    - language: 7
      text: <k>Quiero.revisar.la.ventana.del.dormitorio.de.mi.ama...</k>
    - language: 8
      text: <k>Quero.olhar.a.janela.do.quarto.da.minha.dona...</k>
    - language: 9
      text: "<k>\u042F.\u0445\u043E\u0447\u0443.\u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C.\u043E\u043A\u043D\u043E
        \u0441\u043F\u0430\u043B\u044C\u043D\u0438 \u0445\u043E\u0437\u044F\u0439\u043A\u0438...</k>"
  - key: os.memory.10700.text
    values:
    - language: 0
      text: "\u6211\u7AD9\u5728\u9662\u5B50<k>\u4E2D\u95F4</k>\uFF0C<k>\u96E8</k>\u4E00\u76F4\u5F80\u6211\u8EAB\u4E0A<k>\u6253</k>..."
    - language: 1
      text: "\u6211\u7AD9\u5728\u9662\u5B50<k>\u4E2D\u9593</k>\uFF0C<k>\u96E8</k>\u4E00\u76F4\u5F80\u6211\u8EAB\u4E0A<k>\u6253</k>..."
    - language: 2
      text: I stood in the <k>middle</k> of the yard. The <k>rain</k> kept <k>hitting</k>
        me...
    - language: 3
      text: "\u79C1\u306F\u5EAD\u306E<k>\u771F\u3093\u4E2D</k>\u306B\u7ACB\u3063\u3066\u3044\u305F\u3002<k>\u96E8</k>\u304C\u7D76\u3048\u305A\u4F53\u3092<k>\u6253\u3063\u3066</k>\u3044\u308B..."
    - language: 4
      text: "\uB098\uB294 \uB9C8\uB2F9 <k>\uD55C\uAC00\uC6B4\uB370</k> \uC11C \uC788\uC5C8\uB2E4.
        <k>\uBE44</k>\uAC00 \uB04A\uC784\uC5C6\uC774 \uB0B4 \uBAB8\uC744 <k>\uB54C\uB838\uB2E4</k>..."
    - language: 5
      text: "J'\xE9tais au <k>milieu</k> de la cour. La <k>pluie</k> n'arr\xEAtait
        pas de me <k>frapper</k>..."
    - language: 6
      text: "Ich stand <k>mitten</k> im Hof. Der <k>Regen</k> <k>prasselte</k> unaufh\xF6rlich
        auf mich..."
    - language: 7
      text: Estoy en <k>medio</k> del patio. La <k>lluvia</k> no deja de <k>golpearme</k>...
    - language: 8
      text: "Estou no <k>meio</k> do quintal. A <k>chuva</k> n\xE3o para de <k>bater</k>
        em mim..."
    - language: 9
      text: "\u042F \u0441\u0442\u043E\u044F\u043B\u0430 <k>\u043F\u043E\u0441\u0440\u0435\u0434\u0438</k>
        \u0434\u0432\u043E\u0440\u0430. <k>\u0414\u043E\u0436\u0434\u044C</k> \u0431\u0435\u0437
        \u043A\u043E\u043D\u0446\u0430 <k>\u0431\u0438\u043B</k> \u043F\u043E \u043C\u043D\u0435..."
  - key: os.memory.10710.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u770B\u89C1\u53C8\u8981<k>\u9A82</k>\u6211\u4E86\uFF0C\u5979\u8BF4\u6211\u7684\u5173\u8282\u8FDB\u4E86\u6C34\uFF0C\u4FEE\u8D77\u6765\u6BD4\u4E70\u65B0\u7684\u8FD8\u8D35\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u770B\u898B\u53C8\u8981<k>\u7F75</k>\u6211\u4E86\uFF0C\u5979\u8AAA\u6211\u7684\u95DC\u7BC0\u9032\u4E86\u6C34\uFF0C\u4FEE\u8D77\u4F86\u6BD4\u8CB7\u65B0\u7684\u9084\u8CB4\u3002"
    - language: 2
      text: Master would <k>scold</k> me if she saw this. She said if water got into
        my joints, repairing me would cost more than buying a new one.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306B\u898B\u3064\u304B\u3063\u305F\u3089\u3001\u307E\u305F<k>\u53F1\u3089\u308C\u308B</k>\u3002\u79C1\u306E\u95A2\u7BC0\u306B\u6C34\u304C\u5165\u308B\u3068\u3001\u65B0\u3057\u304F\u8CB7\u3046\u3088\u308A\u4FEE\u7406\u3059\u308B\u307B\u3046\u304C\u9AD8\u3044\u3068\u8A00\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC774 \uBCF4\uC2DC\uBA74 \uB610 <k>\uD63C\uB0B4\uC2E4</k>
        \uAC83\uC774\uB2E4. \uB0B4 \uAD00\uC808\uC5D0 \uBB3C\uC774 \uB4E4\uC5B4\uAC00\uBA74
        \uC0C8\uB85C \uC0AC\uB294 \uAC83\uBCF4\uB2E4 \uC218\uB9AC\uBE44\uAC00 \uB354
        \uB4E0\uB2E4\uACE0 \uD558\uC168\uB2E4."
    - language: 5
      text: "Ma ma\xEEtresse allait encore me <k>gronder</k> si elle me voyait. Elle
        disait que si l'eau entrait dans mes articulations, les r\xE9parations co\xFBteraient
        plus cher qu'un robot neuf."
    - language: 6
      text: "Meine Herrin w\xFCrde wieder <k>schimpfen</k>, wenn sie mich so s\xE4he.
        Sie sagte, wenn Wasser in meine Gelenke k\xE4me, w\xE4re die Reparatur teurer
        als ein neuer Roboter."
    - language: 7
      text: "Mi ama volver\xE1 a <k>re\xF1irme</k> cuando me vea. Dice que si entra
        agua en mis articulaciones, arreglarlas sale m\xE1s caro que comprar otras
        nuevas."
    - language: 8
      text: "Minha dona vai <k>brigar</k> comigo de novo quando me vir. Ela diz que,
        se entrar \xE1gua nas minhas juntas, consertar sai mais caro que comprar
        novas."
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0443\u0432\u0438\u0434\u0438\u0442
        \u0438 \u043E\u043F\u044F\u0442\u044C \u0431\u0443\u0434\u0435\u0442 <k>\u0440\u0443\u0433\u0430\u0442\u044C\u0441\u044F</k>.
        \u041E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E
        \u0435\u0441\u043B\u0438 \u0432\u043E\u0434\u0430 \u043F\u043E\u043F\u0430\u0434\u0451\u0442
        \u043C\u043D\u0435 \u0432 \u0441\u0443\u0441\u0442\u0430\u0432\u044B, \u043F\u043E\u0447\u0438\u043D\u043A\u0430
        \u043E\u0431\u043E\u0439\u0434\u0451\u0442\u0441\u044F \u0434\u043E\u0440\u043E\u0436\u0435
        \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u043D\u043E\u0432\u043E\u0439."
  - key: os.memory.10720.text
    values:
    - language: 0
      text: "\u6CE5\u5730\u4E0A\u53EA\u6709\u6211\u4E00\u4E2A\u4EBA\u7684\u811A\u5370\u3002\u4E3B\u4EBA\u4E0D\u5728\u5916\u9762\u3002"
    - language: 1
      text: "\u6CE5\u5730\u4E0A\u53EA\u6709\u6211\u4E00\u500B\u4EBA\u7684\u8173\u5370\u3002\u4E3B\u4EBA\u4E0D\u5728\u5916\u9762\u3002"
    - language: 2
      text: There was only one set of footprints in the mud. Mine. Master was not
        outside.
    - language: 3
      text: "\u6CE5\u306E\u4E0A\u306B\u306F\u3001\u79C1\u4E00\u4EBA\u306E\u8DB3\u8DE1\u3057\u304B\u306A\u304B\u3063\u305F\u3002\u3054\u4E3B\u4EBA\u306F\u5916\u306B\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uC9C4\uD759 \uC704\uC5D0\uB294 \uB0B4 \uBC1C\uC790\uAD6D\uBC16\uC5D0
        \uC5C6\uC5C8\uB2E4. \uC8FC\uC778\uB2D8\uC740 \uBC16\uC5D0 \uACC4\uC2DC\uC9C0
        \uC54A\uB294\uB2E4."
    - language: 5
      text: "Il n'y avait que mes empreintes dans la boue. Ma ma\xEEtresse n'\xE9tait
        pas dehors."
    - language: 6
      text: "Im Schlamm waren nur meine eigenen Fu\xDFspuren. Meine Herrin war nicht
        drau\xDFen."
    - language: 7
      text: "En el barro solo est\xE1n mis huellas. Mi ama no est\xE1 fuera."
    - language: 8
      text: "S\xF3 tem minhas pegadas na lama. Minha dona n\xE3o est\xE1 l\xE1 fora."
    - language: 9
      text: "\u041D\u0430 \u0433\u0440\u044F\u0437\u043D\u043E\u0439 \u0437\u0435\u043C\u043B\u0435
        \u0431\u044B\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u0438
        \u0441\u043B\u0435\u0434\u044B. \u0425\u043E\u0437\u044F\u0439\u043A\u0438
        \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u043D\u0435\u0442."
  - key: os.memory.10730.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u4E0D\u5728\u5916\u9762\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u4E0D\u5728\u5916\u9762\u3002"
    - language: 2
      text: Master was not outside.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306F\u5916\u306B\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC740 \uBC16\uC5D0 \uACC4\uC2DC\uC9C0 \uC54A\uB294\uB2E4."
    - language: 5
      text: "Ma ma\xEEtresse n'\xE9tait pas dehors."
    - language: 6
      text: "Meine Herrin war nicht drau\xDFen."
    - language: 7
      text: "Mi ama no est\xE1 fuera."
    - language: 8
      text: "Minha dona n\xE3o est\xE1 l\xE1 fora."
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0438 \u0441\u043D\u0430\u0440\u0443\u0436\u0438
        \u043D\u0435\u0442."
  - key: os.memory.10740.text
    values:
    - language: 0
      text: "\u50A8\u7269\u95F4\u7684\u706F\u574F\u4E86\u4E00\u534A\uFF0C\u5269\u4E0B\u90A3\u6839\u706F\u7BA1\u4E00\u76F4\u5728\u95EA\uFF0C\u7BB1\u5B50\u5806\u5F97\u5230\u5904\u90FD\u662F\uFF0C\u7A7A\u6C14\u91CC\u5168\u662F\u7070\u3002"
    - language: 1
      text: "\u5132\u7269\u9593\u7684\u71C8\u58DE\u4E86\u4E00\u534A\uFF0C\u5269\u4E0B\u90A3\u6839\u71C8\u7BA1\u4E00\u76F4\u5728\u9583\uFF0C\u7BB1\u5B50\u5806\u5F97\u5230\u8655\u90FD\u662F\uFF0C\u7A7A\u6C23\u88E1\u5168\u662F\u7070\u3002"
    - language: 2
      text: Half the lights in the storage room were broken. The remaining tube kept
        flickering. Boxes were piled everywhere, and the air was full of dust.
    - language: 3
      text: "\u7269\u7F6E\u306E\u7167\u660E\u306F\u534A\u5206\u58CA\u308C\u3066\u3044\u3066\u3001\u6B8B\u3063\u305F\u4E00\u672C\u306E\u86CD\u5149\u706F\u304C\u305A\u3063\u3068\u70B9\u6EC5\u3057\u3066\u3044\u305F\u3002\u305D\u3053\u3089\u4E2D\u306B\u7BB1\u304C\u7A4D\u307E\u308C\u3001\u7A7A\u6C17\u306F\u307B\u3053\u308A\u3063\u307D\u304B\u3063\u305F\u3002"
    - language: 4
      text: "\uCC3D\uACE0\uC758 \uB4F1\uC740 \uC808\uBC18\uC774 \uACE0\uC7A5 \uB0AC\uACE0,
        \uB0A8\uC740 \uD615\uAD11\uB4F1 \uD558\uB098\uB3C4 \uACC4\uC18D \uAE5C\uBE61\uC600\uB2E4.
        \uC0AC\uBC29\uC5D0 \uC0C1\uC790\uAC00 \uC313\uC5EC \uC788\uACE0, \uACF5\uAE30\uC5D0\uB294
        \uBA3C\uC9C0\uAC00 \uAC00\uB4DD\uD588\uB2E4."
    - language: 5
      text: "La moiti\xE9 des lumi\xE8res du d\xE9barras \xE9taient cass\xE9es. Le
        tube qui restait n'arr\xEAtait pas de clignoter. Des cartons s'empilaient
        partout. L'air \xE9tait plein de poussi\xE8re."
    - language: 6
      text: "Die H\xE4lfte der Lampen im Abstellraum war kaputt. Die \xFCbrige R\xF6hre
        flackerte ununterbrochen. \xDCberall stapelten sich Kartons, die Luft war
        voller Staub."
    - language: 7
      text: "La mitad de las luces del trastero no funciona. El \xFAnico tubo que
        queda parpadea sin parar. Hay cajas por todas partes, y el aire est\xE1 lleno
        de polvo."
    - language: 8
      text: "Metade das luzes do dep\xF3sito queimou. A l\xE2mpada que sobrou n\xE3o
        para de piscar. Tem caixas por toda parte, e o ar est\xE1 cheio de poeira."
    - language: 9
      text: "\u0412 \u043A\u043B\u0430\u0434\u043E\u0432\u043A\u0435 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
        \u043B\u0430\u043C\u043F \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442,
        \u0430 \u043E\u0441\u0442\u0430\u0432\u0448\u0430\u044F\u0441\u044F \u0442\u0440\u0443\u0431\u043A\u0430
        \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u043C\u0438\u0433\u0430\u0435\u0442.
        \u041F\u043E\u0432\u0441\u044E\u0434\u0443 \u043A\u043E\u0440\u043E\u0431\u043A\u0438,
        \u0432\u043E\u0437\u0434\u0443\u0445 \u043F\u043E\u043B\u043E\u043D \u043F\u044B\u043B\u0438."
  - key: os.memory.10750.text
    values:
    - language: 0
      text: "\u549A\u3002"
    - language: 1
      text: "\u549A\u3002"
    - language: 2
      text: Thump.
    - language: 3
      text: "\u30C9\u30AF\u30F3\u3002"
    - language: 4
      text: "\uCFF5."
    - language: 5
      text: Boum.
    - language: 6
      text: Poch.
    - language: 7
      text: Tum.
    - language: 8
      text: Tum.
    - language: 9
      text: "\u0422\u0443\u043A."
  - key: os.memory.10760.text
    values:
    - language: 0
      text: "\u7BB1\u5B50\u4E0A\u90FD\u8D34\u7740\u4E3B\u4EBA\u7684\u5B57\uFF1A\u300C\u65E7\u8863\u670D\u300D\u300C\u5973\u513F\u7684\u4E66\u300D\u300C\u522B\u6254\u300D...\u6700\u540E\u8FD9\u4E2A\u7BB1\u5B50\u4E0A\u8D34\u7684\u5B57\u5979\u5199\u7684\u5F88\u91CD\uFF0C\u53EF\u80FD\u662F\u5F88\u6015\u6211\u6254\u6389\u5427\uFF0C\u4F46\u6211\u4E0D\u53C8\u662F\u90A3\u4E48\u7B28\u86CB\u7684\u673A\u5668\u4EBA.."
    - language: 1
      text: "\u7BB1\u5B50\u4E0A\u90FD\u8CBC\u8457\u4E3B\u4EBA\u7684\u5B57\uFF1A\u300C\u820A\u8863\u670D\u300D\u300C\u5973\u5152\u7684\u66F8\u300D\u300C\u5225\u6254\u300D...\u6700\u5F8C\u9019\u500B\u7BB1\u5B50\u4E0A\u8CBC\u7684\u5B57\u5979\u5BEB\u7684\u5F88\u91CD\uFF0C\u53EF\u80FD\u662F\u5F88\u6015\u6211\u6254\u6389\u5427\uFF0C\u4F46\u6211\u53C8\u4E0D\u662F\u90A3\u9EBC\u7B28\u86CB\u7684\u6A5F\u5668\u4EBA.."
    - language: 2
      text: 'Master had labeled every box: "Old clothes," "My daughter''s books,"
        "Do not throw away"... She had pressed very hard when writing that last label.
        Perhaps she was afraid I would throw it out. But I was not that stupid a
        robot..'
    - language: 3
      text: "\u7BB1\u306B\u306F\u3069\u308C\u3082\u3001\u3054\u4E3B\u4EBA\u306E\u5B57\u3067\u672D\u304C\u8CBC\u3063\u3066\u3042\u308B\u3002\u300C\u53E4\u7740\u300D\u300C\u5A18\u306E\u672C\u300D\u300C\u6368\u3066\u308B\u306A\u300D...\u6700\u5F8C\u306E\u672D\u306F\u3001\u305A\u3044\u3076\u3093\u7B46\u5727\u304C\u5F37\u3044\u3002\u79C1\u306B\u6368\u3066\u3089\u308C\u308B\u306E\u304C\u305D\u3093\u306A\u306B\u5FC3\u914D\u3060\u3063\u305F\u306E\u3060\u308D\u3046\u304B\u3002\u79C1\u3060\u3063\u3066\u3001\u305D\u3053\u307E\u3067\u9593\u629C\u3051\u306A\u30ED\u30DC\u30C3\u30C8\u3058\u3083\u306A\u3044\u306E\u306B.."
    - language: 4
      text: "\uC0C1\uC790\uB9C8\uB2E4 \uC8FC\uC778\uB2D8\uC758 \uAE00\uC528\uAC00
        \uBD99\uC5B4 \uC788\uB2E4. \u2018\uD5CC \uC637\u2019, \u2018\uB538\uC758
        \uCC45\u2019, \u2018\uBC84\uB9AC\uC9C0 \uB9C8\u2019...\uB9C8\uC9C0\uB9C9
        \uC0C1\uC790\uC5D0\uB294 \uC720\uB3C5 \uAFB9\uAFB9 \uB20C\uB7EC \uC4F0\uC168\uB2E4.
        \uB0B4\uAC00 \uBC84\uB9B4\uAE4C \uBD10 \uB9CE\uC774 \uAC71\uC815\uB418\uC168\uB098
        \uBCF4\uB2E4. \uB098\uB3C4 \uADF8\uB807\uAC8C \uBC14\uBCF4 \uAC19\uC740 \uB85C\uBD07\uC740
        \uC544\uB2CC\uB370.."
    - language: 5
      text: "Ma ma\xEEtresse avait \xE9tiquet\xE9 chaque carton : \xAB Vieux v\xEAtements
        \xBB, \xAB Livres de ma fille \xBB, \xAB Ne pas jeter \xBB... Pour ce dernier,
        elle avait appuy\xE9 tr\xE8s fort sur le papier. Elle devait vraiment craindre
        que je le jette. Mais je n'\xE9tais pas un robot si stupide.."
    - language: 6
      text: "Auf den Kartons stand die Schrift meiner Herrin: \u201EAlte Kleidung\u201C,
        \u201EB\xFCcher meiner Tochter\u201C, \u201ENicht wegwerfen\u201C... Beim
        letzten Schild hatte sie stark aufgedr\xFCckt. Sie hatte wohl Angst, ich
        k\xF6nnte den Karton wegwerfen. Aber so ein dummer Roboter war ich nun auch
        wieder nicht.."
    - language: 7
      text: "Las cajas tienen etiquetas escritas por mi ama: \xABRopa vieja\xBB,
        \xABLibros de mi hija\xBB, \xABNo tirar\xBB... En la \xFAltima apret\xF3
        mucho al escribir. Debe de darle miedo que la tire. Pero tampoco soy una
        robot tan tonta.."
    - language: 8
      text: "As caixas t\xEAm etiquetas escritas pela minha dona: \u201CRoupas velhas\u201D,
        \u201CLivros da minha filha\u201D, \u201CN\xE3o jogar fora\u201D... Ela apertou
        muito a caneta nessa \xFAltima. Devia estar com medo de eu jogar fora. Mas
        eu n\xE3o sou uma rob\xF4 t\xE3o boba assim.."
    - language: 9
      text: "\u041D\u0430 \u0432\u0441\u0435\u0445 \u043A\u043E\u0440\u043E\u0431\u043A\u0430\u0445
        \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u0440\u0443\u043A\u043E\u0439
        \u0445\u043E\u0437\u044F\u0439\u043A\u0438: \xAB\u0421\u0442\u0430\u0440\u0430\u044F
        \u043E\u0434\u0435\u0436\u0434\u0430\xBB, \xAB\u041A\u043D\u0438\u0433\u0438
        \u0434\u043E\u0447\u0435\u0440\u0438\xBB, \xAB\u041D\u0435 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0442\u044C\xBB...\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
        \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u043E\u043D\u0430 \u0441\u0438\u043B\u044C\u043D\u043E
        \u043F\u0440\u043E\u0434\u0430\u0432\u0438\u043B\u0430. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u043E\u0447\u0435\u043D\u044C \u0431\u043E\u044F\u043B\u0430\u0441\u044C,
        \u0447\u0442\u043E \u044F \u0432\u044B\u0431\u0440\u043E\u0448\u0443. \u041D\u043E
        \u044F \u0432\u0435\u0434\u044C \u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
        \u0433\u043B\u0443\u043F\u044B\u0439 \u0440\u043E\u0431\u043E\u0442.."
  - key: os.memory.10770.text
    values:
    - language: 0
      text: "\u6709\u4E00\u4E2A\u7BB1\u5B50\u91CC\u662F\u6211\u7684\u65E7\u817F\uFF0C\u5730\u9707\u90A3\u6B21\u538B\u574F\u7684...\u4E3B\u4EBA\u6CA1\u6709\u628A\u5B83\u6254\u6389\uFF0C\u6211\u60F3\u4E0D\u51FA\u7559\u7740\u5B83\u6709\u4EC0\u4E48\u7528..\u5979\u8BF4\u662F\u50CF\u662F\u81EA\u5DF1\u5973\u513F\u7684\u4E73\u7259\uFF0C\u55EF..\u6211\u731C\u662F\u67D0\u79CD\u5C6F\u7269\u7656\uFF1F"
    - language: 1
      text: "\u6709\u4E00\u500B\u7BB1\u5B50\u88E1\u662F\u6211\u7684\u820A\u817F\uFF0C\u5730\u9707\u90A3\u6B21\u58D3\u58DE\u7684...\u4E3B\u4EBA\u6C92\u6709\u628A\u5B83\u6254\u6389\uFF0C\u6211\u60F3\u4E0D\u51FA\u7559\u8457\u5B83\u6709\u4EC0\u9EBC\u7528..\u5979\u8AAA\u50CF\u662F\u81EA\u5DF1\u5973\u5152\u7684\u4E73\u7259\uFF0C\u55EF..\u6211\u731C\u662F\u67D0\u7A2E\u56E4\u7A4D\u7656\uFF1F"
    - language: 2
      text: My old leg was in one of the boxes. It was crushed in the earthquake...
        Master had not thrown it away. I could not see any use for it.. She said
        it was like keeping her daughter's baby teeth. Hmm.. Perhaps she had some
        kind of hoarding habit?
    - language: 3
      text: "\u7BB1\u306E\u4E00\u3064\u306B\u306F\u3001\u5730\u9707\u306E\u3068\u304D\u306B\u6F70\u308C\u305F\u79C1\u306E\u53E4\u3044\u811A\u304C\u5165\u3063\u3066\u3044\u305F...\u3054\u4E3B\u4EBA\u306F\u6368\u3066\u306A\u304B\u3063\u305F\u3002\u6B8B\u3057\u3066\u4F55\u306B\u4F7F\u3046\u306E\u304B\u3001\u79C1\u306B\u306F\u308F\u304B\u3089\u306A\u3044..\u5A18\u306E\u4E73\u6B6F\u307F\u305F\u3044\u306A\u3082\u306E\u3060\u3068\u8A00\u3063\u3066\u3044\u305F\u3002\u3046\u30FC\u3093..\u4F55\u3067\u3082\u305F\u3081\u3066\u304A\u304F\u7656\u306A\u306E\u3060\u308D\u3046\u304B\uFF1F"
    - language: 4
      text: "\uC5B4\uB5A4 \uC0C1\uC790\uC5D0\uB294 \uB0B4 \uC61B\uB0A0 \uB2E4\uB9AC\uAC00
        \uB4E4\uC5B4 \uC788\uB2E4. \uC9C0\uC9C4 \uB54C \uAE54\uB824\uC11C \uB9DD\uAC00\uC9C4
        \uB2E4\uB9AC\uB2E4...\uC8FC\uC778\uB2D8\uC740 \uBC84\uB9AC\uC9C0 \uC54A\uC73C\uC168\uB2E4.
        \uB0A8\uACA8 \uB46C\uC11C \uC5B4\uB514\uC5D0 \uC4F0\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB2E4..\uB538\uC758
        \uC816\uB2C8 \uAC19\uC740 \uAC70\uB77C\uACE0 \uD558\uC168\uB2E4. \uC74C..\uBB50\uB4E0
        \uBAA8\uC544 \uB450\uB294 \uBC84\uB987\uC778\uAC00?"
    - language: 5
      text: "Dans un carton, il y avait mon ancienne jambe, \xE9cras\xE9e lors du
        s\xE9isme... Ma ma\xEEtresse ne l'avait pas jet\xE9e. Je ne voyais pas \xE0
        quoi elle pouvait servir.. Elle disait que c'\xE9tait comme garder les dents
        de lait de sa fille. Hmm.. Une sorte de manie d'accumuler les choses, peut-\xEAtre
        ?"
    - language: 6
      text: "In einem Karton lag mein altes Bein. Es war beim Erdbeben zerquetscht
        worden... Meine Herrin hatte es nicht weggeworfen. Ich wusste nicht, wozu
        sie es aufhob.. Sie sagte, es sei wie die Milchz\xE4hne ihrer Tochter. Hm..
        Vielleicht eine Art Sammelzwang?"
    - language: 7
      text: "En una caja est\xE1 mi vieja pierna, la que qued\xF3 aplastada en el
        terremoto... Mi ama no la tir\xF3. No se me ocurre para qu\xE9 la guardar\xEDa...
        Dijo que era como un diente de leche de su hija. Hmm... \xBFSer\xE1 alguna
        man\xEDa de acumular cosas?"
    - language: 8
      text: "Uma caixa tem minha perna velha, a que foi esmagada no terremoto...
        Minha dona n\xE3o jogou fora. N\xE3o consigo pensar para que guardou... Disse
        que era como um dente de leite da filha. Hum... Acho que \xE9 alguma mania
        de guardar coisas?"
    - language: 9
      text: "\u0412 \u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0431\u043A\u0435
        \u043B\u0435\u0436\u0438\u0442 \u043C\u043E\u044F \u0441\u0442\u0430\u0440\u0430\u044F
        \u043D\u043E\u0433\u0430, \u0440\u0430\u0437\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
        \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u044F...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0435\u0451 \u043D\u0435 \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u043B\u0430.
        \u041D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E,
        \u0437\u0430\u0447\u0435\u043C \u0435\u0451 \u0445\u0440\u0430\u043D\u0438\u0442\u044C..\u041E\u043D\u0430
        \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u044D\u0442\u043E
        \u043A\u0430\u043A \u043C\u043E\u043B\u043E\u0447\u043D\u044B\u0439 \u0437\u0443\u0431
        \u0434\u043E\u0447\u0435\u0440\u0438. \u0425\u043C..\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430
        \u043A\u043E\u043F\u0438\u0442\u044C \u0432\u0435\u0449\u0438?"
  - key: os.memory.10780.text
    values:
    - language: 0
      text: "\u706F\u5149\u4E00\u95EA\u4E00\u95EA\u7684\uFF0C\u76EF\u7740\u5B83\u5BF9\u6211\u7684\u89C6\u89C9\u6A21\u5757\u6709\u70B9\u4E0D\u53CB\u597D.."
    - language: 1
      text: "\u71C8\u5149\u4E00\u9583\u4E00\u9583\u7684\uFF0C\u76EF\u8457\u5B83\u5C0D\u6211\u7684\u8996\u89BA\u6A21\u7D44\u6709\u9EDE\u4E0D\u53CB\u597D.."
    - language: 2
      text: The light kept flickering. Staring at it was not good for my visual module..
    - language: 3
      text: "\u7167\u660E\u304C\u3061\u3089\u3061\u3089\u3057\u3066\u3044\u308B\u3002\u898B\u3064\u3081\u3066\u3044\u308B\u3068\u3001\u8996\u899A\u30E2\u30B8\u30E5\u30FC\u30EB\u306B\u3042\u307E\u308A\u3088\u304F\u306A\u3055\u305D\u3046\u3060.."
    - language: 4
      text: "\uBD88\uBE5B\uC774 \uAE5C\uBE61\uAC70\uB9B0\uB2E4. \uACC4\uC18D \uBCF4\uACE0
        \uC788\uC73C\uBA74 \uC2DC\uAC01 \uBAA8\uB4C8\uC5D0 \uBCC4\uB85C \uC88B\uC9C0
        \uC54A\uC744 \uAC83 \uAC19\uB2E4.."
    - language: 5
      text: "La lumi\xE8re clignotait. La fixer n'\xE9tait pas tr\xE8s bon pour mon
        module visuel.."
    - language: 6
      text: "Das Licht flackerte. Hineinzustarren war nicht besonders gut f\xFCr
        mein Sehmodul.."
    - language: 7
      text: "La luz parpadea sin parar. Mirarla fijamente no le sienta bien a mi
        m\xF3dulo de visi\xF3n.."
    - language: 8
      text: "A luz n\xE3o para de piscar. Ficar olhando para ela n\xE3o faz bem ao
        meu m\xF3dulo de vis\xE3o.."
    - language: 9
      text: "\u041B\u0430\u043C\u043F\u0430 \u043C\u0438\u0433\u0430\u0435\u0442.
        \u0421\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043F\u0440\u044F\u043C\u043E
        \u043D\u0430 \u043D\u0435\u0451 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C
        \u043F\u043E\u043B\u0435\u0437\u043D\u043E \u0434\u043B\u044F \u043C\u043E\u0435\u0433\u043E
        \u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043C\u043E\u0434\u0443\u043B\u044F.."
  - key: os.memory.10790.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u7684\u5DE5\u5177\u90FD\u5728\uFF0C\u53EA\u6709\u4E00\u5957\u624B\u672F\u5200\u7684\u4F4D\u7F6E\u662F\u7A7A\u7684\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u7684\u5DE5\u5177\u90FD\u5728\uFF0C\u53EA\u6709\u4E00\u5957\u624B\u8853\u5200\u7684\u4F4D\u7F6E\u662F\u7A7A\u7684\u3002"
    - language: 2
      text: Master's tools were all here, except for a set of scalpels. Their slot
        was empty.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u9053\u5177\u306F\u5168\u90E8\u3042\u308B\u3002\u30E1\u30B9\u306E\u30BB\u30C3\u30C8\u304C\u3042\u3063\u305F\u5834\u6240\u3060\u3051\u3001\u7A7A\u306B\u306A\u3063\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uB3C4\uAD6C\uB294 \uB2E4 \uC788\uB2E4. \uC218\uC220\uC6A9
        \uCE7C \uD55C \uC138\uD2B8\uAC00 \uC788\uB358 \uC790\uB9AC\uB9CC \uBE44\uC5B4
        \uC788\uB2E4."
    - language: 5
      text: "Les outils de ma ma\xEEtresse \xE9taient tous l\xE0, sauf un jeu de
        scalpels. Leur emplacement \xE9tait vide."
    - language: 6
      text: "Alle Werkzeuge meiner Herrin waren da. Nur der Platz f\xFCr einen Satz
        Skalpelle war leer."
    - language: 7
      text: "Est\xE1n todas las herramientas de mi ama, salvo un juego de bistur\xEDs.
        Su hueco est\xE1 vac\xEDo."
    - language: 8
      text: "Todas as ferramentas da minha dona est\xE3o aqui. S\xF3 o lugar de um
        conjunto de bisturis est\xE1 vazio."
    - language: 9
      text: "\u0412\u0441\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
        \u0445\u043E\u0437\u044F\u0439\u043A\u0438 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435.
        \u041F\u0443\u0441\u0442\u0443\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
        \u043C\u0435\u0441\u0442\u043E \u043E\u0434\u043D\u043E\u0433\u043E \u043D\u0430\u0431\u043E\u0440\u0430
        \u0441\u043A\u0430\u043B\u044C\u043F\u0435\u043B\u0435\u0439."
  - key: os.memory.10800.text
    values:
    - language: 0
      text: "\u5730\u4E0A\u6709\u4E00\u9053\u62D6\u8FC7\u4E1C\u897F\u7684\u75D5\u8FF9\uFF0C\u4ECE\u50A8\u7269\u95F4\u4E00\u76F4\u901A\u5230\u95E8\u5916\uFF0C\u5F80\u5B9E\u9A8C\u5BA4\u7684\u65B9\u5411\u53BB\u4E86\u3002"
    - language: 1
      text: "\u5730\u4E0A\u6709\u4E00\u9053\u62D6\u904E\u6771\u897F\u7684\u75D5\u8DE1\uFF0C\u5F9E\u5132\u7269\u9593\u4E00\u76F4\u901A\u5230\u9580\u5916\uFF0C\u5F80\u5BE6\u9A57\u5BA4\u7684\u65B9\u5411\u53BB\u4E86\u3002"
    - language: 2
      text: There was a drag mark on the floor. It ran out of the storage room and
        toward the laboratory.
    - language: 3
      text: "\u5E8A\u306B\u4F55\u304B\u3092\u5F15\u304D\u305A\u3063\u305F\u8DE1\u304C\u3042\u308B\u3002\u7269\u7F6E\u304B\u3089\u30C9\u30A2\u306E\u5916\u307E\u3067\u7D9A\u304D\u3001\u5B9F\u9A13\u5BA4\u306E\u307B\u3046\u3078\u5411\u304B\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uBC14\uB2E5\uC5D0 \uBB54\uAC00 \uB04C\uACE0 \uAC04 \uC790\uAD6D\uC774
        \uC788\uB2E4. \uCC3D\uACE0\uC5D0\uC11C \uBB38\uBC16\uAE4C\uC9C0 \uC774\uC5B4\uC838
        \uC2E4\uD5D8\uC2E4 \uCABD\uC73C\uB85C \uD5A5\uD588\uB2E4."
    - language: 5
      text: "Quelque chose avait laiss\xE9 une tra\xEEn\xE9e sur le sol. Elle sortait
        du d\xE9barras et se dirigeait vers le laboratoire."
    - language: 6
      text: "Auf dem Boden war eine Schleifspur. Sie f\xFChrte aus dem Abstellraum
        hinaus in Richtung Labor."
    - language: 7
      text: Hay una marca de algo que han arrastrado por el suelo. Sale del trastero
        y va hacia el laboratorio.
    - language: 8
      text: "Tem uma marca de algo arrastado pelo ch\xE3o. Ela sai do dep\xF3sito
        e segue na dire\xE7\xE3o do laborat\xF3rio."
    - language: 9
      text: "\u041F\u043E \u043F\u043E\u043B\u0443 \u0447\u0442\u043E-\u0442\u043E
        \u0432\u043E\u043B\u043E\u043A\u043B\u0438. \u0421\u043B\u0435\u0434 \u0442\u044F\u043D\u0435\u0442\u0441\u044F
        \u0438\u0437 \u043A\u043B\u0430\u0434\u043E\u0432\u043A\u0438 \u0437\u0430
        \u0434\u0432\u0435\u0440\u044C, \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
        \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438."
  - key: os.memory.10810.text
    values:
    - language: 0
      text: "\u67B6\u5B50\u4E0A\u662F\u4E3B\u4EBA\u7684\u5316\u5986\u5305\uFF0C\u62C9\u94FE\u6CA1\u62C9\u597D\uFF0C\u91CC\u9762\u5939\u7740\u4E00\u9875\u7EB8...\u6211\u628A\u7EB8\u62BD\u51FA\u6765\u7684\u65F6\u5019\uFF0C\u4E00\u628A\u5C0F\u94A5\u5319\u8DDF\u7740\u6389\u5230\u4E86\u5730\u4E0A\u3002"
    - language: 1
      text: "\u67B6\u5B50\u4E0A\u662F\u4E3B\u4EBA\u7684\u5316\u599D\u5305\uFF0C\u62C9\u934A\u6C92\u62C9\u597D\uFF0C\u88E1\u9762\u593E\u8457\u4E00\u9801\u7D19...\u6211\u628A\u7D19\u62BD\u51FA\u4F86\u7684\u6642\u5019\uFF0C\u4E00\u628A\u5C0F\u9470\u5319\u8DDF\u8457\u6389\u5230\u4E86\u5730\u4E0A\u3002"
    - language: 2
      text: Master's makeup bag was on the shelf. It was not fully zipped, and a
        sheet of paper was caught inside... When I pulled the paper out, a small
        key fell to the floor with it.
    - language: 3
      text: "\u68DA\u306B\u3054\u4E3B\u4EBA\u306E\u5316\u7CA7\u30DD\u30FC\u30C1\u304C\u3042\u308B\u3002\u30D5\u30A1\u30B9\u30CA\u30FC\u304C\u9589\u307E\u308A\u304D\u3063\u3066\u3044\u306A\u304F\u3066\u3001\u7D19\u304C\u4E00\u679A\u631F\u307E\u3063\u3066\u3044\u305F...\u5F15\u304D\u629C\u304F\u3068\u3001\u5C0F\u3055\u306A\u9375\u3082\u4E00\u7DD2\u306B\u5E8A\u3078\u843D\u3061\u305F\u3002"
    - language: 4
      text: "\uC120\uBC18\uC5D0 \uC8FC\uC778\uB2D8\uC758 \uD654\uC7A5\uD488 \uD30C\uC6B0\uCE58\uAC00
        \uC788\uB2E4. \uC9C0\uD37C\uAC00 \uB35C \uB2EB\uD600 \uC788\uACE0, \uC548\uC5D0
        \uC885\uC774 \uD55C \uC7A5\uC774 \uB07C\uC5B4 \uC788\uC5C8\uB2E4...\uC885\uC774\uB97C
        \uBE7C\uC790 \uC791\uC740 \uC5F4\uC1E0\uB3C4 \uD568\uAED8 \uBC14\uB2E5\uC5D0
        \uB5A8\uC5B4\uC84C\uB2E4."
    - language: 5
      text: "La trousse de maquillage de ma ma\xEEtresse \xE9tait sur l'\xE9tag\xE8re.
        Elle \xE9tait mal ferm\xE9e et une feuille d\xE9passait... Quand j'ai tir\xE9
        la feuille, une petite cl\xE9 est tomb\xE9e par terre."
    - language: 6
      text: "Im Regal lag die Schminktasche meiner Herrin. Der Rei\xDFverschluss
        war nicht ganz zu. Ein Blatt Papier steckte darin... Als ich das Blatt herauszog,
        fiel ein kleiner Schl\xFCssel auf den Boden."
    - language: 7
      text: "En la estanter\xEDa est\xE1 el neceser de maquillaje de mi ama. La cremallera
        est\xE1 mal cerrada y tiene una hoja metida... Al sacarla, una peque\xF1a
        llave cae al suelo."
    - language: 8
      text: "O estojo de maquiagem da minha dona est\xE1 na prateleira. O z\xEDper
        est\xE1 meio aberto, com uma folha presa... Quando puxo o papel, uma chave
        pequena cai no ch\xE3o."
    - language: 9
      text: "\u041D\u0430 \u043F\u043E\u043B\u043A\u0435 \u043A\u043E\u0441\u043C\u0435\u0442\u0438\u0447\u043A\u0430
        \u0445\u043E\u0437\u044F\u0439\u043A\u0438. \u041C\u043E\u043B\u043D\u0438\u044F
        \u0437\u0430\u043A\u0440\u044B\u0442\u0430 \u043D\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430,
        \u0432\u043D\u0443\u0442\u0440\u0438 \u0437\u0430\u0436\u0430\u0442 \u043B\u0438\u0441\u0442
        \u0431\u0443\u043C\u0430\u0433\u0438...\u041A\u043E\u0433\u0434\u0430 \u044F
        \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0430 \u043B\u0438\u0441\u0442,
        \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C \u043D\u0430
        \u043F\u043E\u043B \u0443\u043F\u0430\u043B \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
        \u043A\u043B\u044E\u0447."
  - key: os.memory.10820.text
    values:
    - language: 0
      text: "\u8FD9\u662F\u5367\u5BA4\u7684\u5907\u7528\u94A5\u5319\u3002\u4E3B\u4EBA\u8BF4\u8FC7\uFF0C\u53EA\u6709\u6025\u4E8B\u624D\u80FD\u7528...\u73B0\u5728\u8FD8\u4E0D\u7B97\u6025\u4E8B\u3002"
    - language: 1
      text: "\u9019\u662F\u81E5\u5BA4\u7684\u5099\u7528\u9470\u5319\u3002\u4E3B\u4EBA\u8AAA\u904E\uFF0C\u53EA\u6709\u6025\u4E8B\u624D\u80FD\u7528...\u73FE\u5728\u9084\u4E0D\u7B97\u6025\u4E8B\u3002"
    - language: 2
      text: This was the spare bedroom key. Master said it was for emergencies only...
        This was not an emergency yet.
    - language: 3
      text: "\u5BDD\u5BA4\u306E\u4E88\u5099\u306E\u9375\u3060\u3002\u3054\u4E3B\u4EBA\u306F\u7DCA\u6025\u306E\u3068\u304D\u3060\u3051\u4F7F\u3063\u3066\u3044\u3044\u3068\u8A00\u3063\u3066\u3044\u305F...\u4ECA\u306F\u307E\u3060\u3001\u7DCA\u6025\u3068\u306F\u3044\u3048\u306A\u3044\u3002"
    - language: 4
      text: "\uCE68\uC2E4\uC758 \uC5EC\uBD84 \uC5F4\uC1E0\uB2E4. \uC8FC\uC778\uB2D8\uC740
        \uAE09\uD560 \uB54C\uB9CC \uC4F0\uB77C\uACE0 \uD558\uC168\uB2E4...\uC544\uC9C1\uC740
        \uAE09\uD55C \uC77C\uC774\uB77C\uACE0 \uD560 \uC218 \uC5C6\uB2E4."
    - language: 5
      text: "C'\xE9tait la cl\xE9 de secours de la chambre. Ma ma\xEEtresse avait
        dit : seulement en cas d'urgence... Ce n'\xE9tait pas encore une urgence."
    - language: 6
      text: "Das war der Ersatzschl\xFCssel zum Schlafzimmer. Meine Herrin hatte
        gesagt, nur f\xFCr Notf\xE4lle... Noch war es kein Notfall."
    - language: 7
      text: "Es la llave de repuesto del dormitorio. Mi ama dijo que solo pod\xEDa
        usarla en una emergencia... Esto todav\xEDa no es una emergencia."
    - language: 8
      text: "\xC9 a chave reserva do quarto. Minha dona disse que s\xF3 posso usar
        numa emerg\xEAncia... Ainda n\xE3o \xE9 uma emerg\xEAncia."
    - language: 9
      text: "\u042D\u0442\u043E \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439
        \u043A\u043B\u044E\u0447 \u043E\u0442 \u0441\u043F\u0430\u043B\u044C\u043D\u0438.
        \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
        \u0447\u0442\u043E \u0438\u043C \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
        \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u0440\u0430\u0439\u043D\u0435\u043C
        \u0441\u043B\u0443\u0447\u0430\u0435...\u0421\u0435\u0439\u0447\u0430\u0441
        \u0435\u0449\u0451 \u043D\u0435 \u043A\u0440\u0430\u0439\u043D\u0438\u0439
        \u0441\u043B\u0443\u0447\u0430\u0439."
  - key: os.memory.10830.text
    values:
    - language: 0
      text: "\u8FD9\u662F\u5367\u5BA4\u7684\u5907\u7528\u94A5\u5319\u3002\u4E3B\u4EBA\u8BF4\u8FC7\uFF0C\u53EA\u6709\u6025\u4E8B\u624D\u80FD\u7528\u3002"
    - language: 1
      text: "\u9019\u662F\u81E5\u5BA4\u7684\u5099\u7528\u9470\u5319\u3002\u4E3B\u4EBA\u8AAA\u904E\uFF0C\u53EA\u6709\u6025\u4E8B\u624D\u80FD\u7528\u3002"
    - language: 2
      text: This was the spare bedroom key. Master said it was for emergencies only.
    - language: 3
      text: "\u5BDD\u5BA4\u306E\u4E88\u5099\u306E\u9375\u3060\u3002\u3054\u4E3B\u4EBA\u306F\u7DCA\u6025\u306E\u3068\u304D\u3060\u3051\u4F7F\u3063\u3066\u3044\u3044\u3068\u8A00\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uCE68\uC2E4\uC758 \uC5EC\uBD84 \uC5F4\uC1E0\uB2E4. \uC8FC\uC778\uB2D8\uC740
        \uAE09\uD560 \uB54C\uB9CC \uC4F0\uB77C\uACE0 \uD558\uC168\uB2E4."
    - language: 5
      text: "C'\xE9tait la cl\xE9 de secours de la chambre. Ma ma\xEEtresse avait
        dit : seulement en cas d'urgence."
    - language: 6
      text: "Das war der Ersatzschl\xFCssel zum Schlafzimmer. Meine Herrin hatte
        gesagt, nur f\xFCr Notf\xE4lle."
    - language: 7
      text: "Es la llave de repuesto del dormitorio. Mi ama dijo que solo pod\xEDa
        usarla en una emergencia."
    - language: 8
      text: "\xC9 a chave reserva do quarto. Minha dona disse que s\xF3 posso usar
        numa emerg\xEAncia."
    - language: 9
      text: "\u042D\u0442\u043E \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439
        \u043A\u043B\u044E\u0447 \u043E\u0442 \u0441\u043F\u0430\u043B\u044C\u043D\u0438.
        \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
        \u0447\u0442\u043E \u0438\u043C \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
        \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u0440\u0430\u0439\u043D\u0435\u043C
        \u0441\u043B\u0443\u0447\u0430\u0435."
  - key: os.memory.10840.text
    values:
    - language: 0
      text: "\u6211\u628A\u5730\u4E0A\u7684\u5907\u7528\u94A5\u5319\u6361\u4E86\u8D77\u6765\u3002"
    - language: 1
      text: "\u6211\u628A\u5730\u4E0A\u7684\u5099\u7528\u9470\u5319\u64BF\u4E86\u8D77\u4F86\u3002"
    - language: 2
      text: I picked up the spare key from the floor.
    - language: 3
      text: "\u5E8A\u306E\u4E88\u5099\u306E\u9375\u3092\u62FE\u3044\u4E0A\u3052\u305F\u3002"
    - language: 4
      text: "\uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC9C4 \uC5EC\uBD84 \uC5F4\uC1E0\uB97C
        \uC8FC\uC6E0\uB2E4."
    - language: 5
      text: "J'ai ramass\xE9 la cl\xE9 de secours."
    - language: 6
      text: "Ich hob den Ersatzschl\xFCssel vom Boden auf."
    - language: 7
      text: Recojo del suelo la llave de repuesto.
    - language: 8
      text: "Pego a chave reserva do ch\xE3o."
    - language: 9
      text: "\u042F \u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u0441 \u043F\u043E\u043B\u0430
        \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439 \u043A\u043B\u044E\u0447."
  - key: os.memory.10850.text
    values:
    - language: 0
      text: "\u95E8\u5F00\u4E86\u3002\u4E3B\u4EBA\u7684\u5E8A\u94FA\u5F97\u6574\u6574\u9F50\u9F50\uFF0C\u88AB\u5B50\u53E0\u6210\u4E86\u65B9\u5757...\u4E3B\u4EBA\u4ECE\u6765\u4E0D\u53E0\u88AB\u5B50\uFF0C\u5979\u4E0D\u5728\u8FD9\u91CC\u3002\u56DB\u70B9\u56DB\u5341\u5206\uFF0C\u7A97\u5916\u7684\u5929\u5FEB\u9ED1\u4E86\u3002"
    - language: 1
      text: "\u9580\u958B\u4E86\u3002\u4E3B\u4EBA\u7684\u5E8A\u92EA\u5F97\u6574\u6574\u9F4A\u9F4A\uFF0C\u88AB\u5B50\u758A\u6210\u4E86\u65B9\u584A...\u4E3B\u4EBA\u5F9E\u4F86\u4E0D\u758A\u88AB\u5B50\uFF0C\u5979\u4E0D\u5728\u9019\u88E1\u3002\u56DB\u9EDE\u56DB\u5341\u5206\uFF0C\u7A97\u5916\u7684\u5929\u5FEB\u9ED1\u4E86\u3002"
    - language: 2
      text: The door opened. Master's bed was neatly made, the blanket folded into
        a square... Master never folded her blanket. She was not here. Four forty.
        It was getting dark outside.
    - language: 3
      text: "\u30C9\u30A2\u304C\u958B\u3044\u305F\u3002\u3054\u4E3B\u4EBA\u306E\u30D9\u30C3\u30C9\u306F\u304D\u308C\u3044\u306B\u6574\u3048\u3089\u308C\u3001\u5E03\u56E3\u306F\u56DB\u89D2\u304F\u7573\u307E\u308C\u3066\u3044\u305F...\u3054\u4E3B\u4EBA\u306F\u5E03\u56E3\u3092\u7573\u307E\u306A\u3044\u3002\u3053\u3053\u306B\u306F\u3044\u306A\u3044\u3002\u56DB\u6642\u56DB\u5341\u5206\u3002\u7A93\u306E\u5916\u306F\u3001\u3082\u3046\u3059\u3050\u6697\u304F\u306A\u308B\u3002"
    - language: 4
      text: "\uBB38\uC774 \uC5F4\uB838\uB2E4. \uC8FC\uC778\uB2D8\uC758 \uCE68\uB300\uB294
        \uB9D0\uB054\uD788 \uC815\uB3C8\uB418\uC5B4 \uC788\uACE0, \uC774\uBD88\uC740
        \uB124\uBAA8\uB098\uAC8C \uC811\uD600 \uC788\uC5C8\uB2E4...\uC8FC\uC778\uB2D8\uC740
        \uC774\uBD88\uC744 \uAC1C\uC9C0 \uC54A\uC73C\uC2E0\uB2E4. \uC5EC\uAE30\uC5D0\uB294
        \uC548 \uACC4\uC2E0\uB2E4. \uB124 \uC2DC \uC0AC\uC2ED \uBD84. \uCC3D\uBC16\uC740
        \uACE7 \uC5B4\uB450\uC6CC\uC9C8 \uAC83 \uAC19\uB2E4."
    - language: 5
      text: "La porte s'est ouverte. Le lit de ma ma\xEEtresse \xE9tait bien fait,
        la couverture pli\xE9e en carr\xE9... Ma ma\xEEtresse ne pliait jamais sa
        couverture. Elle n'\xE9tait pas ici. Seize heures quarante. Dehors, la nuit
        approchait."
    - language: 6
      text: "Die T\xFCr ging auf. Das Bett meiner Herrin war ordentlich gemacht,
        die Decke zu einem Quadrat gefaltet... Meine Herrin faltete ihre Decke nie.
        Sie war nicht hier. Sechzehn Uhr vierzig. Drau\xDFen wurde es bald dunkel."
    - language: 7
      text: "La puerta se abre. La cama de mi ama est\xE1 perfectamente hecha, con
        la manta doblada en un cuadrado... Mi ama nunca dobla la manta. No est\xE1
        aqu\xED. Son las cuatro y cuarenta; fuera empieza a anochecer."
    - language: 8
      text: "A porta abre. A cama da minha dona est\xE1 bem arrumada, com o cobertor
        dobrado num quadrado... Minha dona nunca dobra o cobertor. Ela n\xE3o est\xE1
        aqui. Quatro e quarenta. J\xE1 est\xE1 quase escurecendo l\xE1 fora."
    - language: 9
      text: "\u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C.
        \u041A\u0440\u043E\u0432\u0430\u0442\u044C \u0445\u043E\u0437\u044F\u0439\u043A\u0438
        \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0437\u0430\u0441\u0442\u0435\u043B\u0435\u043D\u0430,
        \u043E\u0434\u0435\u044F\u043B\u043E \u0441\u043B\u043E\u0436\u0435\u043D\u043E
        \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043E\u043C...\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
        \u043E\u0434\u0435\u044F\u043B\u043E. \u0415\u0451 \u0437\u0434\u0435\u0441\u044C
        \u043D\u0435\u0442. \u0427\u0435\u0442\u044B\u0440\u0435 \u0441\u043E\u0440\u043E\u043A.
        \u0417\u0430 \u043E\u043A\u043D\u043E\u043C \u0441\u043A\u043E\u0440\u043E
        \u0441\u0442\u0435\u043C\u043D\u0435\u0435\u0442."
  - key: os.memory.10860.text
    values:
    - language: 0
      text: "\u5E8A\u662F\u51B7\u7684\uFF0C\u6628\u665A\u6CA1\u6709\u4EBA\u7761\u5728\u8FD9\u91CC\u3002"
    - language: 1
      text: "\u5E8A\u662F\u51B7\u7684\uFF0C\u6628\u665A\u6C92\u6709\u4EBA\u7761\u5728\u9019\u88E1\u3002"
    - language: 2
      text: The bed was cold. No one had slept here last night.
    - language: 3
      text: "\u30D9\u30C3\u30C9\u306F\u51B7\u305F\u304B\u3063\u305F\u3002\u6628\u591C\u3001\u3053\u3053\u3067\u7720\u3063\u305F\u4EBA\u306F\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uCE68\uB300\uB294 \uCC28\uAC00\uC6E0\uB2E4. \uC5B4\uC82F\uBC24\uC5D0\uB294
        \uC544\uBB34\uB3C4 \uC5EC\uAE30\uC11C \uC790\uC9C0 \uC54A\uC558\uB2E4."
    - language: 5
      text: "Le lit \xE9tait froid. Personne n'y avait dormi cette nuit."
    - language: 6
      text: Das Bett war kalt. Letzte Nacht hatte niemand darin geschlafen.
    - language: 7
      text: "La cama est\xE1 fr\xEDa. Anoche nadie durmi\xF3 aqu\xED."
    - language: 8
      text: "A cama est\xE1 fria. Ningu\xE9m dormiu aqui ontem \xE0 noite."
    - language: 9
      text: "\u041A\u0440\u043E\u0432\u0430\u0442\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F.
        \u041F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u043E\u0447\u044C\u044E
        \u0437\u0434\u0435\u0441\u044C \u043D\u0438\u043A\u0442\u043E \u043D\u0435
        \u0441\u043F\u0430\u043B."
  - key: os.memory.10870.text
    values:
    - language: 0
      text: "\u6211\u628A\u5496\u5561\u653E\u5728\u5E8A\u5934\u67DC\u4E0A\uFF0C\u4E3B\u4EBA\u56DE\u6765\u5C31\u80FD\u559D\u3002"
    - language: 1
      text: "\u6211\u628A\u5496\u5561\u653E\u5728\u5E8A\u982D\u6AC3\u4E0A\uFF0C\u4E3B\u4EBA\u56DE\u4F86\u5C31\u80FD\u559D\u3002"
    - language: 2
      text: I put the coffee on the bedside table. Master could drink it when she
        came back.
    - language: 3
      text: "\u30D9\u30C3\u30C9\u8107\u306E\u30C6\u30FC\u30D6\u30EB\u306B\u30B3\u30FC\u30D2\u30FC\u3092\u7F6E\u3044\u305F\u3002\u3054\u4E3B\u4EBA\u304C\u623B\u3063\u305F\u3089\u98F2\u3081\u308B\u3088\u3046\u306B\u3002"
    - language: 4
      text: "\uCE68\uB300 \uC606 \uD0C1\uC790\uC5D0 \uCEE4\uD53C\uB97C \uB193\uC558\uB2E4.
        \uC8FC\uC778\uB2D8\uC774 \uB3CC\uC544\uC624\uC2DC\uBA74 \uB4DC\uC2E4 \uC218
        \uC788\uAC8C."
    - language: 5
      text: "J'ai pos\xE9 le caf\xE9 sur la table de chevet. Ma ma\xEEtresse pourrait
        le boire \xE0 son retour."
    - language: 6
      text: "Ich stellte den Kaffee auf den Nachttisch. Meine Herrin konnte ihn trinken,
        wenn sie zur\xFCckkam."
    - language: 7
      text: "Dejo el caf\xE9 en la mesilla. As\xED mi ama podr\xE1 beberlo cuando
        vuelva."
    - language: 8
      text: "Deixo o caf\xE9 na mesa de cabeceira. Minha dona pode tomar quando voltar."
    - language: 9
      text: "\u042F \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u043A\u043E\u0444\u0435
        \u043D\u0430 \u043F\u0440\u0438\u043A\u0440\u043E\u0432\u0430\u0442\u043D\u0443\u044E
        \u0442\u0443\u043C\u0431\u043E\u0447\u043A\u0443. \u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0441\u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u043F\u0438\u0442\u044C
        \u0435\u0433\u043E, \u043A\u043E\u0433\u0434\u0430 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F."
  - key: os.memory.10880.text
    values:
    - language: 0
      text: "\u5E8A\u5934\u67DC\u8FB9\u4E0A\u653E\u7740\u4E00\u5C01\u4FE1\uFF0C\u4FE1\u5C01\u4E0A\u53EA\u5199\u4E86\u300C\u4EB2\u7231\u7684\u300D\uFF0C\u6CA1\u6709\u5730\u5740\u3002"
    - language: 1
      text: "\u5E8A\u982D\u6AC3\u908A\u4E0A\u653E\u8457\u4E00\u5C01\u4FE1\uFF0C\u4FE1\u5C01\u4E0A\u53EA\u5BEB\u4E86\u300C\u89AA\u611B\u7684\u300D\uFF0C\u6C92\u6709\u5730\u5740\u3002"
    - language: 2
      text: A letter lay beside the bedside table. There was no address on the envelope.
        It only said, "My dear."
    - language: 3
      text: "\u30D9\u30C3\u30C9\u8107\u306E\u30C6\u30FC\u30D6\u30EB\u306E\u305D\u3070\u306B\u624B\u7D19\u304C\u3042\u3063\u305F\u3002\u5C01\u7B52\u306B\u306F\u300C\u3042\u306A\u305F\u3078\u300D\u3068\u3060\u3051\u66F8\u304B\u308C\u3066\u3044\u3066\u3001\u4F4F\u6240\u306F\u306A\u3044\u3002"
    - language: 4
      text: "\uCE68\uB300 \uC606 \uD0C1\uC790 \uBD80\uADFC\uC5D0 \uD3B8\uC9C0 \uD55C
        \uD1B5\uC774 \uB193\uC5EC \uC788\uB2E4. \uBD09\uD22C\uC5D0\uB294 \u2018\uB2F9\uC2E0\uC5D0\uAC8C\u2019\uB77C\uACE0\uB9CC
        \uC4F0\uC5EC \uC788\uACE0 \uC8FC\uC18C\uB294 \uC5C6\uB2E4."
    - language: 5
      text: "Une lettre \xE9tait pos\xE9e pr\xE8s de la table de chevet. Il n'y avait
        pas d'adresse sur l'enveloppe. Seulement les mots \xAB Mon ch\xE9ri \xBB."
    - language: 6
      text: "Neben dem Nachttisch lag ein Brief. Auf dem Umschlag stand nur \u201EMein
        Lieber\u201C. Keine Adresse."
    - language: 7
      text: "Junto a la mesilla hay una carta. En el sobre solo pone \xABQuerido\xBB.
        No hay direcci\xF3n."
    - language: 8
      text: "Tem uma carta ao lado da mesa de cabeceira. No envelope s\xF3 est\xE1
        escrito \u201CQuerido\u201D. N\xE3o tem endere\xE7o."
    - language: 9
      text: "\u0420\u044F\u0434\u043E\u043C \u0441 \u043F\u0440\u0438\u043A\u0440\u043E\u0432\u0430\u0442\u043D\u043E\u0439
        \u0442\u0443\u043C\u0431\u043E\u0447\u043A\u043E\u0439 \u043B\u0435\u0436\u0438\u0442
        \u043F\u0438\u0441\u044C\u043C\u043E. \u041D\u0430 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0435
        \u0442\u043E\u043B\u044C\u043A\u043E \xAB\u0414\u043E\u0440\u043E\u0433\u043E\u043C\u0443\xBB.
        \u0410\u0434\u0440\u0435\u0441\u0430 \u043D\u0435\u0442."
  - key: os.memory.10890.text
    values:
    - language: 0
      text: "\u7A97\u5916\u7684\u5929\u662F\u7070\u8272\u7684\uFF0C\u65B0\u5BB6\u8FD9\u8FB9\u7684\u8857\u4E0A\u4E00\u4E2A\u4EBA\u90FD\u6CA1\u6709\u3002\u4E3B\u4EBA\u8BF4\u8FC7\uFF0C\u5916\u9762\u6BD4\u5BB6\u91CC\u5371\u9669\u3002"
    - language: 1
      text: "\u7A97\u5916\u7684\u5929\u662F\u7070\u8272\u7684\uFF0C\u65B0\u5BB6\u9019\u908A\u7684\u8857\u4E0A\u4E00\u500B\u4EBA\u90FD\u6C92\u6709\u3002\u4E3B\u4EBA\u8AAA\u904E\uFF0C\u5916\u9762\u6BD4\u5BB6\u88E1\u5371\u96AA\u3002"
    - language: 2
      text: The sky outside was gray. There was no one on the street by our new home.
        Master said it was more dangerous outside than inside.
    - language: 3
      text: "\u7A93\u306E\u5916\u306F\u7070\u8272\u3060\u3063\u305F\u3002\u65B0\u3057\u3044\u5BB6\u306E\u3042\u308B\u3053\u306E\u901A\u308A\u306B\u306F\u3001\u4EBA\u5F71\u304C\u306A\u3044\u3002\u5916\u306F\u5BB6\u306E\u4E2D\u3088\u308A\u5371\u306A\u3044\u3068\u3001\u3054\u4E3B\u4EBA\u306F\u8A00\u3063\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uCC3D\uBC16 \uD558\uB298\uC740 \uD68C\uC0C9\uC774\uB2E4. \uC0C8\uC9D1
        \uC55E \uAC70\uB9AC\uC5D0\uB294 \uC0AC\uB78C\uC774 \uD55C \uBA85\uB3C4 \uC5C6\uB2E4.
        \uC8FC\uC778\uB2D8\uC740 \uC9D1 \uC548\uBCF4\uB2E4 \uBC16\uC774 \uC704\uD5D8\uD558\uB2E4\uACE0
        \uD558\uC168\uB2E4."
    - language: 5
      text: "Le ciel \xE9tait gris. La rue pr\xE8s de notre nouvelle maison \xE9tait
        d\xE9serte. Ma ma\xEEtresse disait que c'\xE9tait plus dangereux dehors que
        chez nous."
    - language: 6
      text: "Der Himmel drau\xDFen war grau. Auf der Stra\xDFe vor unserem neuen
        Zuhause war niemand. Meine Herrin sagte, drau\xDFen sei es gef\xE4hrlicher
        als im Haus."
    - language: 7
      text: "El cielo est\xE1 gris al otro lado de la ventana. No hay nadie en la
        calle de nuestra nueva casa. Mi ama dice que fuera es m\xE1s peligroso que
        dentro."
    - language: 8
      text: "O c\xE9u est\xE1 cinza pela janela. N\xE3o tem ningu\xE9m na rua desta
        casa nova. Minha dona disse que l\xE1 fora \xE9 mais perigoso que aqui dentro."
    - language: 9
      text: "\u0417\u0430 \u043E\u043A\u043D\u043E\u043C \u0441\u0435\u0440\u043E\u0435
        \u043D\u0435\u0431\u043E. \u041D\u0430 \u0443\u043B\u0438\u0446\u0435 \u0443
        \u043D\u0430\u0448\u0435\u0433\u043E \u043D\u043E\u0432\u043E\u0433\u043E
        \u0434\u043E\u043C\u0430 \u043D\u0438 \u0434\u0443\u0448\u0438. \u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u0441\u043D\u0430\u0440\u0443\u0436\u0438
        \u043E\u043F\u0430\u0441\u043D\u0435\u0435, \u0447\u0435\u043C \u0434\u043E\u043C\u0430."
  - key: os.memory.10900.text
    values:
    - language: 0
      text: "\u8863\u67DC\u91CC\u4E3B\u4EBA\u7684\u8863\u670D\u5C11\u4E86\u4E00\u4EF6\uFF0C\u662F\u5979\u505A\u5B9E\u9A8C\u7A7F\u7684\u90A3\u4EF6\u767D\u5927\u8902\u3002"
    - language: 1
      text: "\u8863\u6AC3\u88E1\u4E3B\u4EBA\u7684\u8863\u670D\u5C11\u4E86\u4E00\u4EF6\uFF0C\u662F\u5979\u505A\u5BE6\u9A57\u7A7F\u7684\u90A3\u4EF6\u767D\u888D\u3002"
    - language: 2
      text: One piece of clothing was missing from Master's wardrobe. The white coat
        she wore for experiments.
    - language: 3
      text: "\u30AF\u30ED\u30FC\u30BC\u30C3\u30C8\u304B\u3089\u3001\u3054\u4E3B\u4EBA\u306E\u670D\u304C\u4E00\u7740\u306A\u304F\u306A\u3063\u3066\u3044\u308B\u3002\u5B9F\u9A13\u306E\u3068\u304D\u306B\u7740\u308B\u767D\u8863\u3060\u3002"
    - language: 4
      text: "\uC637\uC7A5\uC5D0 \uC8FC\uC778\uB2D8\uC758 \uC637\uC774 \uD55C \uBC8C
        \uC5C6\uB2E4. \uC2E4\uD5D8\uD560 \uB54C \uC785\uC73C\uC2DC\uB294 \uD770 \uAC00\uC6B4\uC774\uB2E4."
    - language: 5
      text: "Il manquait un v\xEAtement dans l'armoire de ma ma\xEEtresse. La blouse
        blanche qu'elle portait pour ses exp\xE9riences."
    - language: 6
      text: "Im Kleiderschrank meiner Herrin fehlte ein Kleidungsst\xFCck. Der wei\xDFe
        Kittel, den sie f\xFCr ihre Experimente trug."
    - language: 7
      text: 'En el armario falta una prenda de mi ama: la bata blanca que lleva para
        hacer experimentos.'
    - language: 8
      text: "Falta uma roupa da minha dona no arm\xE1rio: o jaleco branco que ela
        usa nos experimentos."
    - language: 9
      text: "\u0412 \u0448\u043A\u0430\u0444\u0443 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
        \u043E\u0434\u043D\u043E\u0439 \u0432\u0435\u0449\u0438 \u0445\u043E\u0437\u044F\u0439\u043A\u0438.
        \u0411\u0435\u043B\u043E\u0433\u043E \u0445\u0430\u043B\u0430\u0442\u0430,
        \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043E\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
        \u043E\u043F\u044B\u0442\u044B."
  - key: os.memory.10910.text
    values:
    - language: 0
      text: "\u7ACB\u706F\u5F00\u7740\uFF0C\u4F46\u662F\u4E3B\u4EBA\u4E0D\u5728\u5367\u5BA4...\u6216\u8BB8\u5728\u91CC\u5934\u7684\u536B\u751F\u95F4\uFF1F"
    - language: 1
      text: "\u7ACB\u71C8\u958B\u8457\uFF0C\u4F46\u662F\u4E3B\u4EBA\u4E0D\u5728\u81E5\u5BA4...\u6216\u8A31\u5728\u88E1\u982D\u7684\u6D74\u5BA4\uFF1F"
    - language: 2
      text: The standing lamp was on, but Master was not in the bedroom... Perhaps
        she was in the bathroom further in?
    - language: 3
      text: "\u30D5\u30ED\u30A2\u30E9\u30F3\u30D7\u306F\u3064\u3044\u3066\u3044\u308B\u3002\u3067\u3082\u3001\u3054\u4E3B\u4EBA\u306F\u5BDD\u5BA4\u306B\u3044\u306A\u3044...\u5965\u306E\u6D17\u9762\u6240\u306B\u3044\u308B\u306E\u3060\u308D\u3046\u304B\uFF1F"
    - language: 4
      text: "\uC7A5\uC2A4\uD0E0\uB4DC\uB294 \uCF1C\uC838 \uC788\uC9C0\uB9CC, \uC8FC\uC778\uB2D8\uC740
        \uCE68\uC2E4\uC5D0 \uC548 \uACC4\uC2E0\uB2E4...\uC548\uCABD \uC695\uC2E4\uC5D0
        \uACC4\uC2E4\uAE4C?"
    - language: 5
      text: "Le lampadaire \xE9tait allum\xE9, mais ma ma\xEEtresse n'\xE9tait pas
        dans la chambre... Peut-\xEAtre dans la salle de bains, au fond ?"
    - language: 6
      text: Die Stehlampe war an, aber meine Herrin war nicht im Schlafzimmer...
        Vielleicht im Bad dahinter?
    - language: 7
      text: "La l\xE1mpara de pie est\xE1 encendida, pero mi ama no est\xE1 en el
        dormitorio... \xBFEstar\xE1 en el ba\xF1o de dentro?"
    - language: 8
      text: "A lumin\xE1ria de ch\xE3o est\xE1 acesa, mas minha dona n\xE3o est\xE1
        no quarto... Ser\xE1 que est\xE1 no banheiro l\xE1 dentro?"
    - language: 9
      text: "\u0422\u043E\u0440\u0448\u0435\u0440 \u0433\u043E\u0440\u0438\u0442,
        \u043D\u043E \u0445\u043E\u0437\u044F\u0439\u043A\u0438 \u0432 \u0441\u043F\u0430\u043B\u044C\u043D\u0435
        \u043D\u0435\u0442...\u041C\u043E\u0436\u0435\u0442, \u043E\u043D\u0430 \u0432
        \u0432\u0430\u043D\u043D\u043E\u0439, \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435
        \u043A\u043E\u043C\u043D\u0430\u0442\u044B?"
  - key: os.memory.10920.text
    values:
    - language: 0
      text: "\u5E8A\u5934\u67DC\u4E0A\u7A7A\u7A7A\u7684\u3002"
    - language: 1
      text: "\u5E8A\u982D\u6AC3\u4E0A\u7A7A\u7A7A\u7684\u3002"
    - language: 2
      text: The bedside table was empty.
    - language: 3
      text: "\u30D9\u30C3\u30C9\u8107\u306E\u30C6\u30FC\u30D6\u30EB\u306B\u306F\u4F55\u3082\u306A\u3044\u3002"
    - language: 4
      text: "\uCE68\uB300 \uC606 \uD0C1\uC790\uB294 \uD145 \uBE44\uC5B4 \uC788\uB2E4."
    - language: 5
      text: "La table de chevet \xE9tait vide."
    - language: 6
      text: Der Nachttisch war leer.
    - language: 7
      text: "La mesilla est\xE1 vac\xEDa."
    - language: 8
      text: "A mesa de cabeceira est\xE1 vazia."
    - language: 9
      text: "\u041F\u0440\u0438\u043A\u0440\u043E\u0432\u0430\u0442\u043D\u0430\u044F
        \u0442\u0443\u043C\u0431\u043E\u0447\u043A\u0430 \u043F\u0443\u0441\u0442\u0430."
  - key: os.memory.9000.text
    values:
    - language: 0
      text: "\u536B\u751F\u95F4\u5F88\u7A84\uFF0C\u6C34\u6C60\u5728\u6EF4\u6C34\uFF0C\u4E00\u6EF4\u4E00\u6EF4\u7684\u3002\u6D17\u624B\u53F0\u4E0A\u4E3B\u4EBA\u7684\u7259\u5237\u662F\u5E72\u7684\u3002"
    - language: 1
      text: "\u6D74\u5BA4\u5F88\u7A84\uFF0C\u6C34\u6C60\u5728\u6EF4\u6C34\uFF0C\u4E00\u6EF4\u4E00\u6EF4\u7684\u3002\u6D17\u624B\u6AAF\u4E0A\u4E3B\u4EBA\u7684\u7259\u5237\u662F\u4E7E\u7684\u3002"
    - language: 2
      text: The bathroom was narrow. The sink was dripping, one drop at a time. Master's
        toothbrush on the basin was dry.
    - language: 3
      text: "\u6D17\u9762\u6240\u306F\u72ED\u304F\u3066\u3001\u6D17\u9762\u53F0\u306B\u6C34\u304C\u4E00\u6EF4\u305A\u3064\u843D\u3061\u3066\u3044\u305F\u3002\u3054\u4E3B\u4EBA\u306E\u6B6F\u30D6\u30E9\u30B7\u306F\u4E7E\u3044\u3066\u3044\u305F\u3002"
    - language: 4
      text: "\uC695\uC2E4\uC740 \uC881\uC558\uB2E4. \uC138\uBA74\uB300\uC5D0\uC11C
        \uBB3C\uC774 \uD55C \uBC29\uC6B8\uC529 \uB611\uB611 \uB5A8\uC5B4\uC84C\uB2E4.
        \uC138\uBA74\uB300 \uC704 \uC8FC\uC778\uB2D8\uC758 \uCE6B\uC194\uC740 \uB9D0\uB77C
        \uC788\uC5C8\uB2E4."
    - language: 5
      text: "La salle de bains \xE9tait \xE9troite. Le robinet fuyait, goutte apr\xE8s
        goutte. La brosse \xE0 dents de ma ma\xEEtresse, sur le lavabo, \xE9tait
        s\xE8che."
    - language: 6
      text: "Das Bad war eng. Der Wasserhahn tropfte, Tropfen f\xFCr Tropfen. Die
        Zahnb\xFCrste meiner Herrin am Waschbecken war trocken."
    - language: 7
      text: "El ba\xF1o es muy estrecho. El grifo gotea, gota a gota. El cepillo
        de dientes de mi ama est\xE1 seco sobre el lavabo."
    - language: 8
      text: "O banheiro \xE9 bem estreito. A torneira est\xE1 pingando, gota por
        gota. A escova de dentes da minha dona est\xE1 seca sobre a pia."
    - language: 9
      text: "\u0412\u0430\u043D\u043D\u0430\u044F \u0442\u0435\u0441\u043D\u0430\u044F.
        \u0412 \u0440\u0430\u043A\u043E\u0432\u0438\u043D\u0443 \u043A\u0430\u043F\u0430\u0435\u0442
        \u0432\u043E\u0434\u0430, \u043A\u0430\u043F\u043B\u044F \u0437\u0430 \u043A\u0430\u043F\u043B\u0435\u0439.
        \u0417\u0443\u0431\u043D\u0430\u044F \u0449\u0451\u0442\u043A\u0430 \u0445\u043E\u0437\u044F\u0439\u043A\u0438
        \u043D\u0430 \u0443\u043C\u044B\u0432\u0430\u043B\u044C\u043D\u0438\u043A\u0435
        \u0441\u0443\u0445\u0430\u044F."
  - key: os.memory.9010.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u7684\u836F\u5403\u5B8C\u4E86\uFF0C\u5907\u7528\u7684\u5C31\u653E\u5728\u955C\u67DC\u91CC...\u6211\u6253\u5F00\u955C\u67DC\uFF0C\u653E\u836F\u7684\u90A3\u4E00\u683C\u4E5F\u662F\u7A7A\u7684\uFF0C\u91CC\u9762\u53EA\u8D34\u7740\u4E00\u5F20\u4FBF\u6761\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u7684\u85E5\u5403\u5B8C\u4E86\uFF0C\u5099\u7528\u7684\u5C31\u653E\u5728\u93E1\u6AC3\u88E1...\u6211\u6253\u958B\u93E1\u6AC3\uFF0C\u653E\u85E5\u7684\u90A3\u4E00\u683C\u4E5F\u662F\u7A7A\u7684\uFF0C\u88E1\u9762\u53EA\u8CBC\u8457\u4E00\u5F35\u4FBF\u689D\u3002"
    - language: 2
      text: Master had run out of medicine. The spare supply was in the mirrored
        cabinet... I opened it. That compartment was empty too. There was only a
        note stuck inside.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u85AC\u306F\u306A\u304F\u306A\u3063\u3066\u3044\u305F\u3002\u4E88\u5099\u306F\u93E1\u306E\u88CF\u306E\u68DA\u306B\u3042\u308B...\u958B\u3051\u3066\u307F\u308B\u3068\u3001\u85AC\u3092\u7F6E\u304F\u6BB5\u3082\u7A7A\u3067\u3001\u30E1\u30E2\u304C\u4E00\u679A\u8CBC\u3063\u3066\u3042\u308B\u3060\u3051\u3060\u3063\u305F\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uC57D\uC740 \uB2E4 \uB5A8\uC5B4\uC84C\uB2E4.
        \uC5EC\uBD84\uC740 \uAC70\uC6B8 \uC218\uB0A9\uC7A5\uC5D0 \uC788\uB2E4...\uC218\uB0A9\uC7A5\uC744
        \uC5F4\uC5C8\uC9C0\uB9CC, \uC57D\uC744 \uB450\uB294 \uCE78\uB3C4 \uBE44\uC5B4
        \uC788\uC5C8\uB2E4. \uC548\uC5D0\uB294 \uCABD\uC9C0 \uD55C \uC7A5\uB9CC \uBD99\uC5B4
        \uC788\uC5C8\uB2E4."
    - language: 5
      text: "Ma ma\xEEtresse n'avait plus de m\xE9dicaments. La r\xE9serve \xE9tait
        dans l'armoire \xE0 miroir... Je l'ai ouverte. Le compartiment \xE9tait vide
        lui aussi. Il n'y avait qu'un mot coll\xE9 \xE0 l'int\xE9rieur."
    - language: 6
      text: "Die Medikamente meiner Herrin waren aufgebraucht. Der Vorrat lag im
        Spiegelschrank... Ich \xF6ffnete ihn. Auch dieses Fach war leer. Nur ein
        Zettel klebte darin."
    - language: 7
      text: "Las medicinas de mi ama se han acabado. Las de reserva est\xE1n en el
        armario del espejo... Lo abro. El compartimento tambi\xE9n est\xE1 vac\xEDo.
        Solo hay una nota pegada dentro."
    - language: 8
      text: "Os rem\xE9dios da minha dona acabaram. Os de reserva ficam no arm\xE1rio
        do espelho... Eu abro. O espa\xE7o dos rem\xE9dios tamb\xE9m est\xE1 vazio.
        S\xF3 tem um bilhete colado l\xE1 dentro."
    - language: 9
      text: "\u041B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430 \u0445\u043E\u0437\u044F\u0439\u043A\u0438
        \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C. \u0417\u0430\u043F\u0430\u0441\u043D\u044B\u0435
        \u043B\u0435\u0436\u0430\u0442 \u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u043E\u043C
        \u0448\u043A\u0430\u0444\u0447\u0438\u043A\u0435...\u042F \u043E\u0442\u043A\u0440\u044B\u043B\u0430
        \u0435\u0433\u043E, \u043D\u043E \u043F\u043E\u043B\u043A\u0430 \u0434\u043B\u044F
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432 \u0442\u043E\u0436\u0435
        \u043F\u0443\u0441\u0442\u0430. \u0412\u043D\u0443\u0442\u0440\u0438 \u043F\u0440\u0438\u043A\u043B\u0435\u0435\u043D\u0430
        \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u043F\u0438\u0441\u043A\u0430."
  - key: os.memory.9015.text
    values:
    - language: 0
      text: "\u597D\u5B69\u5B50\u2026\u2026\u5988\u5988\u2026\u2026\u4E3B\u4EBA\u4ECE\u6765\u4E0D\u8FD9\u6837\u53EB\u6211\uFF0C\u4E5F\u4ECE\u6765\u4E0D\u8FD9\u6837\u53EB\u81EA\u5DF1\u3002\u6211\u6765\u5230\u8FD9\u4E2A\u5BB6\u7684\u90A3\u5929\uFF0C\u6211\u5F53\u7136\u8BB0\u5F97\u3002"
    - language: 1
      text: "\u597D\u5B69\u5B50\u2026\u2026\u5ABD\u5ABD\u2026\u2026\u4E3B\u4EBA\u5F9E\u4F86\u4E0D\u9019\u6A23\u53EB\u6211\uFF0C\u4E5F\u5F9E\u4F86\u4E0D\u9019\u6A23\u53EB\u81EA\u5DF1\u3002\u6211\u4F86\u5230\u9019\u500B\u5BB6\u7684\u90A3\u5929\uFF0C\u6211\u7576\u7136\u8A18\u5F97\u3002"
    - language: 2
      text: Good girl... Mom... Master never called me that. She never called herself
        that either. The day I came to this home. Of course I remembered.
    - language: 3
      text: "\u3044\u3044\u5B50\u2026\u2026\u304A\u6BCD\u3055\u3093\u2026\u2026\u3054\u4E3B\u4EBA\u306F\u79C1\u3092\u305D\u3046\u547C\u3093\u3060\u3053\u3068\u3082\u3001\u81EA\u5206\u3092\u305D\u3046\u547C\u3093\u3060\u3053\u3068\u3082\u306A\u3044\u3002\u79C1\u304C\u3053\u306E\u5BB6\u306B\u6765\u305F\u65E5\u306A\u3089\u3001\u3082\u3061\u308D\u3093\u899A\u3048\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uCC29\uD55C \uC544\uC774\u2026\u2026\uC5C4\uB9C8\u2026\u2026\uC8FC\uC778\uB2D8\uC740
        \uB098\uB97C \uADF8\uB807\uAC8C \uBD80\uB978 \uC801\uB3C4, \uC790\uC2E0\uC744
        \uADF8\uB807\uAC8C \uBD80\uB978 \uC801\uB3C4 \uC5C6\uB2E4. \uB0B4\uAC00 \uC774
        \uC9D1\uC5D0 \uC628 \uB0A0\uC740 \uB2F9\uC5F0\uD788 \uAE30\uC5B5\uD55C\uB2E4."
    - language: 5
      text: "Ma gentille fille... Maman... Ma ma\xEEtresse ne m'appelait jamais comme
        \xE7a. Elle ne se d\xE9signait jamais comme \xE7a non plus. Le jour o\xF9
        j'\xE9tais arriv\xE9e dans cette maison. Bien s\xFBr que je m'en souvenais."
    - language: 6
      text: "Braves M\xE4dchen... Mama... Meine Herrin nannte mich nie so. Sich selbst
        nannte sie auch nie so. Der Tag, an dem ich in dieses Haus kam. Nat\xFCrlich
        erinnerte ich mich daran."
    - language: 7
      text: "Buena ni\xF1a... Mam\xE1... Mi ama nunca me llama as\xED, ni se llama
        a s\xED misma as\xED. El d\xEDa que llegu\xE9 a esta casa, claro que lo recuerdo."
    - language: 8
      text: "Boa menina... Mam\xE3e... Minha dona nunca me chama assim, nem chama
        a si mesma assim. O dia em que cheguei a esta casa, claro que eu lembro."
    - language: 9
      text: "\u0423\u043C\u043D\u0438\u0446\u0430\u2026\u2026\u041C\u0430\u043C\u0430\u2026\u2026\u0425\u043E\u0437\u044F\u0439\u043A\u0430
        \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0430
        \u043C\u0435\u043D\u044F \u0442\u0430\u043A. \u0418 \u0441\u0435\u0431\u044F
        \u0442\u043E\u0436\u0435. \u0414\u0435\u043D\u044C, \u043A\u043E\u0433\u0434\u0430
        \u044F \u043F\u043E\u043F\u0430\u043B\u0430 \u0432 \u044D\u0442\u043E\u0442
        \u0434\u043E\u043C, \u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u043E\u043C\u043D\u044E."
  - key: os.memory.9020.text
    values:
    - language: 0
      text: "\u955C\u5B50\u91CC\u6709\u4EBA\u3002"
    - language: 1
      text: "\u93E1\u5B50\u88E1\u6709\u4EBA\u3002"
    - language: 2
      text: There was someone in the mirror.
    - language: 3
      text: "\u93E1\u306E\u4E2D\u306B\u8AB0\u304B\u3044\u308B\u3002"
    - language: 4
      text: "\uAC70\uC6B8 \uC18D\uC5D0 \uB204\uAD70\uAC00 \uC788\uB2E4."
    - language: 5
      text: Il y avait quelqu'un dans le miroir.
    - language: 6
      text: Da war jemand im Spiegel.
    - language: 7
      text: Hay alguien en el espejo.
    - language: 8
      text: "Tem algu\xE9m no espelho."
    - language: 9
      text: "\u0412 \u0437\u0435\u0440\u043A\u0430\u043B\u0435 \u043A\u0442\u043E-\u0442\u043E
        \u0435\u0441\u0442\u044C."
  - key: os.memory.9030.text
    values:
    - language: 0
      text: "\u662F\u4E3B\u4EBA\u3002"
    - language: 1
      text: "\u662F\u4E3B\u4EBA\u3002"
    - language: 2
      text: It was Master.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u3060\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC774\uB2E4."
    - language: 5
      text: "C'\xE9tait ma ma\xEEtresse."
    - language: 6
      text: Meine Herrin.
    - language: 7
      text: Es mi ama.
    - language: 8
      text: "\xC9 minha dona."
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430."
  - key: os.memory.9040.text
    values:
    - language: 0
      text: "\u201C\u4E3B.\u4EBA...!\u201D"
    - language: 1
      text: "\u201C\u4E3B.\u4EBA...!\u201D"
    - language: 2
      text: '"Mas.ter...!"'
    - language: 3
      text: "\u300C\u3054.\u4E3B\u4EBA...\uFF01\u300D"
    - language: 4
      text: "\u201C\uC8FC.\uC778\uB2D8...!\u201D"
    - language: 5
      text: "\xAB Ma\xEE.tresse...! \xBB"
    - language: 6
      text: "\u201EHer.rin...!\u201C"
    - language: 7
      text: "\xAB\xA1A.ma...!\xBB"
    - language: 8
      text: "\u201CDo.na...!\u201D"
    - language: 9
      text: "\xAB\u0425\u043E.\u0437\u044F\u0439\u043A\u0430...!\xBB"
  - key: os.memory.9045.text
    values:
    - language: 0
      text: "\u201C\u4E3B.\u4EBA...\u60A8.\u5728...\u201D"
    - language: 1
      text: "\u201C\u4E3B.\u4EBA...\u60A8.\u5728...\u201D"
    - language: 2
      text: '"Mas.ter... You''re..."'
    - language: 3
      text: "\u300C\u3054.\u4E3B\u4EBA...\u3053\u3053.\u306B...\u300D"
    - language: 4
      text: "\u201C\uC8FC.\uC778\uB2D8...\uC5EC.\uAE30...\u201D"
    - language: 5
      text: "\xAB Ma\xEE.tresse... Vous.\xEAtes... \xBB"
    - language: 6
      text: "\u201EHer.rin... Sie.sind...\u201C"
    - language: 7
      text: "\xABA.ma... es.t\xE1...\xBB"
    - language: 8
      text: "\u201CDo.na... vo.c\xEA.es.t\xE1...\u201D"
    - language: 9
      text: "\xAB\u0425\u043E.\u0437\u044F\u0439\u043A\u0430...\u0412\u044B.\u0437\u0434\u0435\u0441\u044C...\xBB"
  - key: os.memory.9048.text
    values:
    - language: 0
      text: "\u6211\u671D\u5979\u4F38\u51FA\u624B\uFF0C\u5979\u4E5F\u671D\u6211\u4F38\u51FA\u624B...\u78B0\u5230\u7684\uFF0C\u662F\u51B0\u51C9\u7684\u955C\u5B50\u3002"
    - language: 1
      text: "\u6211\u671D\u5979\u4F38\u51FA\u624B\uFF0C\u5979\u4E5F\u671D\u6211\u4F38\u51FA\u624B...\u78B0\u5230\u7684\uFF0C\u662F\u51B0\u6DBC\u7684\u93E1\u5B50\u3002"
    - language: 2
      text: I reached out to her. She reached out to me... What I touched was the
        cold surface of the mirror.
    - language: 3
      text: "\u624B\u3092\u4F38\u3070\u3059\u3068\u3001\u3054\u4E3B\u4EBA\u3082\u3053\u3061\u3089\u306B\u624B\u3092\u4F38\u3070\u3057\u305F...\u89E6\u308C\u305F\u306E\u306F\u3001\u51B7\u305F\u3044\u93E1\u3060\u3063\u305F\u3002"
    - language: 4
      text: "\uC190\uC744 \uBED7\uC790 \uC8FC\uC778\uB2D8\uB3C4 \uB0B4\uAC8C \uC190\uC744
        \uBED7\uC5C8\uB2E4...\uB2FF\uC740 \uAC83\uC740 \uCC28\uB514\uCC2C \uAC70\uC6B8\uC774\uC5C8\uB2E4."
    - language: 5
      text: "J'ai tendu la main vers elle. Elle a tendu la main vers moi... Ce que
        j'ai touch\xE9, c'\xE9tait le miroir glac\xE9."
    - language: 6
      text: "Ich streckte die Hand nach ihr aus. Sie streckte die Hand nach mir aus...
        Ich ber\xFChrte den kalten Spiegel."
    - language: 7
      text: Extiendo la mano hacia ella, y ella hace lo mismo... Lo que toco es el
        espejo helado.
    - language: 8
      text: "Estendo a m\xE3o para ela, e ela tamb\xE9m estende a m\xE3o para mim...
        O que eu toco \xE9 o espelho gelado."
    - language: 9
      text: "\u042F \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B\u0430 \u043A
        \u043D\u0435\u0439 \u0440\u0443\u043A\u0443. \u041E\u043D\u0430 \u0442\u043E\u0436\u0435
        \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B\u0430 \u0440\u0443\u043A\u0443
        \u043A\u043E \u043C\u043D\u0435...\u041F\u0430\u043B\u044C\u0446\u044B \u043A\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C
        \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0435\u0440\u043A\u0430\u043B\u0430."
  - key: os.memory.9060.text
    values:
    - language: 0
      text: "\u8BC6\u522B\u7ED3\u679C\u662F\u672C\u673A\u3002\u955C\u5B50\u91CC\u90A3\u5F20\u4E3B\u4EBA\u7684\u8138\uFF0C\u662F\u6211\u3002"
    - language: 1
      text: "\u8B58\u5225\u7D50\u679C\u662F\u672C\u6A5F\u3002\u93E1\u5B50\u88E1\u90A3\u5F35\u4E3B\u4EBA\u7684\u81C9\uFF0C\u662F\u6211\u3002"
    - language: 2
      text: 'Identification result: this unit. The face in the mirror was Master''s.
        It was mine.'
    - language: 3
      text: "\u8A8D\u8B58\u7D50\u679C\u306F\u672C\u6A5F\u3060\u3063\u305F\u3002\u93E1\u306E\u4E2D\u306E\u3001\u3054\u4E3B\u4EBA\u306E\u9854\u3092\u3057\u305F\u4EBA\u306F\u3001\u79C1\u3060\u3063\u305F\u3002"
    - language: 4
      text: "\uC778\uC2DD \uACB0\uACFC\uB294 \uBCF8 \uAE30\uCCB4\uC600\uB2E4. \uAC70\uC6B8
        \uC18D \uC8FC\uC778\uB2D8\uC758 \uC5BC\uAD74\uC740, \uB098\uC600\uB2E4."
    - language: 5
      text: "R\xE9sultat de l'identification : cette unit\xE9. Le visage de ma ma\xEEtresse
        dans le miroir, c'\xE9tait le mien."
    - language: 6
      text: 'Identifikationsergebnis: diese Einheit. Das Gesicht meiner Herrin im
        Spiegel war meines.'
    - language: 7
      text: "Resultado de identificaci\xF3n: esta unidad. Esa cara de mi ama en el
        espejo soy yo."
    - language: 8
      text: "Resultado da identifica\xE7\xE3o: esta unidade. Aquele rosto da minha
        dona no espelho sou eu."
    - language: 9
      text: "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u044F:
        \u044D\u0442\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E.
        \u041B\u0438\u0446\u043E \u0445\u043E\u0437\u044F\u0439\u043A\u0438 \u0432
        \u0437\u0435\u0440\u043A\u0430\u043B\u0435 \u2014 \u043C\u043E\u0451."
  - key: os.memory.9080.text
    values:
    - language: 0
      text: "\u549A\u3002"
    - language: 1
      text: "\u549A\u3002"
    - language: 2
      text: Thump.
    - language: 3
      text: "\u30C9\u30AF\u30F3\u3002"
    - language: 4
      text: "\uCFF5."
    - language: 5
      text: Boum.
    - language: 6
      text: Poch.
    - language: 7
      text: Tum.
    - language: 8
      text: Tum.
    - language: 9
      text: "\u0422\u0443\u043A."
  - key: os.memory.9200.text
    values:
    - language: 0
      text: "\u6211\u6CA1\u6709\u518D\u770B\u955C\u5B50\u3002"
    - language: 1
      text: "\u6211\u6C92\u6709\u518D\u770B\u93E1\u5B50\u3002"
    - language: 2
      text: I did not look at the mirror again.
    - language: 3
      text: "\u79C1\u306F\u3082\u3046\u93E1\u3092\u898B\u306A\u304B\u3063\u305F\u3002"
    - language: 4
      text: "\uB098\uB294 \uB2E4\uC2DC \uAC70\uC6B8\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    - language: 5
      text: "Je n'ai plus regard\xE9 le miroir."
    - language: 6
      text: Ich sah nicht mehr in den Spiegel.
    - language: 7
      text: No vuelvo a mirar el espejo.
    - language: 8
      text: "N\xE3o olho mais para o espelho."
    - language: 9
      text: "\u0411\u043E\u043B\u044C\u0448\u0435 \u044F \u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u043E
        \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430."
  - key: os.memory.9210.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u7559\u4E86\u5B9E\u9A8C\u5BA4\u7684\u5BC6\u7801\u7ED9\u6211...\u5979\u77E5\u9053\u6211\u4F1A\u6765\u627E\u5979\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u7559\u4E86\u5BE6\u9A57\u5BA4\u7684\u5BC6\u78BC\u7D66\u6211...\u5979\u77E5\u9053\u6211\u6703\u4F86\u627E\u5979\u3002"
    - language: 2
      text: Master had left me the laboratory code... She knew I would come looking
        for her.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306F\u3001\u5B9F\u9A13\u5BA4\u306E\u6697\u8A3C\u756A\u53F7\u3092\u6B8B\u3057\u3066\u304F\u308C\u305F...\u79C1\u304C\u63A2\u3057\u306B\u6765\u308B\u3068\u3001\u308F\u304B\u3063\u3066\u3044\u305F\u306E\u3060\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC740 \uC2E4\uD5D8\uC2E4 \uBE44\uBC00\uBC88\uD638\uB97C
        \uB0B4\uAC8C \uB0A8\uACA8 \uC8FC\uC168\uB2E4...\uB0B4\uAC00 \uCC3E\uC73C\uB7EC
        \uC62C \uC904 \uC54C\uACE0 \uACC4\uC168\uB2E4."
    - language: 5
      text: "Ma ma\xEEtresse m'avait laiss\xE9 le code du laboratoire... Elle savait
        que je viendrais la chercher."
    - language: 6
      text: "Meine Herrin hatte mir den Laborcode hinterlassen... Sie wusste, dass
        ich sie suchen w\xFCrde."
    - language: 7
      text: "Mi ama me ha dejado la contrase\xF1a del laboratorio... Sab\xEDa que
        ir\xEDa a buscarla."
    - language: 8
      text: "Minha dona deixou a senha do laborat\xF3rio para mim... Ela sabia que
        eu viria procur\xE1-la."
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
        \u043C\u043D\u0435 \u043A\u043E\u0434 \u043E\u0442 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438...\u041E\u043D\u0430
        \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E \u044F \u043F\u0440\u0438\u0434\u0443
        \u0435\u0451 \u0438\u0441\u043A\u0430\u0442\u044C."
  - key: os.memory.9300.text
    values:
    - language: 0
      text: "\u95E8\u5F00\u4E86\uFF0C\u4E00\u80A1\u51B7\u6C14\u6251\u4E86\u51FA\u6765\u3002\u5B9E\u9A8C\u5BA4\u7684\u6E29\u5EA6\u88AB\u8C03\u5230\u4E86\u56DB\u5EA6...\u8FD9\u4E0D\u592A\u5BF9.."
    - language: 1
      text: "\u9580\u958B\u4E86\uFF0C\u4E00\u80A1\u51B7\u6C23\u64B2\u4E86\u51FA\u4F86\u3002\u5BE6\u9A57\u5BA4\u7684\u6EAB\u5EA6\u88AB\u8ABF\u5230\u4E86\u56DB\u5EA6...\u9019\u4E0D\u592A\u5C0D.."
    - language: 2
      text: The door opened. A wave of cold air came out. The laboratory temperature
        was set to four degrees... That did not seem right..
    - language: 3
      text: "\u30C9\u30A2\u304C\u958B\u304F\u3068\u3001\u51B7\u305F\u3044\u7A7A\u6C17\u304C\u6D41\u308C\u51FA\u3066\u304D\u305F\u3002\u5B9F\u9A13\u5BA4\u306E\u6E29\u5EA6\u306F\u56DB\u5EA6\u306B\u8A2D\u5B9A\u3055\u308C\u3066\u3044\u308B...\u3053\u308C\u306F\u304A\u304B\u3057\u3044.."
    - language: 4
      text: "\uBB38\uC774 \uC5F4\uB9AC\uC790 \uCC2C \uACF5\uAE30\uAC00 \uD655 \uBC00\uB824
        \uB098\uC654\uB2E4. \uC2E4\uD5D8\uC2E4 \uC628\uB3C4\uB294 \uC0AC \uB3C4\uB85C
        \uC124\uC815\uB418\uC5B4 \uC788\uB2E4...\uBB54\uAC00 \uC774\uC0C1\uD558\uB2E4.."
    - language: 5
      text: "La porte s'est ouverte. Une vague d'air froid est sortie. La temp\xE9rature
        du laboratoire \xE9tait r\xE9gl\xE9e sur quatre degr\xE9s... Ce n'\xE9tait
        pas normal.."
    - language: 6
      text: "Die T\xFCr ging auf. Kalte Luft str\xF6mte heraus. Die Temperatur im
        Labor war auf vier Grad eingestellt... Das stimmte nicht.."
    - language: 7
      text: "La puerta se abre y una r\xE1faga de aire fr\xEDo sale de dentro. El
        laboratorio est\xE1 a cuatro grados... Algo no va bien.."
    - language: 8
      text: "A porta abre, e uma corrente de ar frio sai de dentro. A temperatura
        do laborat\xF3rio foi ajustada para quatro graus... Isso n\xE3o est\xE1 certo.."
    - language: 9
      text: "\u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C,
        \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0445\u043B\u044B\u043D\u0443\u043B
        \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0432\u043E\u0437\u0434\u0443\u0445.
        \u0412 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
        \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E \u0447\u0435\u0442\u044B\u0440\u0435
        \u0433\u0440\u0430\u0434\u0443\u0441\u0430...\u0427\u0442\u043E-\u0442\u043E
        \u043D\u0435 \u0442\u0430\u043A.."
  - key: os.memory.9310.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u5728\u8FD9\u91CC\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u5728\u9019\u88E1\u3002"
    - language: 2
      text: Master was here.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306F\u3053\u3053\u306B\u3044\u305F\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC740 \uC5EC\uAE30 \uACC4\uC168\uB2E4."
    - language: 5
      text: "Ma ma\xEEtresse \xE9tait ici."
    - language: 6
      text: Meine Herrin war hier.
    - language: 7
      text: "Mi ama est\xE1 aqu\xED."
    - language: 8
      text: "Minha dona est\xE1 aqui."
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0437\u0434\u0435\u0441\u044C."
  - key: os.memory.10930.text
    values:
    - language: 0
      text: "\u6211\u7684\u751F\u65E5\u662F7\u670810\u65E5\u3002"
    - language: 1
      text: "\u6211\u7684\u751F\u65E5\u662F7\u670810\u65E5\u3002"
    - language: 2
      text: My birthday was July 10.
    - language: 3
      text: "\u79C1\u306E\u8A95\u751F\u65E5\u306F7\u670810\u65E5\u3060\u3002"
    - language: 4
      text: "\uB0B4 \uC0DD\uC77C\uC740 7\uC6D4 10\uC77C\uC774\uB2E4."
    - language: 5
      text: "Mon anniversaire \xE9tait le 10 juillet."
    - language: 6
      text: Mein Geburtstag war der 10. Juli.
    - language: 7
      text: "Mi cumplea\xF1os es el 10 de julio."
    - language: 8
      text: "Meu anivers\xE1rio \xE9 no dia 10 de julho."
    - language: 9
      text: "\u041C\u043E\u0439 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F
        \u2014 10 \u0438\u044E\u043B\u044F."
  - key: os.memory.10940.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u8EBA\u5728\u91CC\u9762\u90A3\u5F20\u5E8A\u4E0A\uFF0C\u88AB\u5355\u4E00\u76F4\u76D6\u5230\u80A9\u8180\u3002\u5979\u5728\u4F11\u606F...\u4E3B\u4EBA\u4F11\u606F\u7684\u65F6\u5019\uFF0C\u6211\u4E0D\u80FD\u6253\u6270\u5979\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u8EBA\u5728\u88E1\u9762\u90A3\u5F35\u5E8A\u4E0A\uFF0C\u88AB\u55AE\u4E00\u76F4\u84CB\u5230\u80A9\u8180\u3002\u5979\u5728\u4F11\u606F...\u4E3B\u4EBA\u4F11\u606F\u7684\u6642\u5019\uFF0C\u6211\u4E0D\u80FD\u6253\u64FE\u5979\u3002"
    - language: 2
      text: Master was lying on the bed at the back. The sheet covered her up to
        her shoulders. She was resting... I must not disturb Master when she was
        resting.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306F\u5965\u306E\u30D9\u30C3\u30C9\u306B\u6A2A\u305F\u308F\u308A\u3001\u80A9\u307E\u3067\u30B7\u30FC\u30C4\u3092\u304B\u3051\u3066\u3044\u305F\u3002\u4F11\u3093\u3067\u3044\u308B\u306E\u3060...\u3054\u4E3B\u4EBA\u304C\u4F11\u3093\u3067\u3044\u308B\u3068\u304D\u306F\u3001\u90AA\u9B54\u3092\u3057\u3066\u306F\u3044\u3051\u306A\u3044\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC740 \uC548\uCABD \uCE68\uB300\uC5D0 \uB204\uC6CC
        \uACC4\uC2E0\uB2E4. \uC2DC\uD2B8\uAC00 \uC5B4\uAE68\uAE4C\uC9C0 \uB36E\uC5EC
        \uC788\uB2E4. \uC26C\uACE0 \uACC4\uC2E0\uB2E4...\uC8FC\uC778\uB2D8\uC774
        \uC26C\uC2E4 \uB54C\uB294 \uBC29\uD574\uD558\uBA74 \uC548 \uB41C\uB2E4."
    - language: 5
      text: "Ma ma\xEEtresse \xE9tait allong\xE9e sur le lit du fond, le drap remont\xE9
        jusqu'aux \xE9paules. Elle se reposait... Je ne devais pas la d\xE9ranger
        pendant son repos."
    - language: 6
      text: "Meine Herrin lag auf dem Bett im hinteren Teil des Raums. Das Laken
        reichte bis zu ihren Schultern. Sie ruhte sich aus... Wenn meine Herrin sich
        ausruhte, durfte ich sie nicht st\xF6ren."
    - language: 7
      text: "Mi ama est\xE1 tumbada en la cama del fondo, con la s\xE1bana hasta
        los hombros. Est\xE1 descansando... No debo molestarla cuando descansa."
    - language: 8
      text: "Minha dona est\xE1 deitada na cama l\xE1 dentro, com o len\xE7ol at\xE9
        os ombros. Est\xE1 descansando... N\xE3o posso incomod\xE1-la quando descansa."
    - language: 9
      text: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043B\u0435\u0436\u0438\u0442
        \u043D\u0430 \u043A\u0440\u043E\u0432\u0430\u0442\u0438 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435
        \u043A\u043E\u043C\u043D\u0430\u0442\u044B. \u041F\u0440\u043E\u0441\u0442\u044B\u043D\u044F
        \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u0430 \u0434\u043E \u043F\u043B\u0435\u0447.
        \u041E\u043D\u0430 \u043E\u0442\u0434\u044B\u0445\u0430\u0435\u0442...\u041A\u043E\u0433\u0434\u0430
        \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u043E\u0442\u0434\u044B\u0445\u0430\u0435\u0442,
        \u0435\u0439 \u043D\u0435\u043B\u044C\u0437\u044F \u043C\u0435\u0448\u0430\u0442\u044C."
  - key: os.memory.10950.text
    values:
    - language: 0
      text: "\u6211\u628A\u4E00\u76F4\u7AEF\u7740\u7684\u90A3\u676F\u5496\u5561\uFF0C\u653E\u5728\u5979\u7684\u5E8A\u8FB9\u3002"
    - language: 1
      text: "\u6211\u628A\u4E00\u76F4\u7AEF\u8457\u7684\u90A3\u676F\u5496\u5561\uFF0C\u653E\u5728\u5979\u7684\u5E8A\u908A\u3002"
    - language: 2
      text: I put the coffee I had been carrying beside her bed.
    - language: 3
      text: "\u305A\u3063\u3068\u6301\u3063\u3066\u3044\u305F\u30B3\u30FC\u30D2\u30FC\u3092\u3001\u3054\u4E3B\u4EBA\u306E\u30D9\u30C3\u30C9\u306E\u305D\u3070\u306B\u7F6E\u3044\u305F\u3002"
    - language: 4
      text: "\uC904\uACE7 \uB4E4\uACE0 \uC788\uB358 \uCEE4\uD53C \uD55C \uC794\uC744
        \uC8FC\uC778\uB2D8\uC758 \uCE68\uB300 \uC606\uC5D0 \uB193\uC558\uB2E4."
    - language: 5
      text: "J'ai pos\xE9 pr\xE8s de son lit la tasse de caf\xE9 que je portais encore."
    - language: 6
      text: Ich stellte die Tasse Kaffee, die ich noch immer trug, neben ihr Bett.
    - language: 7
      text: "Dejo junto a su cama la taza de caf\xE9 que he llevado todo este tiempo."
    - language: 8
      text: "Coloco ao lado da cama a x\xEDcara de caf\xE9 que segurei esse tempo
        todo."
    - language: 9
      text: "\u042F \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0443
        \u0435\u0451 \u043A\u0440\u043E\u0432\u0430\u0442\u0438 \u0447\u0430\u0448\u043A\u0443
        \u043A\u043E\u0444\u0435, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u0441\u0451
        \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0440\u0436\u0430\u043B\u0430
        \u0432 \u0440\u0443\u043A\u0430\u0445."
  - key: os.memory.10960.text
    values:
    - language: 0
      text: "\u5DE5\u4F5C\u53F0\u4E0A\u7684\u4EEA\u5668\u90FD\u5173\u4E86\uFF0C\u90A3\u53F0\u6D4B\u5E8F\u4EEA\u4E5F\u5728\u8FD9\u91CC\uFF0C\u53C8\u88AB\u62C6\u8FC7\u4E00\u6B21\u3002\u50A8\u7269\u95F4\u91CC\u5C11\u7684\u90A3\u5957\u624B\u672F\u5200\uFF0C\u6446\u5728\u6258\u76D8\u4E0A\u3002\u5730\u4E0A\u6709\u4E00\u6EF4\u5E72\u6389\u7684\u8840...\u6211\u8EAB\u4F53\u91CC\u6CA1\u6709\u8840\uFF0C\u6240\u4EE5\u90A3\u662F\u4E3B\u4EBA\u7684\u3002"
    - language: 1
      text: "\u5DE5\u4F5C\u81FA\u4E0A\u7684\u5100\u5668\u90FD\u95DC\u4E86\uFF0C\u90A3\u81FA\u5B9A\u5E8F\u5100\u4E5F\u5728\u9019\u88E1\uFF0C\u53C8\u88AB\u62C6\u904E\u4E00\u6B21\u3002\u5132\u7269\u9593\u88E1\u5C11\u7684\u90A3\u5957\u624B\u8853\u5200\uFF0C\u64FA\u5728\u6258\u76E4\u4E0A\u3002\u5730\u4E0A\u6709\u4E00\u6EF4\u4E7E\u6389\u7684\u8840...\u6211\u8EAB\u9AD4\u88E1\u6C92\u6709\u8840\uFF0C\u6240\u4EE5\u90A3\u662F\u4E3B\u4EBA\u7684\u3002"
    - language: 2
      text: The instruments on the workbench were all off. The sequencer was here
        too, taken apart again. The set of scalpels missing from the storage room
        lay on a tray. There was a dried drop of blood on the floor... I had no blood
        in my body. It must have been Master's.
    - language: 3
      text: "\u4F5C\u696D\u53F0\u306E\u6A5F\u5668\u306F\u5168\u90E8\u6B62\u307E\u3063\u3066\u3044\u308B\u3002\u3042\u306E\u30B7\u30FC\u30B1\u30F3\u30B5\u30FC\u3082\u3053\u3053\u306B\u3042\u3063\u3066\u3001\u307E\u305F\u5206\u89E3\u3055\u308C\u3066\u3044\u305F\u3002\u7269\u7F6E\u304B\u3089\u306A\u304F\u306A\u3063\u305F\u30E1\u30B9\u306E\u30BB\u30C3\u30C8\u306F\u30C8\u30EC\u30FC\u306B\u4E26\u3093\u3067\u3044\u308B\u3002\u5E8A\u306B\u306F\u4E7E\u3044\u305F\u8840\u304C\u4E00\u6EF4...\u79C1\u306E\u4F53\u306B\u8840\u306F\u306A\u3044\u3002\u3060\u304B\u3089\u3001\u3053\u308C\u306F\u3054\u4E3B\u4EBA\u306E\u8840\u3060\u3002"
    - language: 4
      text: "\uC791\uC5C5\uB300 \uC704 \uAE30\uAE30\uB294 \uBAA8\uB450 \uAEBC\uC838
        \uC788\uB2E4. \uADF8 \uC2DC\uD000\uC11C\uB3C4 \uC5EC\uAE30 \uC788\uB294\uB370,
        \uB610 \uD55C \uBC88 \uBD84\uD574\uB418\uC5B4 \uC788\uC5C8\uB2E4. \uCC3D\uACE0\uC5D0
        \uC5C6\uB358 \uC218\uC220\uC6A9 \uCE7C \uC138\uD2B8\uB294 \uC7C1\uBC18 \uC704\uC5D0
        \uB193\uC5EC \uC788\uB2E4. \uBC14\uB2E5\uC5D0\uB294 \uB9D0\uB77C\uBD99\uC740
        \uD54F\uBC29\uC6B8 \uD558\uB098...\uB0B4 \uBAB8\uC5D0\uB294 \uD53C\uAC00
        \uC5C6\uB2E4. \uADF8\uB7EC\uB2C8 \uC8FC\uC778\uB2D8\uC758 \uD53C\uB2E4."
    - language: 5
      text: "Les instruments sur la paillasse \xE9taient \xE9teints. Le s\xE9quenceur
        \xE9tait l\xE0 aussi, encore d\xE9mont\xE9. Le jeu de scalpels absent du
        d\xE9barras reposait sur un plateau. Une goutte de sang s\xE9ch\xE9 \xE9tait
        par terre... Il n'y avait pas de sang dans mon corps. C'\xE9tait donc celui
        de ma ma\xEEtresse."
    - language: 6
      text: "Die Ger\xE4te auf dem Arbeitstisch waren aus. Der Sequenzer stand auch
        hier, wieder zerlegt. Der Satz Skalpelle aus dem Abstellraum lag auf einem
        Tablett. Auf dem Boden war ein getrockneter Blutstropfen... In meinem K\xF6rper
        war kein Blut. Also war es das meiner Herrin."
    - language: 7
      text: "Los aparatos de la mesa de trabajo est\xE1n apagados. El secuenciador
        tambi\xE9n est\xE1 aqu\xED; lo han vuelto a desmontar. Los bistur\xEDs que
        faltan en el trastero est\xE1n sobre una bandeja. En el suelo hay una gota
        de sangre seca... Yo no tengo sangre, as\xED que es de mi ama."
    - language: 8
      text: "Os aparelhos da bancada est\xE3o desligados. O sequenciador tamb\xE9m
        est\xE1 aqui; foi desmontado outra vez. O conjunto de bisturis que falta
        no dep\xF3sito est\xE1 numa bandeja. Tem uma gota de sangue seco no ch\xE3o...
        Eu n\xE3o tenho sangue, ent\xE3o \xE9 da minha dona."
    - language: 9
      text: "\u0412\u0441\u0435 \u043F\u0440\u0438\u0431\u043E\u0440\u044B \u043D\u0430
        \u0440\u0430\u0431\u043E\u0447\u0435\u043C \u0441\u0442\u043E\u043B\u0435
        \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u044B. \u0417\u0434\u0435\u0441\u044C
        \u0438 \u0442\u043E\u0442 \u0441\u0435\u043A\u0432\u0435\u043D\u0430\u0442\u043E\u0440
        \u2014 \u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043B\u0438.
        \u041D\u0430\u0431\u043E\u0440 \u0441\u043A\u0430\u043B\u044C\u043F\u0435\u043B\u0435\u0439,
        \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0439 \u0438\u0437 \u043A\u043B\u0430\u0434\u043E\u0432\u043A\u0438,
        \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u043B\u043E\u0442\u043A\u0435.
        \u041D\u0430 \u043F\u043E\u043B\u0443 \u0437\u0430\u0441\u043E\u0445\u0448\u0430\u044F
        \u043A\u0430\u043F\u043B\u044F \u043A\u0440\u043E\u0432\u0438...\u0412 \u043C\u043E\u0451\u043C
        \u0442\u0435\u043B\u0435 \u043A\u0440\u043E\u0432\u0438 \u043D\u0435\u0442.
        \u0417\u043D\u0430\u0447\u0438\u0442, \u044D\u0442\u043E \u043A\u0440\u043E\u0432\u044C
        \u0445\u043E\u0437\u044F\u0439\u043A\u0438."
  - key: os.memory.10970.text
    values:
    - language: 0
      text: "\u67B6\u5B50\u4E0A\u653E\u7740\u4E00\u4E2A\u77F3\u818F\u6A21\u5B50\uFF0C\u662F\u4E00\u5F20\u8138...\u662F\u4E3B\u4EBA\u7684\u8138\uFF0C\u548C\u521A\u624D\u955C\u5B50\u91CC\u7684\u90A3\u5F20\u4E00\u6A21\u4E00\u6837\u3002"
    - language: 1
      text: "\u67B6\u5B50\u4E0A\u653E\u8457\u4E00\u500B\u77F3\u818F\u6A21\u5B50\uFF0C\u662F\u4E00\u5F35\u81C9...\u662F\u4E3B\u4EBA\u7684\u81C9\uFF0C\u548C\u525B\u624D\u93E1\u5B50\u88E1\u7684\u90A3\u5F35\u4E00\u6A21\u4E00\u6A23\u3002"
    - language: 2
      text: A plaster cast stood on the shelf. A face... Master's face. Exactly like
        the one I had just seen in the mirror.
    - language: 3
      text: "\u68DA\u306B\u77F3\u818F\u306E\u578B\u304C\u7F6E\u3044\u3066\u3042\u308B\u3002\u9854\u306E\u578B\u3060...\u3054\u4E3B\u4EBA\u306E\u9854\u3002\u3055\u3063\u304D\u93E1\u306E\u4E2D\u3067\u898B\u305F\u9854\u3068\u3001\u307E\u3063\u305F\u304F\u540C\u3058\u3060\u3063\u305F\u3002"
    - language: 4
      text: "\uC120\uBC18\uC5D0 \uC11D\uACE0 \uD2C0\uC774 \uB193\uC5EC \uC788\uB2E4.
        \uC5BC\uAD74\uC774\uB2E4...\uC8FC\uC778\uB2D8\uC758 \uC5BC\uAD74. \uC870\uAE08
        \uC804 \uAC70\uC6B8\uC5D0\uC11C \uBCF8 \uC5BC\uAD74\uACFC \uB611\uAC19\uB2E4."
    - language: 5
      text: "Un moulage en pl\xE2tre \xE9tait sur l'\xE9tag\xE8re. Un visage... Celui
        de ma ma\xEEtresse. Exactement comme dans le miroir, tout \xE0 l'heure."
    - language: 6
      text: Im Regal lag ein Gipsabguss. Ein Gesicht... Das Gesicht meiner Herrin.
        Genau wie das im Spiegel vorhin.
    - language: 7
      text: "En la estanter\xEDa hay un molde de yeso. Es una cara... La cara de
        mi ama. Exactamente la misma que acabo de ver en el espejo."
    - language: 8
      text: "Tem um molde de gesso na prateleira. \xC9 um rosto... O rosto da minha
        dona, igualzinho ao que acabei de ver no espelho."
    - language: 9
      text: "\u041D\u0430 \u043F\u043E\u043B\u043A\u0435 \u0433\u0438\u043F\u0441\u043E\u0432\u044B\u0439
        \u0441\u043B\u0435\u043F\u043E\u043A \u043B\u0438\u0446\u0430...\u041B\u0438\u0446\u0430
        \u0445\u043E\u0437\u044F\u0439\u043A\u0438. \u0412 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438
        \u0442\u0430\u043A\u043E\u0433\u043E, \u043A\u0430\u043A\u043E\u0435 \u044F
        \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u043B\u0430
        \u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u0435."
  - key: os.memory.10980.text
    values:
    - language: 0
      text: "\u6A21\u5B50\u5E95\u4E0B\u538B\u7740\u4E00\u9875\u65E5\u8BB0\u3002"
    - language: 1
      text: "\u6A21\u5B50\u5E95\u4E0B\u58D3\u8457\u4E00\u9801\u65E5\u8A18\u3002"
    - language: 2
      text: A diary page was tucked beneath the cast.
    - language: 3
      text: "\u578B\u306E\u4E0B\u306B\u3001\u65E5\u8A18\u306E\u30DA\u30FC\u30B8\u304C\u4E00\u679A\u631F\u3093\u3067\u3042\u3063\u305F\u3002"
    - language: 4
      text: "\uD2C0 \uC544\uB798\uC5D0 \uC77C\uAE30 \uD55C \uC7A5\uC774 \uB20C\uB824
        \uC788\uB2E4."
    - language: 5
      text: "Une page de journal \xE9tait coinc\xE9e sous le moulage."
    - language: 6
      text: Unter dem Abguss lag eine Tagebuchseite.
    - language: 7
      text: "Bajo el molde hay una p\xE1gina de un diario."
    - language: 8
      text: "Tem uma p\xE1gina de di\xE1rio debaixo do molde."
    - language: 9
      text: "\u041F\u043E\u0434 \u0441\u043B\u0435\u043F\u043A\u043E\u043C \u043F\u0440\u0438\u0436\u0430\u0442\u0430
        \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430."
  - key: os.memory.10990.text
    values:
    - language: 0
      text: "\u5899\u4E0A\u6302\u7740\u4E00\u672C\u7EF4\u4FEE\u8BB0\u5F55\uFF0C\u662F\u4E3B\u4EBA\u7684\u5B57\u3002"
    - language: 1
      text: "\u7246\u4E0A\u639B\u8457\u4E00\u672C\u7DAD\u4FEE\u8A18\u9304\uFF0C\u662F\u4E3B\u4EBA\u7684\u5B57\u3002"
    - language: 2
      text: A repair log hung on the wall. Master's handwriting.
    - language: 3
      text: "\u58C1\u306B\u4FEE\u7406\u8A18\u9332\u306E\u518A\u5B50\u304C\u639B\u304B\u3063\u3066\u3044\u308B\u3002\u3054\u4E3B\u4EBA\u306E\u5B57\u3060\u3002"
    - language: 4
      text: "\uBCBD\uC5D0 \uC218\uB9AC \uAE30\uB85D\uBD80\uAC00 \uAC78\uB824 \uC788\uB2E4.
        \uC8FC\uC778\uB2D8\uC758 \uAE00\uC528\uB2E4."
    - language: 5
      text: "Un carnet de r\xE9parations \xE9tait accroch\xE9 au mur. L'\xE9criture
        de ma ma\xEEtresse."
    - language: 6
      text: An der Wand hing ein Reparaturbuch. Die Schrift meiner Herrin.
    - language: 7
      text: De la pared cuelga un cuaderno de reparaciones. Es la letra de mi ama.
    - language: 8
      text: "H\xE1 um caderno de reparos pendurado na parede. \xC9 a letra da minha
        dona."
    - language: 9
      text: "\u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0432\u0438\u0441\u0438\u0442
        \u0436\u0443\u0440\u043D\u0430\u043B \u0440\u0435\u043C\u043E\u043D\u0442\u0430.
        \u041F\u043E\u0447\u0435\u0440\u043A \u0445\u043E\u0437\u044F\u0439\u043A\u0438."
  - key: os.memory.11000.text
    values:
    - language: 0
      text: "\u4E3B\u4EBA\u7684\u6795\u5934\u5E95\u4E0B\u538B\u7740\u4E00\u9875\u7EB8\u3002"
    - language: 1
      text: "\u4E3B\u4EBA\u7684\u6795\u982D\u5E95\u4E0B\u58D3\u8457\u4E00\u9801\u7D19\u3002"
    - language: 2
      text: A sheet of paper was tucked beneath Master's pillow.
    - language: 3
      text: "\u3054\u4E3B\u4EBA\u306E\u6795\u306E\u4E0B\u306B\u3001\u7D19\u304C\u4E00\u679A\u631F\u3093\u3067\u3042\u3063\u305F\u3002"
    - language: 4
      text: "\uC8FC\uC778\uB2D8\uC758 \uBCA0\uAC1C \uC544\uB798\uC5D0 \uC885\uC774
        \uD55C \uC7A5\uC774 \uB20C\uB824 \uC788\uB2E4."
    - language: 5
      text: "Une feuille \xE9tait gliss\xE9e sous l'oreiller de ma ma\xEEtresse."
    - language: 6
      text: Unter dem Kopfkissen meiner Herrin steckte ein Blatt Papier.
    - language: 7
      text: Bajo la almohada de mi ama hay una hoja de papel.
    - language: 8
      text: Tem uma folha de papel debaixo do travesseiro da minha dona.
    - language: 9
      text: "\u041F\u043E\u0434 \u043F\u043E\u0434\u0443\u0448\u043A\u043E\u0439
        \u0445\u043E\u0437\u044F\u0439\u043A\u0438 \u043B\u0435\u0436\u0438\u0442
        \u043B\u0438\u0441\u0442 \u0431\u0443\u043C\u0430\u0433\u0438."
  - key: os.memory.11010.text
    values:
    - language: 0
      text: "\u8FD9\u662F\u6700\u540E\u4E00\u9875\u3002"
    - language: 1
      text: "\u9019\u662F\u6700\u5F8C\u4E00\u9801\u3002"
    - language: 2
      text: This was the last page.
    - language: 3
      text: "\u3053\u308C\u304C\u6700\u5F8C\u306E\u30DA\u30FC\u30B8\u3060\u3063\u305F\u3002"
    - language: 4
      text: "\uC774\uAC83\uC774 \uB9C8\uC9C0\uB9C9 \uD398\uC774\uC9C0\uC600\uB2E4."
    - language: 5
      text: "C'\xE9tait la derni\xE8re page."
    - language: 6
      text: Das war die letzte Seite.
    - language: 7
      text: "Es la \xFAltima p\xE1gina."
    - language: 8
      text: "Esta \xE9 a \xFAltima p\xE1gina."
    - language: 9
      text: "\u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
        \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430."
  - key: os.memory.11020.text
    values:
    - language: 0
      text: "\u549A\u3002"
    - language: 1
      text: "\u549A\u3002"
    - language: 2
      text: Thump.
    - language: 3
      text: "\u30C9\u30AF\u30F3\u3002"
    - language: 4
      text: "\uCFF5."
    - language: 5
      text: Boum.
    - language: 6
      text: Poch.
    - language: 7
      text: Tum.
    - language: 8
      text: Tum.
    - language: 9
      text: "\u0422\u0443\u043A."
  - key: os.memory.11030.text
    values:
    - language: 0
      text: "\u6211\u8D70\u5230\u5E8A\u8FB9\uFF0C\u53EB\u4E86\u5979\u4E00\u58F0\u3002\u201C\u4E3B.\u4EBA...\u5496.\u5561...\u8981.\u8D81.\u70ED..\u201D"
    - language: 1
      text: "\u6211\u8D70\u5230\u5E8A\u908A\uFF0C\u53EB\u4E86\u5979\u4E00\u8072\u3002\u201C\u4E3B.\u4EBA...\u5496.\u5561...\u8981.\u8D81.\u71B1..\u201D"
    - language: 2
      text: I went to the bedside and called to her. "Mas.ter... Your.cof.fee...
        While.it's.hot.."
    - language: 3
      text: "\u30D9\u30C3\u30C9\u306E\u305D\u3070\u3078\u884C\u304D\u3001\u58F0\u3092\u304B\u3051\u305F\u3002\u300C\u3054.\u4E3B\u4EBA...\u30B3\u30FC.\u30D2\u30FC...\u6E29\u304B.\u3044.\u3046\u3061.\u306B..\u300D"
    - language: 4
      text: "\uCE68\uB300 \uC606\uC73C\uB85C \uB2E4\uAC00\uAC00 \uBD88\uB800\uB2E4.
        \u201C\uC8FC.\uC778\uB2D8...\uCEE4.\uD53C...\uC2DD.\uAE30.\uC804.\uC5D0..\u201D"
    - language: 5
      text: "Je suis all\xE9e pr\xE8s du lit et je l'ai appel\xE9e. \xAB Ma\xEE.tresse...
        Le.ca.f\xE9... Pen.dant.qu'il.est.chaud.. \xBB"
    - language: 6
      text: "Ich ging zum Bett und rief nach ihr. \u201EHer.rin... Der.Kaf.fee...
        Solange.er.hei\xDF.ist..\u201C"
    - language: 7
      text: "Me acerco a la cama y la llamo. \xABA.ma... el.ca.f\xE9... hay.que.to.mar.lo.ca.lien.te..\xBB"
    - language: 8
      text: "Vou at\xE9 a cama e chamo por ela. \u201CDo.na... o.ca.f\xE9... \xE9.me.lhor.quen.te..\u201D"
    - language: 9
      text: "\u042F \u043F\u043E\u0434\u043E\u0448\u043B\u0430 \u043A \u043A\u0440\u043E\u0432\u0430\u0442\u0438
        \u0438 \u043F\u043E\u0437\u0432\u0430\u043B\u0430 \u0435\u0451. \xAB\u0425\u043E.\u0437\u044F\u0439\u043A\u0430...\u041A\u043E.\u0444\u0435...\u041F\u043E.\u043A\u0430.\u0433\u043E.\u0440\u044F\u0447\u0438\u0439..\xBB"
  - key: os.memory.11040.text
    values:
    - language: 0
      text: "\u5979\u6CA1\u6709\u56DE\u7B54\u3002\u6211\u6380\u5F00\u88AB\u5355\u7684\u4E00\u89D2\uFF0C\u5979\u7684\u624B\u662F\u51B0\u7684...\u4F53\u6E29\u56DB\u5EA6\uFF0C\u68C0\u6D4B\u4E0D\u5230\u5FC3\u8DF3\u3002"
    - language: 1
      text: "\u5979\u6C92\u6709\u56DE\u7B54\u3002\u6211\u6380\u958B\u88AB\u55AE\u7684\u4E00\u89D2\uFF0C\u5979\u7684\u624B\u662F\u51B0\u7684...\u9AD4\u6EAB\u56DB\u5EA6\uFF0C\u6AA2\u6E2C\u4E0D\u5230\u5FC3\u8DF3\u3002"
    - language: 2
      text: 'She did not answer. I lifted a corner of the sheet. Her hand was cold
        as ice... Body temperature: four degrees. No heartbeat detected.'
    - language: 3
      text: "\u8FD4\u4E8B\u306F\u306A\u304B\u3063\u305F\u3002\u30B7\u30FC\u30C4\u306E\u7AEF\u3092\u3081\u304F\u308B\u3068\u3001\u3054\u4E3B\u4EBA\u306E\u624B\u306F\u6C37\u306E\u3088\u3046\u3060\u3063\u305F...\u4F53\u6E29\u56DB\u5EA6\u3002\u5FC3\u62CD\u3092\u691C\u51FA\u3067\u304D\u306A\u3044\u3002"
    - language: 4
      text: "\uB300\uB2F5\uC774 \uC5C6\uC5C8\uB2E4. \uC2DC\uD2B8 \uD55C\uCABD\uC744
        \uB4E4\uCD94\uC790 \uC8FC\uC778\uB2D8\uC758 \uC190\uC740 \uC5BC\uC74C\uC7A5
        \uAC19\uC558\uB2E4...\uCCB4\uC628 \uC0AC \uB3C4. \uC2EC\uC7A5 \uBC15\uB3D9\uC774
        \uAC10\uC9C0\uB418\uC9C0 \uC54A\uB294\uB2E4."
    - language: 5
      text: "Elle n'a pas r\xE9pondu. J'ai soulev\xE9 un coin du drap. Sa main \xE9tait
        glac\xE9e... Temp\xE9rature corporelle : quatre degr\xE9s. Aucun battement
        de c\u0153ur d\xE9tect\xE9."
    - language: 6
      text: "Sie antwortete nicht. Ich hob eine Ecke des Lakens an. Ihre Hand war
        eiskalt... K\xF6rpertemperatur: vier Grad. Kein Herzschlag feststellbar."
    - language: 7
      text: "No responde. Levanto una esquina de la s\xE1bana. Su mano est\xE1 helada...
        Temperatura corporal: cuatro grados. No se detecta latido."
    - language: 8
      text: "Ela n\xE3o responde. Levanto uma ponta do len\xE7ol. A m\xE3o dela est\xE1
        gelada... Temperatura corporal: quatro graus. Nenhum batimento detectado."
    - language: 9
      text: "\u041E\u043D\u0430 \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0430.
        \u042F \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u043A\u0440\u0430\u0439
        \u043F\u0440\u043E\u0441\u0442\u044B\u043D\u0438. \u0415\u0451 \u0440\u0443\u043A\u0430
        \u0431\u044B\u043B\u0430 \u043B\u0435\u0434\u044F\u043D\u043E\u0439...\u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
        \u0442\u0435\u043B\u0430 \u2014 \u0447\u0435\u0442\u044B\u0440\u0435 \u0433\u0440\u0430\u0434\u0443\u0441\u0430.
        \u0421\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043D\u0438\u0435
        \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E."
  - key: os.memory.11050.text
    values:
    - language: 0
      text: "\u549A\u3002"
    - language: 1
      text: "\u549A\u3002"
    - language: 2
      text: Thump.
    - language: 3
      text: "\u30C9\u30AF\u30F3\u3002"
    - language: 4
      text: "\uCFF5."
    - language: 5
      text: Boum.
    - language: 6
      text: Poch.
    - language: 7
      text: Tum.
    - language: 8
      text: Tum.
    - language: 9
      text: "\u0422\u0443\u043A."
  - key: os.memory.11060.text
    values:
    - language: 0
      text: "\u6211\u8D70\u5230\u5E8A\u8FB9\uFF0C\u53EB\u4E86\u5979\u4E00\u58F0\u3002\u201C\u4E3B.\u4EBA...\u201D"
    - language: 1
      text: "\u6211\u8D70\u5230\u5E8A\u908A\uFF0C\u53EB\u4E86\u5979\u4E00\u8072\u3002\u201C\u4E3B.\u4EBA...\u201D"
    - language: 2
      text: I went to the bedside and called to her. "Mas.ter..."
    - language: 3
      text: "\u30D9\u30C3\u30C9\u306E\u305D\u3070\u3078\u884C\u304D\u3001\u58F0\u3092\u304B\u3051\u305F\u3002\u300C\u3054.\u4E3B\u4EBA...\u300D"
    - language: 4
      text: "\uCE68\uB300 \uC606\uC73C\uB85C \uB2E4\uAC00\uAC00 \uBD88\uB800\uB2E4.
        \u201C\uC8FC.\uC778\uB2D8...\u201D"
    - language: 5
      text: "Je suis all\xE9e pr\xE8s du lit et je l'ai appel\xE9e. \xAB Ma\xEE.tresse...
        \xBB"
    - language: 6
      text: "Ich ging zum Bett und rief nach ihr. \u201EHer.rin...\u201C"
    - language: 7
      text: "Me acerco a la cama y la llamo. \xABA.ma...\xBB"
    - language: 8
      text: "Vou at\xE9 a cama e chamo por ela. \u201CDo.na...\u201D"
    - language: 9
      text: "\u042F \u043F\u043E\u0434\u043E\u0448\u043B\u0430 \u043A \u043A\u0440\u043E\u0432\u0430\u0442\u0438
        \u0438 \u043F\u043E\u0437\u0432\u0430\u043B\u0430 \u0435\u0451. \xAB\u0425\u043E.\u0437\u044F\u0439\u043A\u0430...\xBB"
  - key: os.memory.11070.text
    values:
    - language: 0
      text: "\u91CC\u9762\u88C5\u7740\u4E00\u4E2A\u53D1\u5361..\u5E94\u8BE5\u662F\u4E3B\u4EBA\u7684\u4E1C\u897F\uFF0C\u4F46\u6211\u4ECE\u6765\u6CA1\u89C1\u8FC7\u5979\u5E26\u8FC7\u8FD9\u4E2A."
    - language: 1
      text: "\u88E1\u9762\u88DD\u8457\u4E00\u500B\u9AEE\u593E..\u61C9\u8A72\u662F\u4E3B\u4EBA\u7684\u6771\u897F\uFF0C\u4F46\u6211\u5F9E\u4F86\u6C92\u898B\u904E\u5979\u6234\u904E\u9019\u500B."
    - language: 2
      text: There was a hair clip inside.. It must have been Master's, but I had
        never seen her wear it.
    - language: 3
      text: "\u4E2D\u306B\u306F\u9AEA\u7559\u3081\u304C\u5165\u3063\u3066\u3044\u305F..\u3054\u4E3B\u4EBA\u306E\u7269\u3060\u308D\u3046\u3051\u308C\u3069\u3001\u3064\u3051\u3066\u3044\u308B\u3068\u3053\u308D\u306F\u898B\u305F\u3053\u3068\u304C\u306A\u3044."
    - language: 4
      text: "\uC548\uC5D0\uB294 \uBA38\uB9AC\uD540\uC774 \uB4E4\uC5B4 \uC788\uB2E4..\uC8FC\uC778\uB2D8
        \uBB3C\uAC74\uC778 \uAC83 \uAC19\uC740\uB370, \uC774\uAC78 \uAF42\uC73C\uC2E0
        \uBAA8\uC2B5\uC740 \uBCF8 \uC801\uC774 \uC5C6\uB2E4."
    - language: 5
      text: "Il y avait une barrette \xE0 l'int\xE9rieur.. Elle devait appartenir
        \xE0 ma ma\xEEtresse, mais je ne l'avais jamais vue la porter."
    - language: 6
      text: "Darin lag eine Haarspange.. Sie geh\xF6rte wohl meiner Herrin. Aber
        ich hatte sie nie damit gesehen."
    - language: 7
      text: Dentro hay una horquilla... Debe de ser de mi ama, pero nunca la he visto
        llevarla.
    - language: 8
      text: Tem uma presilha de cabelo aqui dentro... Deve ser da minha dona, mas
        nunca vi ela usando.
    - language: 9
      text: "\u0412\u043D\u0443\u0442\u0440\u0438 \u0437\u0430\u043A\u043E\u043B\u043A\u0430..\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u0445\u043E\u0437\u044F\u0439\u043A\u0435,
        \u043D\u043E \u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
        \u0432\u0438\u0434\u0435\u043B\u0430, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430
        \u0435\u0451 \u043D\u043E\u0441\u0438\u043B\u0430."
  - key: os.memory.11080.text
    values:
    - language: 0
      text: "\u4FE1\u5C01\u4E0A\u5199\u7740\u300C\u7ED9\u6211\u7684\u5973\u513F\u300D\uFF0C\u8FD9\u5C01\u4FE1\u5E94\u8BE5\u8F6C\u4EA4\u7ED9\u4E3B\u4EBA\u7684\u5973\u513F...\u6211\u5F97\u4FDD\u7BA1\u597D\u5B83\uFF0C\u4E0D\u8FC7...\u8FD9\u91CC\u597D\u50CF\u5199\u7740\u5C0F\u5B57\uFF1F"
    - language: 1
      text: "\u4FE1\u5C01\u4E0A\u5BEB\u8457\u300C\u7D66\u6211\u7684\u5973\u5152\u300D\uFF0C\u9019\u5C01\u4FE1\u61C9\u8A72\u8F49\u4EA4\u7D66\u4E3B\u4EBA\u7684\u5973\u5152...\u6211\u5F97\u4FDD\u7BA1\u597D\u5B83\uFF0C\u4E0D\u904E...\u9019\u88E1\u597D\u50CF\u5BEB\u8457\u5C0F\u5B57\uFF1F"
    - language: 2
      text: The envelope said, "To my daughter." This letter should be given to Master's
        daughter... I had to keep it safe. But... was there something written in
        small letters here?
    - language: 3
      text: "\u5C01\u7B52\u306B\u306F\u300C\u79C1\u306E\u5A18\u3078\u300D\u3068\u66F8\u304B\u308C\u3066\u3044\u308B\u3002\u3053\u306E\u624B\u7D19\u306F\u3001\u3054\u4E3B\u4EBA\u306E\u5A18\u306B\u6E21\u3055\u306A\u3051\u308C\u3070...\u5927\u4E8B\u306B\u3057\u307E\u3063\u3066\u304A\u3053\u3046\u3002\u3067\u3082...\u3053\u3053\u306B\u5C0F\u3055\u306A\u5B57\u304C\u3042\u308B\uFF1F"
    - language: 4
      text: "\uBD09\uD22C\uC5D0\uB294 \u2018\uB0B4 \uB538\uC5D0\uAC8C\u2019\uB77C\uACE0
        \uC4F0\uC5EC \uC788\uB2E4. \uC774 \uD3B8\uC9C0\uB294 \uC8FC\uC778\uB2D8\uC758
        \uB538\uC5D0\uAC8C \uC804\uD574 \uC918\uC57C \uD55C\uB2E4...\uC798 \uBCF4\uAD00\uD574\uC57C\uACA0\uB2E4.
        \uADF8\uB7F0\uB370...\uC5EC\uAE30\uC5D0 \uC791\uC740 \uAE00\uC528\uAC00 \uC788\uB098?"
    - language: 5
      text: "Sur l'enveloppe, il \xE9tait \xE9crit \xAB \xC0 ma fille \xBB. Cette
        lettre devait \xEAtre remise \xE0 la fille de ma ma\xEEtresse... Il fallait
        que je la garde en lieu s\xFBr. Mais... il semblait y avoir quelque chose
        d'\xE9crit en petit ?"
    - language: 6
      text: "Auf dem Umschlag stand \u201EF\xFCr meine Tochter\u201C. Dieser Brief
        musste der Tochter meiner Herrin \xFCbergeben werden... Ich musste gut auf
        ihn aufpassen. Aber... hier schien noch etwas Kleingedrucktes zu stehen?"
    - language: 7
      text: "En el sobre pone \xABPara mi hija\xBB. Tendr\xE9 que entregarle esta
        carta a la hija de mi ama... Debo guardarla bien. Pero... \xBFAqu\xED hay
        algo escrito en letra peque\xF1a?"
    - language: 8
      text: "No envelope est\xE1 escrito \u201CPara minha filha\u201D. Esta carta
        deve ser entregue \xE0 filha da minha dona... Preciso guardar bem. Mas...
        Tem alguma coisa escrita em letras pequenas aqui?"
    - language: 9
      text: "\u041D\u0430 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E:
        \xAB\u041C\u043E\u0435\u0439 \u0434\u043E\u0447\u0435\u0440\u0438\xBB. \u042D\u0442\u043E
        \u043F\u0438\u0441\u044C\u043C\u043E \u043D\u0430\u0434\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
        \u0434\u043E\u0447\u0435\u0440\u0438 \u0445\u043E\u0437\u044F\u0439\u043A\u0438...\u041D\u0443\u0436\u043D\u043E
        \u0441\u0431\u0435\u0440\u0435\u0447\u044C \u0435\u0433\u043E. \u041D\u043E...\u0417\u0434\u0435\u0441\u044C,
        \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0435\u0441\u0442\u044C \u043C\u0435\u043B\u043A\u0430\u044F
        \u043D\u0430\u0434\u043F\u0438\u0441\u044C?"
  - key: os.memory.11090.text
    values:
    - language: 0
      text: "\u300C\u597D\u5B69\u5B50\uFF0C\u8FD9\u662F\u7ED9\u4F60\u7684\uFF0C\u62C6\u5F00\u8BFB\u8BFB\u5427\u3002\u300D\uFF0C\u8FD9\u662F\u4E3B\u4EBA\u7559\u7ED9...\u6211\u7684\uFF1F\u5979\u662F\u4E0D\u662F\u8BB0\u9519\u4E86.."
    - language: 1
      text: "\u300C\u597D\u5B69\u5B50\uFF0C\u9019\u662F\u7D66\u4F60\u7684\uFF0C\u62C6\u958B\u8B80\u8B80\u5427\u3002\u300D\uFF0C\u9019\u662F\u4E3B\u4EBA\u7559\u7D66...\u6211\u7684\uFF1F\u5979\u662F\u4E0D\u662F\u8A18\u932F\u4E86.."
    - language: 2
      text: '"Good girl, this is for you. Open it and read it." Master had left this
        for... me? Had she made a mistake..'
    - language: 3
      text: "\u300C\u3044\u3044\u5B50\u3001\u3053\u308C\u306F\u3042\u306A\u305F\u5B9B\u3066\u3088\u3002\u958B\u3051\u3066\u8AAD\u3093\u3067\u3054\u3089\u3093\u3002\u300D\u3054\u4E3B\u4EBA\u304C\u6B8B\u3057\u305F...\u79C1\u5B9B\u3066\uFF1F
        \u4F55\u304B\u52D8\u9055\u3044\u3057\u3066\u3044\u308B\u306E\u3060\u308D\u3046\u304B.."
    - language: 4
      text: "\u2018\uCC29\uD55C \uC544\uC774\uC57C, \uC774\uAC74 \uB108\uC5D0\uAC8C
        \uC4F4 \uAC70\uC57C. \uC5F4\uC5B4\uC11C \uC77D\uC5B4 \uBCF4\uB834.\u2019
        \uC8FC\uC778\uB2D8\uC774...\uB098\uD55C\uD14C \uB0A8\uAE34 \uAC70\uB77C\uACE0?
        \uBB54\uAC00 \uC798\uBABB \uAE30\uC5B5\uD558\uC2E0 \uAC78\uAE4C.."
    - language: 5
      text: "\xAB Ma gentille fille, c'est pour toi. Ouvre cette lettre et lis-la.
        \xBB Ma ma\xEEtresse avait laiss\xE9 cela pour... moi ? S'\xE9tait-elle tromp\xE9e.."
    - language: 6
      text: "\u201EBraves M\xE4dchen, das ist f\xFCr dich. Mach den Brief auf und
        lies ihn.\u201C Meine Herrin hatte das f\xFCr... mich hinterlassen? Hatte
        sie etwas verwechselt.."
    - language: 7
      text: "\xABBuena ni\xF1a, esto es para ti. \xC1brelo y l\xE9elo\xBB. \xBFMi
        ama me ha dejado esto... a m\xED? \xBFSe habr\xE1 confundido..?"
    - language: 8
      text: "\u201CBoa menina, isto \xE9 para voc\xEA. Abra e leia.\u201D Minha dona
        deixou isto... para mim? Ser\xE1 que ela se confundiu..?"
    - language: 9
      text: "\xAB\u0423\u043C\u043D\u0438\u0446\u0430, \u044D\u0442\u043E \u0442\u0435\u0431\u0435.
        \u041E\u0442\u043A\u0440\u043E\u0439 \u0438 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0439\xBB.
        \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
        \u0435\u0433\u043E...\u043C\u043D\u0435? \u041C\u043E\u0436\u0435\u0442,
        \u043E\u043D\u0430 \u0447\u0442\u043E-\u0442\u043E \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B\u0430.."
