  - key: ui.os.gramophone.track.paper_push
    values:
    - language: 0
      text: "\u7EB8\u4E0A\u89D2\u529B"
    - language: 1
      text: "\u7D19\u4E0A\u89D2\u529B"
    - language: 2
      text: Paper Rivals
    - language: 3
      text: "\u7D19\u306E\u529B\u6BD4\u3079"
    - language: 4
      text: "\uC885\uC774 \uD798\uACA8\uB8E8\uAE30"
    - language: 5
      text: Rivaux de papier
    - language: 6
      text: Papierrivalen
    - language: 7
      text: Rivales de papel
    - language: 8
      text: Rivais de papel
    - language: 9
      text: "\u0411\u0443\u043C\u0430\u0436\u043D\u044B\u0435 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0438"
  - key: ui.os.chapter01_ending.slide_room
    values:
    - language: 0
      text: "\u5360\u4F4D\u5206\u955C\uFF1A\u6BCD\u4EB2\u79BB\u5F00\u623F\u95F4"
    - language: 1
      text: "\u4F54\u4F4D\u5206\u93E1\uFF1A\u6BCD\u89AA\u96E2\u958B\u623F\u9593"
    - language: 2
      text: 'Placeholder: Mother leaves the room'
    - language: 3
      text: "\u4EEE\u7D75\u30B3\u30F3\u30C6\uFF1A\u6BCD\u304C\u90E8\u5C4B\u3092\u51FA\u308B"
    - language: 4
      text: "\uC784\uC2DC \uC2A4\uD1A0\uB9AC\uBCF4\uB4DC: \uC5B4\uBA38\uB2C8\uAC00
        \uBC29\uC744 \uB098\uAC10"
    - language: 5
      text: "Plan provisoire : la m\xE8re quitte la pi\xE8ce"
    - language: 6
      text: "Platzhalter: Mutter verl\xE4sst das Zimmer"
    - language: 7
      text: "Vi\xF1eta provisional: la madre sale del cuarto"
    - language: 8
      text: "Cena provis\xF3ria: a m\xE3e sai do quarto"
    - language: 9
      text: "\u041A\u0430\u0434\u0440-\u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430:
        \u043C\u0430\u0442\u044C \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437
        \u043A\u043E\u043C\u043D\u0430\u0442\u044B"
  - key: ui.os.chapter01_ending.slide_corridor
    values:
    - language: 0
      text: "\u5360\u4F4D\u5206\u955C\uFF1A\u6BCD\u4EB2\u7A7F\u8FC7\u8D70\u5ECA"
    - language: 1
      text: "\u4F54\u4F4D\u5206\u93E1\uFF1A\u6BCD\u89AA\u7A7F\u904E\u8D70\u5ECA"
    - language: 2
      text: 'Placeholder: Mother walks down the hall'
    - language: 3
      text: "\u4EEE\u7D75\u30B3\u30F3\u30C6\uFF1A\u6BCD\u304C\u5ECA\u4E0B\u3092\u901A\u308B"
    - language: 4
      text: "\uC784\uC2DC \uC2A4\uD1A0\uB9AC\uBCF4\uB4DC: \uC5B4\uBA38\uB2C8\uAC00
        \uBCF5\uB3C4\uB97C \uC9C0\uB098\uAC10"
    - language: 5
      text: "Plan provisoire : la m\xE8re traverse le couloir"
    - language: 6
      text: 'Platzhalter: Mutter geht durch den Flur'
    - language: 7
      text: "Vi\xF1eta provisional: la madre cruza el pasillo"
    - language: 8
      text: "Cena provis\xF3ria: a m\xE3e atravessa o corredor"
    - language: 9
      text: "\u041A\u0430\u0434\u0440-\u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430:
        \u043C\u0430\u0442\u044C \u0438\u0434\u0451\u0442 \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443"
  - key: ui.os.chapter01_ending.slide_doorway
    values:
    - language: 0
      text: "\u5360\u4F4D\u5206\u955C\uFF1A\u6BCD\u4EB2\u6765\u5230\u95E8\u53E3"
    - language: 1
      text: "\u4F54\u4F4D\u5206\u93E1\uFF1A\u6BCD\u89AA\u4F86\u5230\u9580\u53E3"
    - language: 2
      text: 'Placeholder: Mother reaches the doorway'
    - language: 3
      text: "\u4EEE\u7D75\u30B3\u30F3\u30C6\uFF1A\u6BCD\u304C\u6238\u53E3\u306B\u7740\u304F"
    - language: 4
      text: "\uC784\uC2DC \uC2A4\uD1A0\uB9AC\uBCF4\uB4DC: \uC5B4\uBA38\uB2C8\uAC00
        \uBB38 \uC55E\uC5D0 \uB3C4\uCC29\uD568"
    - language: 5
      text: "Plan provisoire : la m\xE8re arrive \xE0 la porte"
    - language: 6
      text: "Platzhalter: Mutter erreicht die T\xFCr"
    - language: 7
      text: "Vi\xF1eta provisional: la madre llega a la puerta"
    - language: 8
      text: "Cena provis\xF3ria: a m\xE3e chega \xE0 porta"
    - language: 9
      text: "\u041A\u0430\u0434\u0440-\u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430:
        \u043C\u0430\u0442\u044C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
        \u043A \u0434\u0432\u0435\u0440\u0438"
  - key: ui.os.chapter01_ending.door
    values:
    - language: 0
      text: "\u70B9\u51FB\u6728\u95E8"
    - language: 1
      text: "\u9EDE\u64CA\u6728\u9580"
    - language: 2
      text: Click the wooden door
    - language: 3
      text: "\u6728\u306E\u6249\u3092\u30AF\u30EA\u30C3\u30AF"
    - language: 4
      text: "\uB098\uBB34 \uBB38 \uD074\uB9AD"
    - language: 5
      text: Cliquez sur la porte en bois
    - language: 6
      text: "Holzt\xFCr anklicken"
    - language: 7
      text: Haz clic en la puerta de madera
    - language: 8
      text: Clique na porta de madeira
    - language: 9
      text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0443\u044E
        \u0434\u0432\u0435\u0440\u044C"
  - key: ui.os.chapter01_ending.animation_placeholder
    values:
    - language: 0
      text: "\u7ED3\u5C3E\u52A8\u753B\u5360\u4F4D"
    - language: 1
      text: "\u7D50\u5C3E\u52D5\u756B\u4F54\u4F4D"
    - language: 2
      text: Ending animation placeholder
    - language: 3
      text: "\u30A8\u30F3\u30C7\u30A3\u30F3\u30B0\u52D5\u753B\u306E\u4EEE\u8868\u793A"
    - language: 4
      text: "\uC5D4\uB529 \uC560\uB2C8\uBA54\uC774\uC158 \uC790\uB9AC \uD45C\uC2DC"
    - language: 5
      text: "Emplacement de l\u2019animation finale"
    - language: 6
      text: "Platzhalter f\xFCr die Schlussanimation"
    - language: 7
      text: "Espacio para la animaci\xF3n final"
    - language: 8
      text: "Espa\xE7o para a anima\xE7\xE3o final"
    - language: 9
      text: "\u0417\u0430\u0433\u043B\u0443\u0448\u043A\u0430 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
        \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438"
  - key: ui.os.chapter01_ending.demo_title
    values:
    - language: 0
      text: "Demo\u5185\u5BB9\u5230\u6B64\u7ED3\u675F"
    - language: 1
      text: "Demo\u5167\u5BB9\u5230\u6B64\u7D50\u675F"
    - language: 2
      text: This is the end of the demo.
    - language: 3
      text: "\u4F53\u9A13\u7248\u306E\u5185\u5BB9\u306F\u3053\u3053\u307E\u3067\u3067\u3059\u3002"
    - language: 4
      text: "\uB370\uBAA8 \uCF58\uD150\uCE20\uB294 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
    - language: 5
      text: "La d\xE9mo s\u2019arr\xEAte ici."
    - language: 6
      text: Hier endet die Demo.
    - language: 7
      text: "El contenido de la demo termina aqu\xED."
    - language: 8
      text: A demo termina aqui.
    - language: 9
      text: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0434\u0435\u043C\u043E\u0432\u0435\u0440\u0441\u0438\u044F
        \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
  - key: ui.os.chapter01_ending.demo_thanks
    values:
    - language: 0
      text: "\u611F\u8C22\u6E38\u73A9\u3002"
    - language: 1
      text: "\u611F\u8B1D\u904A\u73A9\u3002"
    - language: 2
      text: Thank you for playing.
    - language: 3
      text: "\u30D7\u30EC\u30A4\u3057\u3066\u3044\u305F\u3060\u304D\u3001\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002"
    - language: 4
      text: "\uD50C\uB808\uC774\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    - language: 5
      text: "Merci d\u2019avoir jou\xE9."
    - language: 6
      text: "Danke f\xFCrs Spielen."
    - language: 7
      text: Gracias por jugar.
    - language: 8
      text: Obrigado por jogar.
    - language: 9
      text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0438\u0433\u0440\u0443."
  - key: ui.os.chapter01_ending.return_menu
    values:
    - language: 0
      text: "\u56DE\u5230\u4E3B\u83DC\u5355"
    - language: 1
      text: "\u56DE\u5230\u4E3B\u9078\u55AE"
    - language: 2
      text: Return to Main Menu
    - language: 3
      text: "\u30E1\u30A4\u30F3\u30E1\u30CB\u30E5\u30FC\u3078\u623B\u308B"
    - language: 4
      text: "\uBA54\uC778 \uBA54\uB274\uB85C \uB3CC\uC544\uAC00\uAE30"
    - language: 5
      text: Retour au menu principal
    - language: 6
      text: "Zur\xFCck zum Hauptmen\xFC"
    - language: 7
      text: "Volver al men\xFA principal"
    - language: 8
      text: Voltar ao menu principal
    - language: 9
      text: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435
        \u043C\u0435\u043D\u044E"
  - key: ui.save.new_title
    values:
    - language: 0
      text: "\u5F00\u59CB\u65B0\u6E38\u620F\uFF1F"
    - language: 1
      text: "\u958B\u59CB\u65B0\u904A\u6232\uFF1F"
    - language: 2
      text: Start a new game?
    - language: 3
      text: "\u65B0\u3057\u304F\u59CB\u3081\u307E\u3059\u304B\uFF1F"
    - language: 4
      text: "\uC0C8 \uAC8C\uC784\uC744 \uC2DC\uC791\uD560\uAE4C\uC694?"
    - language: 5
      text: Commencer une nouvelle partie ?
    - language: 6
      text: Neues Spiel starten?
    - language: 7
      text: "\xBFEmpezar una partida nueva?"
    - language: 8
      text: "Come\xE7ar um novo jogo?"
    - language: 9
      text: "\u041D\u0430\u0447\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E
        \u0438\u0433\u0440\u0443?"
  - key: ui.save.new_body
    values:
    - language: 0
      text: "\u5F53\u524D\u81EA\u52A8\u5B58\u6863\u5C06\u88AB\u8986\u76D6\u3002\n\u8BED\u8A00\u548C\u6E38\u620F\u8BBE\u7F6E\u4F1A\u4FDD\u7559\u3002"
    - language: 1
      text: "\u76EE\u524D\u7684\u81EA\u52D5\u5B58\u6A94\u5C07\u88AB\u8986\u84CB\u3002\n\u8A9E\u8A00\u8207\u904A\u6232\u8A2D\u5B9A\u6703\u4FDD\u7559\u3002"
    - language: 2
      text: 'Your current autosave will be replaced.

        Language and game settings
        will be kept.'
    - language: 3
      text: "\u73FE\u5728\u306E\u30AA\u30FC\u30C8\u30BB\u30FC\u30D6\u306F\u4E0A\u66F8\u304D\u3055\u308C\u307E\u3059\u3002\n\u8A00\u8A9E\u3068\u30B2\u30FC\u30E0\u8A2D\u5B9A\u306F\u5F15\u304D\u7D99\u304C\u308C\u307E\u3059\u3002"
    - language: 4
      text: "\uD604\uC7AC \uC790\uB3D9 \uC800\uC7A5 \uB370\uC774\uD130\uAC00 \uB36E\uC5B4\uC50C\uC6CC\uC9D1\uB2C8\uB2E4.\n\uC5B8\uC5B4\uC640
        \uAC8C\uC784 \uC124\uC815\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    - language: 5
      text: "La sauvegarde automatique actuelle sera remplac\xE9e.\nLa langue et
        les r\xE9glages seront conserv\xE9s."
    - language: 6
      text: "Der aktuelle automatische Spielstand wird \xFCberschrieben.\nSprache
        und Einstellungen bleiben erhalten."
    - language: 7
      text: "Se sobrescribir\xE1 el guardado autom\xE1tico actual.\nSe conservar\xE1n
        el idioma y los ajustes."
    - language: 8
      text: "O salvamento autom\xE1tico atual ser\xE1 substitu\xEDdo.\nO idioma e
        as configura\xE7\xF5es ser\xE3o mantidos."
    - language: 9
      text: "\u0422\u0435\u043A\u0443\u0449\u0435\u0435 \u0430\u0432\u0442\u043E\u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435
        \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E.\n\u042F\u0437\u044B\u043A
        \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0438\u0433\u0440\u044B
        \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F."
  - key: ui.save.start_new
    values:
    - language: 0
      text: "\u5F00\u59CB\u65B0\u6E38\u620F"
    - language: 1
      text: "\u958B\u59CB\u65B0\u904A\u6232"
    - language: 2
      text: Start new game
    - language: 3
      text: "\u65B0\u3057\u304F\u59CB\u3081\u308B"
    - language: 4
      text: "\uC0C8 \uAC8C\uC784 \uC2DC\uC791"
    - language: 5
      text: Nouvelle partie
    - language: 6
      text: Neues Spiel
    - language: 7
      text: Nueva partida
    - language: 8
      text: Novo jogo
    - language: 9
      text: "\u041D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430"
  - key: ui.save.cancel
    values:
    - language: 0
      text: "\u53D6\u6D88"
    - language: 1
      text: "\u53D6\u6D88"
    - language: 2
      text: Cancel
    - language: 3
      text: "\u30AD\u30E3\u30F3\u30BB\u30EB"
    - language: 4
      text: "\uCDE8\uC18C"
    - language: 5
      text: Annuler
    - language: 6
      text: Abbrechen
    - language: 7
      text: Cancelar
    - language: 8
      text: Cancelar
    - language: 9
      text: "\u041E\u0442\u043C\u0435\u043D\u0430"
  - key: ui.save.error_title
    values:
    - language: 0
      text: "\u81EA\u52A8\u5B58\u6863"
    - language: 1
      text: "\u81EA\u52D5\u5B58\u6A94"
    - language: 2
      text: Autosave
    - language: 3
      text: "\u30AA\u30FC\u30C8\u30BB\u30FC\u30D6"
    - language: 4
      text: "\uC790\uB3D9 \uC800\uC7A5"
    - language: 5
      text: Sauvegarde automatique
    - language: 6
      text: Automatischer Spielstand
    - language: 7
      text: "Guardado autom\xE1tico"
    - language: 8
      text: "Salvamento autom\xE1tico"
    - language: 9
      text: "\u0410\u0432\u0442\u043E\u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435"
  - key: ui.save.load_failed
    values:
    - language: 0
      text: "\u65E0\u6CD5\u8BFB\u53D6\u81EA\u52A8\u5B58\u6863\u3002\n\u539F\u5B58\u6863\u6CA1\u6709\u88AB\u8986\u76D6\u3002"
    - language: 1
      text: "\u7121\u6CD5\u8B80\u53D6\u81EA\u52D5\u5B58\u6A94\u3002\n\u539F\u5B58\u6A94\u4E26\u672A\u88AB\u8986\u84CB\u3002"
    - language: 2
      text: 'The autosave could not be loaded.

        Your existing save has not
        been overwritten.'
    - language: 3
      text: "\u30AA\u30FC\u30C8\u30BB\u30FC\u30D6\u3092\u8AAD\u307F\u8FBC\u3081\u307E\u305B\u3093\u3067\u3057\u305F\u3002\n\u65E2\u5B58\u306E\u30BB\u30FC\u30D6\u30C7\u30FC\u30BF\u306F\u5909\u66F4\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002"
    - language: 4
      text: "\uC790\uB3D9 \uC800\uC7A5 \uB370\uC774\uD130\uB97C \uBD88\uB7EC\uC624\uC9C0
        \uBABB\uD588\uC2B5\uB2C8\uB2E4.\n\uAE30\uC874 \uC800\uC7A5 \uB370\uC774\uD130\uB294
        \uB36E\uC5B4\uC4F0\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    - language: 5
      text: "Impossible de charger la sauvegarde automatique.\nLa sauvegarde existante
        n\u2019a pas \xE9t\xE9 remplac\xE9e."
    - language: 6
      text: "Der automatische Spielstand konnte nicht geladen werden.\nDer bestehende
        Spielstand wurde nicht \xFCberschrieben."
    - language: 7
      text: "No se pudo cargar el guardado autom\xE1tico.\nNo se ha sobrescrito el
        guardado anterior."
    - language: 8
      text: "N\xE3o foi poss\xEDvel carregar o salvamento autom\xE1tico.\nO salvamento
        anterior n\xE3o foi substitu\xEDdo."
    - language: 9
      text: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
        \u0430\u0432\u0442\u043E\u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435.\n\u041F\u0440\u0435\u0436\u043D\u0435\u0435
        \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043D\u0435
        \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E."
  - key: ui.save.write_failed
    values:
    - language: 0
      text: "\u81EA\u52A8\u5B58\u6863\u5199\u5165\u5931\u8D25\uFF0C\u5C1A\u672A\u9000\u51FA\u6E38\u620F\u3002\n\u8BF7\u68C0\u67E5\u78C1\u76D8\u540E\u91CD\u8BD5\u3002"
    - language: 1
      text: "\u81EA\u52D5\u5B58\u6A94\u5BEB\u5165\u5931\u6557\uFF0C\u5C1A\u672A\u9000\u51FA\u904A\u6232\u3002\n\u8ACB\u6AA2\u67E5\u78C1\u789F\u5F8C\u518D\u8A66\u3002"
    - language: 2
      text: 'Autosave failed. The game is still open.

        Please check your
        disk and try again.'
    - language: 3
      text: "\u30AA\u30FC\u30C8\u30BB\u30FC\u30D6\u306B\u5931\u6557\u3057\u305F\u305F\u3081\u3001\u30B2\u30FC\u30E0\u3092\u7D42\u4E86\u3057\u3066\u3044\u307E\u305B\u3093\u3002\n\u30C7\u30A3\u30B9\u30AF\u3092\u78BA\u8A8D\u3057\u3066\u3001\u3082\u3046\u4E00\u5EA6\u304A\u8A66\u3057\u304F\u3060\u3055\u3044\u3002"
    - language: 4
      text: "\uC790\uB3D9 \uC800\uC7A5\uC5D0 \uC2E4\uD328\uD558\uC5EC \uAC8C\uC784\uC744
        \uC885\uB8CC\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\uB514\uC2A4\uD06C\uB97C
        \uD655\uC778\uD55C \uD6C4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    - language: 5
      text: "La sauvegarde a \xE9chou\xE9. Le jeu reste ouvert.\nV\xE9rifiez votre
        disque, puis r\xE9essayez."
    - language: 6
      text: "Speichern fehlgeschlagen. Das Spiel bleibt ge\xF6ffnet.\nBitte pr\xFCfe
        dein Laufwerk und versuche es erneut."
    - language: 7
      text: "El guardado fall\xF3. El juego sigue abierto.\nComprueba el disco e
        int\xE9ntalo de nuevo."
    - language: 8
      text: 'Falha ao salvar. O jogo continua aberto.

        Verifique o disco
        e tente novamente.'
    - language: 9
      text: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
        \u0438\u0433\u0440\u0443. \u0418\u0433\u0440\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
        \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439.\n\u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
        \u0434\u0438\u0441\u043A \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435
        \u043F\u043E\u043F\u044B\u0442\u043A\u0443."
  - key: ui.save.ok
    values:
    - language: 0
      text: "\u77E5\u9053\u4E86"
    - language: 1
      text: "\u77E5\u9053\u4E86"
    - language: 2
      text: OK
    - language: 3
      text: OK
    - language: 4
      text: "\uD655\uC778"
    - language: 5
      text: OK
    - language: 6
      text: OK
    - language: 7
      text: Aceptar
    - language: 8
      text: OK
    - language: 9
      text: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E"
  - key: ui.os.chapter01_ending.demo_update
    values:
    - language: 0
      text: "\u7B2C\u4E8C\u7AE0\u5185\u5BB9\u5C06\u572826.10.20\u65B0\u54C1\u8282\u53D1\u5E03\u3002"
    - language: 1
      text: "\u7B2C\u4E8C\u7AE0\u5167\u5BB9\u5C07\u65BC2026\u5E7410\u670820\u65E5
        Steam Next Fest \u767C\u5E03\u3002"
    - language: 2
      text: Chapter 2 will be released on 20 October 2026 during Steam Next Fest.
    - language: 3
      text: "\u7B2C2\u7AE0\u306F2026\u5E7410\u670820\u65E5\u306ESteam Next Fest\u3067\u516C\u958B\u3055\u308C\u307E\u3059\u3002"
    - language: 4
      text: "\uC81C2\uC7A5 \uCF58\uD150\uCE20\uB294 2026\uB144 10\uC6D4 20\uC77C
        Steam Next Fest\uC5D0\uC11C \uACF5\uAC1C\uB429\uB2C8\uB2E4."
    - language: 5
      text: Le chapitre 2 sortira le 20 octobre 2026 pendant le Steam Next Fest.
    - language: 6
      text: Kapitel 2 erscheint am 20. Oktober 2026 zum Steam Next Fest.
    - language: 7
      text: "El cap\xEDtulo 2 se publicar\xE1 el 20 de octubre de 2026 durante el
        Steam Next Fest."
    - language: 8
      text: "O cap\xEDtulo 2 ser\xE1 lan\xE7ado em 20 de outubro de 2026 durante
        o Steam Next Fest."
    - language: 9
      text: "\u0412\u0442\u043E\u0440\u0430\u044F \u0433\u043B\u0430\u0432\u0430
        \u0432\u044B\u0439\u0434\u0435\u0442 20 \u043E\u043A\u0442\u044F\u0431\u0440\u044F
        2026 \u0433\u043E\u0434\u0430 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
        Steam Next Fest."
  - key: ui.os.chapter01_ending.exit_game
    values:
    - language: 0
      text: "\u9000\u51FA\u6E38\u620F"
    - language: 1
      text: "\u96E2\u958B\u904A\u6232"
    - language: 2
      text: Quit Game
    - language: 3
      text: "\u30B2\u30FC\u30E0\u3092\u7D42\u4E86"
    - language: 4
      text: "\uAC8C\uC784 \uC885\uB8CC"
    - language: 5
      text: Quitter le jeu
    - language: 6
      text: Spiel beenden
    - language: 7
      text: Salir del juego
    - language: 8
      text: Sair do jogo
    - language: 9
      text: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0438\u0433\u0440\u044B"
  - key: ui.os.chapter01_ending.chapter_complete_title
    values:
    - language: 0
      text: "\u7B2C\u4E00\u7AE0\u7ED3\u675F"
    - language: 1
      text: "\u7B2C\u4E00\u7AE0\u7D50\u675F"
    - language: 2
      text: End of Chapter 1
    - language: 3
      text: "\u7B2C1\u7AE0 \u7D42\u4E86"
    - language: 4
      text: "1\uC7A5 \uC885\uB8CC"
    - language: 5
      text: Fin du chapitre 1
    - language: 6
      text: Ende von Kapitel 1
    - language: 7
      text: "Fin del cap\xEDtulo 1"
    - language: 8
      text: "Fim do cap\xEDtulo 1"
    - language: 9
      text: "\u041A\u043E\u043D\u0435\u0446 \u043F\u0435\u0440\u0432\u043E\u0439
        \u0433\u043B\u0430\u0432\u044B"
  - key: ui.os.chapter01_ending.chapter_complete_body
    values:
    - language: 0
      text: "\u611F\u8C22\u6E38\u73A9\u3002"
