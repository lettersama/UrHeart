        {0}"
  - key: ui.os.tool.install.battery_low
    values:
    - language: 0
      text: "\u80FD\u91CF\u4E0D\u8DB3\uFF0C\u5B89\u88C5\u9700\u8981 {1} \u80FD\u91CF\u3002"
    - language: 1
      text: "\u80FD\u91CF\u4E0D\u8DB3\uFF0C\u5B89\u88DD\u9700\u8981 {1} \u80FD\u91CF\u3002"
    - language: 2
      text: Insufficient energy. Installation requires {1}.
    - language: 3
      text: "\u30A8\u30CD\u30EB\u30AE\u30FC\u4E0D\u8DB3\u3002\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u306B\u306F
        {1} \u5FC5\u8981\u3002"
    - language: 4
      text: "\uC5D0\uB108\uC9C0\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4. \uC124\uCE58\uC5D0
        {1} \uD544\uC694\uD569\uB2C8\uB2E4."
    - language: 5
      text: "\xC9nergie insuffisante. Il en faut {1} pour l'installation."
    - language: 6
      text: "Nicht genug Energie. Installation ben\xF6tigt {1}."
    - language: 7
      text: "Energ\xEDa insuficiente. La instalaci\xF3n requiere {1}."
    - language: 8
      text: "Energia insuficiente. A instala\xE7\xE3o requer {1}."
    - language: 9
      text: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
        \u044D\u043D\u0435\u0440\u0433\u0438\u0438. \u0414\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
        \u043D\u0443\u0436\u043D\u043E {1}."
  - key: ui.os.tool.program.unavailable
    values:
    - language: 0
      text: "\u65E0\u6CD5\u8BBF\u95EE\u56DE\u5FC6\u533A\u7A0B\u5E8F\u5305\u3002"
    - language: 1
      text: "\u7121\u6CD5\u5B58\u53D6\u56DE\u61B6\u5340\u7A0B\u5F0F\u5957\u4EF6\u3002"
    - language: 2
      text: Memory packages unavailable.
    - language: 3
      text: "\u8A18\u61B6\u9818\u57DF\u306E\u30D1\u30C3\u30B1\u30FC\u30B8\u306B\u30A2\u30AF\u30BB\u30B9\u3067\u304D\u307E\u305B\u3093\u3002"
    - language: 4
      text: "\uAE30\uC5B5 \uC601\uC5ED \uD328\uD0A4\uC9C0\uC5D0 \uC811\uADFC\uD560
        \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    - language: 5
      text: Paquets de souvenirs inaccessibles.
    - language: 6
      text: "Erinnerungspakete nicht verf\xFCgbar."
    - language: 7
      text: No se puede acceder a los paquetes de recuerdos.
    - language: 8
      text: "Pacotes de mem\xF3ria indispon\xEDveis."
    - language: 9
      text: "\u041F\u0430\u043A\u0435\u0442\u044B \u043F\u0430\u043C\u044F\u0442\u0438
        \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B."
  - key: ui.os.tool.program.unpack_first
    values:
    - language: 0
      text: "\u8BF7\u5148\u8FD0\u884C {0}\u3002"
    - language: 1
      text: "\u8ACB\u5148\u57F7\u884C {0}\u3002"
    - language: 2
      text: Run {0} first.
    - language: 3
      text: "\u5148\u306B {0} \u3092\u5B9F\u884C\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    - language: 4
      text: "\uBA3C\uC800 {0}\uB97C \uC2E4\uD589\uD558\uC138\uC694."
    - language: 5
      text: "Ex\xE9cutez d'abord {0}."
    - language: 6
      text: "Zuerst {0} ausf\xFChren."
    - language: 7
      text: Ejecuta primero {0}.
    - language: 8
      text: Execute {0} primeiro.
    - language: 9
      text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435
        {0}."
  - key: ui.os.tool.program.unknown
    values:
    - language: 0
      text: "\u672A\u627E\u5230\u7A0B\u5E8F\u5305\uFF1A{0}"
    - language: 1
      text: "\u627E\u4E0D\u5230\u7A0B\u5F0F\u5957\u4EF6\uFF1A{0}"
    - language: 2
      text: 'Package not found: {0}'
    - language: 3
      text: "\u30D1\u30C3\u30B1\u30FC\u30B8\u304C\u898B\u3064\u304B\u308A\u307E\u305B\u3093\uFF1A{0}"
    - language: 4
      text: "\uD328\uD0A4\uC9C0\uB97C \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4:
        {0}"
    - language: 5
      text: 'Paquet introuvable : {0}'
    - language: 6
      text: 'Paket nicht gefunden: {0}'
    - language: 7
      text: 'Paquete no encontrado: {0}'
    - language: 8
      text: "Pacote n\xE3o encontrado: {0}"
    - language: 9
      text: "\u041F\u0430\u043A\u0435\u0442 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D:
        {0}"
  - key: ui.os.tool.command.usage
    values:
    - language: 0
      text: "tool unpack --memory - \u5C55\u5F00\u56DE\u5FC6\u533A\u7A0B\u5E8F\u5305\ntool
        install <\u7A0B\u5E8F\u5305ID> - \u5B89\u88C5\u7A0B\u5E8F"
    - language: 1
      text: "tool unpack --memory - \u5C55\u958B\u56DE\u61B6\u5340\u7A0B\u5F0F\u5957\u4EF6\ntool
        install <\u7A0B\u5F0F\u5957\u4EF6ID> - \u5B89\u88DD\u7A0B\u5F0F"
    - language: 2
      text: 'tool unpack --memory - Unpack memory packages

        tool install
        <package-id> - Install a program'
    - language: 3
      text: "tool unpack --memory - \u8A18\u61B6\u9818\u57DF\u306E\u30D1\u30C3\u30B1\u30FC\u30B8\u3092\u5C55\u958B\ntool
        install <\u30D1\u30C3\u30B1\u30FC\u30B8ID> - \u30D7\u30ED\u30B0\u30E9\u30E0\u3092\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB"
    - language: 4
      text: "tool unpack --memory - \uAE30\uC5B5 \uC601\uC5ED \uD328\uD0A4\uC9C0
        \uC555\uCD95 \uD574\uC81C\ntool install <\uD328\uD0A4\uC9C0-ID> - \uD504\uB85C\uADF8\uB7A8
        \uC124\uCE58"
    - language: 5
      text: "tool unpack --memory - D\xE9compresser les paquets de souvenirs\ntool
        install <id-paquet> - Installer un programme"
    - language: 6
      text: 'tool unpack --memory - Erinnerungspakete entpacken

        tool install
        <Paket-ID> - Programm installieren'
    - language: 7
      text: 'tool unpack --memory - Descomprimir paquetes de recuerdos

        tool
        install <id-paquete> - Instalar un programa'
    - language: 8
      text: "tool unpack --memory - Descompactar pacotes de mem\xF3ria\ntool install
        <id-pacote> - Instalar um programa"
    - language: 9
      text: "tool unpack --memory - \u0420\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u0430\u0442\u044C
        \u043F\u0430\u043A\u0435\u0442\u044B \u043F\u0430\u043C\u044F\u0442\u0438\ntool
        install <ID-\u043F\u0430\u043A\u0435\u0442\u0430> - \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443"
  - key: ui.os.memory.repair_required
    values:
    - language: 0
      text: "\u7F3A\u5C11\uFF1A\u56DE\u5FC6\u533A\u4FEE\u590D\u7EC4\u4EF6#1"
    - language: 1
      text: "\u7F3A\u5C11\uFF1A\u56DE\u61B6\u5340\u4FEE\u5FA9\u5143\u4EF6#1"
    - language: 2
      text: 'Missing: Memory Repair Component #1'
    - language: 3
      text: "\u5FC5\u8981\uFF1A\u8A18\u61B6\u9818\u57DF\u4FEE\u5FA9\u30E2\u30B8\u30E5\u30FC\u30EB#1"
    - language: 4
      text: "\uD544\uC694: \uAE30\uC5B5 \uC601\uC5ED \uBCF5\uAD6C \uBAA8\uB4C8 #1"
    - language: 5
      text: "Requis : module de r\xE9paration des souvenirs #1"
    - language: 6
      text: "Ben\xF6tigt: Erinnerungsreparaturmodul #1"
    - language: 7
      text: "Falta: m\xF3dulo de reparaci\xF3n de recuerdos #1"
    - language: 8
      text: "Falta: m\xF3dulo de reparo de mem\xF3rias #1"
    - language: 9
      text: "\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F: \u043C\u043E\u0434\u0443\u043B\u044C
        \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
        \u043F\u0430\u043C\u044F\u0442\u0438 #1"
  - key: os.memory.1000.text
    values:
    - language: 0
      text: "\u6211\u7684\u5973\u513F\u5DF2\u7ECF\u4E24\u5929\u6CA1\u56DE\u6765\u4E86\uFF0C\u57CE\u5E02\u91CC\u56DB\u5904\u90FD\u662F\u66B4\u52A8...\u4E3A\u4E86\u628A\u5979\u627E\u56DE\u6765\uFF0C\u6211\u5DF2\u7ECF\u4E24\u5BBF\u6CA1\u5408\u773C\u4E86.."
    - language: 1
      text: "\u6211\u7684\u5973\u5152\u5DF2\u7D93\u5169\u5929\u6C92\u56DE\u4F86\u4E86\uFF0C\u57CE\u5E02\u88E1\u56DB\u8655\u90FD\u662F\u66B4\u52D5...\u70BA\u4E86\u628A\u5979\u627E\u56DE\u4F86\uFF0C\u6211\u5DF2\u7D93\u5169\u5BBF\u6C92\u95A4\u773C\u4E86.."
    - language: 2
      text: My daughter hasn't come home for two days. Riots are breaking out all
        over the city... I've spent two sleepless nights trying to find her..
    - language: 3
      text: "\u5A18\u304C\u5E30\u3063\u3066\u3053\u306A\u304F\u306A\u3063\u3066\u3001\u3082\u3046\u4E8C\u65E5\u3002\u8857\u306E\u3042\u3061\u3053\u3061\u3067\u66B4\u52D5\u304C\u8D77\u304D\u3066\u3044\u308B...\u3042\u306E\u5B50\u3092\u898B\u3064\u3051\u3088\u3046\u3068\u3001\u79C1\u3082\u4E8C\u6669\u3001\u4E00\u7761\u3082\u3057\u3066\u3044\u306A\u3044.."
    - language: 4
      text: "\uB538\uC774 \uC9D1\uC5D0 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC740 \uC9C0
        \uBC8C\uC368 \uC774\uD2C0\uC774\uB2E4. \uB3C4\uC2DC \uACF3\uACF3\uC5D0\uC11C
        \uD3ED\uB3D9\uC774 \uBC8C\uC5B4\uC9C0\uACE0 \uC788\uB2E4... \uC544\uC774\uB97C
        \uCC3E\uB290\uB77C \uB098\uB3C4 \uC774\uD2C0 \uBC24\uC744 \uD55C\uC228\uB3C4
        \uBABB \uC7A4\uB2E4.."
    - language: 5
      text: "Ma fille n'est pas rentr\xE9e depuis deux jours. Des \xE9meutes \xE9clatent
        partout en ville... J'ai pass\xE9 deux nuits sans fermer l'\u0153il \xE0
        la chercher.."
    - language: 6
      text: "Meine Tochter ist seit zwei Tagen nicht nach Hause gekommen. \xDCberall
        in der Stadt gibt es Aufst\xE4nde... Seit zwei N\xE4chten habe ich auf der
        Suche nach ihr kein Auge zugetan.."
    - language: 7
      text: "Mi hija lleva dos d\xEDas sin volver a casa. Hay disturbios por toda
        la ciudad... Llevo dos noches sin pegar ojo busc\xE1ndola.."
    - language: 8
      text: "Minha filha n\xE3o volta para casa h\xE1 dois dias. H\xE1 revoltas por
        toda a cidade... J\xE1 passei duas noites sem pregar o olho, procurando por
        ela.."
    - language: 9
      text: "\u041C\u043E\u044F \u0434\u043E\u0447\u044C \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0434\u043E\u043C\u043E\u0439 \u0443\u0436\u0435 \u0434\u0432\u0430 \u0434\u043D\u044F.
        \u041F\u043E \u0432\u0441\u0435\u043C\u0443 \u0433\u043E\u0440\u043E\u0434\u0443
        \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043A\u0438... \u041F\u044B\u0442\u0430\u044F\u0441\u044C
        \u043D\u0430\u0439\u0442\u0438 \u0435\u0451, \u044F \u0443\u0436\u0435 \u0434\u0432\u0435
        \u043D\u043E\u0447\u0438 \u043D\u0435 \u0441\u043E\u043C\u043A\u043D\u0443\u043B\u0430
        \u0433\u043B\u0430\u0437.."
  - key: os.memory.1010.text
    values:
    - language: 0
      text: "\u5916\u9762\u5230\u5904\u8981\u4E48\u88AB\u70E7\u8981\u4E48\u88AB\u7838\uFF0C\u56DB\u5904\u90FD\u88AB\u5C18\u57C3\u67D3\u5F97\u8840\u7EA2\u3002\u8001\u5B9E\u8BF4\u602A\u5413\u4EBA\u7684\uFF0C\u8981\u662F\u6709\u4EBA\u966A\u7740\u5979\u5C31\u597D\u4E86\u2026\u2026\u827E\u4E39\u90A3\u7537\u5B69\u8FD8\u633A\u9760\u8C31\u7684\uFF0C\u8EAB\u4E0A\u6709\u4E00\u70B9\u4ED6\u7236\u4EB2\u7684\u6837\u5B50\u2026\u2026\u5509\u3002"
    - language: 1
      text: "\u5916\u9762\u5230\u8655\u8981\u9EBC\u88AB\u71D2\u8981\u9EBC\u88AB\u7838\uFF0C\u56DB\u8655\u90FD\u88AB\u5875\u57C3\u67D3\u5F97\u8840\u7D05\u3002\u8001\u5BE6\u8AAA\u602A\u5687\u4EBA\u7684\uFF0C\u8981\u662F\u6709\u4EBA\u966A\u8457\u5979\u5C31\u597D\u4E86\u2026\u2026\u827E\u4E39\u90A3\u7537\u5B69\u9084\u633A\u9760\u8B5C\u7684\uFF0C\u8EAB\u4E0A\u6709\u4E00\u9EDE\u4ED6\u7236\u89AA\u7684\u6A23\u5B50\u2026\u2026\u5509\u3002"
    - language: 2
      text: "Everything outside is either burned or smashed, and the dust has stained
        it all blood-red. It's frightening, honestly. I wish someone were with her\u2026
        Aidan's a dependable boy. There's something of his father in him\u2026 Ah."
    - language: 3
      text: "\u5916\u306F\u3069\u3053\u3082\u713C\u304B\u308C\u305F\u308A\u58CA\u3055\u308C\u305F\u308A\u3057\u3066\u3001\u8FBA\u308A\u4E00\u9762\u3001\u821E\u3044\u4E0A\u304C\u308B\u5875\u3067\u8840\u306E\u3088\u3046\u306B\u8D64\u304F\u67D3\u307E\u3063\u3066\u3044\u308B\u3002\u6B63\u76F4\u3001\u6016\u3044\u3002\u8AB0\u304B\u304C\u5A18\u306E\u305D\u3070\u306B\u3044\u3066\u304F\u308C\u305F\u3089\u3044\u3044\u306E\u306B\u2026\u2026\u30A8\u30A4\u30C0\u30F3\u306F\u306A\u304B\u306A\u304B\u983C\u308A\u306B\u306A\u308B\u9752\u5E74\u3060\u3002\u7236\u89AA\u306E\u9762\u5F71\u304C\u5C11\u3057\u3042\u308B\u2026\u2026\u306F\u3042\u3002"
    - language: 4
      text: "\uBC16\uC740 \uC628\uD1B5 \uBD88\uD0C0\uAC70\uB098 \uBD80\uC11C\uC838
        \uC788\uACE0, \uBA3C\uC9C0\uAC00 \uC0AC\uBC29\uC744 \uD54F\uBE5B\uC73C\uB85C
        \uBB3C\uB4E4\uC600\uB2E4. \uC194\uC9C1\uD788 \uBB34\uC12D\uB2E4. \uB204\uAC00
        \uB538 \uACC1\uC5D0 \uC788\uC5B4 \uC8FC\uBA74 \uC88B\uC73C\uB828\uB9CC\u2026\u2026
        \uC5D0\uC774\uB4E0\uC740 \uAF64 \uBBFF\uC74C\uC9C1\uD55C \uCCAD\uB144\uC774\uB2E4.
        \uC544\uBC84\uC9C0\uB97C \uC870\uAE08 \uB2EE\uC740 \uAD6C\uC11D\uB3C4 \uC788\uACE0\u2026\u2026
        \uD558\uC544."
    - language: 5
      text: "Dehors, tout est br\xFBl\xE9 ou saccag\xE9. La poussi\xE8re a tout teint\xE9
        de rouge sang. Franchement, \xE7a fait peur. Si seulement quelqu'un \xE9tait
        avec elle\u2026 Aidan est un gar\xE7on fiable, il a quelque chose de son
        p\xE8re\u2026 Enfin."
    - language: 6
      text: "Drau\xDFen ist alles verbrannt oder zerschlagen. Der Staub hat alles
        blutrot gef\xE4rbt. Ehrlich gesagt macht es mir Angst. Wenn doch nur jemand
        bei ihr w\xE4re\u2026 Aidan ist ein verl\xE4sslicher Junge, er hat etwas
        von seinem Vater\u2026 Ach."
    - language: 7
      text: "Fuera todo est\xE1 quemado o destrozado, y el polvo lo ha te\xF1ido
        todo de rojo sangre. La verdad es que da miedo. Ojal\xE1 haya alguien con
        ella\u2026 Ese chico, Aidan, es de fiar. Tiene algo de su padre\u2026 Ay."
    - language: 8
      text: "L\xE1 fora, est\xE1 tudo queimado ou destru\xEDdo, e a poeira tingiu
        tudo de vermelho-sangue. Para ser sincera, d\xE1 medo. Tomara que tenha algu\xE9m
        com ela\u2026 Aquele rapaz, o Aidan, \xE9 de confian\xE7a. Tem um pouco do
        pai dele\u2026 Ai."
    - language: 9
      text: "\u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u0432\u0441\u0451 \u043B\u0438\u0431\u043E
        \u0441\u043E\u0436\u0436\u0435\u043D\u043E, \u043B\u0438\u0431\u043E \u0440\u0430\u0437\u0431\u0438\u0442\u043E,
        \u0430 \u043F\u044B\u043B\u044C \u043E\u043A\u0440\u0430\u0441\u0438\u043B\u0430
        \u0432\u0441\u0451 \u0432\u043E\u043A\u0440\u0443\u0433 \u0432 \u043A\u0440\u043E\u0432\u0430\u0432\u043E-\u043A\u0440\u0430\u0441\u043D\u044B\u0439
        \u0446\u0432\u0435\u0442. \u0427\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
        \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0432\u0430\u0442\u043E. \u0425\u043E\u0442\u044C
        \u0431\u044B \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0435\u0439 \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0431\u044B\u043B\u2026 \u042D\u0439\u0434\u0430\u043D \u2014 \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0439
        \u043F\u0430\u0440\u0435\u043D\u044C, \u0432 \u043D\u0451\u043C \u0435\u0441\u0442\u044C
        \u0447\u0442\u043E-\u0442\u043E \u043E\u0442 \u0435\u0433\u043E \u043E\u0442\u0446\u0430\u2026
        \u042D\u0445."
  - key: os.memory.1020.text
    values:
    - language: 0
      text: "\u53EF\u6211\u8FDE\u5979\u662F\u4E0D\u662F\u4E00\u4E2A\u4EBA\u90FD\u4E0D\u77E5\u9053\u3002\u5973\u513F\u5979\u4E5F\u611F\u67D3\u4E0A\u4E86\u90A3\u8BE5\u6B7B\u7684\u5FC3\u810F\u75C5\u6BD2\u2026\u2026\u6211\u2026\u2026\u5509\uFF0C\u4E0D\u7BA1\u600E\u4E48\u8BF4\uFF0C\u4ECA\u5929\u4E5F\u6536\u62FE\u4E00\u4E0B\u51C6\u5907\u51FA\u95E8\u627E\u627E\u5979\u5427\u3002"
    - language: 1
      text: "\u53EF\u6211\u9023\u5979\u662F\u4E0D\u662F\u4E00\u500B\u4EBA\u90FD\u4E0D\u77E5\u9053\u3002\u5973\u5152\u5979\u4E5F\u611F\u67D3\u4E0A\u4E86\u90A3\u8A72\u6B7B\u7684\u5FC3\u81DF\u75C5\u6BD2\u2026\u2026\u6211\u2026\u2026\u5509\uFF0C\u4E0D\u7BA1\u600E\u9EBC\u8AAA\uFF0C\u4ECA\u5929\u4E5F\u6536\u62FE\u4E00\u4E0B\u6E96\u5099\u51FA\u9580\u627E\u627E\u5979\u5427\u3002"
    - language: 2
      text: "But I don't even know if she's alone. My daughter caught that damned
        heart virus too\u2026 I\u2026 Ah, anyway, I'd better get ready and go out
        looking for her again today."
    - language: 3
      text: "\u3067\u3082\u3001\u3042\u306E\u5B50\u304C\u4E00\u4EBA\u3067\u3044\u308B\u306E\u304B\u3069\u3046\u304B\u3055\u3048\u5206\u304B\u3089\u306A\u3044\u3002\u5A18\u307E\u3067\u3001\u3042\u306E\u5FCC\u3005\u3057\u3044\u5FC3\u81D3\u30A6\u30A4\u30EB\u30B9\u306B\u611F\u67D3\u3057\u3066\u3057\u307E\u3063\u305F\u2026\u2026\u79C1\u2026\u2026\u306F\u3042\u3001\u3068\u306B\u304B\u304F\u4ECA\u65E5\u3082\u652F\u5EA6\u3092\u3057\u3066\u3001\u3042\u306E\u5B50\u3092\u635C\u3057\u306B\u51FA\u3088\u3046\u3002"
    - language: 4
      text: "\uD558\uC9C0\uB9CC \uADF8 \uC560\uAC00 \uD63C\uC790\uC778\uC9C0\uC870\uCC28
        \uBAA8\uB978\uB2E4. \uC6B0\uB9AC \uB538\uB3C4 \uADF8 \uBE4C\uC5B4\uBA39\uC744
        \uC2EC\uC7A5 \uBC14\uC774\uB7EC\uC2A4\uC5D0 \uAC10\uC5FC\uB410\uB2E4\u2026\u2026
        \uB098\uB294\u2026\u2026 \uD558\uC544, \uC5B4\uCA0C\uB4E0 \uC624\uB298\uB3C4
        \uCC44\uBE44\uB97C \uD558\uACE0 \uB538\uC744 \uCC3E\uC544 \uB098\uAC00 \uBD10\uC57C\uACA0\uB2E4."
    - language: 5
      text: "Mais je ne sais m\xEAme pas si elle est seule. Ma fille a aussi attrap\xE9
        ce fichu virus cardiaque\u2026 Je\u2026 Enfin, quoi qu'il en soit, je ferais
        mieux de me pr\xE9parer pour aller la chercher encore aujourd'hui."
    - language: 6
      text: "Aber ich wei\xDF ja nicht einmal, ob sie allein ist. Meine Tochter hat
        sich auch dieses verdammte Herzvirus eingefangen\u2026 Ich\u2026 Ach, wie
        auch immer. Ich sollte mich fertig machen und heute wieder nach ihr suchen."
    - language: 7
      text: "Pero ni siquiera s\xE9 si est\xE1 sola. Mi hija tambi\xE9n ha contra\xEDdo
        ese maldito virus card\xEDaco\u2026 Yo\u2026 Ay, en fin, ser\xE1 mejor que
        me prepare para salir a buscarla hoy tambi\xE9n."
    - language: 8
      text: "Mas eu nem sei se ela est\xE1 sozinha. Minha filha tamb\xE9m pegou aquele
        maldito v\xEDrus card\xEDaco\u2026 Eu\u2026 Ai, de qualquer forma, \xE9 melhor
        me arrumar para sair e procurar por ela hoje tamb\xE9m."
    - language: 9
      text: "\u041D\u043E \u044F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E,
        \u043E\u0434\u043D\u0430 \u043B\u0438 \u043E\u043D\u0430. \u0414\u043E\u0447\u044C
        \u0432\u0435\u0434\u044C \u0442\u043E\u0436\u0435 \u0437\u0430\u0440\u0430\u0437\u0438\u043B\u0430\u0441\u044C
        \u044D\u0442\u0438\u043C \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u043C
        \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u043C \u0432\u0438\u0440\u0443\u0441\u043E\u043C\u2026
        \u042F\u2026 \u042D\u0445, \u043A\u0430\u043A \u0431\u044B \u0442\u043E \u043D\u0438
        \u0431\u044B\u043B\u043E, \u043D\u0430\u0434\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F.
        \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u043D\u043E\u0432\u0430
        \u043F\u043E\u0439\u0434\u0443 \u0435\u0451 \u0438\u0441\u043A\u0430\u0442\u044C."
  - key: os.memory.1030.text
    values:
    - language: 0
      text: "\u6D17\u8138\uFF0C\u5237\u7259\uFF0C\u6211\u76EF\u7740\u955C\u5B50\u91CC\u62AB\u5934\u6563\u53D1\u7684\u5973\u4EBA....\u6211\u627F\u8BA4\u6700\u8FD1\u7684\u4E8B\u60C5\u5F04\u7684\u6211\u6709\u4E9B\u795E\u7ECF\u8D28\u4E86\uFF0C\u81EA\u4ECE\u8FD9\u4E2A\u56FD\u5BB6\u7206\u53D1\u75C5\u6BD2\u5F00\u59CB\uFF0C\u4E00\u5207\u5C31\u5F00\u59CB\u5F80\u574F\u7684\u65B9\u9762\u53D1\u5C55\u3002"
    - language: 1
      text: "\u6D17\u81C9\uFF0C\u5237\u7259\uFF0C\u6211\u76EF\u8457\u93E1\u5B50\u88E1\u62AB\u982D\u6563\u9AEE\u7684\u5973\u4EBA....\u6211\u627F\u8A8D\u6700\u8FD1\u7684\u4E8B\u60C5\u5F04\u7684\u6211\u6709\u4E9B\u795E\u7D93\u8CEA\u4E86\uFF0C\u81EA\u5F9E\u9019\u500B\u570B\u5BB6\u7206\u767C\u75C5\u6BD2\u958B\u59CB\uFF0C\u4E00\u5207\u5C31\u958B\u59CB\u5F80\u58DE\u7684\u65B9\u9762\u767C\u5C55\u3002"
    - language: 2
      text: I wash my face, brush my teeth, and stare at the disheveled woman in
        the mirror.... I'll admit these past few days have left me rather on edge.
        Ever since the virus broke out in this country, everything has been going
        wrong.
    - language: 3
      text: "\u9854\u3092\u6D17\u3044\u3001\u6B6F\u3092\u78E8\u304D\u306A\u304C\u3089\u3001\u93E1\u306E\u4E2D\u306E\u9AEA\u3092\u632F\u308A\u4E71\u3057\u305F\u5973\u3092\u898B\u3064\u3081\u308B....\u6700\u8FD1\u306E\u51FA\u6765\u4E8B\u3067\u3001\u5C11\u3057\u795E\u7D4C\u8CEA\u306B\u306A\u3063\u3066\u3044\u308B\u306E\u306F\u8A8D\u3081\u308B\u3002\u3053\u306E\u56FD\u3067\u30A6\u30A4\u30EB\u30B9\u304C\u5E83\u304C\u308A\u59CB\u3081\u3066\u304B\u3089\u3001\u4F55\u3082\u304B\u3082\u60AA\u3044\u307B\u3046\u3078\u5411\u304B\u3063\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uC138\uC218\uD558\uACE0 \uC774\uB97C \uB2E6\uC73C\uBA70 \uAC70\uC6B8
        \uC18D \uBA38\uB9AC \uD5DD\uD074\uC5B4\uC9C4 \uC5EC\uC790\uB97C \uBC14\uB77C\uBCF8\uB2E4....
        \uC694\uC998 \uC77C\uB4E4 \uB54C\uBB38\uC5D0 \uB0B4\uAC00 \uC870\uAE08 \uC2E0\uACBD\uC9C8\uC801\uC73C\uB85C
        \uBCC0\uD588\uB2E4\uB294 \uAC74 \uC778\uC815\uD55C\uB2E4. \uC774 \uB098\uB77C\uC5D0
        \uBC14\uC774\uB7EC\uC2A4\uAC00 \uD37C\uC9C0\uAE30 \uC2DC\uC791\uD55C \uB4A4\uB85C
        \uBAA8\uB4E0 \uAC8C \uB098\uBE60\uC9C0\uAE30\uB9CC \uD588\uB2E4."
    - language: 5
      text: "Je me lave le visage, me brosse les dents et fixe la femme \xE9chevel\xE9e
        dans le miroir.... Je reconnais que les derniers \xE9v\xE9nements m'ont mise
        \xE0 cran. Depuis que le virus s'est d\xE9clar\xE9 dans ce pays, tout va
        de travers."
    - language: 6
      text: "Ich wasche mein Gesicht, putze die Z\xE4hne und starre die zerzauste
        Frau im Spiegel an.... Zugegeben, die letzten Ereignisse haben mich ziemlich
        nerv\xF6s gemacht. Seit das Virus in diesem Land ausgebrochen ist, geht alles
        bergab."
    - language: 7
      text: "Me lavo la cara, me cepillo los dientes y observo a la mujer desgre\xF1ada
        en el espejo.... Admito que los \xFAltimos acontecimientos me han puesto
        algo nerviosa. Desde que estall\xF3 el brote en este pa\xEDs, todo ha ido
        de mal en peor."
    - language: 8
      text: "Lavo o rosto, escovo os dentes e encaro a mulher descabelada no espelho....
        Admito que os \xFAltimos acontecimentos me deixaram com os nervos \xE0 flor
        da pele. Desde que o v\xEDrus se espalhou por este pa\xEDs, tudo come\xE7ou
        a dar errado."
    - language: 9
      text: "\u0423\u043C\u044B\u0432\u0430\u044E\u0441\u044C, \u0447\u0438\u0449\u0443
        \u0437\u0443\u0431\u044B \u0438 \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430
        \u0440\u0430\u0441\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u0443\u044E
        \u0436\u0435\u043D\u0449\u0438\u043D\u0443 \u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u0435....
        \u041F\u0440\u0438\u0437\u043D\u0430\u044E, \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0440\u0430\u0441\u0448\u0430\u0442\u0430\u043B\u0438 \u043C\u043D\u0435
        \u043D\u0435\u0440\u0432\u044B. \u0421 \u0442\u0435\u0445 \u043F\u043E\u0440
        \u043A\u0430\u043A \u0432 \u044D\u0442\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u0435
        \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u043B\u0430 \u044D\u043F\u0438\u0434\u0435\u043C\u0438\u044F,
        \u0432\u0441\u0451 \u0438\u0434\u0451\u0442 \u043D\u0430\u043F\u0435\u0440\u0435\u043A\u043E\u0441\u044F\u043A."
  - key: os.memory.1040.text
    values:
    - language: 0
      text: "\u5148\u662F\u4E22\u6389\u7814\u7A76\u6240\u7684\u5DE5\u4F5C\uFF0C\u518D\u662F\u90A3\u4E2A\u8BE5\u6B7B\u7684\u56FD\u5BB6\u53D1\u52A8\u7684\u5077\u88AD\u6218\u4E89\uFF0C\u7269\u8D44\u7D27\u7F3A\u548C\u75C5\u6BD2\u7B80\u76F4\u8981\u6467\u6BC1\u6211\u4EEC\u7684\u751F\u6D3B...\u6700\u8FD1\u7684\u5F62\u52BF\u8D8A\u6765\u8D8A\u4E25\u5CFB\u4E86\u3002"
    - language: 1
      text: "\u5148\u662F\u4E1F\u6389\u7814\u7A76\u6240\u7684\u5DE5\u4F5C\uFF0C\u518D\u662F\u90A3\u500B\u8A72\u6B7B\u7684\u570B\u5BB6\u767C\u52D5\u7684\u5077\u8972\u6230\u722D\uFF0C\u7269\u8CC7\u7DCA\u7F3A\u548C\u75C5\u6BD2\u7C21\u76F4\u8981\u6467\u6BC0\u6211\u5011\u7684\u751F\u6D3B...\u6700\u8FD1\u7684\u5F62\u52E2\u8D8A\u4F86\u8D8A\u56B4\u5CFB\u4E86\u3002"
    - language: 2
      text: First I lost my job at the institute. Then that damned country launched
        its surprise attack. Between the shortages and the virus, our lives are falling
        apart... Things have been getting worse by the day.
    - language: 3
      text: "\u307E\u305A\u7814\u7A76\u6240\u306E\u4ED5\u4E8B\u3092\u5931\u3063\u305F\u3002\u6B21\u306B\u3001\u3042\u306E\u5FCC\u3005\u3057\u3044\u56FD\u304C\u5947\u8972\u3092\u4ED5\u639B\u3051\u3066\u304D\u305F\u3002\u7269\u4E0D\u8DB3\u3068\u30A6\u30A4\u30EB\u30B9\u3067\u3001\u79C1\u305F\u3061\u306E\u66AE\u3089\u3057\u306F\u3082\u3046\u5D29\u308C\u305D\u3046\u3060...\u3053\u3053\u6700\u8FD1\u3001\u72B6\u6CC1\u306F\u53B3\u3057\u304F\u306A\u308B\u4E00\u65B9\u3002"
    - language: 4
      text: "\uBA3C\uC800 \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uC77C\uC790\uB9AC\uB97C
        \uC783\uC5C8\uB2E4. \uADF8\uB7EC\uB354\uB2C8 \uADF8 \uBE4C\uC5B4\uBA39\uC744
        \uB098\uB77C\uAC00 \uAE30\uC2B5 \uC804\uC7C1\uC744 \uC77C\uC73C\uCF30\uB2E4.
        \uBB3C\uC790 \uBD80\uC871\uC5D0 \uBC14\uC774\uB7EC\uC2A4\uAE4C\uC9C0, \uC6B0\uB9AC
        \uC0B6\uC744 \uC1A1\uB450\uB9AC\uC9F8 \uBB34\uB108\uB728\uB9B4 \uD310\uC774\uB2E4...
        \uCD5C\uADFC \uB4E4\uC5B4 \uC0C1\uD669\uC740 \uC810\uC810 \uB354 \uC2EC\uAC01\uD574\uC9C0\uACE0
        \uC788\uB2E4."
    - language: 5
      text: "D'abord, j'ai perdu mon poste \xE0 l'institut. Puis ce maudit pays a
        lanc\xE9 son attaque surprise. Entre les p\xE9nuries et le virus, notre vie
        part en morceaux... La situation empire de jour en jour."
    - language: 6
      text: "Erst verlor ich meine Stelle am Institut. Dann kam der \xDCberraschungsangriff
        dieses verfluchten Landes. Die Versorgungsnot und das Virus zerrei\xDFen
        unser Leben... Die Lage wird immer schlimmer."
    - language: 7
      text: "Primero perd\xED mi trabajo en el instituto. Despu\xE9s, aquel maldito
        pa\xEDs lanz\xF3 su ataque sorpresa. La escasez y el virus est\xE1n destrozando
        nuestras vidas... \xDAltimamente la situaci\xF3n no hace m\xE1s que empeorar."
    - language: 8
      text: "Primeiro perdi o emprego no instituto. Depois, aquele maldito pa\xEDs
        lan\xE7ou um ataque surpresa. A escassez e o v\xEDrus est\xE3o destruindo
        nossas vidas... Ultimamente, a situa\xE7\xE3o s\xF3 piora."
    - language: 9
      text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044C
        \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435.
        \u041F\u043E\u0442\u043E\u043C \u044D\u0442\u0430 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0430\u044F
        \u0441\u0442\u0440\u0430\u043D\u0430 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
        \u043D\u0430\u043F\u0430\u043B\u0430 \u043D\u0430 \u043D\u0430\u0441. \u041D\u0435\u0445\u0432\u0430\u0442\u043A\u0430
        \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0438 \u0432\u0438\u0440\u0443\u0441
        \u0432\u043E\u0442-\u0432\u043E\u0442 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0442
        \u043D\u0430\u0448\u0443 \u0436\u0438\u0437\u043D\u044C... \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
        \u0432\u0440\u0435\u043C\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0432\u0441\u0451 \u0445\u0443\u0436\u0435."
  - key: os.memory.1050.text
    values:
    - language: 0
      text: "\u4E5F\u96BE\u602A\u66B4\u52A8\u4F1A\u53D8\u672C\u52A0\u5389\uFF0C\u5E0C\u671B\u5973\u513F\u522B\u8DDF\u7740\u827E\u4E39\u90A3\u6B63\u4E49\u611F\u7206\u68DA\u7684\u5C0F\u5B50\u8DD1\u53BB\u53CD\u5BF9\u66B4\u52A8\uFF0C\u73B0\u5728\u7684\u5E74\u8F7B\u4EBA\u771F\u662F\u8D8A\u6765\u8D8A.......\"\u5E74\u8F7B\"\u4E86\u3002"
    - language: 1
      text: "\u4E5F\u96E3\u602A\u66B4\u52D5\u6703\u8B8A\u672C\u52A0\u53B2\uFF0C\u5E0C\u671B\u5973\u5152\u5225\u8DDF\u8457\u827E\u4E39\u90A3\u6B63\u7FA9\u611F\u7206\u68DA\u7684\u5C0F\u5B50\u8DD1\u53BB\u53CD\u5C0D\u66B4\u52D5\uFF0C\u73FE\u5728\u7684\u5E74\u8F15\u4EBA\u771F\u662F\u8D8A\u4F86\u8D8A.......\"\u5E74\u8F15\"\u4E86\u3002"
    - language: 2
      text: No wonder the riots keep getting worse. I hope my daughter hasn't followed
        that self-righteous boy Aidan off to stand up to the rioters. Young people
        these days are getting more and more....... 'young.'
    - language: 3
      text: "\u66B4\u52D5\u304C\u307E\u3059\u307E\u3059\u3072\u3069\u304F\u306A\u308B\u306E\u3082\u7121\u7406\u306F\u306A\u3044\u3002\u5A18\u304C\u3001\u3042\u306E\u6B63\u7FA9\u611F\u3070\u304B\u308A\u5F37\u3044\u30A8\u30A4\u30C0\u30F3\u306B\u3064\u3044\u3066\u3001\u66B4\u5F92\u306B\u7ACB\u3061\u5411\u304B\u304A\u3046\u3068\u3057\u3066\u3044\u306A\u3051\u308C\u3070\u3044\u3044\u3051\u308C\u3069\u3002\u4ECA\u3069\u304D\u306E\u82E5\u8005\u306F\u3001\u672C\u5F53\u306B\u307E\u3059\u307E\u3059.......\u300E\u82E5\u304F\u300F\u306A\u308B\u3002"
    - language: 4
      text: "\uD3ED\uB3D9\uC774 \uAC08\uC218\uB85D \uC2EC\uD574\uC9C0\uB294 \uAC83\uB3C4
        \uB2F9\uC5F0\uD558\uB2E4. \uB538\uC774 \uC815\uC758\uAC10\uB9CC \uB118\uCE58\uB294
        \uC5D0\uC774\uB4E0\uC744 \uB530\uB77C \uD3ED\uB3C4\uB4E4\uC744 \uB9C9\uACA0\uB2E4\uACE0
        \uB098\uC11C\uC9C0 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uB2E4. \uC694\uC998
        \uC80A\uC740\uC774\uB4E4\uC740 \uC815\uB9D0 \uC810\uC810 \uB354....... '\uC80A\uC5B4'\uC9C4\uB2E4."
    - language: 5
      text: "Pas \xE9tonnant que les \xE9meutes redoublent. Pourvu que ma fille n'ait
        pas suivi ce petit justicier d'Aidan pour s'opposer aux \xE9meutiers. Les
        jeunes d'aujourd'hui sont vraiment de plus en plus....... \xAB jeunes \xBB."
    - language: 6
      text: "Kein Wunder, dass die Aufst\xE4nde immer heftiger werden. Hoffentlich
        ist meine Tochter nicht mit diesem kleinen Weltverbesserer Aidan losgezogen,
        um sich den Aufst\xE4ndischen entgegenzustellen. Die Jugend von heute wird
        wirklich immer....... \u201Ajugendlicher\u2018."
    - language: 7
      text: "No me extra\xF1a que los disturbios vayan a m\xE1s. Espero que mi hija
        no haya seguido a ese justiciero de Aidan para enfrentarse a los alborotadores.
        Los j\xF3venes de hoy son cada vez m\xE1s....... \xABj\xF3venes\xBB."
    - language: 8
      text: "N\xE3o \xE9 de estranhar que as revoltas estejam piorando. Espero que
        minha filha n\xE3o tenha seguido aquele justiceiro do Aidan para enfrentar
        os revoltosos. Os jovens de hoje est\xE3o cada vez mais....... 'jovens'."
    - language: 9
      text: "\u041D\u0435\u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
        \u0447\u0442\u043E \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043A\u0438
        \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F.
        \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0434\u043E\u0447\u044C \u043D\u0435
        \u0443\u0432\u044F\u0437\u0430\u043B\u0430\u0441\u044C \u0437\u0430 \u044D\u0442\u0438\u043C
        \u043F\u043E\u0431\u043E\u0440\u043D\u0438\u043A\u043E\u043C \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0438
        \u042D\u0439\u0434\u0430\u043D\u043E\u043C \u0443\u0441\u043C\u0438\u0440\u044F\u0442\u044C
        \u0431\u0443\u043D\u0442\u043E\u0432\u0449\u0438\u043A\u043E\u0432. \u041D\u044B\u043D\u0435\u0448\u043D\u044F\u044F
        \u043C\u043E\u043B\u043E\u0434\u0451\u0436\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0432\u0441\u0451....... \xAB\u043C\u043E\u043B\u043E\u0436\u0435\xBB."
  - key: os.memory.1060.text
    values:
    - language: 0
      text: "*\u6211\u6DAE\u4E86\u53E3\u6C34\uFF0C\u5410\u5E72\u51C0\u5634\u91CC\u7684\u6CE1\u6CAB\u3002"
    - language: 1
      text: "*\u6211\u6DAE\u4E86\u53E3\u6C34\uFF0C\u5410\u4E7E\u6DE8\u5634\u88E1\u7684\u6CE1\u6CAB\u3002"
    - language: 2
      text: '*I rinse my mouth and spit out the last of the foam.'
    - language: 3
      text: "*\u53E3\u3092\u3059\u3059\u304E\u3001\u6B8B\u3063\u305F\u6CE1\u3092\u304D\u308C\u3044\u306B\u5410\u304D\u51FA\u3059\u3002"
    - language: 4
      text: "*\uC785\uC744 \uD5F9\uAD6C\uACE0 \uB0A8\uC740 \uAC70\uD488\uC744 \uB9D0\uB054\uD788
        \uBC49\uB294\uB2E4."
    - language: 5
      text: "*Je me rince la bouche et recrache les derni\xE8res traces de mousse."
    - language: 6
      text: "*Ich sp\xFCle den Mund aus und spucke den letzten Schaum ins Becken."
    - language: 7
      text: "*Me enjuago la boca y escupo los \xFAltimos restos de espuma."
    - language: 8
      text: "*Enx\xE1guo a boca e cuspo o resto da espuma."
    - language: 9
      text: "*\u042F \u043F\u043E\u043B\u043E\u0449\u0443 \u0440\u043E\u0442 \u0438
        \u0432\u044B\u043F\u043B\u0451\u0432\u044B\u0432\u0430\u044E \u043E\u0441\u0442\u0430\u0442\u043A\u0438
        \u043F\u0435\u043D\u044B."
  - key: os.memory.1070.text
    values:
    - language: 0
      text: "\u6211\u7FFB\u627E\u7740\u6795\u5934\u4E0B\u7684\u4E1C\u897F\uFF0C\u4E00\u628A\u7D27\u51D1\u578B\u624B\u67AA\uFF0C\u8FD9\u5E74\u5934\u7528\u8FD9\u4E2A\u5BF9\u4ED8\u75C5\u6BD2\u53D8\u5F02\u540E\u7684\u517D\u5316\u4EBA\uFF0C\u8FD9\u53EF\u4EE5\u8BF4\u662F\u6709\u4E9B\u641E\u7B11\u3002\u4F46\u53C8\u80FD\u600E\u4E48\u529E\u5462\uFF0C\u5B83\u81F3\u5C11\u53EF\u4EE5\u7ED9\u6211\u70B9\u5B89\u5168\u611F\u3002\u5982\u679C\u627E\u4E0D\u5230\u5973\u513F\uFF0C\u6211\u8FD8\u80FD\u62FF\u5B83\u7ED3\u675F\u4E0B\u6211\u7684\u75DB\u82E6."
    - language: 1
      text: "\u6211\u7FFB\u627E\u8457\u6795\u982D\u4E0B\u7684\u6771\u897F\uFF0C\u4E00\u628A\u7DCA\u6E4A\u578B\u624B\u69CD\uFF0C\u9019\u5E74\u982D\u7528\u9019\u500B\u5C0D\u4ED8\u75C5\u6BD2\u8B8A\u7570\u5F8C\u7684\u7378\u5316\u4EBA\uFF0C\u9019\u53EF\u4EE5\u8AAA\u662F\u6709\u4E9B\u641E\u7B11\u3002\u4F46\u53C8\u80FD\u600E\u9EBC\u8FA6\u5462\uFF0C\u5B83\u81F3\u5C11\u53EF\u4EE5\u7D66\u6211\u9EDE\u5B89\u5168\u611F\u3002\u5982\u679C\u627E\u4E0D\u5230\u5973\u5152\uFF0C\u6211\u9084\u80FD\u62FF\u5B83\u7D50\u675F\u4E0B\u6211\u7684\u75DB\u82E6."
    - language: 2
      text: I rummage under the pillow and find a compact pistol. These days, using
        this against people the virus has turned into beasts is something of a joke.
        But what else can I do? At least it makes me feel a little safer. If I can't
        find my daughter, I could use it to put an end to my suffering.
    - language: 3
      text: "\u6795\u306E\u4E0B\u3092\u63A2\u308B\u3002\u5C0F\u578B\u306E\u62F3\u9283\u3002\u3053\u306E\u3054\u6642\u4E16\u3001\u30A6\u30A4\u30EB\u30B9\u3067\u7363\u5316\u3057\u305F\u4EBA\u9593\u306B\u3053\u308C\u3067\u7ACB\u3061\u5411\u304B\u3046\u306A\u3093\u3066\u3001\u7B11\u3044\u8A71\u306E\u3088\u3046\u306A\u3082\u306E\u3060\u3002\u3067\u3082\u3001\u307B\u304B\u306B\u3069\u3046\u3057\u308D\u3068\u3002\u5C11\u306A\u304F\u3068\u3082\u3001\u5C11\u3057\u306F\u5B89\u5FC3\u3067\u304D\u308B\u3002\u5A18\u304C\u898B\u3064\u304B\u3089\u306A\u3051\u308C\u3070\u3001\u3053\u308C\u3067\u82E6\u3057\u307F\u3092\u7D42\u308F\u3089\u305B\u308B\u3053\u3068\u3060\u3063\u3066\u3067\u304D\u308B\u3002"
    - language: 4
      text: "\uBCA0\uAC1C \uBC11\uC744 \uB4A4\uC9C4\uB2E4. \uC18C\uD615 \uAD8C\uCD1D
        \uD55C \uC790\uB8E8. \uC694\uC998 \uC138\uC0C1\uC5D0 \uBC14\uC774\uB7EC\uC2A4\uB85C
        \uC57C\uC218\uD654\uD55C \uC0AC\uB78C\uB4E4\uC744 \uC774\uAC78\uB85C \uC0C1\uB300\uD558\uACA0\uB2E4\uB294
        \uAC74 \uC880 \uC6B0\uC2A4\uC6B4 \uC77C\uC774\uB2E4. \uADF8\uB798\uB3C4 \uB2EC\uB9AC
        \uC5B4\uCA4C\uACA0\uB294\uAC00. \uC801\uC5B4\uB3C4 \uC870\uAE08\uC740 \uC548\uC2EC\uC774
        \uB41C\uB2E4. \uB538\uC744 \uCC3E\uC9C0 \uBABB\uD558\uBA74, \uC774\uAC78\uB85C
        \uB0B4 \uACE0\uD1B5\uC744 \uB05D\uB0BC \uC218\uB3C4 \uC788\uB2E4."
    - language: 5
      text: "Je fouille sous l'oreiller et retrouve un pistolet compact. Par les
        temps qui courent, affronter avec \xE7a les gens que le virus a transform\xE9s
        en b\xEAtes, c'est presque une plaisanterie. Mais que faire d'autre ? Il
        me rassure un peu, au moins. Si je ne retrouve pas ma fille, je pourrai toujours
        m'en servir pour mettre fin \xE0 ma souffrance."
    - language: 6
      text: "Ich taste unter dem Kopfkissen nach einer kompakten Pistole. Heutzutage
        damit gegen Menschen vorzugehen, die das Virus in Bestien verwandelt hat,
        ist fast schon ein Witz. Aber was soll ich sonst tun? Wenigstens gibt sie
        mir ein bisschen Sicherheit. Wenn ich meine Tochter nicht finde, k\xF6nnte
        ich damit auch meinem Leid ein Ende setzen."
    - language: 7
      text: "Busco bajo la almohada y saco una pistola compacta. A estas alturas,
        usarla contra quienes el virus ha convertido en bestias es casi un chiste.
        Pero \xBFqu\xE9 otra cosa puedo hacer? Al menos me da algo de seguridad.
        Si no encuentro a mi hija, tambi\xE9n podr\xEDa usarla para poner fin a mi
        sufrimiento."
    - language: 8
      text: "Remexo debaixo do travesseiro e encontro uma pistola compacta. Hoje
        em dia, usar isso contra as pessoas que o v\xEDrus transformou em feras chega
        a ser uma piada. Mas o que mais posso fazer? Pelo menos ela me d\xE1 alguma
        seguran\xE7a. Se eu n\xE3o encontrar minha filha, tamb\xE9m posso us\xE1-la
        para acabar com meu sofrimento."
    - language: 9
      text: "\u0428\u0430\u0440\u044E \u043F\u043E\u0434 \u043F\u043E\u0434\u0443\u0448\u043A\u043E\u0439.
        \u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442.
        \u0412 \u043D\u0430\u0448\u0438 \u0434\u043D\u0438 \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F
        \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C\u0441\u044F \u0438\u043C
        \u043E\u0442 \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
        \u0432\u0438\u0440\u0443\u0441 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B
        \u0432 \u0437\u0432\u0435\u0440\u0435\u0439, \u043F\u043E\u043F\u0440\u043E\u0441\u0442\u0443
        \u0441\u043C\u0435\u0448\u043D\u043E. \u041D\u043E \u0447\u0442\u043E \u0435\u0449\u0451
        \u043C\u043D\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F? \u0421
        \u043D\u0438\u043C \u0445\u043E\u0442\u044F \u0431\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435. \u0415\u0441\u043B\u0438
        \u044F \u043D\u0435 \u043D\u0430\u0439\u0434\u0443 \u0434\u043E\u0447\u044C,
        \u0441\u043C\u043E\u0433\u0443 \u0441 \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u044C\u044E
        \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u043E\u043D\u0435\u0446
        \u0441\u0432\u043E\u0438\u043C \u043C\u0443\u0447\u0435\u043D\u0438\u044F\u043C."
  - key: os.memory.1080.text
    values:
    - language: 0
      text: "<color=red>\"\u54AF\u54AF\u54AF\"</color>\uFF0C\u623F\u95F4\u91CC\u4F20\u6765\u4E00\u9635\u7684\u7B11\u58F0\uFF0C\u6211\u77E5\u9053\uFF0C\u5979\u53C8\u5728\u5632\u7B11\u6211\u4E86\uFF0C\u6211\u7684\u8EAB\u5B50\u91CC\u501F\u4F4F\u7740\u53E6\u5916\u4E00\u4E2A\u4EBA\u3002\u81EA\u4ECE\u6211\u4E08\u592B\u7684\u79BB\u53BB\uFF0C\u53E6\u5916\u4E00\u4E2A\u4EBA\u5C31\u94BB\u8FDB\u4E86\u6211\u7684\u8EAB\u4F53\u3002"
    - language: 1
      text: "<color=red>\"\u54AF\u54AF\u54AF\"</color>\uFF0C\u623F\u9593\u88E1\u50B3\u4F86\u4E00\u9663\u7684\u7B11\u8072\uFF0C\u6211\u77E5\u9053\uFF0C\u5979\u53C8\u5728\u5632\u7B11\u6211\u4E86\uFF0C\u6211\u7684\u8EAB\u5B50\u88E1\u501F\u4F4F\u8457\u53E6\u5916\u4E00\u500B\u4EBA\u3002\u81EA\u5F9E\u6211\u4E08\u592B\u7684\u96E2\u53BB\uFF0C\u53E6\u5916\u4E00\u500B\u4EBA\u5C31\u947D\u9032\u4E86\u6211\u7684\u8EAB\u9AD4\u3002"
    - language: 2
      text: <color=red>"Heh heh heh"</color> Laughter rings through the room. I know.
        She's mocking me again. Someone else has taken up residence inside my body.
        Ever since my husband left, someone else has crawled inside me.
    - language: 3
      text: "<color=red>\"\u304F\u3059\u304F\u3059\u304F\u3059\"</color>\u90E8\u5C4B\u306B\u7B11\u3044\u58F0\u304C\u97FF\u304F\u3002\u308F\u304B\u3063\u3066\u3044\u308B\u3002\u307E\u305F\u5F7C\u5973\u304C\u79C1\u3092\u5632\u7B11\u3063\u3066\u3044\u308B\u3002\u79C1\u306E\u4F53\u306B\u306F\u3001\u3082\u3046\u4E00\u4EBA\u304C\u9593\u501F\u308A\u3057\u3066\u3044\u308B\u3002\u592B\u304C\u53BB\u3063\u3066\u304B\u3089\u3001\u5225\u306E\u8AB0\u304B\u304C\u79C1\u306E\u4F53\u306B\u6F5C\u308A\u8FBC\u3093\u3060\u3002"
    - language: 4
      text: "<color=red>\"\uD0A5\uD0A5\uD0A5\"</color> \uBC29 \uC548\uC5D0 \uC6C3\uC74C\uC18C\uB9AC\uAC00
        \uC6B8\uB9B0\uB2E4. \uC548\uB2E4. \uADF8\uB140\uAC00 \uB610 \uB098\uB97C
        \uBE44\uC6C3\uACE0 \uC788\uB2E4. \uB0B4 \uBAB8\uC5D0\uB294 \uB2E4\uB978 \uC0AC\uB78C\uC774
        \uD558\uB098 \uC5B9\uD600\uC0B4\uACE0 \uC788\uB2E4. \uB0A8\uD3B8\uC774 \uB5A0\uB09C
        \uB4A4\uB85C, \uB2E4\uB978 \uB204\uAD70\uAC00\uAC00 \uB0B4 \uBAB8 \uC548\uC73C\uB85C
        \uD30C\uACE0\uB4E4\uC5C8\uB2E4."
    - language: 5
      text: "<color=red>\"Hi hi hi\"</color> Un rire r\xE9sonne dans la pi\xE8ce.
        Je sais, elle se moque encore de moi. Quelqu'un d'autre s'est install\xE9
        dans mon corps. Depuis que mon mari est parti, une autre personne s'est gliss\xE9e
        en moi."
    - language: 6
      text: "<color=red>\"Hehehe\"</color> Ein Lachen hallt durchs Zimmer. Ich wei\xDF,
        sie verspottet mich wieder. In meinem K\xF6rper hat sich jemand anderes eingenistet.
        Seit mein Mann fort ist, ist jemand anderes in meinen K\xF6rper gekrochen."
    - language: 7
      text: "<color=red>\"Je, je, je\"</color> Una risa resuena en la habitaci\xF3n.
        Lo s\xE9, vuelve a burlarse de m\xED. Hay otra persona alojada dentro de
        mi cuerpo. Desde que mi marido se fue, alguien m\xE1s se ha metido dentro
        de m\xED."
    - language: 8
      text: "<color=red>\"Hehehe\"</color> Uma risada ecoa pelo quarto. Eu sei, ela
        est\xE1 zombando de mim outra vez. Tem outra pessoa morando dentro do meu
        corpo. Desde que meu marido se foi, outra pessoa se enfiou dentro de mim."
    - language: 9
      text: "<color=red>\"\u0425\u0438-\u0445\u0438-\u0445\u0438\"</color> \u041F\u043E
        \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0440\u0430\u0437\u043D\u043E\u0441\u0438\u0442\u0441\u044F
        \u0441\u043C\u0435\u0445. \u042F \u0437\u043D\u0430\u044E. \u041E\u043D\u0430
        \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439
        \u0438\u0437\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044F. \u0412 \u043C\u043E\u0451\u043C
        \u0442\u0435\u043B\u0435 \u043F\u043E\u0441\u0435\u043B\u0438\u043B\u0441\u044F
        \u0435\u0449\u0451 \u043A\u0442\u043E-\u0442\u043E. \u0421 \u0442\u0435\u0445
        \u043F\u043E\u0440 \u043A\u0430\u043A \u043C\u0443\u0436 \u0443\u0448\u0451\u043B,
        \u043A\u0442\u043E-\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0439 \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F
        \u0432 \u043C\u043E\u0451 \u0442\u0435\u043B\u043E."
  - key: os.memory.1090.text
    values:
    - language: 0
      text: "\u6211\u6CA1\u6709\u7406\u4F1A\u90A3\u4E2A\u4E11\u964B\u7684\u7B11\u58F0\uFF0C\u62D4\u51FA\u5F39\u5323\uFF0C\u91CC\u9762\u53EA\u6709\u4E24\u9897\u5B50\u5F39\u3002\u7B97\u4E0D\u4E0A\u5B64\u96F6\u96F6\uFF0C\u6BD4\u8D77\u6211\u8FD9\u6837\u4E00\u4E2A\u4E27\u592B\u7684\u5973\u4EBA\u6765\u8BF4\uFF0C\u5F88\u96BE\u8BF4\u6211\u4E0D\u4F1A\u7FA1\u6155\u5B83\u4EEC\u4FE9\u3002"
    - language: 1
      text: "\u6211\u6C92\u6709\u7406\u6703\u90A3\u500B\u919C\u964B\u7684\u7B11\u8072\uFF0C\u62D4\u51FA\u5F48\u5323\uFF0C\u88E1\u9762\u53EA\u6709\u5169\u9846\u5B50\u5F48\u3002\u7B97\u4E0D\u4E0A\u5B64\u96F6\u96F6\uFF0C\u6BD4\u8D77\u6211\u9019\u6A23\u4E00\u500B\u55AA\u592B\u7684\u5973\u4EBA\u4F86\u8AAA\uFF0C\u5F88\u96E3\u8AAA\u6211\u4E0D\u6703\u7FA8\u6155\u5B83\u5011\u5006\u3002"
    - language: 2
      text: I ignore that ugly laugh and pull out the magazine. Only two rounds inside.
        At least they aren't alone. Compared with a woman who's lost her husband,
        like me... well, it's hard not to envy the pair of them.
    - language: 3
      text: "\u919C\u3044\u7B11\u3044\u58F0\u3092\u7121\u8996\u3057\u3066\u3001\u5F3E\u5009\u3092\u629C\u304F\u3002\u5F3E\u306F\u4E8C\u767A\u3060\u3051\u3002\u5C11\u306A\u304F\u3068\u3082\u72EC\u308A\u307C\u3063\u3061\u3067\u306F\u306A\u3044\u3002\u592B\u3092\u5931\u3063\u305F\u79C1\u306E\u3088\u3046\u306A\u5973\u304B\u3089\u3059\u308C\u3070\u3001\u3042\u306E\u4E8C\u3064\u304C\u7FA8\u307E\u3057\u304F\u306A\u3044\u3068\u306F\u8A00\u3044\u5207\u308C\u306A\u3044\u3002"
    - language: 4
      text: "\uADF8 \uCD94\uD55C \uC6C3\uC74C\uC744 \uBB34\uC2DC\uD558\uACE0 \uD0C4\uCC3D\uC744
        \uBE80\uB2E4. \uC548\uC5D0\uB294 \uD0C4\uD658\uC774 \uB450 \uBC1C\uBFD0\uC774\uB2E4.
        \uC801\uC5B4\uB3C4 \uD63C\uC790\uB294 \uC544\uB2C8\uB2E4. \uB098\uCC98\uB7FC
        \uB0A8\uD3B8\uC744 \uC783\uC740 \uC5EC\uC790\uB77C\uBA74, \uC800 \uB458\uC774
        \uBD80\uB7FD\uC9C0 \uC54A\uB2E4\uACE0 \uD558\uAE30\uB294 \uC5B4\uB835\uB2E4."
    - language: 5
      text: "J'ignore ce rire hideux et retire le chargeur. Il ne reste que deux
        cartouches. Au moins, elles ne sont pas seules. Compar\xE9es \xE0 une femme
        qui a perdu son mari, comme moi... difficile de ne pas les envier."
    - language: 6
      text: "Ich ignoriere das h\xE4ssliche Lachen und ziehe das Magazin heraus.
        Nur zwei Patronen. Wenigstens sind sie nicht allein. Verglichen mit einer
        Frau wie mir, die ihren Mann verloren hat... Schwer zu behaupten, dass ich
        die beiden nicht beneide."
    - language: 7
      text: "Ignoro esa risa desagradable y saco el cargador. Solo quedan dos balas.
        Al menos no est\xE1n solas. Comparadas con una mujer que ha perdido a su
        marido, como yo... es dif\xEDcil no envidiarlas."
    - language: 8
      text: "Ignoro aquela risada horr\xEDvel e retiro o carregador. S\xF3 duas balas.
        Pelo menos elas n\xE3o est\xE3o sozinhas. Comparadas a uma mulher que perdeu
        o marido, como eu... \xE9 dif\xEDcil n\xE3o sentir inveja das duas."
    - language: 9
      text: "\u041D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u044F \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
        \u043D\u0430 \u044D\u0442\u043E\u0442 \u043C\u0435\u0440\u0437\u043A\u0438\u0439
        \u0441\u043C\u0435\u0445, \u0432\u044B\u043D\u0438\u043C\u0430\u044E \u043C\u0430\u0433\u0430\u0437\u0438\u043D.
        \u0412\u0441\u0435\u0433\u043E \u0434\u0432\u0430 \u043F\u0430\u0442\u0440\u043E\u043D\u0430.
        \u0417\u0430\u0442\u043E \u043D\u0435 \u043E\u0434\u0438\u043D\u043E\u043A\u0438.
        \u0422\u0430\u043A\u043E\u0439 \u0436\u0435\u043D\u0449\u0438\u043D\u0435,
        \u043A\u0430\u043A \u044F, \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0435\u0439
        \u043C\u0443\u0436\u0430, \u0442\u0440\u0443\u0434\u043D\u043E \u0438\u043C
        \u043D\u0435 \u043F\u043E\u0437\u0430\u0432\u0438\u0434\u043E\u0432\u0430\u0442\u044C."
  - key: os.memory.1100.text
    values:
    - language: 0
      text: "\u6211\u585E\u56DE\u5F39\u5323\uFF0C\u4E3E\u67AA\u5BF9\u7740\u7A97\u5916\u7684\u8001\u6811\uFF0C\u4E0A\u9762\u6709\u4E0D\u5C11\u5F39\u75D5\u3002\u5F53\u7136\uFF0C\u90A3\u4E0D\u662F\u6211\u7684\u8457\u4F5C\u3002\u6211\u53EA\u80FD\u7B97\u662F\u4E2A\u4E0D\u4F1A\u5F00\u67AA\u7684\u79D1\u5B66\u5BB6\uFF0C\u4E0D\u4F1A\u5F00\u67AA\u662F\u771F\u7684\uFF0C\u79D1\u5B66\u5BB6\u4E5F\u80FD\u7B97\u771F\u7684\u3002<color=red>\"\u54AF\u54AF\u54AF\u54AF!\"</color>\uFF0C\u4F60\u770B\uFF0C\u90A3\u4E2A\u4EBA\u53C8\u5728\u5632\u7B11\u6211\u4E86\u3002"
    - language: 1
      text: "\u6211\u585E\u56DE\u5F48\u5323\uFF0C\u8209\u69CD\u5C0D\u8457\u7A97\u5916\u7684\u8001\u6A39\uFF0C\u4E0A\u9762\u6709\u4E0D\u5C11\u5F48\u75D5\u3002\u7576\u7136\uFF0C\u90A3\u4E0D\u662F\u6211\u7684\u8457\u4F5C\u3002\u6211\u53EA\u80FD\u7B97\u662F\u500B\u4E0D\u6703\u958B\u69CD\u7684\u79D1\u5B78\u5BB6\uFF0C\u4E0D\u6703\u958B\u69CD\u662F\u771F\u7684\uFF0C\u79D1\u5B78\u5BB6\u4E5F\u80FD\u7B97\u771F\u7684\u3002<color=red>\"\u54AF\u54AF\u54AF\u54AF!\"</color>\uFF0C\u4F60\u770B\uFF0C\u90A3\u500B\u4EBA\u53C8\u5728\u5632\u7B11\u6211\u4E86\u3002"
    - language: 2
      text: I slide the magazine back in and aim at the old tree outside the window.
        It bears quite a few bullet scars. Those aren't my work, of course. I'm just
        a scientist who can't shoot. The part about not being able to shoot is true,
        and I suppose the scientist part is true too. <color=red>"Heh heh heh heh!"</color>
        See? There she goes, mocking me again.
    - language: 3
      text: "\u5F3E\u5009\u3092\u623B\u3057\u3001\u7A93\u306E\u5916\u306E\u8001\u6728\u306B\u9283\u3092\u5411\u3051\u308B\u3002\u5F3E\u75D5\u304C\u3044\u304F\u3064\u3082\u3042\u308B\u3002\u3082\u3061\u308D\u3093\u3001\u3042\u308C\u306F\u79C1\u306E\u4F5C\u54C1\u3067\u306F\u306A\u3044\u3002\u79C1\u306F\u305F\u3060\u306E\u3001\u9283\u3082\u6483\u3066\u306A\u3044\u79D1\u5B66\u8005\u3060\u3002\u6483\u3066\u306A\u3044\u306E\u306F\u672C\u5F53\u3002\u79D1\u5B66\u8005\u3068\u3044\u3046\u306E\u3082\u3001\u307E\u3042\u672C\u5F53\u3060\u3002<color=red>\"\u304F\u3059\u304F\u3059\u304F\u3059\u304F\u3059\uFF01\"</color>\u307B\u3089\u3001\u307E\u305F\u3042\u306E\u4EBA\u304C\u79C1\u3092\u7B11\u3063\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uD0C4\uCC3D\uC744 \uB07C\uC6B0\uACE0 \uCC3D\uBC16\uC758 \uB299\uC740
        \uB098\uBB34\uC5D0 \uCD1D\uC744 \uACA8\uB208\uB2E4. \uD0C4\uD754\uC774 \uAF64
        \uB9CE\uB2E4. \uBB3C\uB860 \uC800\uAC74 \uB0B4 \uC791\uD488\uC774 \uC544\uB2C8\uB2E4.
        \uB098\uB294 \uADF8\uC800 \uCD1D\uB3C4 \uC3E0 \uC904 \uBAA8\uB974\uB294 \uACFC\uD559\uC790\uC77C
        \uBFD0\uC774\uB2E4. \uCD1D\uC744 \uBABB \uC3D8\uB294 \uAC74 \uC0AC\uC2E4\uC774\uACE0,
        \uACFC\uD559\uC790\uB77C\uB294 \uAC83\uB3C4 \uC0AC\uC2E4\uC774\uB77C\uACE0
        \uD560 \uC218 \uC788\uACA0\uC9C0. <color=red>\"\uD0A5\uD0A5\uD0A5\uD0A5!\"</color>
        \uBCF4\uB77C. \uADF8 \uC0AC\uB78C\uC774 \uB610 \uB098\uB97C \uBE44\uC6C3\uB294\uB2E4."
    - language: 5
      text: "Je remets le chargeur et vise le vieil arbre dehors. Il porte pas mal
        d'impacts. Ce n'est pas mon \u0153uvre, bien s\xFBr. Je ne suis qu'une scientifique
        qui ne sait pas tirer. Que je ne sache pas tirer, c'est vrai. Et scientifique,
        je suppose que \xE7a aussi, c'est vrai. <color=red>\"Hi hi hi hi !\"</color>
        Vous voyez ? Elle recommence \xE0 se moquer de moi."
    - language: 6
      text: "Ich schiebe das Magazin zur\xFCck und ziele auf den alten Baum vor dem
        Fenster. Er ist voller Einschussnarben. Nat\xFCrlich ist das nicht mein Werk.
        Ich bin nur eine Wissenschaftlerin, die nicht schie\xDFen kann. Dass ich
        nicht schie\xDFen kann, stimmt. Und Wissenschaftlerin bin ich wohl auch wirklich.
        <color=red>\"Hehehehe!\"</color> Seht ihr? Schon verspottet sie mich wieder."
    - language: 7
      text: "Vuelvo a introducir el cargador y apunto al viejo \xE1rbol de fuera.
        Tiene bastantes marcas de disparos. No son obra m\xEDa, claro. Solo soy una
        cient\xEDfica que no sabe disparar. Lo de no saber disparar es cierto, y
        supongo que lo de cient\xEDfica tambi\xE9n. <color=red>\"\xA1Je, je, je,
        je!\"</color> \xBFLo veis? Ya vuelve a burlarse."
    - language: 8
      text: "Recoloco o carregador e miro na velha \xE1rvore l\xE1 fora. Ela est\xE1
        cheia de marcas de tiros. N\xE3o s\xE3o obra minha, claro. Sou apenas uma
        cientista que n\xE3o sabe atirar. A parte de n\xE3o saber atirar \xE9 verdade,
        e acho que a de ser cientista tamb\xE9m. <color=red>\"Hehehehe!\"</color>
        Est\xE1 vendo? L\xE1 est\xE1 ela, zombando de mim de novo."
    - language: 9
      text: "\u0412\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u043C\u0430\u0433\u0430\u0437\u0438\u043D
        \u0438 \u043D\u0430\u0432\u043E\u0436\u0443 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442
        \u043D\u0430 \u0441\u0442\u0430\u0440\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E
        \u0437\u0430 \u043E\u043A\u043D\u043E\u043C. \u041D\u0430 \u043D\u0451\u043C
        \u043D\u0435\u043C\u0430\u043B\u043E \u0441\u043B\u0435\u0434\u043E\u0432
        \u043E\u0442 \u043F\u0443\u043B\u044C. \u0420\u0430\u0437\u0443\u043C\u0435\u0435\u0442\u0441\u044F,
        \u044D\u0442\u043E \u043D\u0435 \u043C\u043E\u0438 \u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F.
        \u042F \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u0443\u0447\u0451\u043D\u0430\u044F,
        \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0435 \u0443\u043C\u0435\u0435\u0442
        \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C. \u0421\u0442\u0440\u0435\u043B\u044F\u0442\u044C
        \u044F \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u043D\u0435 \u0443\u043C\u0435\u044E.
        \u0414\u0430 \u0438 \u0443\u0447\u0451\u043D\u0430\u044F \u044F, \u043F\u043E\u0436\u0430\u043B\u0443\u0439,
        \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F. <color=red>\"\u0425\u0438-\u0445\u0438-\u0445\u0438-\u0445\u0438!\"</color>
        \u0412\u043E\u0442 \u0432\u0438\u0434\u0438\u0442\u0435? \u041E\u043D\u0430
        \u043E\u043F\u044F\u0442\u044C \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439
        \u0441\u043C\u0435\u0451\u0442\u0441\u044F."
  - key: os.memory.1110.text
    values:
    - language: 0
      text: "\u6216\u8BB8\u6211\u8BE5\u4E00\u67AA\u6253\u6B7B\u5979\uFF0C\u65E2\u8BA9\u5979\u4E0D\u80FD\u5982\u613F\u4EE5\u507F\uFF0C\u53C8\u53EF\u4EE5\u6BC1\u706D\u90A3\u5B50\u5F39\u4EEC\u7684\"\u53EF\u7B11\"\u5BB6\u5EAD....\u6211\u4E3E\u7740\u67AA\u3002"
    - language: 1
      text: "\u6216\u8A31\u6211\u8A72\u4E00\u69CD\u6253\u6B7B\u5979\uFF0C\u65E2\u8B93\u5979\u4E0D\u80FD\u5982\u9858\u4EE5\u511F\uFF0C\u53C8\u53EF\u4EE5\u6BC0\u6EC5\u90A3\u5B50\u5F48\u5011\u7684\"\u53EF\u7B11\"\u5BB6\u5EAD....\u6211\u8209\u8457\u69CD\u3002"
    - language: 2
      text: Perhaps I should shoot her. Deny her what she wants, and destroy that
        'ridiculous' little family of bullets while I'm at it.... I raise the gun.
    - language: 3
      text: "\u3044\u3063\u305D\u3001\u5F7C\u5973\u3092\u6483\u3061\u6BBA\u305B\u3070\u3044\u3044\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u601D\u3044\u3069\u304A\u308A\u306B\u306F\u3055\u305B\u305A\u3001\u3064\u3044\u3067\u306B\u3042\u306E\u5F3E\u4E38\u305F\u3061\u306E\u300E\u7B11\u3048\u308B\u300F\u5BB6\u5EAD\u3082\u58CA\u3057\u3066\u3057\u307E\u3048\u308B....\u79C1\u306F\u9283\u3092\u6301\u3061\u4E0A\u3052\u308B\u3002"
    - language: 4
      text: "\uCC28\uB77C\uB9AC \uADF8\uB140\uB97C \uC3F4 \uC8FD\uC774\uBA74 \uC5B4\uB5A8\uAE4C.
        \uC6D0\uD558\uB294 \uB300\uB85C \uB418\uC9C0\uB294 \uC54A\uC744 \uD14C\uACE0,
        \uD0C4\uD658\uB4E4\uC758 \uC800 '\uC6B0\uC2A4\uC6B4' \uAC00\uC815\uB3C4 \uD568\uAED8
        \uBD80\uC234 \uBC84\uB9B4 \uC218 \uC788\uB2E4.... \uB098\uB294 \uCD1D\uC744
        \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4."
    - language: 5
      text: "Je devrais peut-\xEAtre l'abattre. La priver de ce qu'elle veut, et
        d\xE9truire au passage la \xAB ridicule \xBB petite famille de ces cartouches....
        Je l\xE8ve l'arme."
    - language: 6
      text: "Vielleicht sollte ich sie erschie\xDFen. Ihr ihren Wunsch verwehren
        und dabei gleich die \u201Al\xE4cherliche\u2018 kleine Familie dieser Patronen
        zerst\xF6ren.... Ich hebe die Waffe."
    - language: 7
      text: "Quiz\xE1 deber\xEDa pegarle un tiro. Negarle lo que quiere y, de paso,
        destruir la \xABrid\xEDcula\xBB familia de esas balas.... Levanto el arma."
    - language: 8
      text: "Talvez eu devesse dar um tiro nela. Impedir que consiga o que quer e
        ainda destruir aquela fam\xEDlia 'rid\xEDcula' das balas.... Ergo a arma."
    - language: 9
      text: "\u041C\u043E\u0436\u0435\u0442, \u0441\u0442\u043E\u0438\u0442 \u0435\u0451
        \u0437\u0430\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C. \u0418 \u0441\u0432\u043E\u0435\u0433\u043E
        \u043E\u043D\u0430 \u043D\u0435 \u0434\u043E\u0431\u044C\u0451\u0442\u0441\u044F,
        \u0438 \u044F \u0437\u0430\u043E\u0434\u043D\u043E \u0440\u0430\u0437\u0440\u0443\u0448\u0443
        \u044D\u0442\u0443 \xAB\u0441\u043C\u0435\u0445\u043E\u0442\u0432\u043E\u0440\u043D\u0443\u044E\xBB
        \u0441\u0435\u043C\u044C\u044E \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432....
        \u042F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442."
  - key: os.memory.1120.text
    values:
    - language: 0
      text: "\u6211\u95ED\u4E0A\u4E86\u773C......"
    - language: 1
      text: "\u6211\u9589\u4E0A\u4E86\u773C......"
    - language: 2
      text: I close my eyes......
    - language: 3
      text: "\u76EE\u3092\u9589\u3058\u308B......"
    - language: 4
      text: "\uB208\uC744 \uAC10\uB294\uB2E4......"
    - language: 5
      text: Je ferme les yeux......
    - language: 6
      text: "Ich schlie\xDFe die Augen......"
    - language: 7
      text: Cierro los ojos......
    - language: 8
      text: Fecho os olhos......
    - language: 9
      text: "\u042F \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E \u0433\u043B\u0430\u0437\u0430......"
  - key: os.memory.1130.text
    values:
    - language: 0
      text: "\u6211\u731B\u5730\u7741\u773C\uFF0C\u6211\u4E0D\u80FD\u8BA9\u5979\u5982\u613F\u4EE5\u507F\uFF0C\u8FD9\u662F\u5979\u86CA\u60D1\u6211\u7684\u624B\u6BB5\uFF0C\u6211\u4E0D\u80FD\u5728\u73B0\u5728\u6253\u6B7B\u5979\u3002\u6211\u51B2\u5411\u5E8A\u5934\uFF0C\u90A3\u6709\u4E00\u7F50\u4E34\u65F6\u6D88\u706D\u5979\u7684\u7CD6\u679C\uFF0C\u5373\u4FBF\u5979\u8FD8\u662F\u4F1A\u5728\u4E00\u6BB5\u65F6\u95F4\u540E\u4ECE\u5730\u677F\u4E0A\u957F\u51FA\u6765\u3002"
    - language: 1
      text: "\u6211\u731B\u5730\u775C\u773C\uFF0C\u6211\u4E0D\u80FD\u8B93\u5979\u5982\u9858\u4EE5\u511F\uFF0C\u9019\u662F\u5979\u8831\u60D1\u6211\u7684\u624B\u6BB5\uFF0C\u6211\u4E0D\u80FD\u5728\u73FE\u5728\u6253\u6B7B\u5979\u3002\u6211\u885D\u5411\u5E8A\u982D\uFF0C\u90A3\u6709\u4E00\u7F50\u81E8\u6642\u6D88\u6EC5\u5979\u7684\u7CD6\u679C\uFF0C\u5373\u4FBF\u5979\u9084\u662F\u6703\u5728\u4E00\u6BB5\u6642\u9593\u5F8C\u5F9E\u5730\u677F\u4E0A\u9577\u51FA\u4F86\u3002"
    - language: 2
      text: I snap my eyes open. I can't let her have her way. This is how she lures
        me in. I can't kill her now. I rush to the bedside. There's a bottle of sweets
        there that can make her disappear for a while, though after a time she always
        grows back out of the floor.
    - language: 3
      text: "\u306F\u3063\u3068\u76EE\u3092\u958B\u304F\u3002\u5F7C\u5973\u306E\u601D\u3044\u3069\u304A\u308A\u306B\u306F\u3055\u305B\u3089\u308C\u306A\u3044\u3002\u3053\u308C\u304C\u79C1\u3092\u305D\u305D\u306E\u304B\u3059\u624B\u53E3\u3060\u3002\u4ECA\u3001\u5F7C\u5973\u3092\u6483\u3061\u6BBA\u3057\u3066\u306F\u3044\u3051\u306A\u3044\u3002\u30D9\u30C3\u30C9\u8107\u3078\u99C6\u3051\u5BC4\u308B\u3002\u305D\u3053\u306B\u306F\u3001\u5F7C\u5973\u3092\u3057\u3070\u3089\u304F\u6D88\u3057\u3066\u304A\u3051\u308B\u98F4\u306E\u74F6\u304C\u3042\u308B\u3002\u5C11\u3057\u7D4C\u3066\u3070\u3001\u307E\u305F\u5E8A\u304B\u3089\u751F\u3048\u3066\u304F\u308B\u306E\u3060\u3051\u308C\u3069\u3002"
    - language: 4
      text: "\uBC88\uCA4D \uB208\uC744 \uB72C\uB2E4. \uADF8\uB140\uAC00 \uC6D0\uD558\uB294
        \uB300\uB85C \uD574 \uC918\uC11C\uB294 \uC548 \uB41C\uB2E4. \uC774\uAC74
        \uB098\uB97C \uAF80\uB824\uB294 \uC218\uC791\uC774\uB2E4. \uC9C0\uAE08 \uADF8\uB140\uB97C
        \uC3F4 \uC8FD\uC5EC\uC11C\uB294 \uC548 \uB41C\uB2E4. \uCE68\uB300 \uBA38\uB9AC\uB9E1\uC73C\uB85C
        \uB2EC\uB824\uAC04\uB2E4. \uADF8\uB140\uB97C \uC7A0\uAE50 \uC5C6\uC560 \uC904
        \uC0AC\uD0D5\uC774 \uD55C \uD1B5 \uC788\uB2E4. \uC2DC\uAC04\uC774 \uC870\uAE08
        \uC9C0\uB098\uBA74 \uB2E4\uC2DC \uBC14\uB2E5\uC5D0\uC11C \uC790\uB77C\uB098\uACA0\uC9C0\uB9CC."
    - language: 5
      text: "J'ouvre brusquement les yeux. Je ne peux pas la laisser gagner. C'est
        comme \xE7a qu'elle cherche \xE0 me pi\xE9ger. Je ne peux pas la tuer maintenant.
        Je me pr\xE9cipite au chevet du lit. Il y a l\xE0 un flacon de bonbons qui
        la font dispara\xEEtre pour un temps, m\xEAme si elle finit toujours par
        repousser \xE0 travers le plancher."
    - language: 6
      text: "Ich rei\xDFe die Augen auf. Ich darf ihr nicht ihren Willen lassen.
        So versucht sie, mich zu verf\xFChren. Ich darf sie jetzt nicht t\xF6ten.
        Ich st\xFCrze ans Bett. Dort steht ein Fl\xE4schchen mit Bonbons, die sie
        f\xFCr eine Weile verschwinden lassen. Auch wenn sie irgendwann wieder aus
        den Dielen w\xE4chst."
    - language: 7
      text: "Abro los ojos de golpe. No puedo dejar que se salga con la suya. As\xED
        es como intenta engatusarme. No puedo matarla ahora. Corro hacia la cabecera
        de la cama. All\xED tengo un frasco de caramelos que la hacen desaparecer
        por un rato, aunque despu\xE9s siempre vuelve a brotar del suelo."
    - language: 8
      text: "Abro os olhos de repente. N\xE3o posso deixar que ela ven\xE7a. \xC9
        assim que ela tenta me enganar. N\xE3o posso mat\xE1-la agora. Corro para
        a cabeceira da cama. H\xE1 um frasco de doces ali que faz ela desaparecer
        por um tempo, embora depois ela sempre volte a brotar do ch\xE3o."
    - language: 9
      text: "\u0420\u0435\u0437\u043A\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E
        \u0433\u043B\u0430\u0437\u0430. \u041D\u0435\u043B\u044C\u0437\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C
        \u0435\u0439 \u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0441\u0432\u043E\u0435\u0433\u043E.
        \u0422\u0430\u043A \u043E\u043D\u0430 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
        \u043C\u0435\u043D\u044F \u043E\u0431\u043C\u0430\u043D\u0443\u0442\u044C.
        \u0421\u0435\u0439\u0447\u0430\u0441 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
        \u0435\u0451 \u0437\u0430\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C.
        \u0411\u0440\u043E\u0441\u0430\u044E\u0441\u044C \u043A \u0438\u0437\u0433\u043E\u043B\u043E\u0432\u044C\u044E
        \u043A\u0440\u043E\u0432\u0430\u0442\u0438. \u0422\u0430\u043C \u0441\u0442\u043E\u0438\u0442
        \u0431\u0430\u043D\u043E\u0447\u043A\u0430 \u043A\u043E\u043D\u0444\u0435\u0442,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E
        \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u0435\u0451
        \u0438\u0441\u0447\u0435\u0437\u043D\u0443\u0442\u044C. \u0425\u043E\u0442\u044F
        \u043F\u043E\u0442\u043E\u043C \u043E\u043D\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
        \u0441\u043D\u043E\u0432\u0430 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442
        \u0438\u0437 \u043F\u043E\u043B\u0430."
  - key: os.memory.1140.text
    values:
    - language: 0
      text: "\u54C8......"
    - language: 1
      text: "\u54C8......"
    - language: 2
      text: Hah......
    - language: 3
      text: "\u306F\u3042......"
    - language: 4
      text: "\uD558\uC544......"
    - language: 5
      text: Ah......
    - language: 6
      text: Ha......
    - language: 7
      text: Ah......
    - language: 8
      text: Ah......
    - language: 9
      text: "\u0425\u0430......"
  - key: os.memory.1150.text
    values:
    - language: 0
      text: "\u54C8....\u5F88\u5403\u529B\uFF0C\u4F46\u770B\u8D77\u6765\u8FD8\u7B97\u6B63\u5E38...\u81F3\u5C11\u53EF\u4EE5\u6B63\u5E38\u4F9B\u5F39\u3002\u6700\u8FD1\u7684\u5C40\u52BF\u8D8A\u6765\u8D8A\u6076\u52A3\u4E86\uFF0C\u4FDD\u4E0D\u9F50\u4E24\u9897\u5B50\u5F39\u5176\u5B9E\u4E0D\u591F\u7528\uFF0C\u6216\u8BB8\u6211\u8BE5\u53BB\u518D\u641E\u70B9\u3002"
    - language: 1
      text: "\u54C8....\u5F88\u5403\u529B\uFF0C\u4F46\u770B\u8D77\u4F86\u9084\u7B97\u6B63\u5E38...\u81F3\u5C11\u53EF\u4EE5\u6B63\u5E38\u4F9B\u5F48\u3002\u6700\u8FD1\u7684\u5C40\u52E2\u8D8A\u4F86\u8D8A\u60E1\u52A3\u4E86\uFF0C\u4FDD\u4E0D\u9F4A\u5169\u9846\u5B50\u5F48\u5176\u5BE6\u4E0D\u5920\u7528\uFF0C\u6216\u8A31\u6211\u8A72\u53BB\u518D\u641E\u9EDE\u3002"
    - language: 2
      text: Hah.... It takes some effort, but everything seems to work... At least
        it still feeds properly. Things are getting uglier out there. Two rounds
        might not be enough. Perhaps I should find a few more.
    - language: 3
      text: "\u306F\u3042....\u529B\u306F\u8981\u308B\u3051\u308C\u3069\u3001\u52D5\u304D\u306F\u304A\u304B\u3057\u304F\u306A\u3044...\u5C11\u306A\u304F\u3068\u3082\u3001\u3061\u3083\u3093\u3068\u5F3E\u306F\u9001\u3089\u308C\u308B\u3002\u5916\u306E\u72B6\u6CC1\u306F\u60AA\u304F\u306A\u308B\u3070\u304B\u308A\u3002\u4E8C\u767A\u3067\u306F\u8DB3\u308A\u306A\u3044\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u3082\u3046\u5C11\u3057\u7528\u610F\u3057\u305F\u307B\u3046\u304C\u3088\u3055\u305D\u3046\u3060\u3002"
    - language: 4
      text: "\uD558\uC544.... \uD798\uC740 \uAF64 \uB4E4\uC9C0\uB9CC, \uC791\uB3D9\uC740
        \uC815\uC0C1\uC778 \uAC83 \uAC19\uB2E4... \uC801\uC5B4\uB3C4 \uD0C4\uC740
        \uC81C\uB300\uB85C \uB4E4\uC5B4\uAC04\uB2E4. \uBC16\uC758 \uC0C1\uD669\uC740
        \uC810\uC810 \uD5D8\uC545\uD574\uC9C0\uACE0 \uC788\uB2E4. \uB450 \uBC1C\uB85C\uB294
        \uBAA8\uC790\uB784\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uC870\uAE08 \uB354 \uAD6C\uD574
        \uB450\uB294 \uD3B8\uC774 \uC88B\uACA0\uB2E4."
    - language: 5
      text: "Ah.... C'est dur, mais tout semble fonctionner... Au moins, l'alimentation
        se fait correctement. La situation se d\xE9grade. Deux cartouches ne suffiront
        peut-\xEAtre pas. Je devrais en trouver d'autres."
    - language: 6
      text: "Ha.... Es geht schwer, aber es scheint zu funktionieren... Wenigstens
        f\xFChrt sie noch richtig zu. Die Lage wird immer bedrohlicher. Vielleicht
        reichen zwei Patronen nicht. Ich sollte noch ein paar auftreiben."
    - language: 7
      text: "Ah.... Cuesta, pero parece funcionar... Al menos alimenta bien. La situaci\xF3n
        es cada vez peor. Puede que dos balas no basten. Deber\xEDa conseguir algunas
        m\xE1s."
    - language: 8
      text: "Ah.... Est\xE1 dif\xEDcil, mas parece funcionar... Pelo menos a alimenta\xE7\xE3o
        est\xE1 normal. A situa\xE7\xE3o anda cada vez mais perigosa. Talvez duas
        balas n\xE3o bastem. \xC9 melhor arranjar mais algumas."
    - language: 9
      text: "\u0425\u0430.... \u0422\u0443\u0433\u043E, \u043D\u043E \u0432\u0440\u043E\u0434\u0435
        \u0432\u0441\u0451 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435... \u041F\u043E
        \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435, \u043F\u0430\u0442\u0440\u043E\u043D\u044B
        \u043F\u043E\u0434\u0430\u044E\u0442\u0441\u044F \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E.
        \u0421\u0438\u0442\u0443\u0430\u0446\u0438\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0432\u0441\u0451 \u0445\u0443\u0436\u0435. \u0414\u0432\u0443\u0445 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432
        \u043C\u043E\u0436\u0435\u0442 \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442\u044C.
        \u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u043D\u0430\u0434\u043E \u0440\u0430\u0437\u0434\u043E\u0431\u044B\u0442\u044C
        \u0435\u0449\u0451."
  - key: os.memory.1160.text
    values:
    - language: 0
      text: "\u6211\u8D70\u5411\u6211\u7684\u5DE5\u4F5C\u5BA4\uFF0C\u66FE\u7ECF\u6211\u662F\u7814\u7A76\u533B\u836F\u7684\uFF0C\u4E5F\u7814\u7A76\u4EBA\u4F53...\u6211\u770B\u7740\u684C\u5B50\u4E0A\u7684\u7B14\u8BB0\uFF0C\u81F3\u5C11\u6211\u4E4B\u524D\u5728\u5C1D\u8BD5\u80FD\u4E0D\u80FD\u9006\u8F6C\uFF0C\u6216\u8005\u7EF4\u6301\u4F4FR\u53F7\u5FC3\u810F\u75C5\u6BD2\u7684\u517D\u5316\u8FDB\u7A0B\u3002\u597D\u6B79\u662F\u4E3A\u4E86\u5973\u513F\u3002"
    - language: 1
      text: "\u6211\u8D70\u5411\u6211\u7684\u5DE5\u4F5C\u5BA4\uFF0C\u66FE\u7D93\u6211\u662F\u7814\u7A76\u91AB\u85E5\u7684\uFF0C\u4E5F\u7814\u7A76\u4EBA\u9AD4...\u6211\u770B\u8457\u684C\u5B50\u4E0A\u7684\u7B46\u8A18\uFF0C\u81F3\u5C11\u6211\u4E4B\u524D\u5728\u5617\u8A66\u80FD\u4E0D\u80FD\u9006\u8F49\uFF0C\u6216\u8005\u7DAD\u6301\u4F4FR\u865F\u5FC3\u81DF\u75C5\u6BD2\u7684\u7378\u5316\u9032\u7A0B\u3002\u597D\u6B79\u662F\u70BA\u4E86\u5973\u5152\u3002"
    - language: 2
      text: I walk into my workroom. I used to study medicine. The human body, too...
        I look at the notes on my desk. At least I was trying to find a way to reverse
        the beastification caused by the R-strain heart virus, or keep it from progressing.
        For my daughter, if nothing else.
    - language: 3
      text: "\u4F5C\u696D\u5BA4\u3078\u5411\u304B\u3046\u3002\u304B\u3064\u3066\u79C1\u306F\u533B\u85AC\u54C1\u3092\u7814\u7A76\u3057\u3066\u3044\u305F\u3002\u4EBA\u4F53\u3082...\u673A\u306E\u4E0A\u306E\u30CE\u30FC\u30C8\u3092\u898B\u308B\u3002\u5C11\u306A\u304F\u3068\u3082\u3001R\u578B\u5FC3\u81D3\u30A6\u30A4\u30EB\u30B9\u306B\u3088\u308B\u7363\u5316\u3092\u5143\u306B\u623B\u305B\u306A\u3044\u304B\u3001\u305D\u308C\u304C\u7121\u7406\u3067\u3082\u9032\u884C\u3092\u98DF\u3044\u6B62\u3081\u3089\u308C\u306A\u3044\u304B\u3001\u8A66\u3057\u3066\u306F\u3044\u305F\u3002\u5A18\u306E\u305F\u3081\u306B\u3002"
    - language: 4
      text: "\uC791\uC5C5\uC2E4\uB85C \uD5A5\uD55C\uB2E4. \uB098\uB294 \uD55C\uB54C
        \uC758\uC57D\uD488\uC744 \uC5F0\uAD6C\uD588\uB2E4. \uC778\uCCB4\uB3C4...
        \uCC45\uC0C1 \uC704\uC758 \uB178\uD2B8\uB97C \uBC14\uB77C\uBCF8\uB2E4. \uC801\uC5B4\uB3C4
        R\uD615 \uC2EC\uC7A5 \uBC14\uC774\uB7EC\uC2A4\uB85C \uC778\uD55C \uC57C\uC218\uD654\uB97C
        \uB418\uB3CC\uB9AC\uAC70\uB098, \uC9C4\uD589\uC744 \uBA48\uCD9C \uC218\uB294
        \uC5C6\uC744\uC9C0 \uC2DC\uB3C4\uD558\uACE0 \uC788\uC5C8\uB2E4. \uB538\uC744
        \uC704\uD574\uC11C\uB77C\uB3C4."
    - language: 5
      text: "Je vais dans mon atelier. J'\xE9tudiais la m\xE9decine, autrefois. Le
        corps humain aussi... Je regarde les notes sur le bureau. Au moins, j'essayais
        de trouver comment inverser la bestialisation due au virus cardiaque de type
        R, ou en arr\xEAter la progression. Pour ma fille, \xE0 d\xE9faut d'autre
        chose."
    - language: 6
      text: "Ich gehe in mein Arbeitszimmer. Fr\xFCher habe ich Medizin erforscht.
        Und den menschlichen K\xF6rper... Ich sehe auf die Notizen auf dem Tisch.
        Ich habe immerhin versucht, die Bestialisierung durch das Herzvirus Typ R
        umzukehren oder zumindest aufzuhalten. Wenn schon f\xFCr nichts anderes,
        dann f\xFCr meine Tochter."
    - language: 7
      text: "Voy a mi taller. Antes investigaba sobre medicina. Y sobre el cuerpo
        humano... Miro las notas del escritorio. Al menos intentaba averiguar c\xF3mo
        revertir la bestializaci\xF3n causada por el virus card\xEDaco de tipo R,
        o detener su avance. Por mi hija, si no por otra cosa."
    - language: 8
      text: "Vou para minha oficina. Antes, eu pesquisava medicina. E o corpo humano...
        Olho as anota\xE7\xF5es sobre a mesa. Pelo menos eu tentava descobrir como
        reverter a bestializa\xE7\xE3o causada pelo v\xEDrus card\xEDaco tipo R,
        ou impedir seu avan\xE7o. Pela minha filha, que fosse."
    - language: 9
      text: "\u0418\u0434\u0443 \u0432 \u0441\u0432\u043E\u044E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E.
        \u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430. \u0418 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0435
        \u0442\u0435\u043B\u043E... \u0421\u043C\u043E\u0442\u0440\u044E \u043D\u0430
        \u0437\u0430\u043F\u0438\u0441\u0438 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.
        \u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435,
        \u044F \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C,
        \u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C
        \u0432\u0441\u043F\u044F\u0442\u044C \u043E\u0437\u0432\u0435\u0440\u0435\u043D\u0438\u0435,
        \u0432\u044B\u0437\u0432\u0430\u043D\u043D\u043E\u0435 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u043C
        \u0432\u0438\u0440\u0443\u0441\u043E\u043C \u0448\u0442\u0430\u043C\u043C\u0430
        R, \u0438\u043B\u0438 \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u0435\u0433\u043E. \u0420\u0430\u0434\u0438 \u0434\u043E\u0447\u0435\u0440\u0438."
  - key: os.memory.1170.text
    values:
    - language: 0
      text: "\u684C\u5B50\u4E0B\u653E\u7740\u4E00\u76D2\u591A\u4F59\u7684\u5668\u5177\uFF0C\u91CC\u9762\u6709\u4E9B\u62FF\u6765\u5E72\u6D3B\u7684\u5DE5\u5177\uFF0C\u954A\u5B50\uFF0C\u710A\u67AA...\u4E0D\u5C11\u5F39\u58F3\u3002"
    - language: 1
      text: "\u684C\u5B50\u4E0B\u653E\u8457\u4E00\u76D2\u591A\u9918\u7684\u5668\u5177\uFF0C\u88E1\u9762\u6709\u4E9B\u62FF\u4F86\u5E79\u6D3B\u7684\u5DE5\u5177\uFF0C\u9477\u5B50\uFF0C\u710A\u69CD...\u4E0D\u5C11\u5F48\u6BBC\u3002"
    - language: 2
      text: 'Under the desk sits a box of spare equipment. Some tools for the job:
        tweezers, a soldering iron... and quite a few shell casings.'
    - language: 3
      text: "\u673A\u306E\u4E0B\u306B\u3001\u4F59\u3063\u305F\u5668\u5177\u306E\u7BB1\u304C\u3042\u308B\u3002\u4E2D\u306B\u306F\u4F5C\u696D\u7528\u306E\u9053\u5177\u304C\u3044\u304F\u3064\u304B\u3002\u30D4\u30F3\u30BB\u30C3\u30C8\u3001\u306F\u3093\u3060\u3054\u3066...\u85AC\u83A2\u3082\u304B\u306A\u308A\u3042\u308B\u3002"
    - language: 4
      text: "\uCC45\uC0C1 \uBC11\uC5D0 \uC5EC\uBD84\uC758 \uAE30\uAD6C\uB97C \uB123\uC5B4
        \uB454 \uC0C1\uC790\uAC00 \uC788\uB2E4. \uC791\uC5C5\uC6A9 \uB3C4\uAD6C\uAC00
        \uBA87 \uAC1C \uB4E4\uC5B4 \uC788\uB2E4. \uD540\uC14B, \uC778\uB450... \uD0C4\uD53C\uB3C4
        \uAF64 \uB9CE\uB2E4."
    - language: 5
      text: "Sous le bureau, une bo\xEEte de mat\xE9riel de rechange. De quoi travailler
        : des pinces, un fer \xE0 souder... et pas mal de douilles."
    - language: 6
      text: "Unter dem Tisch steht eine Kiste mit \xFCbrigen Ger\xE4ten. Ein paar
        Werkzeuge: Pinzette, L\xF6tkolben... und eine ganze Menge Patronenh\xFClsen."
    - language: 7
      text: 'Debajo del escritorio hay una caja con material sobrante. Algunas herramientas
        para trabajar: pinzas, un soldador... y bastantes casquillos.'
    - language: 8
      text: "Debaixo da mesa h\xE1 uma caixa de material sobressalente. Algumas ferramentas
        de trabalho: pin\xE7as, ferro de solda... e um bom n\xFAmero de estojos de
        muni\xE7\xE3o."
    - language: 9
      text: "\u041F\u043E\u0434 \u0441\u0442\u043E\u043B\u043E\u043C \u0441\u0442\u043E\u0438\u0442
        \u043A\u043E\u0440\u043E\u0431\u043A\u0430 \u0441 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u043C\u0438
        \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u044F\u043C\u0438.
        \u0412\u043D\u0443\u0442\u0440\u0438 \u043A\u043E\u0435-\u043A\u0430\u043A\u0438\u0435
        \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B: \u043F\u0438\u043D\u0446\u0435\u0442,
        \u043F\u0430\u044F\u043B\u044C\u043D\u0438\u043A... \u0418 \u043D\u0435\u043C\u0430\u043B\u043E
        \u0433\u0438\u043B\u044C\u0437."
  - key: os.memory.1180.text
    values:
    - language: 0
      text: "\u6211\u5F80\u624B\u67AA\u53EF\u80FD\u9700\u8981\u7684\u5730\u65B9\u585E\u4E86\u70B9\u6DA6\u6ED1\u6CB9\uFF0C\u6216\u8BB8\u6211\u4E0D\u8BE5\u8FD9\u4E48\u505A\uFF0C\u4F46\u597D\u6B79\u4E0A\u819B\u8F7B\u677E\u591A\u4E86\u3002\u53C8\u989D\u5916\u82B1\u4E86\u70B9\u65F6\u95F4\uFF0C\u641E\u4E86\u51E0\u9897\u5B50\u5F39\uFF0C\u6211\u5F3A\u786C\u5730\u585E\u5230\u5F39\u5323\u91CC\uFF0C\u5B83\u4EEC\u770B\u8D77\u6765\u80FD\u597D\u597D\u76F8\u5904\u3002"
    - language: 1
      text: "\u6211\u5F80\u624B\u69CD\u53EF\u80FD\u9700\u8981\u7684\u5730\u65B9\u585E\u4E86\u9EDE\u6F64\u6ED1\u6CB9\uFF0C\u6216\u8A31\u6211\u4E0D\u8A72\u9019\u9EBC\u505A\uFF0C\u4F46\u597D\u6B79\u4E0A\u819B\u8F15\u9B06\u591A\u4E86\u3002\u53C8\u984D\u5916\u82B1\u4E86\u9EDE\u6642\u9593\uFF0C\u641E\u4E86\u5E7E\u9846\u5B50\u5F48\uFF0C\u6211\u5F37\u786C\u5730\u585E\u5230\u5F48\u5323\u88E1\uFF0C\u5B83\u5011\u770B\u8D77\u4F86\u80FD\u597D\u597D\u76F8\u8655\u3002"
    - language: 2
      text: I put a little oil wherever the pistol looks as though it might need
        it. Perhaps I shouldn't have, but it's much easier to rack now. I spend a
        little extra time getting hold of a few rounds and force them into the magazine.
        They look as though they'll get along.
    - language: 3
      text: "\u62F3\u9283\u306E\u3001\u5FC5\u8981\u305D\u3046\u306A\u7B87\u6240\u306B\u5C11\u3057\u6CB9\u3092\u5DEE\u3059\u3002\u3084\u3089\u306A\u3044\u307B\u3046\u304C\u3088\u304B\u3063\u305F\u304B\u3082\u3057\u308C\u306A\u3044\u3051\u308C\u3069\u3001\u5C11\u306A\u304F\u3068\u3082\u88C5\u586B\u306F\u305A\u3063\u3068\u697D\u306B\u306A\u3063\u305F\u3002\u3055\u3089\u306B\u5C11\u3057\u6642\u9593\u3092\u304B\u3051\u3066\u3001\u5F3E\u3092\u4F55\u767A\u304B\u7528\u610F\u3057\u305F\u3002\u5F3E\u5009\u3078\u7121\u7406\u3084\u308A\u62BC\u3057\u8FBC\u3080\u3002\u4EF2\u826F\u304F\u3084\u308C\u305D\u3046\u306B\u898B\u3048\u308B\u3002"
    - language: 4
      text: "\uAD8C\uCD1D\uC5D0\uC11C \uD544\uC694\uD574 \uBCF4\uC774\uB294 \uACF3\uC5D0
        \uC724\uD65C\uC720\uB97C \uC870\uAE08 \uB123\uB294\uB2E4. \uC774\uB7EC\uBA74
        \uC548 \uB410\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC9C0\uB9CC, \uC801\uC5B4\uB3C4
        \uC7A5\uC804\uC740 \uD6E8\uC52C \uC218\uC6D4\uD574\uC84C\uB2E4. \uC2DC\uAC04\uC744
        \uC870\uAE08 \uB354 \uB4E4\uC5EC \uD0C4\uD658\uC744 \uBA87 \uBC1C \uB9C8\uB828\uD588\uB2E4.
        \uD0C4\uCC3D\uC5D0 \uC5B5\uC9C0\uB85C \uBC00\uC5B4 \uB123\uB294\uB2E4. \uC798
        \uC5B4\uC6B8\uB824 \uC9C0\uB0BC \uAC83 \uAC19\uB2E4."
    - language: 5
      text: "Je mets un peu d'huile l\xE0 o\xF9 le pistolet semble en avoir besoin.
        Je n'aurais peut-\xEAtre pas d\xFB, mais la culasse glisse bien mieux. Je
        prends encore un peu de temps pour me procurer quelques cartouches et les
        force dans le chargeur. Elles ont l'air de pouvoir s'entendre."
    - language: 6
      text: "Ich gebe etwas \xD6l an die Stellen der Pistole, die es vielleicht brauchen.
        Vielleicht h\xE4tte ich das lassen sollen, aber sie l\xE4sst sich jetzt viel
        leichter durchladen. Ich nehme mir noch etwas Zeit, treibe ein paar Patronen
        auf und dr\xFCcke sie mit Gewalt ins Magazin. Sie sehen aus, als w\xFCrden
        sie sich vertragen."
    - language: 7
      text: "Pongo un poco de aceite donde creo que la pistola lo necesita. Quiz\xE1
        no deb\xED hacerlo, pero ahora es mucho m\xE1s f\xE1cil mover la corredera.
        Dedico un poco m\xE1s de tiempo a conseguir unas balas y las meto a la fuerza
        en el cargador. Parece que podr\xE1n llevarse bien."
    - language: 8
      text: "Coloco um pouco de \xF3leo onde acho que a pistola precisa. Talvez eu
        n\xE3o devesse, mas agora \xE9 muito mais f\xE1cil puxar o ferrolho. Gasto
        mais um pouco de tempo para conseguir algumas balas e as enfio \xE0 for\xE7a
        no carregador. Parece que elas v\xE3o se dar bem."
    - language: 9
      text: "\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u044E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0441\u043C\u0430\u0437\u043A\u0438 \u0442\u0443\u0434\u0430, \u0433\u0434\u0435
        \u043E\u043D\u0430, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043C\u043E\u0436\u0435\u0442
        \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F.
        \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0435 \u0441\u0442\u043E\u0438\u043B\u043E,
        \u043D\u043E \u0432\u0437\u0432\u043E\u0434\u0438\u0442\u044C \u0437\u0430\u0442\u0432\u043E\u0440
        \u0441\u0442\u0430\u043B\u043E \u043A\u0443\u0434\u0430 \u043B\u0435\u0433\u0447\u0435.
        \u0422\u0440\u0430\u0447\u0443 \u0435\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0447\u0442\u043E\u0431\u044B
        \u0440\u0430\u0437\u0434\u043E\u0431\u044B\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432, \u0438 \u0441\u0438\u043B\u043E\u0439
        \u0432\u0442\u0438\u0441\u043A\u0438\u0432\u0430\u044E \u0438\u0445 \u0432
        \u043C\u0430\u0433\u0430\u0437\u0438\u043D. \u0412\u0440\u043E\u0434\u0435
        \u0431\u044B \u043F\u043E\u043B\u0430\u0434\u044F\u0442."
  - key: os.memory.1190.text
    values:
    - language: 0
      text: "\u6211\u9760\u4E86\u51E0\u79D2\u949F\uFF0C\u8FD9\u8BE5\u6B7B\u7684\u6905\u5B50\u771F\u786C\u3002\u623F\u5B50\u91CC\u53EA\u6709\u6211\u81EA\u5DF1\u7684\u58F0\u97F3\uFF0C\u6709\u70B9\u5B89\u9759\u7684\u5413\u4EBA\u3002\u4E0D\u7BA1\u600E\u4E48\u8BF4\uFF0C\u8BE5\u51FA\u95E8\u4E86\u3002"
    - language: 1
      text: "\u6211\u9760\u4E86\u5E7E\u79D2\u9418\uFF0C\u9019\u8A72\u6B7B\u7684\u6905\u5B50\u771F\u786C\u3002\u623F\u5B50\u88E1\u53EA\u6709\u6211\u81EA\u5DF1\u7684\u8072\u97F3\uFF0C\u6709\u9EDE\u5B89\u975C\u7684\u5687\u4EBA\u3002\u4E0D\u7BA1\u600E\u9EBC\u8AAA\uFF0C\u8A72\u51FA\u9580\u4E86\u3002"
    - language: 2
      text: I lean back for a few seconds. This damned chair is so hard. Mine is
        the only sound in the house. It's quiet enough to be frightening. Anyway,
        it's time to go.
    - language: 3
      text: "\u6570\u79D2\u3001\u80CC\u3092\u9810\u3051\u308B\u3002\u3053\u306E\u5FCC\u3005\u3057\u3044\u6905\u5B50\u306F\u672C\u5F53\u306B\u786C\u3044\u3002\u5BB6\u306B\u306F\u79C1\u306E\u97F3\u3057\u304B\u306A\u3044\u3002\u6016\u3044\u307B\u3069\u9759\u304B\u3060\u3002\u3068\u306B\u304B\u304F\u3001\u3082\u3046\u51FA\u304B\u3051\u3088\u3046\u3002"
    - language: 4
      text: "\uBA87 \uCD08 \uB3D9\uC548 \uB4F1\uC744 \uAE30\uB304\uB2E4. \uC774 \uBE4C\uC5B4\uBA39\uC744
        \uC758\uC790\uB294 \uC815\uB9D0 \uB531\uB531\uD558\uB2E4. \uC9D1 \uC548\uC5D0\uB294
        \uB098 \uD63C\uC790 \uB0B4\uB294 \uC18C\uB9AC\uBC16\uC5D0 \uC5C6\uB2E4. \uBB34\uC11C\uC6B8
        \uB9CC\uD07C \uC870\uC6A9\uD558\uB2E4. \uC5B4\uCA0C\uB4E0, \uC774\uC81C \uB098\uAC00\uC57C\uACA0\uB2E4."
    - language: 5
      text: "Je m'adosse quelques secondes. Cette fichue chaise est si dure. Je suis
        la seule \xE0 faire du bruit dans cette maison. Ce silence en devient effrayant.
        Bref, il faut partir."
    - language: 6
      text: "Ich lehne mich ein paar Sekunden zur\xFCck. Dieser verdammte Stuhl ist
        hart. Meine Ger\xE4usche sind die einzigen im Haus. Diese Stille macht mir
        Angst. Wie auch immer. Zeit zu gehen."
    - language: 7
      text: "Me recuesto unos segundos. Qu\xE9 dura es esta maldita silla. Mis ruidos
        son los \xFAnicos de la casa. El silencio da miedo. En fin, es hora de salir."
    - language: 8
      text: "Me recosto por alguns segundos. Essa maldita cadeira \xE9 t\xE3o dura.
        Os \xFAnicos sons da casa s\xE3o os meus. Um sil\xEAncio de dar medo. De
        qualquer forma, est\xE1 na hora de sair."
    - language: 9
      text: "\u041D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u0442\u043A\u0438\u0434\u044B\u0432\u0430\u044E\u0441\u044C
        \u043D\u0430 \u0441\u043F\u0438\u043D\u043A\u0443. \u041F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0439
        \u0441\u0442\u0443\u043B, \u043A\u0430\u043A\u043E\u0439 \u0436\u0435 \u043E\u043D
        \u0436\u0451\u0441\u0442\u043A\u0438\u0439. \u0412 \u0434\u043E\u043C\u0435
        \u0441\u043B\u044B\u0448\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
        \u043C\u0435\u043D\u044F. \u0414\u043E \u0436\u0443\u0442\u0438 \u0442\u0438\u0445\u043E.
        \u041A\u0430\u043A \u0431\u044B \u0442\u043E \u043D\u0438 \u0431\u044B\u043B\u043E,
        \u043F\u043E\u0440\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C."
  - key: os.memory.1200.text
    values:
    - language: 0
      text: "\u51B0\u7BB1\u65C1\u8FB9\u8FD8\u6709\u51E0\u888B\u9762\u5305\uFF0C\u5730\u4E0A\u5076\u5C14\u8DEF\u8FC7\u51E0\u53EA\u5403\u788E\u5C51\u7684\u87D1\u8782\u3002"
    - language: 1
      text: "\u51B0\u7BB1\u65C1\u908A\u9084\u6709\u5E7E\u888B\u9EB5\u5305\uFF0C\u5730\u4E0A\u5076\u723E\u8DEF\u904E\u5E7E\u53EA\u5403\u788E\u5C51\u7684\u87D1\u8782\u3002"
    - language: 2
      text: There are a few bags of bread beside the fridge. Now and then a cockroach
        scuttles across the floor, feeding on crumbs.
    - language: 3
      text: "\u51B7\u8535\u5EAB\u306E\u305D\u3070\u306B\u306F\u3001\u307E\u3060\u30D1\u30F3\u304C\u6570\u888B\u3042\u308B\u3002\u5E8A\u3092\u3068\u304D\u3069\u304D\u3001\u30D1\u30F3\u304F\u305A\u3092\u98DF\u3079\u308B\u30B4\u30AD\u30D6\u30EA\u304C\u6A2A\u5207\u3063\u3066\u3044\u304F\u3002"
    - language: 4
      text: "\uB0C9\uC7A5\uACE0 \uC606\uC5D0\uB294 \uBE75\uC774 \uBA87 \uBD09\uC9C0
        \uB0A8\uC544 \uC788\uB2E4. \uBC14\uB2E5\uC5D0\uB294 \uAC00\uB054 \uBD80\uC2A4\uB7EC\uAE30\uB97C
        \uC8FC\uC6CC \uBA39\uB294 \uBC14\uD034\uBC8C\uB808\uAC00 \uBA87 \uB9C8\uB9AC
        \uC9C0\uB098\uAC04\uB2E4."
    - language: 5
      text: "Il reste quelques sacs de pain pr\xE8s du r\xE9frig\xE9rateur. De temps
        \xE0 autre, un cafard traverse le sol pour manger les miettes."
    - language: 6
      text: "Neben dem K\xFChlschrank liegen noch ein paar T\xFCten Brot. Ab und
        zu huscht eine Kakerlake \xFCber den Boden und frisst die Kr\xFCmel."
    - language: 7
      text: Quedan unas bolsas de pan junto a la nevera. De vez en cuando pasa alguna
        cucaracha por el suelo, comiendo migas.
    - language: 8
      text: "Ainda h\xE1 alguns sacos de p\xE3o perto da geladeira. De vez em quando
        uma barata atravessa o ch\xE3o, comendo migalhas."
    - language: 9
      text: "\u0412\u043E\u0437\u043B\u0435 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430
        \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043F\u0430\u043A\u0435\u0442\u043E\u0432 \u0441 \u0445\u043B\u0435\u0431\u043E\u043C.
        \u041F\u043E \u043F\u043E\u043B\u0443 \u0432\u0440\u0435\u043C\u044F \u043E\u0442
        \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u043E\u0431\u0435\u0433\u0430\u044E\u0442
        \u0442\u0430\u0440\u0430\u043A\u0430\u043D\u044B, \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044F
        \u043A\u0440\u043E\u0448\u043A\u0438."
  - key: os.memory.1210.text
    values:
    - language: 0
      text: "\u6211\u4E0D\u592A\u559C\u6B22\u5B83\u4EEC\uFF0C\u4E00\u7FA4\u4E0D\u77E5\u9053\u4EC0\u4E48\u662F\u751F\u6D3B\u7684\u50BB\u74DC\uFF0C\u5C31\u8FDE\u65E0\u5934\u9E21\u90FD\u6BD4\u5B83\u4EEC\u6709\u8111\u5B50\u3002"
    - language: 1
      text: "\u6211\u4E0D\u592A\u559C\u6B61\u5B83\u5011\uFF0C\u4E00\u7FA4\u4E0D\u77E5\u9053\u4EC0\u9EBC\u662F\u751F\u6D3B\u7684\u50BB\u74DC\uFF0C\u5C31\u9023\u7121\u982D\u96DE\u90FD\u6BD4\u5B83\u5011\u6709\u8166\u5B50\u3002"
    - language: 2
      text: I don't much like them. A bunch of fools who haven't the faintest idea
        what living means. Even a headless chicken has more brains.
    - language: 3
      text: "\u3042\u307E\u308A\u597D\u304D\u3067\u306F\u306A\u3044\u3002\u66AE\u3089\u3059\u3053\u3068\u304C\u4F55\u306A\u306E\u304B\u3082\u77E5\u3089\u306A\u3044\u99AC\u9E7F\u3070\u304B\u308A\u3002\u9996\u306E\u306A\u3044\u9D8F\u306E\u307B\u3046\u304C\u3001\u307E\u3060\u982D\u3092\u4F7F\u3063\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uBCC4\uB85C \uC88B\uC544\uD558\uC9C0 \uC54A\uB294\uB2E4. \uC0B0\uB2E4\uB294
        \uAC8C \uBB54\uC9C0\uB3C4 \uBAA8\uB974\uB294 \uBA4D\uCCAD\uC774\uB4E4. \uBA38\uB9AC
        \uC5C6\uB294 \uB2ED\uC870\uCC28 \uC800\uAC83\uB4E4\uBCF4\uB2E4\uB294 \uC0DD\uAC01\uC774
        \uC788\uB2E4."
    - language: 5
      text: "Je ne les aime pas beaucoup. Une bande d'imb\xE9ciles qui ignorent ce
        que vivre signifie. M\xEAme un poulet sans t\xEAte a plus de cervelle."
    - language: 6
      text: "Ich mag sie nicht besonders. Ein Haufen Dummk\xF6pfe, die nicht wissen,
        was Leben bedeutet. Selbst ein kopfloses Huhn hat mehr Verstand."
    - language: 7
      text: "No me gustan mucho. Una pandilla de idiotas que no saben lo que es vivir.
        Hasta un pollo sin cabeza tiene m\xE1s cerebro."
    - language: 8
      text: "N\xE3o gosto muito delas. Um bando de idiotas que n\xE3o sabe o que
        \xE9 viver. At\xE9 uma galinha sem cabe\xE7a tem mais c\xE9rebro."
    - language: 9
      text: "\u042F \u0438\u0445 \u043D\u0435\u0434\u043E\u043B\u044E\u0431\u043B\u0438\u0432\u0430\u044E.
        \u0421\u0431\u043E\u0440\u0438\u0449\u0435 \u0434\u0443\u0440\u0430\u043A\u043E\u0432,
        \u043F\u043E\u043D\u044F\u0442\u0438\u044F \u043D\u0435 \u0438\u043C\u0435\u044E\u0449\u0438\u0445,
        \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442 \u0436\u0438\u0442\u044C.
        \u0414\u0430\u0436\u0435 \u0443 \u043A\u0443\u0440\u0438\u0446\u044B \u0431\u0435\u0437
        \u0433\u043E\u043B\u043E\u0432\u044B \u043C\u043E\u0437\u0433\u043E\u0432
        \u0431\u043E\u043B\u044C\u0448\u0435."
  - key: os.memory.1220.text
    values:
    - language: 0
      text: "\u6211\u987A\u624B\u62FF\u4E86\u888B\u9762\u5305\u5C31\u7740\u6C34\u5403\u51C6\u5907\u51FA\u95E8\uFF0C\u95E8\u4E0A\u8D34\u7740\u4E00\u4EFD\u65E5\u5386\uFF0C\u4E0A\u9762\u90FD\u662F\u5973\u513F\u753B\u7684\u5708\u5708\uFF0C\u4F30\u8BA1\u662F\u5979\u548C\u5979\u90A3\u7FA4\u597D\u670B\u53CB\u7684\u8BA1\u5212\u5427\u3002\u4ED6\u4EEC\u81F3\u5C11\u6BD4\u6211\u5F3A\uFF0C\u4E0A\u5230\u9ED1\u5165\u7F51\u7EDC\u4E0B\u5230\u7167\u987E\u793E\u533A\uFF0C\u6BD4\u8D77\u6211\u8FD9\u6837\u7684\u9634\u6697\u8001\u5988\u5B50......"
    - language: 1
      text: "\u6211\u9806\u624B\u62FF\u4E86\u888B\u9EB5\u5305\u5C31\u8457\u6C34\u5403\u6E96\u5099\u51FA\u9580\uFF0C\u9580\u4E0A\u8CBC\u8457\u4E00\u4EFD\u65E5\u66C6\uFF0C\u4E0A\u9762\u90FD\u662F\u5973\u5152\u756B\u7684\u5708\u5708\uFF0C\u4F30\u8A08\u662F\u5979\u548C\u5979\u90A3\u7FA4\u597D\u670B\u53CB\u7684\u8A08\u5283\u5427\u3002\u4ED6\u5011\u81F3\u5C11\u6BD4\u6211\u5F37\uFF0C\u4E0A\u5230\u9ED1\u5165\u7DB2\u8DEF\u4E0B\u5230\u7167\u9867\u793E\u5340\uFF0C\u6BD4\u8D77\u6211\u9019\u6A23\u7684\u9670\u6697\u8001\u5ABD\u5B50......"
    - language: 2
      text: I grab a bag of bread, wash it down with water, and get ready to leave.
        There's a calendar stuck to the door, covered in circles my daughter drew.
        Plans with her friends, probably. They're better than me, at least. Everything
        from breaking into networks to looking after the neighborhood. Compared with
        a gloomy old mother like me......
    - language: 3
      text: "\u30D1\u30F3\u3092\u4E00\u888B\u3064\u304B\u307F\u3001\u6C34\u3067\u6D41\u3057\u8FBC\u307F\u306A\u304C\u3089\u51FA\u304B\u3051\u308B\u652F\u5EA6\u3092\u3059\u308B\u3002\u30C9\u30A2\u306B\u8CBC\u3089\u308C\u305F\u30AB\u30EC\u30F3\u30C0\u30FC\u306F\u3001\u5A18\u306E\u63CF\u3044\u305F\u4E38\u3067\u3044\u3063\u3071\u3044\u3060\u3002\u53CB\u9054\u3068\u306E\u4E88\u5B9A\u3060\u308D\u3046\u3002\u5C11\u306A\u304F\u3068\u3082\u3001\u3042\u306E\u5B50\u305F\u3061\u306F\u79C1\u3088\u308A\u7ACB\u6D3E\u3060\u3002\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u3078\u306E\u4FB5\u5165\u304B\u3089\u5730\u57DF\u306E\u4E16\u8A71\u307E\u3067\u3001\u4F55\u3067\u3082\u3059\u308B\u3002\u79C1\u307F\u305F\u3044\u306A\u9670\u6C17\u306A\u6BCD\u89AA\u306B\u6BD4\u3079\u308C\u3070......"
    - language: 4
      text: "\uBE75 \uD55C \uBD09\uC9C0\uB97C \uC9D1\uC5B4 \uBB3C\uACFC \uD568\uAED8
        \uBA39\uC73C\uBA70 \uB098\uAC08 \uC900\uBE44\uB97C \uD55C\uB2E4. \uBB38\uC5D0
        \uBD99\uC740 \uB2EC\uB825\uC740 \uB538\uC774 \uADF8\uB9B0 \uB3D9\uADF8\uB77C\uBBF8\uB85C
        \uAC00\uB4DD\uD558\uB2E4. \uCE5C\uAD6C\uB4E4\uACFC \uC138\uC6B4 \uACC4\uD68D\uC774\uACA0\uC9C0.
        \uC801\uC5B4\uB3C4 \uADF8 \uC544\uC774\uB4E4\uC740 \uB098\uBCF4\uB2E4 \uB0AB\uB2E4.
        \uB124\uD2B8\uC6CC\uD06C\uB97C \uD574\uD0B9\uD558\uB294 \uC77C\uBD80\uD130
        \uB3D9\uB124\uB97C \uB3CC\uBCF4\uB294 \uC77C\uAE4C\uC9C0 \uB2E4 \uD558\uB2C8\uAE4C.
        \uB098\uCC98\uB7FC \uC74C\uCE68\uD55C \uB299\uC740 \uC5C4\uB9C8\uC5D0 \uBE44\uD558\uBA74......"
    - language: 5
      text: "Je prends un sac de pain, le mange avec de l'eau et m'appr\xEAte \xE0
        sortir. Sur la porte, un calendrier couvert de cercles trac\xE9s par ma fille.
        Ses projets avec ses amis, sans doute. Ils valent mieux que moi, au moins.
        Ils piratent des r\xE9seaux, s'occupent du quartier... \xC0 c\xF4t\xE9 d'une
        vieille m\xE8re lugubre comme moi......"
    - language: 6
      text: "Ich nehme eine T\xFCte Brot, esse es mit Wasser und mache mich zum Gehen
        bereit. An der T\xFCr h\xE4ngt ein Kalender, voller Kreise, die meine Tochter
        eingezeichnet hat. Vermutlich ihre Pl\xE4ne mit ihren Freunden. Sie sind
        immerhin besser als ich. Sie hacken Netzwerke und k\xFCmmern sich um die
        Nachbarschaft. Verglichen mit so einer finsteren alten Mutter wie mir......"
    - language: 7
      text: "Cojo una bolsa de pan, lo como con agua y me preparo para salir. Hay
        un calendario pegado a la puerta, lleno de c\xEDrculos que dibuj\xF3 mi hija.
        Ser\xE1n sus planes con sus amigos. Al menos son mejores que yo. Lo mismo
        piratean redes que cuidan del barrio. Comparados con una madre vieja y sombr\xEDa
        como yo......"
    - language: 8
      text: "Pego um saco de p\xE3o, como com \xE1gua e me preparo para sair. H\xE1
        um calend\xE1rio colado na porta, cheio de c\xEDrculos que minha filha desenhou.
        Devem ser os planos dela com os amigos. Pelo menos eles s\xE3o melhores do
        que eu. Invadem redes, cuidam da comunidade... Comparados a uma m\xE3e velha
        e sombria como eu......"
    - language: 9
      text: "\u0425\u0432\u0430\u0442\u0430\u044E \u043F\u0430\u043A\u0435\u0442
        \u0441 \u0445\u043B\u0435\u0431\u043E\u043C, \u0435\u043C, \u0437\u0430\u043F\u0438\u0432\u0430\u044F
        \u0432\u043E\u0434\u043E\u0439, \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
        \u0443\u0445\u043E\u0434\u0438\u0442\u044C. \u041D\u0430 \u0434\u0432\u0435\u0440\u0438
        \u0432\u0438\u0441\u0438\u0442 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044C,
        \u0432\u0435\u0441\u044C \u0432 \u043A\u0440\u0443\u0436\u043E\u0447\u043A\u0430\u0445,
        \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u043D\u044B\u0445
        \u0434\u043E\u0447\u0435\u0440\u044C\u044E. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u0435\u0451 \u043F\u043B\u0430\u043D\u044B \u0441 \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438.
        \u041E\u043D\u0438-\u0442\u043E \u0445\u043E\u0442\u044F \u0431\u044B \u043B\u0443\u0447\u0448\u0435
        \u043C\u0435\u043D\u044F. \u0418 \u0441\u0435\u0442\u0438 \u0432\u0437\u043B\u0430\u043C\u044B\u0432\u0430\u044E\u0442,
        \u0438 \u043E \u0441\u043E\u0441\u0435\u0434\u044F\u0445 \u0437\u0430\u0431\u043E\u0442\u044F\u0442\u0441\u044F.
        \u041A\u0443\u0434\u0430 \u0434\u043E \u043D\u0438\u0445 \u0442\u0430\u043A\u043E\u0439
        \u043C\u0440\u0430\u0447\u043D\u043E\u0439 \u0441\u0442\u0430\u0440\u043E\u0439
        \u043C\u0430\u043C\u0430\u0448\u0435, \u043A\u0430\u043A \u044F......"
  - key: os.memory.1230.text
    values:
    - language: 0
      text: "\u54E6\u5BF9..."
    - language: 1
      text: "\u54E6\u5C0D..."
    - language: 2
      text: Oh, right...
    - language: 3
      text: "\u3042\u3042\u3001\u305D\u3046\u3060..."
    - language: 4
      text: "\uC544, \uB9DE\uB2E4..."
    - language: 5
      text: Ah, oui...
    - language: 6
      text: Ach ja...
    - language: 7
      text: Ah, cierto...
    - language: 8
      text: Ah, sim...
    - language: 9
      text: "\u0410\u0445 \u0434\u0430..."
  - key: os.memory.1240.text
    values:
    - language: 0
      text: "\u6211\u56DE\u8EAB\u8D70\u56DE\u5BA2\u5385\uFF0C\u4E00\u4E2A\u53F0\u5B50\u4E0A\u653E\u7740\u4E00\u5757\u663E\u773C\u7684\u76F8\u6846...\u6211\u7684\u4E08\u592B\u3002\u4ED6\u53BB\u4E86\u51E0\u5E74\u524D\u7684\u53CD\u4FB5\u7565\u6218\u4E89\uFF0C\u76F4\u5230\u73B0\u5728\u90FD\u6CA1\u80FD\u5BC4\u56DE\u6765\u4EFB\u4F55\u4E66\u4FE1\u3002"
    - language: 1
      text: "\u6211\u56DE\u8EAB\u8D70\u56DE\u5BA2\u5EF3\uFF0C\u4E00\u500B\u81FA\u5B50\u4E0A\u653E\u8457\u4E00\u584A\u986F\u773C\u7684\u76F8\u6846...\u6211\u7684\u4E08\u592B\u3002\u4ED6\u53BB\u4E86\u5E7E\u5E74\u524D\u7684\u53CD\u4FB5\u7565\u6230\u722D\uFF0C\u76F4\u5230\u73FE\u5728\u90FD\u6C92\u80FD\u5BC4\u56DE\u4F86\u4EFB\u4F55\u66F8\u4FE1\u3002"
    - language: 2
      text: I turn back into the living room. A photograph stands prominently on
        a small table... My husband. He left for the war against the invasion a few
        years ago. To this day, no letters from him have made it home.
    - language: 3
      text: "\u5F15\u304D\u8FD4\u3057\u3066\u5C45\u9593\u3078\u623B\u308B\u3002\u5C0F\u3055\u306A\u53F0\u306E\u4E0A\u306B\u3001\u3072\u3068\u304D\u308F\u76EE\u7ACB\u3064\u5199\u771F\u7ACB\u3066\u304C\u3042\u308B...\u592B\u3060\u3002\u6570\u5E74\u524D\u3001\u4FB5\u7565\u306B\u6297\u3046\u3042\u306E\u6226\u4E89\u3078\u884C\u3063\u305F\u3002\u4ECA\u306B\u81F3\u308B\u307E\u3067\u3001\u624B\u7D19\u306F\u4E00\u901A\u3082\u5C4A\u3044\u3066\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uBAB8\uC744 \uB3CC\uB824 \uAC70\uC2E4\uB85C \uB3CC\uC544\uAC04\uB2E4.
        \uC791\uC740 \uD0C1\uC790 \uC704\uC5D0 \uB208\uC5D0 \uB744\uB294 \uC561\uC790\uAC00
        \uB193\uC5EC \uC788\uB2E4... \uB0B4 \uB0A8\uD3B8. \uBA87 \uB144 \uC804 \uCE68\uB7B5\uC5D0
        \uB9DE\uC11C\uB294 \uC804\uC7C1\uC5D0 \uB098\uAC14\uB2E4. \uC9C0\uAE08\uAE4C\uC9C0\uB3C4
        \uD3B8\uC9C0 \uD55C \uD1B5 \uBCF4\uB0B4\uC624\uC9C0 \uBABB\uD588\uB2E4."
    - language: 5
      text: "Je retourne au salon. Sur une petite table, un cadre bien en vue...
        Mon mari. Il est parti combattre l'invasion il y a quelques ann\xE9es. Depuis,
        aucune lettre de lui n'est arriv\xE9e."
    - language: 6
      text: "Ich kehre ins Wohnzimmer zur\xFCck. Auf einem kleinen Tisch steht gut
        sichtbar ein Bilderrahmen... Mein Mann. Er zog vor ein paar Jahren in den
        Krieg gegen die Invasoren. Bis heute hat mich kein einziger Brief von ihm
        erreicht."
    - language: 7
      text: "Regreso al sal\xF3n. Sobre una mesita hay un marco bien a la vista...
        Mi marido. Se fue hace unos a\xF1os a la guerra contra la invasi\xF3n. Hasta
        hoy no ha llegado ni una carta suya."
    - language: 8
      text: "Volto para a sala. Sobre uma mesinha, um porta-retrato chama a aten\xE7\xE3o...
        Meu marido. Ele partiu h\xE1 alguns anos para a guerra contra a invas\xE3o.
        At\xE9 hoje, nenhuma carta dele chegou em casa."
    - language: 9
      text: "\u0420\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0441\u044C
        \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0441\u044C
        \u0432 \u0433\u043E\u0441\u0442\u0438\u043D\u0443\u044E. \u041D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A\u0435,
        \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0432\u0438\u0434\u043D\u043E\u043C
        \u043C\u0435\u0441\u0442\u0435, \u0441\u0442\u043E\u0438\u0442 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F
        \u0432 \u0440\u0430\u043C\u043A\u0435... \u041C\u043E\u0439 \u043C\u0443\u0436.
        \u041E\u043D \u0443\u0448\u0451\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434 \u043D\u0430 \u0432\u043E\u0439\u043D\u0443
        \u043F\u0440\u043E\u0442\u0438\u0432 \u0437\u0430\u0445\u0432\u0430\u0442\u0447\u0438\u043A\u043E\u0432.
        \u0414\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043E\u0442 \u043D\u0435\u0433\u043E
        \u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u043E \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
        \u043F\u0438\u0441\u044C\u043C\u0430."
  - key: os.memory.1250.text
    values:
    - language: 0
      text: "\u6211\u62FF\u8D77\u76F8\u6846\uFF0C\u5934\u9760\u7740\u6211\u7684\u7231\u4EBA...\"\u7B49\u6211\u6CBB\u597D\u6211\u4EEC\u5973\u513F\uFF0C\u4EB2\u7231\u7684...\""
    - language: 1
      text: "\u6211\u62FF\u8D77\u76F8\u6846\uFF0C\u982D\u9760\u8457\u6211\u7684\u611B\u4EBA...\"\u7B49\u6211\u6CBB\u597D\u6211\u5011\u5973\u5152\uFF0C\u89AA\u611B\u7684...\""
    - language: 2
      text: I pick up the frame and rest my head against my love... 'Once I've cured
        our daughter, darling...'
    - language: 3
      text: "\u5199\u771F\u7ACB\u3066\u3092\u624B\u306B\u53D6\u308A\u3001\u611B\u3057\u3044\u4EBA\u306B\u982D\u3092\u5BC4\u305B\u308B...\u300E\u5A18\u3092\u6CBB\u3057\u305F\u3089\u306D\u3001\u3042\u306A\u305F...\u300F"
    - language: 4
      text: "\uC561\uC790\uB97C \uC9D1\uC5B4 \uB4E4\uACE0 \uC0AC\uB791\uD558\uB294
        \uC0AC\uB78C\uC5D0\uAC8C \uBA38\uB9AC\uB97C \uAE30\uB304\uB2E4... '\uC6B0\uB9AC
        \uB538\uC744 \uACE0\uCE58\uACE0 \uB098\uBA74, \uC5EC\uBCF4...'"
    - language: 5
      text: "Je prends le cadre et pose ma t\xEAte contre mon amour... \xAB Quand
        j'aurai gu\xE9ri notre fille, mon ch\xE9ri... \xBB"
    - language: 6
      text: "Ich nehme den Rahmen und lehne meinen Kopf an meinen Liebsten... \u201ASobald
        ich unsere Tochter geheilt habe, mein Schatz...\u2018"
    - language: 7
      text: "Cojo el marco y apoyo la cabeza contra mi amor... \xABCuando cure a
        nuestra hija, cari\xF1o...\xBB"
    - language: 8
      text: "Pego o porta-retrato e encosto a cabe\xE7a no meu amor... 'Assim que
        eu curar nossa filha, querido...'"
    - language: 9
      text: "\u0411\u0435\u0440\u0443 \u0440\u0430\u043C\u043A\u0443 \u0438 \u0441\u043A\u043B\u043E\u043D\u044F\u044E
        \u0433\u043E\u043B\u043E\u0432\u0443 \u043A \u043B\u044E\u0431\u0438\u043C\u043E\u043C\u0443...
        \xAB\u0412\u043E\u0442 \u0432\u044B\u043B\u0435\u0447\u0443 \u043D\u0430\u0448\u0443
        \u0434\u043E\u0447\u044C, \u0440\u043E\u0434\u043D\u043E\u0439...\xBB"
  - key: os.memory.1260.text
    values:
    - language: 0
      text: "\u505A\u5B8C\u6211\u89C9\u5F97\u6700\u91CD\u8981\u7684\u51FA\u95E8\u4EEA\u5F0F\uFF0C\u6211\u6487\u4E86\u6487\u8863\u89D2\u3002"
    - language: 1
      text: "\u505A\u5B8C\u6211\u89BA\u5F97\u6700\u91CD\u8981\u7684\u51FA\u9580\u5100\u5F0F\uFF0C\u6211\u6487\u4E86\u6487\u8863\u89D2\u3002"
    - language: 2
      text: Having completed what I consider the most important part of leaving the
        house, I brush down the hem of my coat.
    - language: 3
      text: "\u79C1\u306B\u3068\u3063\u3066\u4F55\u3088\u308A\u5927\u5207\u306A\u5916\u51FA\u524D\u306E\u5100\u5F0F\u3092\u6E08\u307E\u305B\u3001\u670D\u306E\u88FE\u3092\u6255\u3063\u305F\u3002"
    - language: 4
      text: "\uB0B4\uAC00 \uAC00\uC7A5 \uC911\uC694\uD558\uAC8C \uC5EC\uAE30\uB294
        \uC678\uCD9C \uC804 \uC758\uC2DD\uC744 \uB9C8\uCE58\uACE0, \uC637\uC790\uB77D\uC744
        \uD138\uC5C8\uB2E4."
    - language: 5
      text: "Apr\xE8s ce qui me semble \xEAtre le plus important de mes rituels de
        d\xE9part, je lisse le bas de mon manteau."
    - language: 6
      text: "Nachdem ich das f\xFCr mich wichtigste Ritual vor dem Aufbruch erledigt
        habe, streiche ich den Saum meines Mantels glatt."
    - language: 7
      text: "Una vez cumplido el que considero mi ritual m\xE1s importante antes
        de salir, me aliso el bajo del abrigo."
    - language: 8
      text: Depois de cumprir o que considero meu ritual mais importante antes de
        sair, aliso a barra do casaco.
    - language: 9
      text: "\u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0432 \u0441\u0430\u043C\u044B\u0439
        \u0432\u0430\u0436\u043D\u044B\u0439, \u043D\u0430 \u043C\u043E\u0439 \u0432\u0437\u0433\u043B\u044F\u0434,
        \u0440\u0438\u0442\u0443\u0430\u043B \u043F\u0435\u0440\u0435\u0434 \u0432\u044B\u0445\u043E\u0434\u043E\u043C
        \u0438\u0437 \u0434\u043E\u043C\u0430, \u044F \u043E\u0434\u0451\u0440\u0433\u0438\u0432\u0430\u044E
        \u043A\u0440\u0430\u0439 \u043E\u0434\u0435\u0436\u0434\u044B."
  - key: os.memory.1020.option.1
    values:
    - language: 0
      text: "\u6D17\u6F31"
    - language: 1
      text: "\u6D17\u6F31"
    - language: 2
      text: Wash up
    - language: 3
      text: "\u8EAB\u652F\u5EA6\u3092\u3059\u308B"
    - language: 4
      text: "\uC53B\uACE0 \uB2E8\uC7A5\uD55C\uB2E4"
    - language: 5
      text: Faire ma toilette
    - language: 6
      text: Waschen
    - language: 7
      text: Asearme
    - language: 8
      text: Me lavar
    - language: 9
      text: "\u0423\u043C\u044B\u0442\u044C\u0441\u044F"
  - key: os.memory.1060.option.1
    values:
    - language: 0
      text: "\u68C0\u67E5\u9632\u8EAB\u7528\u6B66\u5668"
    - language: 1
      text: "\u6AA2\u67E5\u9632\u8EAB\u7528\u6B66\u5668"
    - language: 2
      text: Check my weapon
    - language: 3
      text: "\u8B77\u8EAB\u7528\u306E\u6B66\u5668\u3092\u78BA\u8A8D\u3059\u308B"
    - language: 4
      text: "\uD638\uC2E0\uC6A9 \uBB34\uAE30\uB97C \uD655\uC778\uD55C\uB2E4"
    - language: 5
      text: "V\xE9rifier mon arme"
    - language: 6
      text: "Waffe \xFCberpr\xFCfen"
    - language: 7
      text: Revisar mi arma
    - language: 8
      text: Verificar minha arma
    - language: 9
      text: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043E\u0440\u0443\u0436\u0438\u0435
        \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u043E\u0431\u043E\u0440\u043E\u043D\u044B"
  - key: os.memory.1080.option.1
    values:
    - language: 0
      text: "\u68C0\u89C6\u624B\u67AA"
    - language: 1
      text: "\u6AA2\u8996\u624B\u69CD"
    - language: 2
      text: Inspect the pistol
    - language: 3
      text: "\u62F3\u9283\u3092\u8ABF\u3079\u308B"
    - language: 4
      text: "\uAD8C\uCD1D\uC744 \uC0B4\uD3B4\uBCF8\uB2E4"
    - language: 5
      text: Examiner le pistolet
    - language: 6
      text: Pistole untersuchen
    - language: 7
      text: Examinar la pistola
    - language: 8
      text: Examinar a pistola
    - language: 9
      text: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442"
  - key: os.memory.1140.option.1
    values:
    - language: 0
      text: "\u7EE7\u7EED\u68C0\u67E5\u624B\u67AA\uFF0C\u4E0A\u819B\u3002"
    - language: 1
      text: "\u7E7C\u7E8C\u6AA2\u67E5\u624B\u69CD\uFF0C\u4E0A\u819B\u3002"
    - language: 2
      text: Check the pistol again. Rack the slide.
    - language: 3
      text: "\u62F3\u9283\u306E\u78BA\u8A8D\u3092\u7D9A\u3051\u3001\u88C5\u586B\u3059\u308B\u3002"
    - language: 4
      text: "\uAD8C\uCD1D\uC744 \uACC4\uC18D \uC810\uAC80\uD558\uACE0 \uC7A5\uC804\uD55C\uB2E4."
    - language: 5
      text: "Rev\xE9rifier le pistolet et l'armer."
    - language: 6
      text: "Pistole erneut pr\xFCfen und durchladen."
    - language: 7
      text: Revisar de nuevo la pistola y amartillarla.
    - language: 8
      text: "Verificar a pistola de novo e engatilh\xE1-la."
    - language: 9
      text: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443
        \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430. \u0412\u0437\u0432\u0435\u0441\u0442\u0438
        \u0437\u0430\u0442\u0432\u043E\u0440."
  - key: os.memory.1170.option.1
    values:
    - language: 0
      text: "\u7EF4\u62A4\u624B\u67AA"
    - language: 1
      text: "\u7DAD\u8B77\u624B\u69CD"
    - language: 2
      text: Maintain the pistol
    - language: 3
      text: "\u62F3\u9283\u3092\u6574\u5099\u3059\u308B"
    - language: 4
      text: "\uAD8C\uCD1D\uC744 \uC815\uBE44\uD55C\uB2E4"
    - language: 5
      text: Entretenir le pistolet
    - language: 6
      text: Pistole warten
    - language: 7
      text: Mantener la pistola
    - language: 8
      text: "Fazer manuten\xE7\xE3o na pistola"
    - language: 9
      text: "\u041E\u0431\u0441\u043B\u0443\u0436\u0438\u0442\u044C \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442"
  - key: os.memory.1230.option.1
    values:
    - language: 0
      text: ....
    - language: 1
      text: ....
    - language: 2
      text: ....
    - language: 3
      text: ....
    - language: 4
      text: ....
    - language: 5
      text: ....
    - language: 6
      text: ....
    - language: 7
      text: ....
    - language: 8
      text: ....
    - language: 9
      text: ....
  - key: os.memory.1260.option.1
    values:
    - language: 0
      text: "\u51FA\u95E8"
    - language: 1
      text: "\u51FA\u9580"
    - language: 2
      text: Go outside
    - language: 3
      text: "\u5916\u3078\u51FA\u308B"
    - language: 4
      text: "\uBC16\uC73C\uB85C \uB098\uAC04\uB2E4"
    - language: 5
      text: Sortir
    - language: 6
      text: Hinausgehen
    - language: 7
      text: Salir
    - language: 8
      text: Sair
    - language: 9
      text: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0434\u043E\u043C\u0430"
  - key: ui.os.character.link_message.chapter01_memory_connected
    values:
    - language: 0
      text: "\u55EF.\u5DF2\u7ECF\u6B63\u5E38\u63A5\u5165\u8BB0\u5FC6\u4E86,\u4E00\u5207\u6B63\u5E38!"
    - language: 1
      text: "\u55EF.\u5DF2\u7D93\u6B63\u5E38\u63A5\u5165\u8A18\u61B6\u4E86,\u4E00\u5207\u6B63\u5E38!"
    - language: 2
      text: Mm. The memory connection is working. Everything looks normal!
    - language: 3
      text: "\u3046\u3093\u3002\u8A18\u61B6\u306B\u3061\u3083\u3093\u3068\u63A5\u7D9A\u3067\u304D\u305F\u3002\u7570\u5E38\u306A\u3057\uFF01"
    - language: 4
      text: "\uC751. \uAE30\uC5B5\uC5D0 \uC815\uC0C1\uC801\uC73C\uB85C \uC811\uC18D\uD588\uC5B4.
        \uC774\uC0C1 \uC5C6\uC5B4!"
    - language: 5
      text: "Hum. La connexion \xE0 la m\xE9moire fonctionne. Tout est normal !"
    - language: 6
      text: Hm. Die Verbindung zur Erinnerung steht. Alles in Ordnung!
    - language: 7
      text: "Mmm. La conexi\xF3n con la memoria funciona. \xA1Todo normal!"
    - language: 8
      text: "Hum. A conex\xE3o com a mem\xF3ria est\xE1 funcionando. Tudo normal!"
    - language: 9
      text: "\u0423\u0433\u0443. \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
        \u043A \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C
        \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u0412\u0441\u0451 \u0432
        \u043D\u043E\u0440\u043C\u0435!"
  - key: ui.os.character.link_message.chapter01_memory_strange_humor
    values:
    - language: 0
      text: "\u8D8A\u6765\u8D8A\u201C\u5E74\u8F7B\u201D?\u597D\u5947\u602A\u7684\u5E7D\u9ED8\u611F..."
    - language: 1
      text: "\u8D8A\u4F86\u8D8A\u201C\u5E74\u8F15\u201D?\u597D\u5947\u602A\u7684\u5E7D\u9ED8\u611F..."
    - language: 2
      text: More and more 'young'? What a strange sense of humor...
    - language: 3
      text: "\u307E\u3059\u307E\u3059\u300E\u82E5\u304F\u300F\uFF1F\u5909\u308F\u3063\u305F\u30E6\u30FC\u30E2\u30A2\u3060\u306D..."
    - language: 4
      text: "\uC810\uC810 \uB354 '\uC80A\uC5B4\uC9C4\uB2E4'\uACE0? \uCC38 \uC774\uC0C1\uD55C
        \uC720\uBA38 \uAC10\uAC01\uC774\uB124..."
    - language: 5
      text: "De plus en plus \xAB jeunes \xBB ? Quel dr\xF4le de sens de l'humour..."
    - language: 6
      text: "Immer \u201Ajugendlicher\u2018? Ein seltsamer Sinn f\xFCr Humor..."
    - language: 7
      text: "\xBFCada vez m\xE1s \xABj\xF3venes\xBB? Qu\xE9 sentido del humor tan
        extra\xF1o..."
    - language: 8
      text: Cada vez mais 'jovens'? Que senso de humor estranho...
    - language: 9
      text: "\u0412\u0441\u0451 \xAB\u043C\u043E\u043B\u043E\u0436\u0435\xBB? \u0421\u0442\u0440\u0430\u043D\u043D\u043E\u0435
        \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u044E\u043C\u043E\u0440\u0430..."
  - key: ui.os.character.link_message.chapter01_memory_harsh_words
    values:
    - language: 0
      text: "\u2026\u2026\u8FDE\u4E24\u9897\u5B50\u5F39\u90FD\u80FD\u60F3\u5230\u8FD9\u4E9B\u554A\u3002"
    - language: 1
      text: "\u2026\u2026\u9023\u5169\u9846\u5B50\u5F48\u90FD\u80FD\u60F3\u5230\u9019\u4E9B\u554A\u3002"
    - language: 2
      text: "\u2026Even two bullets get her thinking about all that."
    - language: 3
      text: "\u2026\u2026\u305F\u3063\u305F\u4E8C\u767A\u306E\u5F3E\u304B\u3089\u3001\u305D\u3053\u307E\u3067\u8003\u3048\u3061\u3083\u3046\u3093\u3060\u3002"
    - language: 4
      text: "\u2026\u2026\uACE0\uC791 \uCD1D\uC54C \uB450 \uBC1C\uB85C \uADF8\uB7F0
        \uC0DD\uAC01\uAE4C\uC9C0 \uD558\uB124."
    - language: 5
      text: "\u2026M\xEAme deux balles lui font penser \xE0 tout \xE7a."
    - language: 6
      text: "\u2026Selbst bei zwei Kugeln kommt sie auf solche Gedanken."
    - language: 7
      text: "\u2026Hasta dos balas le hacen pensar en todo eso."
    - language: 8
      text: "\u2026At\xE9 duas balas fazem ela pensar em tudo isso."
    - language: 9
      text: "\u2026\u0414\u0430\u0436\u0435 \u0434\u0432\u0435 \u043F\u0443\u043B\u0438
        \u043D\u0430\u0432\u043E\u0434\u044F\u0442 \u0435\u0451 \u043D\u0430 \u0442\u0430\u043A\u0438\u0435
        \u043C\u044B\u0441\u043B\u0438."
  - key: ui.os.character.link_message.chapter01_memory_insects
    values:
    - language: 0
      text: "......\u6211\u786E\u5B9E\u4E0D\u559C\u6B22\u87D1\u8782\uFF0C\u4F46\u8FD9\u4E2A\u7528\u8BCD\u6709\u70B9\u602A\u602A\u7684"
    - language: 1
      text: "......\u6211\u78BA\u5BE6\u4E0D\u559C\u6B61\u87D1\u8782\uFF0C\u4F46\u9019\u500B\u7528\u8A5E\u6709\u9EDE\u602A\u602A\u7684"
    - language: 2
      text: ......I really don't like cockroaches, but that's a strange way to put
        it.
    - language: 3
      text: "......\u78BA\u304B\u306B\u30B4\u30AD\u30D6\u30EA\u306F\u597D\u304D\u3058\u3083\u306A\u3044\u3051\u3069\u3001\u305D\u306E\u8A00\u3044\u65B9\u306F\u3061\u3087\u3063\u3068\u5909\u304B\u3082\u3002"
    - language: 4
      text: "......\uB098\uB3C4 \uBC14\uD034\uBC8C\uB808\uB294 \uC2EB\uC5B4\uD558\uC9C0\uB9CC,
        \uC800 \uD45C\uD604\uC740 \uC880 \uC774\uC0C1\uD55C\uB370."
    - language: 5
      text: "......Je n'aime vraiment pas les cafards, mais c'est une dr\xF4le de
        fa\xE7on de le dire."
    - language: 6
      text: "......Ich mag Kakerlaken wirklich nicht, aber das ist seltsam ausgedr\xFCckt."
    - language: 7
      text: "......Es verdad que no me gustan las cucarachas, pero qu\xE9 forma tan
        rara de decirlo."
    - language: 8
      text: "......Eu realmente n\xE3o gosto de baratas, mas esse jeito de falar
        \xE9 meio estranho."
    - language: 9
      text: "......\u042F \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u043D\u0435
        \u043B\u044E\u0431\u043B\u044E \u0442\u0430\u0440\u0430\u043A\u0430\u043D\u043E\u0432,
        \u043D\u043E \u043A\u0430\u043A-\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E
        \u044D\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043D\u043E."
  - key: ui.os.memory.option_requires_program
    values:
    - language: 0
      text: "\u9700\u5B89\u88C5{0}\u540E\u624D\u53EF\u9009\u62E9"
    - language: 1
      text: "\u9700\u5B89\u88DD{0}\u5F8C\u624D\u53EF\u9078\u64C7"
    - language: 2
      text: Install {0} to select this option
    - language: 3
      text: "{0}\u306E\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u304C\u5FC5\u8981\u3067\u3059"
    - language: 4
      text: "{0} \uC124\uCE58 \uD6C4 \uC120\uD0DD \uAC00\uB2A5"
    - language: 5
      text: Installez {0} pour choisir cette option
    - language: 6
      text: "Zum Ausw\xE4hlen {0} installieren"
    - language: 7
      text: "Instala {0} para elegir esta opci\xF3n"
    - language: 8
      text: "Instale {0} para escolher esta op\xE7\xE3o"
    - language: 9
      text: "\u0414\u043B\u044F \u0432\u044B\u0431\u043E\u0440\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
        \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C {0}"
  - key: os.memory.subwindows.000.shot.01.text.00
    values:
    - language: 0
      text: "\u5580\u54D2"
    - language: 1
      text: "\u5580\u5660"
    - language: 2
      text: Click
    - language: 3
      text: "\u30AB\u30C1\u30E3"
    - language: 4
      text: "\uB538\uAE4D"
    - language: 5
      text: Clic
    - language: 6
      text: Klick
    - language: 7
      text: Clic
    - language: 8
      text: Clique
    - language: 9
      text: "\u0429\u0451\u043B\u043A"
  - key: os.memory.1280.text
    values:
    - language: 0
      text: "\u95E8\u8F74\u53D1\u51FA\u4E0D\u8010\u70E6\u7684\u58F0\u97F3\uFF0C\u8BF4\u771F\u7684\uFF0C\u5916\u9762\u7684\u7A7A\u6C14\u6BD4\u5C4B\u91CC\u7684\u8FD8\u8981\u6D51\u6D4A\u3002\u5929\u5E55\u88AB\u6218\u4E89\u7559\u4E0B\u7684\u7C89\u5C18\u906E\u853D\uFF0C\u4ECE\u5916\u9762\u770B\u8FDC\u6BD4\u900F\u8FC7\u7A97\u6237\u770B\u8981\u66F4\u7EA2\u3002"
    - language: 1
      text: "\u9580\u8EF8\u767C\u51FA\u4E0D\u8010\u7169\u7684\u8072\u97F3\uFF0C\u8AAA\u771F\u7684\uFF0C\u5916\u9762\u7684\u7A7A\u6C23\u6BD4\u5C4B\u88E1\u7684\u9084\u8981\u6E3E\u6FC1\u3002\u5929\u5E55\u88AB\u6230\u722D\u7559\u4E0B\u7684\u7C89\u5875\u906E\u853D\uFF0C\u5F9E\u5916\u9762\u770B\u9060\u6BD4\u900F\u904E\u7A97\u6236\u770B\u8981\u66F4\u7D05\u3002"
    - language: 2
      text: The hinges give an impatient groan. Honestly, the air outside is even
        murkier than it is indoors. Dust left by the war veils the sky; out here,
        it looks far redder than it did through the window.
    - language: 3
      text: "\u8776\u756A\u304C\u82DB\u7ACB\u3063\u305F\u3088\u3046\u306A\u97F3\u3092\u7ACB\u3066\u308B\u3002\u6B63\u76F4\u3001\u5916\u306E\u7A7A\u6C17\u306F\u90E8\u5C4B\u306E\u4E2D\u3088\u308A\u6FC1\u3063\u3066\u3044\u308B\u3002\u6226\u4E89\u304C\u6B8B\u3057\u305F\u7C89\u5875\u306B\u7A7A\u306F\u8986\u308F\u308C\u3001\u7A93\u8D8A\u3057\u306B\u898B\u308B\u3088\u308A\u305A\u3063\u3068\u8D64\u3044\u3002"
    - language: 4
      text: "\uBB38 \uACBD\uCCA9\uC774 \uC9DC\uC99D \uC11E\uC778 \uC18C\uB9AC\uB97C
        \uB0B8\uB2E4. \uC194\uC9C1\uD788 \uBC16\uC758 \uACF5\uAE30\uAC00 \uC9D1 \uC548\uBCF4\uB2E4
        \uB354 \uD0C1\uD558\uB2E4. \uC804\uC7C1\uC774 \uB0A8\uAE34 \uBA3C\uC9C0\uAC00
        \uD558\uB298\uC744 \uAC00\uB838\uACE0, \uBC16\uC5D0\uC11C \uBCF4\uB2C8 \uCC3D\uBB38
        \uB108\uBA38\uB85C \uBCFC \uB54C\uBCF4\uB2E4 \uD6E8\uC52C \uBD89\uB2E4."
    - language: 5
      text: "Les gonds poussent un grincement impatient. Franchement, l'air dehors
        est encore plus trouble qu'\xE0 l'int\xE9rieur. La poussi\xE8re laiss\xE9e
        par la guerre voile le ciel ; d'ici, il para\xEEt bien plus rouge qu'\xE0
        travers la fen\xEAtre."
    - language: 6
      text: "Die Scharniere knarren ungeduldig. Ehrlich gesagt ist die Luft drau\xDFen
        noch tr\xFCber als drinnen. Der Staub des Krieges verh\xFCllt den Himmel;
        hier drau\xDFen wirkt er viel r\xF6ter als durch das Fenster."
    - language: 7
      text: "Las bisagras sueltan un quejido impaciente. La verdad, el aire de fuera
        est\xE1 a\xFAn m\xE1s turbio que el de dentro. El polvo que dej\xF3 la guerra
        vela el cielo; desde aqu\xED se ve mucho m\xE1s rojo que a trav\xE9s de la
        ventana."
    - language: 8
      text: "As dobradi\xE7as soltam um gemido impaciente. Sinceramente, o ar l\xE1
        fora est\xE1 ainda mais turvo que o de dentro. A poeira deixada pela guerra
        encobre o c\xE9u; daqui ele parece muito mais vermelho do que pela janela."
    - language: 9
      text: "\u041F\u0435\u0442\u043B\u0438 \u0438\u0437\u0434\u0430\u044E\u0442
        \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0439
        \u0441\u043A\u0440\u0438\u043F. \u0427\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
        \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u0432\u043E\u0437\u0434\u0443\u0445
        \u0435\u0449\u0451 \u043C\u0443\u0442\u043D\u0435\u0435, \u0447\u0435\u043C
        \u0432 \u0434\u043E\u043C\u0435. \u041D\u0435\u0431\u043E \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u043E
        \u043F\u044B\u043B\u044C\u044E, \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044F
        \u043F\u043E\u0441\u043B\u0435 \u0432\u043E\u0439\u043D\u044B. \u041E\u0442\u0441\u044E\u0434\u0430
        \u043E\u043D\u043E \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043A\u0443\u0434\u0430
        \u043A\u0440\u0430\u0441\u043D\u0435\u0435, \u0447\u0435\u043C \u0438\u0437
        \u043E\u043A\u043D\u0430."
  - key: os.memory.1290.text
    values:
    - language: 0
      text: "\u6211\u521A\u8FC8\u51FA\u534A\u6B65\uFF0C\u8033\u8FB9\u7684\u8BBE\u5907\u5C31\u4F20\u6765\u4EE4\u4EBA\u70E6\u8E81\u7684\u7535\u6D41\u58F0\uFF0C\u53C8\u662F\u54EA\u5BB6\u7684\u5C0F\u5C41\u5B69\u5728\u778E\u5E7F\u64AD\u4E86\u3002\u96BE\u9053\u5C31\u6CA1\u6709\u4E00\u70B9\u70B9\u53EF\u4EE5\u7528\u7684\u4FE1\u606F\u5417\uFF1F\u6211\u62C9\u4E0B\u4E86\u6302\u8033\u6735\u4E0A\u7684\u6536\u97F3\u8BBE\u5907\u3002"
    - language: 1
      text: "\u6211\u525B\u9081\u51FA\u534A\u6B65\uFF0C\u8033\u908A\u7684\u8A2D\u5099\u5C31\u50B3\u4F86\u4EE4\u4EBA\u7169\u8E81\u7684\u96FB\u6D41\u8072\uFF0C\u53C8\u662F\u54EA\u5BB6\u7684\u5C0F\u5C41\u5B69\u5728\u778E\u5EE3\u64AD\u4E86\u3002\u96E3\u9053\u5C31\u6C92\u6709\u4E00\u9EDE\u9EDE\u53EF\u4EE5\u7528\u7684\u4FE1\u606F\u55CE\uFF1F\u6211\u62C9\u4E0B\u4E86\u639B\u8033\u6735\u4E0A\u7684\u6536\u97F3\u8A2D\u5099\u3002"
    - language: 2
      text: I've barely taken half a step when the device by my ear starts crackling.
        Some little brat broadcasting nonsense again. Isn't there a scrap of useful
        information anywhere? I pull the receiver off my ear.
    - language: 3
      text: "\u534A\u6B69\u3082\u51FA\u306A\u3044\u3046\u3061\u306B\u3001\u8033\u5143\u306E\u6A5F\u5668\u304C\u8033\u969C\u308A\u306A\u96D1\u97F3\u3092\u7ACB\u3066\u305F\u3002\u307E\u305F\u3069\u3053\u304B\u306E\u30AC\u30AD\u304C\u3001\u304F\u3060\u3089\u306A\u3044\u653E\u9001\u3092\u3057\u3066\u3044\u308B\u3002\u5C11\u3057\u3050\u3089\u3044\u5F79\u306B\u7ACB\u3064\u60C5\u5831\u306F\u306A\u3044\u306E\uFF1F\u3000\u8033\u306B\u639B\u3051\u305F\u53D7\u4FE1\u6A5F\u3092\u5916\u3057\u305F\u3002"
    - language: 4
      text: "\uBC18 \uBC1C\uC9DD\uB3C4 \uCC44 \uB098\uAC00\uC9C0 \uC54A\uC558\uB294\uB370
        \uADC0\uC5D0 \uAC74 \uC7A5\uCE58\uC5D0\uC11C \uAC70\uC2AC\uB9AC\uB294 \uC7A1\uC74C\uC774
        \uD758\uB7EC\uB098\uC628\uB2E4. \uB610 \uC5B4\uB514 \uC0AC\uB294 \uAF2C\uB9F9\uC774\uAC00
        \uC4F8\uB370\uC5C6\uB294 \uBC29\uC1A1\uC744 \uD558\uB294 \uBAA8\uC591\uC774\uB2E4.
        \uC4F8 \uB9CC\uD55C \uC815\uBCF4\uB294 \uC870\uAE08\uB3C4 \uC5C6\uB098? \uADC0\uC5D0
        \uAC78\uB9B0 \uC218\uC2E0\uAE30\uB97C \uBC97\uB294\uB2E4."
    - language: 5
      text: "J'ai \xE0 peine fait un demi-pas que l'appareil \xE0 mon oreille se
        met \xE0 gr\xE9siller. Encore un sale gosse qui diffuse n'importe quoi. Il
        n'y a donc pas la moindre information utile ? Je d\xE9croche le r\xE9cepteur
        de mon oreille."
    - language: 6
      text: "Kaum habe ich einen halben Schritt gemacht, knistert das Ger\xE4t an
        meinem Ohr schon wieder. Irgendein Balg sendet Unsinn. Gibt es denn nicht
        eine einzige brauchbare Information? Ich nehme den Empf\xE4nger vom Ohr."
    - language: 7
      text: "Apenas doy medio paso cuando el aparato de mi oreja empieza a crepitar.
        Otra vez alg\xFAn mocoso emitiendo tonter\xEDas. \xBFNo hay ni una pizca
        de informaci\xF3n \xFAtil? Me quito el receptor de la oreja."
    - language: 8
      text: "Mal dou meio passo e o aparelho na minha orelha come\xE7a a chiar. Outra
        vez algum pirralho transmitindo bobagem. Ser\xE1 que n\xE3o existe uma \xFAnica
        informa\xE7\xE3o \xFAtil? Tiro o receptor da orelha."
    - language: 9
      text: "\u041D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u044E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
        \u0438 \u043F\u043E\u043B\u0448\u0430\u0433\u0430, \u043A\u0430\u043A \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
        \u0443 \u0443\u0445\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u043E \u0442\u0440\u0435\u0449\u0430\u0442\u044C.
        \u041E\u043F\u044F\u0442\u044C \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
        \u043C\u0430\u043B\u043E\u043B\u0435\u0442\u043D\u0438\u0439 \u0431\u0430\u043B\u0431\u0435\u0441
        \u043D\u0435\u0441\u0451\u0442 \u0447\u0443\u0448\u044C \u0432 \u044D\u0444\u0438\u0440.
        \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043D\u0435\u0442 \u0445\u043E\u0442\u044C
        \u043A\u0440\u0443\u043F\u0438\u0446\u044B \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439
        \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438? \u042F \u0441\u043D\u0438\u043C\u0430\u044E
        \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A \u0441 \u0443\u0445\u0430."
  - key: os.memory.1300.text
    values:
    - language: 0
      text: "\u6211\u62C9\u4E86\u4E24\u4E0B\uFF0C\u786E\u8BA4\u95E8\u5728\u8EAB\u540E\u5408\u4E0A\u3002\u518D\u51FA\u53BB\u95EE\u95EE\u5427\u2026\u2026\u603B\u4E0D\u80FD\u4E00\u76F4\u5728\u5C4B\u91CC\u5750\u7740\u3002"
    - language: 1
      text: "\u6211\u62C9\u4E86\u5169\u4E0B\uFF0C\u78BA\u8A8D\u9580\u5728\u8EAB\u5F8C\u5408\u4E0A\u3002\u518D\u51FA\u53BB\u554F\u554F\u5427\u2026\u2026\u7E3D\u4E0D\u80FD\u4E00\u76F4\u5728\u5C4B\u88E1\u5750\u8457\u3002"
    - language: 2
      text: "I give the door a couple of tugs to make sure it's shut behind me. I'll
        try asking around again\u2026 I can't just keep sitting at home."
    - language: 3
      text: "\u80CC\u5F8C\u306E\u30C9\u30A2\u3092\u4E8C\u5EA6\u5F15\u3044\u3066\u3001\u304D\u3061\u3093\u3068\u9589\u307E\u3063\u305F\u3053\u3068\u3092\u78BA\u304B\u3081\u308B\u3002\u307E\u305F\u5916\u3067\u805E\u3044\u3066\u56DE\u308D\u3046\u2026\u2026\u3044\u3064\u307E\u3067\u3082\u5BB6\u3067\u5EA7\u3063\u3066\u3044\u308B\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u3044\u3002"
    - language: 4
      text: "\uB4F1 \uB4A4\uC758 \uBB38\uC744 \uB450 \uBC88 \uB2F9\uACA8 \uBCF4\uACE0,
        \uC81C\uB300\uB85C \uB2EB\uD78C \uAC78 \uD655\uC778\uD55C\uB2E4. \uB2E4\uC2DC
        \uB098\uAC00\uC11C \uBB3C\uC5B4\uBCF4\uC790\u2026\u2026 \uC5B8\uC81C\uAE4C\uC9C0\uACE0
        \uC9D1\uC5D0 \uC549\uC544 \uC788\uC744 \uC218\uB294 \uC5C6\uC73C\uB2C8\uAE4C."
    - language: 5
      text: "Je tire deux fois sur la porte pour v\xE9rifier qu'elle est bien ferm\xE9e
        derri\xE8re moi. Allons encore interroger les gens\u2026 Je ne peux pas rester
        assise \xE0 la maison ind\xE9finiment."
    - language: 6
      text: "Ich ziehe zweimal an der T\xFCr, um sicherzugehen, dass sie hinter mir
        zu ist. Ich sollte noch einmal herumfragen\u2026 Ich kann ja nicht die ganze
        Zeit zu Hause sitzen."
    - language: 7
      text: "Tiro un par de veces de la puerta para asegurarme de que ha quedado
        cerrada detr\xE1s de m\xED. Volver\xE9 a preguntar por ah\xED\u2026 No puedo
        quedarme sentada en casa sin m\xE1s."
    - language: 8
      text: "Puxo a porta duas vezes para ter certeza de que ficou fechada atr\xE1s
        de mim. Vou sair e perguntar de novo\u2026 N\xE3o posso ficar sentada em
        casa o tempo todo."
    - language: 9
      text: "\u0414\u0432\u0430\u0436\u0434\u044B \u0434\u0451\u0440\u0433\u0430\u044E
        \u0434\u0432\u0435\u0440\u044C, \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F,
        \u0437\u0430\u043A\u0440\u044B\u043B\u0430\u0441\u044C \u043B\u0438 \u043E\u043D\u0430
        \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439. \u041F\u043E\u0439\u0434\u0443
        \u0435\u0449\u0451 \u043F\u043E\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E
        \u043B\u044E\u0434\u0435\u0439\u2026 \u041D\u0435 \u0441\u0438\u0434\u0435\u0442\u044C
        \u0436\u0435 \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0434\u043E\u043C\u0430."
  - key: os.memory.1310.text
    values:
    - language: 0
      text: "\u8857\u53E3\u6BD4\u6628\u5929\u66F4\u4E71\u4E86\u3002\u7FFB\u5012\u7684\u8F66\u8F86\uFF0C\u63A9\u9762\u7684\u517D\u5316\u4EBA\uFF0C\u7740\u706B\u7684\u5E97\u94FA\u3002\u77ED\u77ED\u51E0\u5E74\uFF0C\u6211\u5DF2\u7ECF\u5B8C\u5168\u4E0D\u8BA4\u8BC6\u8FD9\u4E2A\u56FD\u5BB6\u4E86...\u5509"
    - language: 1
      text: "\u8857\u53E3\u6BD4\u6628\u5929\u66F4\u4E82\u4E86\u3002\u7FFB\u5012\u7684\u8ECA\u8F1B\uFF0C\u63A9\u9762\u7684\u7378\u5316\u4EBA\uFF0C\u8457\u706B\u7684\u5E97\u92EA\u3002\u77ED\u77ED\u51E0\u5E74\uFF0C\u6211\u5DF2\u7D93\u5B8C\u5168\u4E0D\u8A8D\u8B58\u9019\u500B\u570B\u5BB6\u4E86...\u5509"
    - language: 2
      text: The junction is even more of a mess than yesterday. Overturned vehicles,
        beastified people hiding their faces, shops on fire. In just a few years,
        this country has become completely unrecognizable... Sigh.
    - language: 3
      text: "\u4EA4\u5DEE\u70B9\u306F\u6628\u65E5\u3088\u308A\u8352\u308C\u3066\u3044\u305F\u3002\u6A2A\u8EE2\u3057\u305F\u8ECA\u3001\u9854\u3092\u8986\u3046\u7363\u5316\u3057\u305F\u4EBA\u3005\u3001\u71C3\u3048\u308B\u5E97\u3002\u305F\u3063\u305F\u6570\u5E74\u3067\u3001\u3053\u306E\u56FD\u306F\u3059\u3063\u304B\u308A\u898B\u77E5\u3089\u306C\u5834\u6240\u306B\u306A\u3063\u305F...\u306F\u3042\u3002"
    - language: 4
      text: "\uAE38\uBAA9\uC740 \uC5B4\uC81C\uBCF4\uB2E4 \uB354 \uC5C9\uB9DD\uC774\uB2E4.
        \uB4A4\uC9D1\uD78C \uCC28\uB7C9, \uC5BC\uAD74\uC744 \uAC00\uB9B0 \uC57C\uC218\uD654
        \uD658\uC790\uB4E4, \uBD88\uD0C0\uB294 \uAC00\uAC8C. \uBD88\uACFC \uBA87
        \uB144 \uB9CC\uC5D0 \uC774 \uB098\uB77C\uB294 \uC644\uC804\uD788 \uB0AF\uC124\uC5B4\uC84C\uB2E4...
        \uD558\uC544."
    - language: 5
      text: "Le carrefour est encore plus d\xE9vast\xE9 qu'hier. Des v\xE9hicules
        renvers\xE9s, des personnes bestialis\xE9es qui se cachent le visage, des
        boutiques en feu. En quelques ann\xE9es, ce pays est devenu m\xE9connaissable...
        Enfin."
    - language: 6
      text: "Die Kreuzung ist noch verw\xFCsteter als gestern. Umgest\xFCrzte Fahrzeuge,
        bestialisierte Menschen, die ihr Gesicht verbergen, brennende L\xE4den. Nach
        nur wenigen Jahren erkenne ich dieses Land \xFCberhaupt nicht mehr wieder...
        Ach."
    - language: 7
      text: "El cruce est\xE1 a\xFAn peor que ayer. Veh\xEDculos volcados, personas
        bestializadas que se tapan la cara, tiendas en llamas. En apenas unos a\xF1os,
        este pa\xEDs se ha vuelto irreconocible... En fin."
    - language: 8
      text: "O cruzamento est\xE1 ainda mais destru\xEDdo que ontem. Ve\xEDculos
        tombados, pessoas bestializadas escondendo o rosto, lojas em chamas. Em poucos
        anos, este pa\xEDs ficou irreconhec\xEDvel... Ai."
    - language: 9
      text: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435
        \u0435\u0449\u0451 \u0445\u0443\u0436\u0435, \u0447\u0435\u043C \u0432\u0447\u0435\u0440\u0430.
        \u041F\u0435\u0440\u0435\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0435
        \u043C\u0430\u0448\u0438\u043D\u044B, \u043E\u0437\u0432\u0435\u0440\u0435\u0432\u0448\u0438\u0435
        \u043B\u044E\u0434\u0438, \u043F\u0440\u044F\u0447\u0443\u0449\u0438\u0435
        \u043B\u0438\u0446\u0430, \u0433\u043E\u0440\u044F\u0449\u0438\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B.
        \u0412\u0441\u0435\u0433\u043E \u0437\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043B\u0435\u0442 \u044D\u0442\u0430 \u0441\u0442\u0440\u0430\u043D\u0430
        \u0441\u0442\u0430\u043B\u0430 \u043C\u043D\u0435 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
        \u0447\u0443\u0436\u043E\u0439... \u042D\u0445."
  - key: os.memory.1320.text
    values:
    - language: 0
      text: "\u4EBA\u4EEC\u8BE5\u8DD1\u7684\u4E0D\u8BE5\u8DD1\u7684\u90FD\u8DD1\u4E86\uFF0C\u6362\u8C01\u6765\u90FD\u4E0D\u4F1A\u89C9\u5F97\u8FD9\u662F\u5802\u5802\u5927\u56FD\u7684\u9996\u90FD\uFF0C\u7B49\u6211\u628A\u5973\u513F\u627E\u56DE\u6765\uFF0C\u6216\u8BB8\u6211\u4EEC\u4E5F\u8BE5\u642C\u8D70\u3002"
    - language: 1
      text: "\u4EBA\u5011\u8A72\u8DD1\u7684\u4E0D\u8A72\u8DD1\u7684\u90FD\u8DD1\u4E86\uFF0C\u63DB\u8AB0\u4F86\u90FD\u4E0D\u6703\u89BA\u5F97\u9019\u662F\u5802\u5802\u5927\u570B\u7684\u9996\u90FD\uFF0C\u7B49\u6211\u628A\u5973\u5152\u627E\u56DE\u4F86\uFF0C\u6216\u8A31\u6211\u5011\u4E5F\u8A72\u642C\u8D70\u3002"
    - language: 2
      text: Everyone has fled, whether they should have or not. Nobody would believe
        this was the capital of a great nation. Once I find my daughter, perhaps
        we should leave too.
    - language: 3
      text: "\u9003\u3052\u308B\u3079\u304D\u4EBA\u3082\u3001\u305D\u3046\u3067\u306A\u3044\u4EBA\u3082\u3001\u307F\u3093\u306A\u9003\u3052\u305F\u3002\u3053\u3053\u304C\u5927\u56FD\u306E\u9996\u90FD\u3060\u306A\u3093\u3066\u3001\u8AB0\u3082\u601D\u308F\u306A\u3044\u3060\u308D\u3046\u3002\u5A18\u3092\u898B\u3064\u3051\u305F\u3089\u3001\u79C1\u305F\u3061\u3082\u5F15\u3063\u8D8A\u3059\u3079\u304D\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
    - language: 4
      text: "\uB5A0\uB0A0 \uC0AC\uB78C\uB3C4, \uC548 \uB5A0\uB0A0 \uC0AC\uB78C\uB3C4
        \uC8C4\uB2E4 \uB3C4\uB9DD\uCCE4\uB2E4. \uB204\uAC00 \uBD10\uB3C4 \uB300\uAD6D\uC758
        \uC218\uB3C4\uB77C\uACE0\uB294 \uC0DD\uAC01\uD558\uC9C0 \uBABB\uD560 \uAC83\uC774\uB2E4.
        \uB538\uC744 \uCC3E\uC73C\uBA74 \uC6B0\uB9AC\uB3C4 \uC774\uC0AC\uB97C \uAC00\uC57C
        \uD560\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    - language: 5
      text: "Tout le monde a fui, qu'il l'ait d\xFB ou non. Personne ne croirait
        que c'est la capitale d'une grande nation. Quand j'aurai retrouv\xE9 ma fille,
        nous devrions peut-\xEAtre partir aussi."
    - language: 6
      text: "Alle sind geflohen, ob sie sollten oder nicht. Niemand w\xFCrde glauben,
        dass dies die Hauptstadt einer Gro\xDFmacht ist. Wenn ich meine Tochter gefunden
        habe, sollten wir vielleicht auch wegziehen."
    - language: 7
      text: "Todo el mundo ha huido, debiera hacerlo o no. Nadie creer\xEDa que esta
        es la capital de una gran naci\xF3n. Cuando encuentre a mi hija, quiz\xE1
        nosotras tambi\xE9n deber\xEDamos marcharnos."
    - language: 8
      text: "Todo mundo fugiu, quem devia e quem n\xE3o devia. Ningu\xE9m acreditaria
        que esta \xE9 a capital de uma grande na\xE7\xE3o. Quando eu encontrar minha
        filha, talvez tamb\xE9m dev\xEAssemos ir embora."
    - language: 9
      text: "\u0421\u0431\u0435\u0436\u0430\u043B\u0438 \u0432\u0441\u0435 \u2014
        \u043A\u043E\u043C\u0443 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E
        \u0438 \u043A\u043E\u043C\u0443 \u043D\u0435 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E.
        \u041D\u0438\u043A\u0442\u043E \u0431\u044B \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0438\u043B,
        \u0447\u0442\u043E \u044D\u0442\u043E \u0441\u0442\u043E\u043B\u0438\u0446\u0430
        \u0432\u0435\u043B\u0438\u043A\u043E\u0439 \u0434\u0435\u0440\u0436\u0430\u0432\u044B.
        \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0443 \u0434\u043E\u0447\u044C,
        \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043D\u0430\u043C \u0442\u043E\u0436\u0435
        \u0441\u0442\u043E\u0438\u0442 \u0443\u0435\u0445\u0430\u0442\u044C."
  - key: os.memory.1330.text
    values:
    - language: 0
      text: "\u642C\u53BB\u54EA\u5462......\uFF1F\u73B0\u5728\u75C5\u6BD2\u8086\u8650\uFF0C\u5B8C\u5168\u6CA1\u6709\u505C\u4E0B\u6765\u7684\u52BF\u5934\uFF0C\u56FD\u5BB6\u4E0A\u4E0B\u90FD\u5728\u6050\u614C\u4E4B\u4E2D\u3002"
    - language: 1
      text: "\u642C\u53BB\u54EA\u5462......\uFF1F\u73FE\u5728\u75C5\u6BD2\u8086\u8650\uFF0C\u5B8C\u5168\u6C92\u6709\u505C\u4E0B\u4F86\u7684\u52E2\u982D\uFF0C\u570B\u5BB6\u4E0A\u4E0B\u90FD\u5728\u6050\u614C\u4E4B\u4E2D\u3002"
    - language: 2
      text: Leave for where......? The virus is raging, with no sign of slowing down.
        The whole country is in a panic.
    - language: 3
      text: "\u3069\u3053\u3078......\uFF1F\u3000\u30A6\u30A4\u30EB\u30B9\u306F\u731B\u5A01\u3092\u632F\u308B\u3044\u3001\u53CE\u307E\u308B\u6C17\u914D\u306F\u307E\u308B\u3067\u306A\u3044\u3002\u56FD\u4E2D\u304C\u6050\u6016\u306B\u5305\u307E\u308C\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uC5B4\uB514\uB85C......? \uBC14\uC774\uB7EC\uC2A4\uB294 \uAE30\uC2B9\uC744
        \uBD80\uB9AC\uBA70 \uBA48\uCD9C \uAE30\uBBF8\uB3C4 \uC5C6\uB2E4. \uB098\uB77C
        \uC804\uCCB4\uAC00 \uACF5\uD3EC\uC5D0 \uBE60\uC838 \uC788\uB2E4."
    - language: 5
      text: "Partir o\xF9...... ? Le virus fait rage et ne semble pas pr\xE8s de
        s'arr\xEAter. Le pays entier est pris de panique."
    - language: 6
      text: "Aber wohin......? Das Virus w\xFCtet ungebremst. Im ganzen Land herrscht
        Panik."
    - language: 7
      text: "\xBFMarcharnos ad\xF3nde......? El virus hace estragos y no da se\xF1ales
        de frenarse. Todo el pa\xEDs est\xE1 sumido en el p\xE1nico."
    - language: 8
      text: "Ir para onde......? O v\xEDrus se alastra sem nenhum sinal de parar.
        O pa\xEDs inteiro est\xE1 em p\xE2nico."
    - language: 9
      text: "\u041A\u0443\u0434\u0430......? \u0412\u0438\u0440\u0443\u0441 \u0441\u0432\u0438\u0440\u0435\u043F\u0441\u0442\u0432\u0443\u0435\u0442
        \u0438 \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
        \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0442\u044C. \u0412\u0441\u044F
        \u0441\u0442\u0440\u0430\u043D\u0430 \u043E\u0445\u0432\u0430\u0447\u0435\u043D\u0430
        \u043F\u0430\u043D\u0438\u043A\u043E\u0439."
  - key: os.memory.1340.text
    values:
    - language: 0
      text: "\u5509...\u4E0D\u53BB\u60F3\u4E86\u3002"
    - language: 1
      text: "\u5509...\u4E0D\u53BB\u60F3\u4E86\u3002"
    - language: 2
      text: Sigh... No use thinking about that.
    - language: 3
      text: "\u306F\u3042...\u8003\u3048\u308B\u306E\u306F\u3084\u3081\u3088\u3046\u3002"
    - language: 4
      text: "\uD558\uC544... \uC0DD\uAC01\uD558\uC9C0 \uB9D0\uC790."
    - language: 5
      text: Ah... Inutile d'y penser.
    - language: 6
      text: "Ach... Nicht dar\xFCber nachdenken."
    - language: 7
      text: Ay... Mejor no pensarlo.
    - language: 8
      text: "Ai... Melhor n\xE3o pensar nisso."
    - language: 9
      text: "\u042D\u0445... \u041D\u0435 \u0431\u0443\u0434\u0443 \u043E\u0431 \u044D\u0442\u043E\u043C
        \u0434\u0443\u043C\u0430\u0442\u044C."
  - key: os.memory.1350.text
    values:
    - language: 0
      text: "\u8FD9\u6761\u4EBA\u884C\u9053\u4EE5\u524D\u6CA1\u6709\u8FD9\u4E48\u5BBD\uFF0C\u73B0\u5728\u90A3\u4E9B\u70E6\u4EBA\u7684\u6905\u5B50\u684C\u5B50\u90FD\u88AB\u632A\u8D70\u4E86\uFF0C\u5730\u4E0A\u5C31\u53EA\u5269\u4E9B\u788E\u73BB\u7483\u548C\u6B8B\u6E23...\u8FD8\u6709\u9057\u9AB8...."
    - language: 1
      text: "\u9019\u689D\u4EBA\u884C\u9053\u4EE5\u524D\u6C92\u6709\u9019\u9EBC\u5BEC\uFF0C\u73FE\u5728\u90A3\u4E9B\u7169\u4EBA\u7684\u6905\u5B50\u684C\u5B50\u90FD\u88AB\u632A\u8D70\u4E86\uFF0C\u5730\u4E0A\u5C31\u53EA\u5269\u4E9B\u788E\u73BB\u7483\u548C\u6B98\u6E23...\u9084\u6709\u907A\u9AB8...."
    - language: 2
      text: This pavement never used to be so wide. All those annoying tables and
        chairs are gone now. There's nothing left on the ground but broken glass
        and debris... and remains....
    - language: 3
      text: "\u3053\u306E\u6B69\u9053\u306F\u3001\u6614\u306F\u3053\u3093\u306A\u306B\u5E83\u304F\u306A\u304B\u3063\u305F\u3002\u90AA\u9B54\u3060\u3063\u305F\u6905\u5B50\u3084\u30C6\u30FC\u30D6\u30EB\u306F\u307F\u3093\u306A\u7247\u3065\u3051\u3089\u308C\u3066\u3001\u5730\u9762\u306B\u306F\u30AC\u30E9\u30B9\u7247\u3068\u74E6\u792B...\u305D\u308C\u306B\u907A\u9AB8\u3057\u304B\u6B8B\u3063\u3066\u3044\u306A\u3044...."
    - language: 4
      text: "\uC774 \uBCF4\uB3C4\uB294 \uC608\uC804\uC5D4 \uC774\uB807\uAC8C \uB113\uC9C0
        \uC54A\uC558\uB2E4. \uAC70\uC2AC\uB9AC\uB358 \uC758\uC790\uC640 \uD0C1\uC790\uB294
        \uC804\uBD80 \uCE58\uC6CC\uC84C\uACE0, \uBC14\uB2E5\uC5D0\uB294 \uC720\uB9AC
        \uC870\uAC01\uACFC \uC794\uD574... \uADF8\uB9AC\uACE0 \uC2DC\uC2E0\uB9CC
        \uB0A8\uC558\uB2E4...."
    - language: 5
      text: "Ce trottoir n'\xE9tait pas aussi large avant. Toutes ces tables et ces
        chaises encombrantes ont disparu. Il ne reste que du verre bris\xE9 et des
        d\xE9bris... et des restes humains...."
    - language: 6
      text: "Fr\xFCher war dieser Gehweg nicht so breit. Die l\xE4stigen Tische und
        St\xFChle sind alle weg. Auf dem Boden liegen nur noch Glasscherben und Tr\xFCmmer...
        und sterbliche \xDCberreste...."
    - language: 7
      text: Antes esta acera no era tan ancha. Ya han retirado aquellas mesas y sillas
        tan molestas. Solo quedan cristales rotos y escombros... y restos humanos....
    - language: 8
      text: "Esta cal\xE7ada n\xE3o era t\xE3o larga. Tiraram todas aquelas mesas
        e cadeiras irritantes. S\xF3 sobraram vidro quebrado e entulho... e restos
        humanos...."
    - language: 9
      text: "\u0420\u0430\u043D\u044C\u0448\u0435 \u0442\u0440\u043E\u0442\u0443\u0430\u0440
        \u043D\u0435 \u0431\u044B\u043B \u0442\u0430\u043A\u0438\u043C \u0448\u0438\u0440\u043E\u043A\u0438\u043C.
        \u0412\u0441\u0435 \u044D\u0442\u0438 \u043D\u0430\u0434\u043E\u0435\u0434\u043B\u0438\u0432\u044B\u0435
        \u0441\u0442\u043E\u043B\u044B \u0438 \u0441\u0442\u0443\u043B\u044C\u044F
        \u0443\u0431\u0440\u0430\u043B\u0438. \u041D\u0430 \u0437\u0435\u043C\u043B\u0435
        \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
        \u0431\u0438\u0442\u043E\u0435 \u0441\u0442\u0435\u043A\u043B\u043E, \u043E\u0431\u043B\u043E\u043C\u043A\u0438...
        \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0435
        \u043E\u0441\u0442\u0430\u043D\u043A\u0438...."
  - key: os.memory.1360.text
    values:
    - language: 0
      text: "\"<color=red>\u5C31\u50CF\u7ED9\u4F60\u51C6\u5907\u7684\u5730\u6BEF\uFF0C\u54C8\u54C8\u54C8\uFF01</color>\""
    - language: 1
      text: "\"<color=red>\u5C31\u50CF\u7D66\u4F60\u6E96\u5099\u7684\u5730\u6BEF\uFF0C\u54C8\u54C8\u54C8\uFF01</color>\""
    - language: 2
      text: '"<color=red>Like a carpet laid out just for you. Hahaha!</color>"'
    - language: 3
      text: "\u300C<color=red>\u3042\u3093\u305F\u306E\u305F\u3081\u306E\u7D68\u6BEF\u307F\u305F\u3044\u306D\u3002\u3042\u306F\u306F\uFF01</color>\u300D"
    - language: 4
      text: "\"<color=red>\uB110 \uC704\uD574 \uAE54\uC544 \uB193\uC740 \uCE74\uD3AB
        \uAC19\uB124. \uD558\uD558\uD558!</color>\""
    - language: 5
      text: "\"<color=red>On dirait un tapis d\xE9roul\xE9 pour toi, hahaha !</color>\""
    - language: 6
      text: "\"<color=red>Wie ein Teppich, eigens f\xFCr dich ausgerollt. Hahaha!</color>\""
    - language: 7
      text: "\"<color=red>Como una alfombra extendida para ti. \xA1Jajaja!</color>\""
    - language: 8
      text: "\"<color=red>\xC9 como um tapete estendido para voc\xEA. Hahaha!</color>\""
    - language: 9
      text: "\"<color=red>\u0421\u043B\u043E\u0432\u043D\u043E \u043A\u043E\u0432\u0451\u0440
        \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
        \u0442\u0435\u0431\u044F \u043F\u043E\u0441\u0442\u0435\u043B\u0438\u043B\u0438.
        \u0425\u0430-\u0445\u0430-\u0445\u0430!</color>\""
  - key: os.memory.1370.text
    values:
    - language: 0
      text: "\u5979\u53C8\u5728\u8BF4\u8BDD\u4E86...\u5509\uFF0C\u6700\u8FD1\u5979\u8D8A\u6765\u8D8A\u6D3B\u8DC3\u4E86...\"\u95ED\u5634\uFF0C\u4F60\u592A\u8052\u566A\u4E86\u3002\"\u6211\u6697\u9A82\u4E86\u5979\u51E0\u53E5\u3002"
    - language: 1
      text: "\u5979\u53C8\u5728\u8AAA\u8A71\u4E86...\u5509\uFF0C\u6700\u8FD1\u5979\u8D8A\u4F86\u8D8A\u6D3B\u8E8D\u4E86...\"\u9589\u5634\uFF0C\u4F60\u592A\u8052\u566A\u4E86\u3002\"\u6211\u6697\u7F75\u4E86\u5979\u5E7E\u53E5\u3002"
    - language: 2
      text: She's talking again... Sigh. She's been getting more and more active
        lately... "Shut up. You're too damn noisy." I curse her under my breath.
    - language: 3
      text: "\u307E\u305F\u558B\u3063\u3066\u3044\u308B...\u306F\u3042\u3001\u6700\u8FD1\u307E\u3059\u307E\u3059\u6D3B\u767A\u306B\u306A\u3063\u3066\u304D\u305F...\u300C\u9ED9\u3063\u3066\u3002\u3046\u308B\u3055\u3059\u304E\u308B\u306E\u3088\u300D\u5C0F\u58F0\u3067\u4F55\u5EA6\u304B\u7F75\u3063\u305F\u3002"
    - language: 4
      text: "\uB610 \uB9D0\uC744 \uAC74\uB2E4... \uD558\uC544, \uC694\uC998 \uB4E4\uC5B4
        \uC810\uC810 \uB354 \uD65C\uBC1C\uD574\uC9C4\uB2E4... \"\uB2E5\uCCD0. \uB108\uBB34
        \uC2DC\uB044\uB7EC\uC6CC.\" \uB098\uB294 \uC791\uAC8C \uC695\uC744 \uBA87
        \uB9C8\uB514 \uB0B4\uBC49\uB294\uB2E4."
    - language: 5
      text: "Elle recommence \xE0 parler... Ah, elle se manifeste de plus en plus
        ces derniers temps... \"Tais-toi. Tu me casses les oreilles.\" Je lui lance
        quelques insultes entre mes dents."
    - language: 6
      text: "Sie redet schon wieder... Ach, in letzter Zeit meldet sie sich immer
        h\xE4ufiger... \"Halt den Mund. Du bist unertr\xE4glich laut.\" Ich fluche
        leise vor mich hin."
    - language: 7
      text: "Ya est\xE1 hablando otra vez... Ay, \xFAltimamente se manifiesta cada
        vez m\xE1s... \"C\xE1llate. No hay quien te aguante.\" Le suelto unas maldiciones
        entre dientes."
    - language: 8
      text: "Ela voltou a falar... Ai, anda cada vez mais ativa ultimamente... \"Cala
        a boca. Voc\xEA \xE9 barulhenta demais.\" Solto alguns xingamentos entre
        os dentes."
    - language: 9
      text: "\u041E\u043D\u0430 \u043E\u043F\u044F\u0442\u044C \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430...
        \u042D\u0445, \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
        \u0432\u0440\u0435\u043C\u044F \u043E\u043D\u0430 \u0432\u0441\u0451 \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0435...
        \"\u0417\u0430\u0442\u043A\u043D\u0438\u0441\u044C. \u0421\u043B\u0438\u0448\u043A\u043E\u043C
        \u043C\u043D\u043E\u0433\u043E \u0448\u0443\u043C\u0430 \u043E\u0442 \u0442\u0435\u0431\u044F\".
        \u042F \u0442\u0438\u0445\u043E \u0440\u0443\u0433\u0430\u044E\u0441\u044C."
  - key: os.memory.1380.text
    values:
    - language: 0
      text: "\u8FD9\u6761\u8857\u4E5F\u6CA1\u5269\u4E0B\u51E0\u4E2A\u4EBA\u4E86\u3002\u6211\u653E\u6162\u811A\u6B65\uFF0C\u60F3\u627E\u4E2A\u80FD\u8BF4\u4E0A\u8BDD\u7684\u4EBA\uFF0C\u53EF\u8FD9\u8DEF\u4E0A\u7684\u60E8\u72B6\u2026\u2026\u5F88\u96BE\u8BF4\u6211\u80FD\u4E0D\u80FD\u9047\u5230\u6B63\u5E38\u4EBA\u3002"
    - language: 1
      text: "\u9019\u689D\u8857\u4E5F\u6C92\u5269\u4E0B\u5E7E\u500B\u4EBA\u4E86\u3002\u6211\u653E\u6162\u8173\u6B65\uFF0C\u60F3\u627E\u500B\u80FD\u8AAA\u4E0A\u8A71\u7684\u4EBA\uFF0C\u53EF\u9019\u8DEF\u4E0A\u7684\u6158\u72C0\u2026\u2026\u5F88\u96E3\u8AAA\u6211\u80FD\u4E0D\u80FD\u9047\u5230\u6B63\u5E38\u4EBA\u3002"
    - language: 2
      text: "There aren't many people left on this street either. I slow down, looking
        for someone I can talk to, but with the state of this place\u2026 I don't
        know if I'll find anyone normal."
    - language: 3
      text: "\u3053\u306E\u901A\u308A\u3082\u3001\u4EBA\u304C\u307B\u3068\u3093\u3069\u3044\u306A\u304F\u306A\u3063\u305F\u3002\u6B69\u307F\u3092\u7DE9\u3081\u3001\u8A71\u304C\u3067\u304D\u305D\u3046\u306A\u4EBA\u3092\u635C\u3059\u3002\u3067\u3082\u3001\u3053\u306E\u9053\u306E\u60E8\u72B6\u3092\u898B\u308B\u3068\u2026\u2026\u307E\u3068\u3082\u306A\u4EBA\u306B\u4F1A\u3048\u308B\u304B\u3069\u3046\u304B\u3082\u5206\u304B\u3089\u306A\u3044\u3002"
    - language: 4
      text: "\uC774 \uAC70\uB9AC\uC5D0\uB3C4 \uB0A8\uC740 \uC0AC\uB78C\uC774 \uBCC4\uB85C
        \uC5C6\uB2E4. \uAC78\uC74C\uC744 \uB2A6\uCD94\uACE0 \uB9D0\uC774\uB77C\uB3C4
        \uB098\uB20C \uC0AC\uB78C\uC744 \uCC3E\uC544\uBCF8\uB2E4. \uD558\uC9C0\uB9CC
        \uC774 \uCC38\uD639\uD55C \uAC70\uB9AC\uC5D0\uC11C\u2026\u2026 \uC81C\uC815\uC2E0\uC778
        \uC0AC\uB78C\uC744 \uB9CC\uB0A0 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB974\uACA0\uB2E4."
    - language: 5
      text: "Il ne reste plus grand monde dans cette rue. Je ralentis le pas, cherchant
        quelqu'un \xE0 qui parler, mais vu l'\xE9tat de la rue\u2026 difficile de
        savoir si je vais rencontrer quelqu'un de normal."
    - language: 6
      text: "In dieser Stra\xDFe sind auch kaum noch Menschen \xFCbrig. Ich verlangsame
        meine Schritte und suche jemanden, mit dem ich reden kann. Aber bei dem Elend
        auf dieser Stra\xDFe\u2026 wer wei\xDF, ob ich \xFCberhaupt einem normalen
        Menschen begegne."
    - language: 7
      text: "En esta calle tampoco queda mucha gente. Aflojo el paso, buscando a
        alguien con quien hablar, pero viendo c\xF3mo est\xE1 todo\u2026 no s\xE9
        si encontrar\xE9 a alguien normal."
    - language: 8
      text: "Tamb\xE9m n\xE3o sobrou muita gente nesta rua. Diminuo o passo, procurando
        algu\xE9m com quem conversar, mas vendo o estado deste lugar\u2026 nem sei
        se vou encontrar algu\xE9m normal."
    - language: 9
      text: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u0443\u043B\u0438\u0446\u0435
        \u0442\u043E\u0436\u0435 \u043F\u043E\u0447\u0442\u0438 \u043D\u0438\u043A\u043E\u0433\u043E
        \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C. \u042F \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E
        \u0448\u0430\u0433, \u0438\u0449\u0443, \u0441 \u043A\u0435\u043C \u0431\u044B
        \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043D\u043E
        \u043F\u0440\u0438 \u0432\u0438\u0434\u0435 \u044D\u0442\u043E\u0433\u043E
        \u0443\u0436\u0430\u0441\u0430\u2026 \u0442\u0440\u0443\u0434\u043D\u043E
        \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0432\u0441\u0442\u0440\u0435\u0447\u0443
        \u043B\u0438 \u044F \u0445\u043E\u0442\u044C \u043A\u043E\u0433\u043E-\u0442\u043E
        \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E."
  - key: os.memory.1390.text
    values:
    - language: 0
      text: ......
    - language: 1
      text: ......
    - language: 2
      text: ......
    - language: 3
      text: ......
    - language: 4
      text: ......
    - language: 5
      text: ......
    - language: 6
      text: ......
    - language: 7
      text: ......
    - language: 8
      text: ......
    - language: 9
      text: ......
  - key: os.memory.1400.text
    values:
    - language: 0
      text: "\u524D\u9762\u7F8E\u5BB9\u5E97\u7684\u62DB\u724C\u5782\u4E0B\u6765\u534A\u5757\uFF0C\u867D\u7136\u4E0D\u788D\u7740\u8DEF\uFF0C\u4F46\u5B83\u88AB\u98CE\u5439\u7740\u5431\u5440\u5431\u5440\u7684...\u6211\u5F53\u7136\u8BB0\u5F97\u8FD9\u5BB6\u5E97."
    - language: 1
      text: "\u524D\u9762\u7F8E\u5BB9\u5E97\u7684\u62DB\u724C\u5782\u4E0B\u4F86\u534A\u584A\uFF0C\u96D6\u7136\u4E0D\u7919\u8457\u8DEF\uFF0C\u4F46\u5B83\u88AB\u98A8\u5439\u8457\u5431\u5440\u5431\u5440\u7684...\u6211\u7576\u7136\u8A18\u5F97\u9019\u5BB6\u5E97."
    - language: 2
      text: Half the sign over the beauty salon ahead has come loose. It isn't blocking
        the way, but it creaks and creaks in the wind... Of course I remember this
        place.
    - language: 3
      text: "\u524D\u65B9\u306E\u7F8E\u5BB9\u5BA4\u306E\u770B\u677F\u304C\u3001\u534A\u5206\u5916\u308C\u3066\u5782\u308C\u4E0B\u304C\u3063\u3066\u3044\u308B\u3002\u9053\u306F\u585E\u3044\u3067\u3044\u306A\u3044\u3051\u308C\u3069\u3001\u98A8\u306B\u5439\u304B\u308C\u3066\u304E\u3044\u304E\u3044\u9CF4\u308B...\u3082\u3061\u308D\u3093\u3001\u3053\u306E\u5E97\u306F\u899A\u3048\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uC55E\uCABD \uBBF8\uC6A9\uC2E4 \uAC04\uD310\uC758 \uC808\uBC18\uC774
        \uB5A8\uC5B4\uC838 \uB9E4\uB2EC\uB824 \uC788\uB2E4. \uAE38\uC744 \uB9C9\uC9C0\uB294
        \uC54A\uC9C0\uB9CC \uBC14\uB78C\uC5D0 \uC090\uAC71\uC090\uAC71 \uC18C\uB9AC\uAC00
        \uB09C\uB2E4... \uB2F9\uC5F0\uD788 \uAE30\uC5B5\uD558\uB294 \uAC00\uAC8C\uB2E4."
    - language: 5
      text: "La moiti\xE9 de l'enseigne du salon de beaut\xE9 pend devant moi. Elle
        ne g\xEAne pas le passage, mais elle grince sans arr\xEAt dans le vent...
        Bien s\xFBr que je me souviens de cet endroit."
    - language: 6
      text: "Vom Schild des Sch\xF6nheitssalons vor mir h\xE4ngt die H\xE4lfte herunter.
        Es versperrt nicht den Weg, knarrt aber unaufh\xF6rlich im Wind... Nat\xFCrlich
        erinnere ich mich an diesen Laden."
    - language: 7
      text: "La mitad del letrero del sal\xF3n de belleza de delante cuelga suelta.
        No estorba el paso, pero no deja de chirriar con el viento... Claro que recuerdo
        este sitio."
    - language: 8
      text: "Metade da placa do sal\xE3o de beleza est\xE1 pendurada l\xE1 na frente.
        N\xE3o atrapalha a passagem, mas fica rangendo com o vento... Claro que me
        lembro deste lugar."
    - language: 9
      text: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0432\u044B\u0432\u0435\u0441\u043A\u0438
        \u0441\u0430\u043B\u043E\u043D\u0430 \u043A\u0440\u0430\u0441\u043E\u0442\u044B
        \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u043E\u0442\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C
        \u0438 \u0441\u0432\u0438\u0441\u0430\u0435\u0442. \u041F\u0440\u043E\u0445\u043E\u0434\u0443
        \u043D\u0435 \u043C\u0435\u0448\u0430\u0435\u0442, \u0437\u0430\u0442\u043E
        \u0441\u043A\u0440\u0438\u043F\u0438\u0442 \u0438 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
        \u043D\u0430 \u0432\u0435\u0442\u0440\u0443... \u041A\u043E\u043D\u0435\u0447\u043D\u043E,
        \u044F \u043F\u043E\u043C\u043D\u044E \u044D\u0442\u043E\u0442 \u0441\u0430\u043B\u043E\u043D."
  - key: os.memory.1410.text
    values:
    - language: 0
      text: "\u5973\u513F\u65F6\u5E38\u62C9\u7740\u6211\u6765\u8FD9\uFF0C\u8981\u8BD5\u8BD5\u5404\u79CD\u5404\u6837\u7684\u5934\u53D1......\u5F53\u7136.\u5979\u8BF4\u6211\u603B\u80FD\u628A\u8BDD\u804A\u5F97\u5F88\u6CA1\u610F\u601D\u3002"
    - language: 1
      text: "\u5973\u5152\u6642\u5E38\u62C9\u8457\u6211\u4F86\u9019\uFF0C\u8981\u8A66\u8A66\u5404\u7A2E\u5404\u6A23\u7684\u982D\u9AEE......\u7576\u7136.\u5979\u8AAA\u6211\u7E3D\u80FD\u628A\u8A71\u804A\u5F97\u5F88\u6C92\u610F\u601D\u3002"
    - language: 2
      text: My daughter would often drag me here to try all sorts of hairstyles......
        Naturally, she said I could make any conversation boring.
    - language: 3
      text: "\u5A18\u306F\u3088\u304F\u3001\u3044\u308D\u3093\u306A\u9AEA\u578B\u3092\u8A66\u3057\u305F\u3044\u3068\u79C1\u3092\u3053\u3053\u3078\u5F15\u3063\u5F35\u3063\u3066\u304D\u305F......\u3082\u3061\u308D\u3093\u3001\u79C1\u3068\u8A71\u3059\u3068\u4F55\u3067\u3082\u3064\u307E\u3089\u306A\u304F\u306A\u308B\u3001\u3068\u8A00\u308F\u308C\u305F\u3051\u308C\u3069\u3002"
    - language: 4
      text: "\uB538\uC740 \uC628\uAC16 \uBA38\uB9AC \uBAA8\uC591\uC744 \uD574 \uBCF4\uACE0
        \uC2F6\uB2E4\uBA70 \uB098\uB97C \uC790\uC8FC \uC5EC\uAE30\uB85C \uB04C\uACE0
        \uC654\uB2E4...... \uBB3C\uB860, \uB098\uB294 \uC5B4\uB5A4 \uB300\uD654\uB4E0
        \uC7AC\uBBF8\uC5C6\uAC8C \uB9CC\uB4E0\uB2E4\uACE0 \uD588\uB2E4."
    - language: 5
      text: "Ma fille m'y tra\xEEnait souvent pour essayer toutes sortes de coiffures......
        \xC9videmment, elle disait que je savais rendre n'importe quelle conversation
        ennuyeuse."
    - language: 6
      text: "Meine Tochter schleppte mich oft her, um alle m\xF6glichen Frisuren
        auszuprobieren...... Nat\xFCrlich meinte sie, ich k\xF6nnte jedes Gespr\xE4ch
        langweilig machen."
    - language: 7
      text: "Mi hija sol\xEDa arrastrarme aqu\xED para probar toda clase de peinados......
        Naturalmente, dec\xEDa que yo consegu\xEDa volver aburrida cualquier conversaci\xF3n."
    - language: 8
      text: "Minha filha vivia me arrastando aqui para experimentar todo tipo de
        penteado...... Claro, ela dizia que eu conseguia deixar qualquer conversa
        sem gra\xE7a."
    - language: 9
      text: "\u0414\u043E\u0447\u044C \u0447\u0430\u0441\u0442\u043E \u0442\u0430\u0449\u0438\u043B\u0430
        \u043C\u0435\u043D\u044F \u0441\u044E\u0434\u0430 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
        \u0432\u0441\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435
        \u043F\u0440\u0438\u0447\u0451\u0441\u043A\u0438...... \u041F\u0440\u0430\u0432\u0434\u0430,
        \u043E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E
        \u044F \u0443\u043C\u0435\u044E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
        \u0441\u043A\u0443\u0447\u043D\u044B\u043C \u043B\u044E\u0431\u043E\u0439
        \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440."
  - key: os.memory.1410.option.1
    values:
    - language: 0
      text: "\u60F3\u60F3\u5979\u4E0A\u6B21\u6765\u8FD9\u91CC\u65F6\u7684\u6837\u5B50"
    - language: 1
      text: "\u60F3\u60F3\u5979\u4E0A\u6B21\u4F86\u9019\u88E1\u6642\u7684\u6A23\u5B50"
    - language: 2
      text: Think back to her last visit here
    - language: 3
      text: "\u524D\u306B\u3053\u3053\u3078\u6765\u305F\u5A18\u306E\u59FF\u3092\u601D\u3044\u51FA\u3059"
    - language: 4
      text: "\uC9C0\uB09C\uBC88 \uC5EC\uAE30 \uC654\uC744 \uB54C\uC758 \uB538\uC744
        \uB5A0\uC62C\uB9B0\uB2E4"
    - language: 5
      text: "Repenser \xE0 sa derni\xE8re visite ici"
    - language: 6
      text: An ihren letzten Besuch hier denken
    - language: 7
      text: "Recordar su \xFAltima visita aqu\xED"
    - language: 8
      text: "Lembrar da \xFAltima visita dela aqui"
    - language: 9
      text: "\u0412\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0435\u0451
        \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0432\u0438\u0437\u0438\u0442
        \u0441\u044E\u0434\u0430"
  - key: os.memory.1420.text
    values:
    - language: 0
      text: "\u6211\u4ECE\u65C1\u8FB9\u7ECF\u8FC7\uFF0C\u5E97\u9762\u4E0A\u5269\u4E0B\u7684\u534A\u6247\u73BB\u7483\u91CC\uFF0C
        \u6620\u5C04\u51FA\u4E00\u5F20\u4EBA\u8138\u3002\u6211\u5F80\u540E\u632A\u4E86\u4E00\u6B65\uFF0C\u73BB\u7483\u91CC\u7684\u4EBA\u4E5F\u9000\u4E86\u70B9\u3002"
    - language: 1
      text: "\u6211\u5F9E\u65C1\u908A\u7D93\u904E\uFF0C\u5E97\u9762\u4E0A\u5269\u4E0B\u7684\u534A\u6247\u73BB\u7483\u88E1\uFF0C
        \u6620\u51FA\u4E00\u5F35\u4EBA\u81C9\u3002\u6211\u5F80\u5F8C\u632A\u4E86\u4E00\u6B65\uFF0C\u73BB\u7483\u88E1\u7684\u4EBA\u4E5F\u9000\u4E86\u9EDE\u3002"
    - language: 2
      text: As I pass, a face appears in the half-pane of glass still standing in
        the shopfront. I take a step back. The person in the glass retreats a little
        too.
    - language: 3
      text: "\u5E97\u306E\u6A2A\u3092\u901A\u308B\u3068\u3001\u534A\u5206\u3060\u3051\u6B8B\u3063\u305F\u30AC\u30E9\u30B9\u306B\u4EBA\u306E\u9854\u304C\u6620\u3063\u305F\u3002\u4E00\u6B69\u4E0B\u304C\u308B\u3002\u30AC\u30E9\u30B9\u306E\u4E2D\u306E\u4EBA\u3082\u5C11\u3057\u4E0B\u304C\u3063\u305F\u3002"
    - language: 4
      text: "\uC606\uC744 \uC9C0\uB098\uC790 \uAC00\uAC8C \uC55E\uC5D0 \uBC18\uCBE4
        \uB0A8\uC740 \uC720\uB9AC\uCC3D\uC5D0 \uC0AC\uB78C \uC5BC\uAD74\uC774 \uBE44\uCE5C\uB2E4.
        \uD55C \uBC1C\uC9DD \uBB3C\uB7EC\uC11C\uC790 \uC720\uB9AC \uC18D \uC0AC\uB78C\uB3C4
        \uC870\uAE08 \uB4A4\uB85C \uBB3C\uB7EC\uB09C\uB2E4."
    - language: 5
      text: "En passant, j'aper\xE7ois un visage dans la moiti\xE9 de vitre qui reste
        \xE0 la devanture. Je recule d'un pas. La personne dans la vitre recule un
        peu aussi."
    - language: 6
      text: "Als ich vorbeigehe, erscheint in der halben Scheibe, die noch in der
        Ladenfront steckt, ein Gesicht. Ich trete einen Schritt zur\xFCck. Die Person
        im Glas weicht ebenfalls etwas zur\xFCck."
    - language: 7
      text: "Al pasar, aparece una cara reflejada en la mitad de cristal que queda
        en el escaparate. Retrocedo un paso. La persona del cristal tambi\xE9n retrocede
        un poco."
    - language: 8
      text: "Ao passar, vejo um rosto refletido na metade de vidro que resta na fachada.
        Dou um passo para tr\xE1s. A pessoa no vidro tamb\xE9m recua um pouco."
    - language: 9
      text: "\u041A\u043E\u0433\u0434\u0430 \u044F \u043F\u0440\u043E\u0445\u043E\u0436\u0443
        \u043C\u0438\u043C\u043E, \u0432 \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0435\u0439
        \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 \u0432\u0438\u0442\u0440\u0438\u043D\u043D\u043E\u0433\u043E
        \u0441\u0442\u0435\u043A\u043B\u0430 \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F
        \u043B\u0438\u0446\u043E. \u042F \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u044E
        \u043D\u0430 \u0448\u0430\u0433. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
        \u0432 \u0441\u0442\u0435\u043A\u043B\u0435 \u0442\u043E\u0436\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442."
  - key: os.memory.1430.text
    values:
    - language: 0
      text: "\u5934\u53D1\u4E71\u7684\u548C\u65E9\u4E0A\u8D77\u5E8A\u6CA1\u533A\u522B\uFF0C\u955C\u5B50\u91CC\u7684\u5973\u4EBA\u6C14\u8272\u4E5F\u4E0D\u600E\u4E48\u6837...\u6BD5\u7ADF\u8EAB\u4F53\u672C\u6765\u5C31\u4E0D\u592A\u597D\uFF0C\u8FD9\u4E9B\u5929\u7684\u4F11\u606F\u4E5F\u7CDF\u7CD5\u5F97\u8981\u6B7B\u3002"
    - language: 1
      text: "\u982D\u9AEE\u4E82\u7684\u548C\u65E9\u4E0A\u8D77\u5E8A\u6C92\u5340\u5225\uFF0C\u93E1\u5B50\u88E1\u7684\u5973\u4EBA\u6C23\u8272\u4E5F\u4E0D\u600E\u9EBC\u6A23...\u7562\u7ADF\u8EAB\u9AD4\u672C\u4F86\u5C31\u4E0D\u592A\u597D\uFF0C\u9019\u4E9B\u5929\u7684\u4F11\u606F\u4E5F\u7CDF\u7CD5\u5F97\u8981\u6B7B\u3002"
    - language: 2
      text: My hair is as much of a mess as it was when I got up. The woman in the
        reflection doesn't look well either... My health was never great, and I've
        been sleeping like hell these past few days.
    - language: 3
      text: "\u9AEA\u306F\u671D\u8D77\u304D\u305F\u3068\u304D\u3068\u540C\u3058\u304F\u3089\u3044\u4E71\u308C\u3066\u3044\u308B\u3002\u6620\u3063\u305F\u5973\u306E\u9854\u8272\u3082\u3088\u304F\u306A\u3044...\u3082\u3068\u3082\u3068\u4E08\u592B\u306A\u4F53\u3067\u306F\u306A\u3044\u3057\u3001\u3053\u3053\u6570\u65E5\u306F\u308D\u304F\u306B\u4F11\u3081\u3066\u3082\u3044\u306A\u3044\u3002"
    - language: 4
      text: "\uBA38\uB9AC\uB294 \uC544\uCE68\uC5D0 \uC77C\uC5B4\uB0AC\uC744 \uB54C\uB098
        \uB2E4\uB984\uC5C6\uC774 \uC5C9\uB9DD\uC774\uB2E4. \uBE44\uCE5C \uC5EC\uC790\uC758
        \uC548\uC0C9\uB3C4 \uC88B\uC9C0 \uC54A\uB2E4... \uC6D0\uB798 \uBAB8\uC774
        \uD2BC\uD2BC\uD558\uC9C0\uB3C4 \uC54A\uC740 \uB370\uB2E4, \uBA70\uCE60 \uB3D9\uC548
        \uC81C\uB300\uB85C \uC26C\uC9C0\uB3C4 \uBABB\uD588\uB2E4."
    - language: 5
      text: "Mes cheveux sont aussi en bataille qu'au r\xE9veil. La femme dans le
        reflet n'a pas bonne mine non plus... Ma sant\xE9 n'a jamais \xE9t\xE9 brillante,
        et je dors affreusement mal depuis quelques jours."
    - language: 6
      text: Meine Haare sind so zerzaust wie beim Aufstehen. Die Frau im Spiegelbild
        sieht auch sonst nicht gut aus... Meine Gesundheit war nie die beste, und
        in den letzten Tagen habe ich miserabel geschlafen.
    - language: 7
      text: "Tengo el pelo tan revuelto como cuando me levant\xE9. La mujer del reflejo
        tampoco tiene buen aspecto... Nunca he tenido una salud estupenda, y estos
        d\xEDas he descansado fatal."
    - language: 8
      text: "Meu cabelo est\xE1 t\xE3o bagun\xE7ado quanto quando acordei. A mulher
        no reflexo tamb\xE9m n\xE3o parece nada bem... Minha sa\xFAde nunca foi grande
        coisa, e tenho descansado muito mal nestes dias."
    - language: 9
      text: "\u0412\u043E\u043B\u043E\u0441\u044B \u0440\u0430\u0441\u0442\u0440\u0451\u043F\u0430\u043D\u044B
        \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0443\u0442\u0440\u043E\u043C
        \u043F\u043E\u0441\u043B\u0435 \u0441\u043D\u0430. \u0414\u0430 \u0438 \u0446\u0432\u0435\u0442
        \u043B\u0438\u0446\u0430 \u0443 \u0436\u0435\u043D\u0449\u0438\u043D\u044B
        \u0432 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0438 \u043D\u0435\u0437\u0434\u043E\u0440\u043E\u0432\u044B\u0439...
        \u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0443 \u043C\u0435\u043D\u044F
        \u0438 \u0442\u0430\u043A \u043D\u0435\u0432\u0430\u0436\u043D\u043E\u0435,
        \u0430 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u043D\u0438
        \u044F \u043E\u0442\u0434\u044B\u0445\u0430\u044E \u043F\u0440\u043E\u0441\u0442\u043E
        \u0443\u0436\u0430\u0441\u043D\u043E."
  - key: os.memory.1440.text
    values:
    - language: 0
      text: "\u773C\u775B\u91CC\u5168\u662F\u8840\u4E1D\uFF0C\u8981\u6211\u8BF4\uFF0C\u8FD8\u4E0D\u5982\u5F97\u4E86\u90A3\u5FC3\u810F\u75C5\u6BD2\u5462\u3002\u597D\u6B79\u542C\u8BF4\u517D\u5316\u4E4B\u540E\u8EAB\u4F53\u4F1A\u786C\u6717\u4E0D\u5C11..."
    - language: 1
      text: "\u773C\u775B\u88E1\u5168\u662F\u8840\u7D72\uFF0C\u8981\u6211\u8AAA\uFF0C\u9084\u4E0D\u5982\u5F97\u4E86\u90A3\u5FC3\u81DF\u75C5\u6BD2\u5462\u3002\u597D\u6B79\u807D\u8AAA\u7378\u5316\u4E4B\u5F8C\u8EAB\u9AD4\u6703\u786C\u6717\u4E0D\u5C11..."
    - language: 2
      text: My eyes are bloodshot. Honestly, I might be better off catching that
        heart virus. At least they say beastification makes you a good deal stronger...
    - language: 3
      text: "\u76EE\u306F\u8840\u8D70\u3063\u3066\u3044\u308B\u3002\u3044\u3063\u305D\u5FC3\u81D3\u30A6\u30A4\u30EB\u30B9\u306B\u611F\u67D3\u3057\u305F\u307B\u3046\u304C\u307E\u3057\u3060\u3002\u7363\u5316\u3059\u308C\u3070\u3001\u4F53\u304C\u305A\u3063\u3068\u4E08\u592B\u306B\u306A\u308B\u3068\u805E\u304F\u3057..."
    - language: 4
      text: "\uB208\uC5D0\uB294 \uD54F\uBC1C\uC774 \uAC00\uB4DD\uD558\uB2E4. \uCC28\uB77C\uB9AC
        \uADF8 \uC2EC\uC7A5 \uBC14\uC774\uB7EC\uC2A4\uC5D0 \uAC78\uB9AC\uB294 \uAC8C
        \uB0AB\uACA0\uB2E4. \uC57C\uC218\uD654\uD558\uBA74 \uBAB8\uC740 \uD6E8\uC52C
        \uD2BC\uD2BC\uD574\uC9C4\uB2E4\uB358\uB370..."
    - language: 5
      text: "J'ai les yeux inject\xE9s de sang. Franchement, autant attraper ce virus
        cardiaque. Il para\xEEt qu'au moins, la bestialisation rend bien plus robuste..."
    - language: 6
      text: "Meine Augen sind blutunterlaufen. Ehrlich gesagt w\xE4re mir das Herzvirus
        fast lieber. Angeblich wird man durch die Bestialisierung wenigstens deutlich
        kr\xE4ftiger..."
    - language: 7
      text: "Tengo los ojos inyectados en sangre. La verdad, casi ser\xEDa mejor
        contraer ese virus card\xEDaco. Por lo menos dicen que la bestializaci\xF3n
        te vuelve bastante m\xE1s fuerte..."
    - language: 8
      text: "Meus olhos est\xE3o cheios de veias vermelhas. Sinceramente, quase seria
        melhor pegar aquele v\xEDrus card\xEDaco. Pelo menos dizem que a bestializa\xE7\xE3o
        deixa o corpo bem mais forte..."
    - language: 9
      text: "\u0413\u043B\u0430\u0437\u0430 \u043D\u0430\u043B\u0438\u0442\u044B
        \u043A\u0440\u043E\u0432\u044C\u044E. \u0427\u0435\u0441\u0442\u043D\u043E
        \u0433\u043E\u0432\u043E\u0440\u044F, \u043B\u0443\u0447\u0448\u0435 \u0431\u044B
        \u0443\u0436 \u0437\u0430\u0440\u0430\u0437\u0438\u043B\u0430\u0441\u044C
        \u0442\u0435\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u043C
        \u0432\u0438\u0440\u0443\u0441\u043E\u043C. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
        \u043F\u043E\u0441\u043B\u0435 \u043E\u0437\u0432\u0435\u0440\u0435\u043D\u0438\u044F
        \u0442\u0435\u043B\u043E \u0445\u043E\u0442\u044F \u0431\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043A\u0440\u0435\u043F\u0447\u0435..."
  - key: os.memory.1450.text
    values:
    - language: 0
      text: "\u5C31\u8FD9\u6837\u5427\uFF0C\u6211\u62E8\u4E86\u62E8\u5934\u53D1\uFF0C\u603B\u4E0D\u80FD\u627E\u5230\u5973\u513F\u7684\u65F6\u5019\u81EA\u5DF1\u8FD8\u50CF\u4E2A\u62AB\u5934\u6563\u53D1\u7684\u5973\u75AF\u5B50\u3002"
    - language: 1
      text: "\u5C31\u9019\u6A23\u5427\uFF0C\u6211\u64A5\u4E86\u64A5\u982D\u9AEE\uFF0C\u7E3D\u4E0D\u80FD\u627E\u5230\u5973\u5152\u7684\u6642\u5019\u81EA\u5DF1\u9084\u50CF\u500B\u62AB\u982D\u6563\u9AEE\u7684\u5973\u760B\u5B50\u3002"
    - language: 2
      text: That'll have to do. I smooth my hair a little. I can't look like some
        wild-haired madwoman when I finally find my daughter.
    - language: 3
      text: "\u3053\u3093\u306A\u3082\u306E\u304B\u3002\u9AEA\u3092\u5C11\u3057\u6574\u3048\u308B\u3002\u5A18\u3092\u898B\u3064\u3051\u305F\u3068\u304D\u307E\u3067\u3001\u9AEA\u3092\u632F\u308A\u4E71\u3057\u305F\u72C2\u5973\u307F\u305F\u3044\u306A\u59FF\u3067\u306F\u3044\u3089\u308C\u306A\u3044\u3002"
    - language: 4
      text: "\uC774 \uC815\uB3C4\uBA74 \uB410\uB2E4. \uBA38\uB9AC\uB97C \uC870\uAE08
        \uC815\uB3C8\uD55C\uB2E4. \uB538\uC744 \uCC3E\uC558\uC744 \uB54C\uAE4C\uC9C0
        \uBA38\uB9AC\uB97C \uD480\uC5B4\uD5E4\uCE5C \uBBF8\uCE5C \uC5EC\uC790 \uAF34\uC77C
        \uC218\uB294 \uC5C6\uC73C\uB2C8\uAE4C."
    - language: 5
      text: "\xC7a fera l'affaire. Je remets mes cheveux en place. Je ne peux pas
        avoir l'air d'une folle \xE9chevel\xE9e quand je retrouverai enfin ma fille."
    - language: 6
      text: "Das muss reichen. Ich streiche mir die Haare zurecht. Wenn ich meine
        Tochter finde, kann ich doch nicht wie eine wilde, zerzauste Verr\xFCckte
        aussehen."
    - language: 7
      text: "As\xED est\xE1 bien. Me arreglo un poco el pelo. No puedo parecer una
        loca desgre\xF1ada cuando por fin encuentre a mi hija."
    - language: 8
      text: "Assim est\xE1 bom. Arrumo um pouco o cabelo. N\xE3o posso parecer uma
        louca descabelada quando finalmente encontrar minha filha."
    - language: 9
      text: "\u0421\u043E\u0439\u0434\u0451\u0442. \u042F \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u043F\u0440\u0438\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u044E \u0432\u043E\u043B\u043E\u0441\u044B.
        \u041D\u0435 \u043C\u043E\u0433\u0443 \u0436\u0435 \u044F \u043F\u0440\u0438
        \u0432\u0441\u0442\u0440\u0435\u0447\u0435 \u0441 \u0434\u043E\u0447\u0435\u0440\u044C\u044E
        \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0440\u0430\u0441\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u0439
        \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0435\u0439."
  - key: os.memory.1460.text
    values:
    - language: 0
      text: "\u5F80\u524D\u7684\u5899\u4E0A\u8D34\u4E86\u51E0\u5F20\u65B0\u8D34\u7684\u4FBF\u6761\uFF0C\u4E0A\u9762\u8BB0\u5F55\u4E86\u4E00\u4E2A......\u5E87\u62A4\u6240?\u770B\u8D77\u6765\u66F4\u50CF\u662F\u4E00\u4E2A\u5783\u573E\u573A..."
    - language: 1
      text: "\u5F80\u524D\u7684\u7246\u4E0A\u8CBC\u4E86\u5E7E\u5F35\u65B0\u8CBC\u7684\u4FBF\u689D\uFF0C\u4E0A\u9762\u8A18\u9304\u4E86\u4E00\u500B......\u5E87\u8B77\u6240?\u770B\u8D77\u4F86\u66F4\u50CF\u662F\u4E00\u500B\u5783\u573E\u5834..."
    - language: 2
      text: A few fresh notices are pasted on the wall ahead. They mention a......
        shelter? It looks more like a rubbish dump...
    - language: 3
      text: "\u524D\u306E\u58C1\u306B\u3001\u8CBC\u3089\u308C\u305F\u3070\u304B\u308A\u306E\u7D19\u304C\u4F55\u679A\u304B\u3042\u308B\u3002\u66F8\u304B\u308C\u3066\u3044\u308B\u306E\u306F......\u907F\u96E3\u6240\uFF1F\u3000\u30B4\u30DF\u6368\u3066\u5834\u306B\u3057\u304B\u898B\u3048\u306A\u3044\u3051\u308C\u3069..."
    - language: 4
      text: "\uC55E\uCABD \uBCBD\uC5D0 \uC0C8\uB85C \uBD99\uC778 \uCABD\uC9C0 \uBA87
        \uC7A5\uC774 \uBCF4\uC778\uB2E4. \uC801\uD78C \uAC83\uC740...... \uB300\uD53C\uC18C?
        \uC4F0\uB808\uAE30\uC7A5\uC5D0 \uB354 \uAC00\uAE4C\uC6CC \uBCF4\uC774\uB294\uB370..."
    - language: 5
      text: "Quelques annonces toutes fra\xEEches sont coll\xE9es au mur devant moi.
        Elles indiquent un...... refuge ? \xC7a ressemble plut\xF4t \xE0 une d\xE9charge..."
    - language: 6
      text: "An der Mauer vor mir kleben ein paar neue Zettel. Sie weisen auf eine......
        Unterkunft hin? Sieht eher wie eine M\xFCllhalde aus..."
    - language: 7
      text: "En el muro de delante hay unas notas reci\xE9n pegadas. Indican un......
        \xBFrefugio? Parece m\xE1s bien un vertedero..."
    - language: 8
      text: "H\xE1 alguns bilhetes rec\xE9m-colados no muro \xE0 frente. Indicam
        um...... abrigo? Parece mais um lix\xE3o..."
    - language: 9
      text: "\u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0432\u0435\u0436\u0438\u0445
        \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0439. \u0422\u0430\u043C
        \u0443\u043A\u0430\u0437\u0430\u043D\u043E...... \u0443\u0431\u0435\u0436\u0438\u0449\u0435?
        \u0411\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u0445\u043E\u0436\u0435
        \u043D\u0430 \u0441\u0432\u0430\u043B\u043A\u0443..."
  - key: os.memory.1470.text
    values:
    - language: 0
      text: "\u4FBF\u6761\u4E0A\u7684\u7BAD\u5934\u6307\u5411\u5DF7\u5B50\u6DF1\u5904\u3002\u6211\u5F80\u91CC\u9762\u8D70\u4E86\u4E00\u6BB5\uFF0C\u5783\u573E\u8D8A\u6765\u8D8A\u591A\uFF0C\u5012\u662F\u6CA1\u8D70\u9519\u5730\u65B9\u3002"
    - language: 1
      text: "\u4FBF\u689D\u4E0A\u7684\u7BAD\u982D\u6307\u5411\u5DF7\u5B50\u6DF1\u8655\u3002\u6211\u5F80\u88E1\u9762\u8D70\u4E86\u4E00\u6BB5\uFF0C\u5783\u573E\u8D8A\u4F86\u8D8A\u591A\uFF0C\u5012\u662F\u6C92\u8D70\u932F\u5730\u65B9\u3002"
    - language: 2
      text: The arrow on the notice points deeper into the alley. I walk a little
        way in. There's more and more rubbish. Looks like I'm in the right place.
    - language: 3
      text: "\u7D19\u306E\u77E2\u5370\u306F\u8DEF\u5730\u306E\u5965\u3092\u6307\u3057\u3066\u3044\u305F\u3002\u3057\u3070\u3089\u304F\u5165\u3063\u3066\u3044\u304F\u3068\u3001\u30B4\u30DF\u304C\u3069\u3093\u3069\u3093\u5897\u3048\u3066\u304F\u308B\u3002\u5834\u6240\u306F\u9593\u9055\u3063\u3066\u3044\u306A\u3044\u3089\u3057\u3044\u3002"
    - language: 4
      text: "\uCABD\uC9C0\uC758 \uD654\uC0B4\uD45C\uB294 \uACE8\uBAA9 \uC548\uCABD\uC744
        \uAC00\uB9AC\uD0A8\uB2E4. \uC870\uAE08 \uB4E4\uC5B4\uAC00\uC790 \uC4F0\uB808\uAE30\uAC00
        \uC810\uC810 \uB9CE\uC544\uC9C4\uB2E4. \uC798\uBABB \uC628 \uAC74 \uC544\uB2CC
        \uBAA8\uC591\uC774\uB2E4."
    - language: 5
      text: "La fl\xE8che de l'annonce pointe vers le fond de la ruelle. Je m'y enfonce
        un peu. Les ordures se multiplient. Je ne me suis pas tromp\xE9e d'endroit."
    - language: 6
      text: "Der Pfeil zeigt tiefer in die Gasse. Ich gehe ein St\xFCck hinein. Es
        liegt immer mehr M\xFCll herum. Dann bin ich wohl richtig."
    - language: 7
      text: "La flecha apunta al fondo del callej\xF3n. Me adentro un poco. Cada
        vez hay m\xE1s basura; parece que voy por buen camino."
    - language: 8
      text: "A seta aponta para o fundo do beco. Ando um pouco para dentro. O lixo
        s\xF3 aumenta. Ent\xE3o vim ao lugar certo."
    - language: 9
      text: "\u0421\u0442\u0440\u0435\u043B\u043A\u0430 \u043D\u0430 \u043B\u0438\u0441\u0442\u043A\u0435
        \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0432\u0433\u043B\u0443\u0431\u044C
        \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0430. \u041F\u0440\u043E\u0445\u043E\u0436\u0443
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0434\u0430\u043B\u044C\u0448\u0435.
        \u041C\u0443\u0441\u043E\u0440\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435. \u0417\u043D\u0430\u0447\u0438\u0442,
        \u043D\u0435 \u043E\u0448\u0438\u0431\u043B\u0430\u0441\u044C."
  - key: os.memory.1480.text
    values:
    - language: 0
      text: "\u5E87\u62A4\u6240\u7684\u724C\u5B50\u7FFB\u4E86\u4E2A\u9762\uFF0C\u539F\u5148\u5199\u4EC0\u4E48\u5DF2\u7ECF\u770B\u4E0D\u6E05\u4E86\uFF0C\u73B0\u5728\u4E0A\u9762\u6B6A\u6B6A\u626D\u626D\u5730\u5199\u7740\u201C\u4E34\u65F6\u5E87\u62A4\u6240\u201D...\u8FD9\u91CC\u7684\u5473\u9053\u4E0D\u662F\u90A3\u4E48\u597D\u95FB\u3002"
    - language: 1
      text: "\u5E87\u8B77\u6240\u7684\u724C\u5B50\u7FFB\u4E86\u500B\u9762\uFF0C\u539F\u5148\u5BEB\u4EC0\u9EBC\u5DF2\u7D93\u770B\u4E0D\u6E05\u4E86\uFF0C\u73FE\u5728\u4E0A\u9762\u6B6A\u6B6A\u626D\u626D\u5730\u5BEB\u8457\u201C\u81E8\u6642\u5E87\u8B77\u6240\u201D...\u9019\u88E1\u7684\u5473\u9053\u4E0D\u662F\u90A3\u9EBC\u597D\u805E\u3002"
    - language: 2
      text: The shelter's sign has been turned over. I can't make out what it used
        to say. Now 'Temporary Shelter' is scrawled crookedly across it... It doesn't
        smell very nice in here.
    - language: 3
      text: "\u907F\u96E3\u6240\u306E\u770B\u677F\u306F\u88CF\u8FD4\u3055\u308C\u3066\u3044\u305F\u3002\u5143\u306E\u6587\u5B57\u306F\u3082\u3046\u8AAD\u3081\u306A\u3044\u3002\u4ECA\u306F\u300C\u81E8\u6642\u907F\u96E3\u6240\u300D\u3068\u6B6A\u3093\u3060\u5B57\u304C\u66F8\u304B\u308C\u3066\u3044\u308B...\u3042\u307E\u308A\u3044\u3044\u5302\u3044\u306F\u3057\u306A\u3044\u3002"
    - language: 4
      text: "\uB300\uD53C\uC18C \uAC04\uD310\uC740 \uB4A4\uC9D1\uD600 \uC788\uB2E4.
        \uC6D0\uB798 \uAE00\uC790\uB294 \uC54C\uC544\uBCFC \uC218 \uC5C6\uACE0, \uC9C0\uAE08\uC740
        '\uC784\uC2DC \uB300\uD53C\uC18C'\uB77C\uB294 \uAE00\uC528\uAC00 \uC090\uB6A4\uBE7C\uB6A4
        \uC801\uD600 \uC788\uB2E4... \uB0C4\uC0C8\uAC00 \uADF8\uB2E4\uC9C0 \uC88B\uC9C0\uB294
        \uC54A\uB2E4."
    - language: 5
      text: "Le panneau du refuge a \xE9t\xE9 retourn\xE9. L'ancienne inscription
        est illisible. Maintenant, on y a griffonn\xE9 de travers \xAB Refuge temporaire
        \xBB... L'odeur n'est pas tr\xE8s agr\xE9able."
    - language: 6
      text: "Das Schild der Unterkunft wurde umgedreht. Die alte Aufschrift ist nicht
        mehr zu erkennen. Jetzt steht dort krakelig \u201ENotunterkunft\u201C...
        Besonders angenehm riecht es hier nicht."
    - language: 7
      text: "Han dado la vuelta al cartel del refugio. Ya no se distingue qu\xE9
        pon\xEDa antes. Ahora han garabateado \xABRefugio temporal\xBB con letras
        torcidas... Aqu\xED no huele muy bien."
    - language: 8
      text: "Viraram a placa do abrigo. N\xE3o d\xE1 mais para ler o que estava escrito
        antes. Agora tem um \"Abrigo tempor\xE1rio\" rabiscado e torto... O cheiro
        aqui n\xE3o \xE9 dos melhores."
    - language: 9
      text: "\u0422\u0430\u0431\u043B\u0438\u0447\u043A\u0443 \u0443\u0431\u0435\u0436\u0438\u0449\u0430
        \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u0438. \u0421\u0442\u0430\u0440\u0443\u044E
        \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u0443\u0436\u0435 \u043D\u0435
        \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C. \u0422\u0435\u043F\u0435\u0440\u044C
        \u043D\u0430 \u043D\u0435\u0439 \u043A\u0440\u0438\u0432\u043E \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u043E
        \xAB\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0435 \u0443\u0431\u0435\u0436\u0438\u0449\u0435\xBB...
        \u041F\u0430\u0445\u043D\u0435\u0442 \u0437\u0434\u0435\u0441\u044C \u043D\u0435
        \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E."
  - key: os.memory.1480.option.1
    values:
    - language: 0
      text: "\u8FDB\u53BB\u95EE\u95EE"
    - language: 1
      text: "\u9032\u53BB\u554F\u554F"
    - language: 2
      text: Go inside and ask
    - language: 3
      text: "\u4E2D\u3078\u5165\u3063\u3066\u805E\u3044\u3066\u307F\u308B"
    - language: 4
      text: "\uB4E4\uC5B4\uAC00\uC11C \uBB3C\uC5B4\uBCF8\uB2E4"
    - language: 5
      text: Entrer se renseigner
    - language: 6
      text: Hineingehen und nachfragen
    - language: 7
      text: Entrar a preguntar
    - language: 8
      text: Entrar e perguntar
    - language: 9
      text: "\u0417\u0430\u0439\u0442\u0438 \u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C"
  - key: os.memory.1490.text
    values:
    - language: 0
      text: "\u95E8\u6CA1\u5173\u4E25\uFF0C\u88AB\u5730\u4E0A\u7684\u788E\u77F3\u5361\u4F4F\u4E86\u3002\u6211\u4FA7\u8EAB\u6324\u8FDB\u53BB\uFF0C\u91CC\u9762\u770B\u8D77\u6765\u4E71\u7CDF\u7CDF\u7684\uFF0C\u5806\u7740\u7684\u5BB6\u5177\uFF0C\u6563\u843D\u7684\u6728\u677F.."
    - language: 1
      text: "\u9580\u6C92\u95DC\u56B4\uFF0C\u88AB\u5730\u4E0A\u7684\u788E\u77F3\u5361\u4F4F\u4E86\u3002\u6211\u5074\u8EAB\u64E0\u9032\u53BB\uFF0C\u88E1\u9762\u770B\u8D77\u4F86\u4E82\u7CDF\u7CDF\u7684\uFF0C\u5806\u8457\u7684\u50A2\u4FF1\uFF0C\u6563\u843D\u7684\u6728\u677F.."
    - language: 2
      text: 'The door won''t close properly; a stone on the ground is wedged beneath
        it. I squeeze in sideways. It''s a mess inside: piled-up furniture, scattered
        planks...'
    - language: 3
      text: "\u5730\u9762\u306E\u77F3\u304C\u631F\u307E\u3063\u3066\u3001\u6249\u304C\u9589\u307E\u308A\u304D\u3063\u3066\u3044\u306A\u3044\u3002\u6A2A\u5411\u304D\u306B\u306A\u3063\u3066\u5165\u308A\u8FBC\u3080\u3002\u4E2D\u306F\u3054\u3061\u3083\u3054\u3061\u3083\u3060\u3002\u7A4D\u307E\u308C\u305F\u5BB6\u5177\u3001\u6563\u3089\u3070\u3063\u305F\u677F..."
    - language: 4
      text: "\uBB38\uC774 \uBC14\uB2E5\uC758 \uB3CC\uC5D0 \uAC78\uB824 \uC81C\uB300\uB85C
        \uB2EB\uD788\uC9C0 \uC54A\uB294\uB2E4. \uBAB8\uC744 \uC606\uC73C\uB85C \uD2C0\uC5B4
        \uBE44\uC9D1\uACE0 \uB4E4\uC5B4\uAC04\uB2E4. \uC548\uC740 \uC5C9\uB9DD\uC774\uB2E4.
        \uC313\uC544 \uB193\uC740 \uAC00\uAD6C, \uD769\uC5B4\uC9C4 \uB110\uBE64\uC9C0..."
    - language: 5
      text: "La porte ferme mal, bloqu\xE9e par un caillou au sol. Je me glisse de
        c\xF4t\xE9 \xE0 l'int\xE9rieur. Quel d\xE9sordre : des meubles empil\xE9s,
        des planches \xE9parpill\xE9es..."
    - language: 6
      text: "Die T\xFCr geht nicht richtig zu; ein Stein am Boden klemmt darunter.
        Ich zw\xE4nge mich seitlich hinein. Drinnen herrscht Chaos: aufgestapelte
        M\xF6bel, verstreute Bretter..."
    - language: 7
      text: 'La puerta no cierra bien: una piedra del suelo la atasca. Me cuelo de
        lado. Dentro reina el desorden: muebles apilados, tablones por todas partes...'
    - language: 8
      text: "A porta n\xE3o fecha direito, presa por uma pedra no ch\xE3o. Entro
        de lado. L\xE1 dentro est\xE1 tudo uma bagun\xE7a: m\xF3veis empilhados,
        t\xE1buas espalhadas..."
    - language: 9
      text: "\u0414\u0432\u0435\u0440\u044C \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0430
        \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u2014 \u0435\u0439 \u043C\u0435\u0448\u0430\u0435\u0442
        \u043A\u0430\u043C\u0435\u043D\u044C \u043D\u0430 \u0437\u0435\u043C\u043B\u0435.
        \u042F \u043F\u0440\u043E\u0442\u0438\u0441\u043A\u0438\u0432\u0430\u044E\u0441\u044C
        \u0431\u043E\u043A\u043E\u043C. \u0412\u043D\u0443\u0442\u0440\u0438 \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043E\u043A:
        \u043D\u0430\u0432\u0430\u043B\u0435\u043D\u043D\u0430\u044F \u043C\u0435\u0431\u0435\u043B\u044C,
        \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043D\u044B\u0435
        \u0434\u043E\u0441\u043A\u0438..."
  - key: os.memory.1500.text
    values:
    - language: 0
      text: "\"\u6253\u6270\u4E00\u4E0B...\u4F60\u4EEC\u6709\u6CA1\u6709\u89C1\u8FC7\u4E00\u4E2A\u5973\u5B69\uFF1F\u53EF\u80FD\u548C\u4E00\u4E2A\u7537\u5B69\u5728\u4E00\u8D77\uFF0C\u90A3\u4E2A\u7537\u5B69\u53EB\u827E\u4E39\u2026\u2026\u201D"
    - language: 1
      text: "\"\u6253\u64FE\u4E00\u4E0B...\u4F60\u5011\u6709\u6C92\u6709\u898B\u904E\u4E00\u500B\u5973\u5B69\uFF1F\u53EF\u80FD\u548C\u4E00\u500B\u7537\u5B69\u5728\u4E00\u8D77\uFF0C\u90A3\u500B\u7537\u5B69\u53EB\u827E\u4E39\u2026\u2026\u201D"
    - language: 2
      text: '"Excuse me... Have you seen a girl? She might be with a boy. His name''s
        Aidan..."'
    - language: 3
      text: "\u300C\u3059\u307F\u307E\u305B\u3093...\u5973\u306E\u5B50\u3092\u898B\u307E\u305B\u3093\u3067\u3057\u305F\u304B\uFF1F\u3000\u7537\u306E\u5B50\u3068\u4E00\u7DD2\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002\u30A8\u30A4\u30C0\u30F3\u3068\u3044\u3046\u5B50\u306A\u3093\u3067\u3059\u304C...\u300D"
    - language: 4
      text: "\"\uC2E4\uB840\uD569\uB2C8\uB2E4... \uC5EC\uC790\uC544\uC774 \uBABB
        \uBCF4\uC168\uB098\uC694? \uB0A8\uC790\uC544\uC774\uC640 \uD568\uAED8 \uC788\uC744
        \uC218\uB3C4 \uC788\uC5B4\uC694. \uB0A8\uC790\uC544\uC774 \uC774\uB984\uC740
        \uC5D0\uC774\uB4E0\uC778\uB370...\""
    - language: 5
      text: "\"Excusez-moi... Vous avez vu une fille ? Elle est peut-\xEAtre avec
        un gar\xE7on qui s'appelle Aidan...\""
    - language: 6
      text: "\"Entschuldigung... Haben Sie ein M\xE4dchen gesehen? Vielleicht ist
        sie mit einem Jungen zusammen. Er hei\xDFt Aidan...\""
    - language: 7
      text: "\"Disculpen... \xBFHan visto a una chica? Quiz\xE1 vaya con un chico
        que se llama Aidan...\""
    - language: 8
      text: "\"Com licen\xE7a... Voc\xEAs viram uma garota? Talvez esteja com um
        rapaz chamado Aidan...\""
    - language: 9
      text: "\"\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435... \u0412\u044B \u043D\u0435
        \u0432\u0438\u0434\u0435\u043B\u0438 \u0434\u0435\u0432\u0443\u0448\u043A\u0443?
        \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0441 \u043F\u0430\u0440\u043D\u0435\u043C.
        \u0415\u0433\u043E \u0437\u043E\u0432\u0443\u0442 \u042D\u0439\u0434\u0430\u043D...\""
  - key: os.memory.1510.text
    values:
    - language: 0
      text: "\u6CA1\u8BF4\u5B8C\uFF0C\u91CC\u9762\u4F20\u6765\u4E00\u9635\u54B3\u55FD......"
    - language: 1
      text: "\u6C92\u8AAA\u5B8C\uFF0C\u88E1\u9762\u50B3\u4F86\u4E00\u9663\u54B3\u55FD......"
    - language: 2
      text: Before I can finish, I hear coughing from inside......
    - language: 3
      text: "\u8A00\u3044\u7D42\u308F\u308B\u524D\u306B\u3001\u5965\u304B\u3089\u54B3\u304C\u805E\u3053\u3048\u305F......"
    - language: 4
      text: "\uB9D0\uC744 \uB9C8\uCE58\uAE30\uB3C4 \uC804\uC5D0 \uC548\uCABD\uC5D0\uC11C
        \uAE30\uCE68 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4......"
    - language: 5
      text: "Je n'ai pas termin\xE9 qu'une toux retentit \xE0 l'int\xE9rieur......"
    - language: 6
      text: "Noch bevor ich ausreden kann, h\xF6re ich von drinnen Husten......"
    - language: 7
      text: Antes de que termine, se oye una tos desde dentro......
    - language: 8
      text: "Antes de terminar, ou\xE7o uma tosse l\xE1 de dentro......"
    - language: 9
      text: "\u041D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u044E \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C,
        \u043A\u0430\u043A \u0438\u0437\u043D\u0443\u0442\u0440\u0438 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
        \u043A\u0430\u0448\u0435\u043B\u044C......"
  - key: os.memory.1520.text
    values:
    - language: 0
      text: "\u6211\u8D70\u4E86\u8FC7\u53BB\uFF0C\u7A9D\u68DA\u91CC\u4E00\u4E2A\u5973\u4EBA\u8EBA\u5728\u51E0\u5C42\u65E7\u57AB\u5B50\u4E0A\uFF0C\u9732\u51FA\u6765\u7684\u8138\u5374\u5168\u662F\u6C57\u3002\u65C1\u8FB9\u8E72\u7740\u4E2A\u5973\u5B69\uFF0C\u6B63\u62FF\u4E00\u53EA\u676F\u5B50\u5F80\u5979\u5634\u8FB9\u9001\u3002"
    - language: 1
      text: "\u6211\u8D70\u4E86\u904E\u53BB\uFF0C\u7AA9\u68DA\u88E1\u4E00\u500B\u5973\u4EBA\u8EBA\u5728\u5E7E\u5C64\u820A\u588A\u5B50\u4E0A\uFF0C\u9732\u51FA\u4F86\u7684\u81C9\u537B\u5168\u662F\u6C57\u3002\u65C1\u908A\u8E72\u8457\u500B\u5973\u5B69\uFF0C\u6B63\u62FF\u4E00\u96BB\u676F\u5B50\u5F80\u5979\u5634\u908A\u9001\u3002"
    - language: 2
      text: I head over. A woman is lying on several old cushions in a makeshift
        shack, her exposed face covered in sweat. A girl crouches beside her, holding
        a cup to her lips.
    - language: 3
      text: "\u8FD1\u3065\u304F\u3068\u3001\u7C97\u672B\u306A\u5C0F\u5C4B\u306E\u4E2D\u3067\u3001\u5973\u306E\u4EBA\u304C\u53E4\u3044\u6577\u7269\u3092\u4F55\u679A\u3082\u91CD\u306D\u305F\u4E0A\u306B\u5BDD\u3066\u3044\u305F\u3002\u8997\u3044\u3066\u3044\u308B\u9854\u306F\u6C57\u3060\u3089\u3051\u3060\u3002\u96A3\u306B\u3057\u3083\u304C\u3093\u3060\u5C11\u5973\u304C\u3001\u30B3\u30C3\u30D7\u3092\u53E3\u5143\u3078\u904B\u3093\u3067\u3044\u308B\u3002"
    - language: 4
      text: "\uB2E4\uAC00\uAC00 \uBCF4\uB2C8 \uD310\uC7A3\uC9D1 \uC548\uC5D0\uC11C
        \uD55C \uC5EC\uC790\uAC00 \uB0A1\uC740 \uBC29\uC11D \uC5EC\uB7EC \uACB9 \uC704\uC5D0
        \uB204\uC6CC \uC788\uB2E4. \uB4DC\uB7EC\uB09C \uC5BC\uAD74\uC740 \uC628\uD1B5
        \uB540\uD22C\uC131\uC774\uB2E4. \uC606\uC5D0 \uCABC\uADF8\uB824 \uC549\uC740
        \uC5EC\uC790\uC544\uC774\uAC00 \uCEF5\uC744 \uC785\uAC00\uC5D0 \uB300 \uC8FC\uACE0
        \uC788\uB2E4."
    - language: 5
      text: "Je m'approche. Dans une cabane de fortune, une femme est allong\xE9e
        sur plusieurs vieux coussins, le visage couvert de sueur. Une fille accroupie
        \xE0 c\xF4t\xE9 d'elle porte une tasse \xE0 ses l\xE8vres."
    - language: 6
      text: "Ich gehe hin\xFCber. In einem Verschlag liegt eine Frau auf mehreren
        alten Polstern, das sichtbare Gesicht schwei\xDFnass. Neben ihr hockt ein
        M\xE4dchen und h\xE4lt ihr einen Becher an die Lippen."
    - language: 7
      text: "Me acerco. En una chabola hay una mujer tumbada sobre varios cojines
        viejos, con la cara cubierta de sudor. Una ni\xF1a agachada a su lado le
        acerca una taza a los labios."
    - language: 8
      text: "Vou at\xE9 l\xE1. Num barraco, uma mulher est\xE1 deitada sobre v\xE1rias
        almofadas velhas, com o rosto coberto de suor. Ao lado, uma menina agachada
        leva um copo \xE0 boca dela."
    - language: 9
      text: "\u041F\u043E\u0434\u0445\u043E\u0436\u0443 \u0431\u043B\u0438\u0436\u0435.
        \u0412 \u043B\u0430\u0447\u0443\u0433\u0435 \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
        \u0441\u0442\u0430\u0440\u044B\u0445 \u043F\u043E\u0434\u0441\u0442\u0438\u043B\u043A\u0430\u0445
        \u043B\u0435\u0436\u0438\u0442 \u0436\u0435\u043D\u0449\u0438\u043D\u0430,
        \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0435 \u043B\u0438\u0446\u043E
        \u0432\u0441\u0451 \u0432 \u043F\u043E\u0442\u0443. \u0420\u044F\u0434\u043E\u043C
        \u043D\u0430 \u043A\u043E\u0440\u0442\u043E\u0447\u043A\u0430\u0445 \u0441\u0438\u0434\u0438\u0442
        \u0434\u0435\u0432\u043E\u0447\u043A\u0430 \u0438 \u043F\u043E\u0434\u043D\u043E\u0441\u0438\u0442
        \u0447\u0430\u0448\u043A\u0443 \u043A \u0435\u0451 \u0433\u0443\u0431\u0430\u043C."
  - key: os.memory.1530.text
    values:
    - language: 0
      text: "\"\u8FD9\u6837\u591A\u4E45\u4E86\uFF1F\"\uFF0C\u6211\u81EA\u4F5C\u4E3B\u5F20\u5730\u95EE\u7740\u3002\u867D\u7136\u6211\u4E0D\u662F\u533B\u751F\uFF0C\u4F46\u7814\u7A76\u751F\u7269\u7684\uFF0C\u5728\u8FD9\u5E74\u5934\u4E5F\u80FD\u7B97\u533B\u751F\u4E86\u3002"
    - language: 1
      text: "\"\u9019\u6A23\u591A\u4E45\u4E86\uFF1F\"\uFF0C\u6211\u81EA\u4F5C\u4E3B\u5F35\u5730\u554F\u8457\u3002\u96D6\u7136\u6211\u4E0D\u662F\u91AB\u751F\uFF0C\u4F46\u7814\u7A76\u751F\u7269\u7684\uFF0C\u5728\u9019\u5E74\u982D\u4E5F\u80FD\u7B97\u91AB\u751F\u4E86\u3002"
    - language: 2
      text: '"How long has she been like this?" I ask, taking it upon myself. I''m
        no doctor, but in times like these, studying biology is close enough.'
    - language: 3
      text: "\u300C\u3044\u3064\u304B\u3089\u3053\u306E\u72B6\u614B\u306A\u306E\uFF1F\u300D\u52DD\u624B\u306B\u53E3\u3092\u51FA\u3059\u3002\u533B\u8005\u3067\u306F\u306A\u3044\u3051\u308C\u3069\u3001\u751F\u7269\u306E\u7814\u7A76\u3092\u3057\u3066\u3044\u308C\u3070\u3001\u3053\u306E\u3054\u6642\u4E16\u3067\u306F\u533B\u8005\u306E\u3088\u3046\u306A\u3082\u306E\u3060\u3002"
    - language: 4
      text: "\"\uC774\uB807\uAC8C \uB41C \uC9C0 \uC5BC\uB9C8\uB098 \uB410\uB2C8?\"
        \uB098\uB294 \uC81C\uBA4B\uB300\uB85C \uBB3B\uB294\uB2E4. \uC758\uC0AC\uB294
        \uC544\uB2C8\uC9C0\uB9CC \uC0DD\uBB3C\uC744 \uC5F0\uAD6C\uD588\uC73C\uB2C8,
        \uC694\uC998 \uC138\uC0C1\uC5D0\uC120 \uC758\uC0AC\uB77C\uACE0 \uD574\uB3C4
        \uB420 \uAC83\uC774\uB2E4."
    - language: 5
      text: "\"Depuis combien de temps est-elle comme \xE7a ?\" Je pose la question
        de ma propre initiative. Je ne suis pas m\xE9decin, mais par les temps qui
        courent, avoir \xE9tudi\xE9 la biologie suffit presque."
    - language: 6
      text: "\"Wie lange geht das schon?\" frage ich eigenm\xE4chtig. Ich bin zwar
        keine \xC4rztin, aber wer Biologie erforscht, geht heutzutage wohl als eine
        durch."
    - language: 7
      text: "\"\xBFCu\xE1nto tiempo lleva as\xED?\", pregunto por mi cuenta. No soy
        m\xE9dica, pero en estos tiempos, investigar biolog\xEDa casi basta para
        serlo."
    - language: 8
      text: "\"H\xE1 quanto tempo ela est\xE1 assim?\", pergunto por conta pr\xF3pria.
        N\xE3o sou m\xE9dica, mas, hoje em dia, pesquisar biologia quase basta para
        ser uma."
    - language: 9
      text: "\"\u0414\u0430\u0432\u043D\u043E \u043E\u043D\u0430 \u0442\u0430\u043A?\"
        \u2014 \u0441\u0430\u043C\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u044E\u0441\u044C
        \u044F. \u042F \u043D\u0435 \u0432\u0440\u0430\u0447, \u043D\u043E \u0432
        \u043D\u0430\u0448\u0435 \u0432\u0440\u0435\u043C\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C
        \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0438 \u0432\u043F\u043E\u043B\u043D\u0435
        \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0439\u0442\u0438 \u0437\u0430
        \u0432\u0440\u0430\u0447\u0430."
  - key: os.memory.1540.text
    values:
    - language: 0
      text: "\u5973\u5B69\u561F\u56D4\u7740\u4EC0\u4E48\uFF0C\u7D27\u7D27\u6525\u7740\u5973\u4EBA\u7684\u8863\u89D2...\u770B\u8D77\u6765\u90A3\u662F\u5979\u7684\u6BCD\u4EB2\u3002\u5973\u4EBA\u545B\u7740\u547C\u5438\u8BF4\u7740..."
    - language: 1
      text: "\u5973\u5B69\u561F\u56D4\u8457\u4EC0\u9EBC\uFF0C\u7DCA\u7DCA\u6525\u8457\u5973\u4EBA\u7684\u8863\u89D2...\u770B\u8D77\u4F86\u90A3\u662F\u5979\u7684\u6BCD\u89AA\u3002\u5973\u4EBA\u55C6\u8457\u547C\u5438\u8AAA\u8457..."
    - language: 2
      text: The girl mumbles something, clutching the woman's clothes... Her mother,
        apparently. The woman speaks between choking breaths...
    - language: 3
      text: "\u5C11\u5973\u306F\u4F55\u304B\u545F\u304D\u3001\u5973\u306E\u4EBA\u306E\u670D\u3092\u304E\u3085\u3063\u3068\u63B4\u3093\u3067\u3044\u308B...\u6BCD\u89AA\u3089\u3057\u3044\u3002\u5973\u306E\u4EBA\u306F\u606F\u3092\u8A70\u307E\u3089\u305B\u306A\u304C\u3089\u8A71\u3057\u305F..."
    - language: 4
      text: "\uC544\uC774\uB294 \uBB34\uC5B8\uAC00 \uC911\uC5BC\uAC70\uB9AC\uBA70
        \uC5EC\uC790\uC758 \uC637\uC790\uB77D\uC744 \uAF2D \uC6C0\uCF1C\uC954\uB2E4...
        \uC5C4\uB9C8\uC778 \uBAA8\uC591\uC774\uB2E4. \uC5EC\uC790\uAC00 \uAC00\uC05C
        \uC228 \uC0AC\uC774\uB85C \uB9D0\uC744 \uAEBC\uB0B8\uB2E4..."
    - language: 5
      text: "La fille marmonne quelque chose en agrippant les v\xEAtements de la
        femme... Sa m\xE8re, apparemment. La femme parle entre deux respirations
        \xE9touff\xE9es..."
    - language: 6
      text: "Das M\xE4dchen murmelt etwas und umklammert die Kleidung der Frau...
        Offenbar ihre Mutter. Die Frau spricht zwischen stockenden Atemz\xFCgen..."
    - language: 7
      text: "La ni\xF1a murmura algo y se agarra con fuerza a la ropa de la mujer...
        Parece ser su madre. La mujer habla entre respiraciones ahogadas..."
    - language: 8
      text: "A menina murmura alguma coisa, agarrada \xE0 roupa da mulher... Parece
        ser a m\xE3e dela. A mulher fala entre respira\xE7\xF5es sufocadas..."
    - language: 9
      text: "\u0414\u0435\u0432\u043E\u0447\u043A\u0430 \u0447\u0442\u043E-\u0442\u043E
        \u0431\u043E\u0440\u043C\u043E\u0447\u0435\u0442, \u043A\u0440\u0435\u043F\u043A\u043E
        \u0441\u0436\u0438\u043C\u0430\u044F \u043A\u0440\u0430\u0439 \u0436\u0435\u043D\u0441\u043A\u043E\u0439
        \u043E\u0434\u0435\u0436\u0434\u044B... \u041F\u043E\u0445\u043E\u0436\u0435,
        \u044D\u0442\u043E \u0435\u0451 \u043C\u0430\u0442\u044C. \u0416\u0435\u043D\u0449\u0438\u043D\u0430
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0437\u0430\u0445\u043B\u0451\u0431\u044B\u0432\u0430\u044F\u0441\u044C
        \u0434\u044B\u0445\u0430\u043D\u0438\u0435\u043C..."
  - key: os.memory.1550.text
    values:
    - language: 0
      text: "\"\u6709\u4E9B...\u54B3\u54B3..\u6709\u4E9B\u65F6\u95F4\u4E86\uFF0C\u836F\u5DF2\u7ECF\u5403\uFF0C\u5403\u5B8C\u4E86..\"\u6211\u4F38\u624B\u53BB\u63A2\u5979\u7684\u989D\u5934\uFF0C\u770B\u8D77\u6765\u53EA\u662F\u53C8\u662F\u4F4E\u70E7\u53C8\u662F\u7D2F\u574F\u4E86\u3002"
    - language: 1
      text: "\"\u6709\u4E9B...\u54B3\u54B3..\u6709\u4E9B\u6642\u9593\u4E86\uFF0C\u85E5\u5DF2\u7D93\u5403\uFF0C\u5403\u5B8C\u4E86..\"\u6211\u4F38\u624B\u53BB\u63A2\u5979\u7684\u984D\u982D\uFF0C\u770B\u8D77\u4F86\u53EA\u662F\u53C8\u662F\u4F4E\u71D2\u53C8\u662F\u7D2F\u58DE\u4E86\u3002"
    - language: 2
      text: '"A... cough, cough... a while. I''ve taken all... all the medicine..."
        I reach out to feel her forehead. It seems to be a low fever and sheer exhaustion.'
    - language: 3
      text: "\u300C\u3057\u3070\u3089\u304F...\u3054\u307B\u3001\u3054\u307B...\u524D\u304B\u3089\u3067\u3059\u3002\u85AC\u306F\u3082\u3046\u3001\u98F2\u307F\u304D\u3063\u3066...\u300D\u984D\u306B\u624B\u3092\u5F53\u3066\u308B\u3002\u5FAE\u71B1\u3068\u3001\u3072\u3069\u3044\u75B2\u52B4\u304C\u91CD\u306A\u3063\u3066\u3044\u308B\u3060\u3051\u306E\u3088\u3046\u3060\u3002"
    - language: 4
      text: "\"\uC880... \uCF5C\uB85D, \uCF5C\uB85D... \uB410\uC5B4\uC694. \uC57D\uC740
        \uC774\uC81C, \uB2E4 \uBA39\uC5B4\uC11C...\" \uC774\uB9C8\uC5D0 \uC190\uC744
        \uB300 \uBCF8\uB2E4. \uBBF8\uC5F4\uC5D0\uB2E4 \uC2EC\uD558\uAC8C \uC9C0\uCE5C
        \uAC83\uBFD0\uC778 \uB4EF\uD558\uB2E4."
    - language: 5
      text: "\"Un... kof, kof... un certain temps. Les m\xE9dicaments... je les ai
        tous pris...\" Je tends la main vers son front. On dirait une petite fi\xE8vre
        et un \xE9puisement total."
    - language: 6
      text: "\"Schon... hust, hust... eine Weile. Die Medikamente sind... sind alle...\"
        Ich f\xFChle ihre Stirn. Es scheint nur leichtes Fieber und v\xF6llige Ersch\xF6pfung
        zu sein."
    - language: 7
      text: "\"Un... cof, cof... un tiempo. Ya he tomado toda... toda la medicina...\"
        Le palpo la frente. Parece solo una febr\xEDcula y puro agotamiento."
    - language: 8
      text: "\"H\xE1... cof, cof... algum tempo. O rem\xE9dio... j\xE1 tomei tudo...\"
        Estendo a m\xE3o e sinto a testa dela. Parece s\xF3 uma febre baixa e um
        cansa\xE7o enorme."
    - language: 9
      text: "\"\u0423\u0436\u0435... \u043A\u0445\u0435-\u043A\u0445\u0435... \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
        \u0432\u0440\u0435\u043C\u044F. \u041B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430...
        \u044F \u0443\u0436\u0435 \u0432\u0441\u0451 \u0432\u044B\u043F\u0438\u043B\u0430...\"
        \u042F \u043A\u0430\u0441\u0430\u044E\u0441\u044C \u0435\u0451 \u043B\u0431\u0430.
        \u041F\u043E\u0445\u043E\u0436\u0435, \u043F\u0440\u043E\u0441\u0442\u043E
        \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
        \u0438 \u0441\u0438\u043B\u044C\u043D\u043E\u0435 \u0438\u0441\u0442\u043E\u0449\u0435\u043D\u0438\u0435."
  - key: os.memory.1550.option.1
    values:
    - language: 0
      text: "\"\u4F60\u4EEC\u8FD9\u9644\u8FD1\u6709\u4EC0\u4E48\u836F\u7269\u5417\uFF1F\u8FD9\u4E48\u5927\u4E2A\u5730\u65B9\""
    - language: 1
      text: "\"\u4F60\u5011\u9019\u9644\u8FD1\u6709\u4EC0\u9EBC\u85E5\u7269\u55CE\uFF1F\u9019\u9EBC\u5927\u500B\u5730\u65B9\""
    - language: 2
      text: '"Is there any medicine around here? It''s such a big place."'
    - language: 3
      text: "\u300C\u3053\u3093\u306A\u306B\u5E83\u3044\u5834\u6240\u306A\u3089\u3001\u8FD1\u304F\u306B\u85AC\u306F\u306A\u3044\u306E\uFF1F\u300D"
    - language: 4
      text: "\"\uC774\uB807\uAC8C \uB113\uC740 \uACF3\uC778\uB370, \uADFC\uCC98\uC5D0
        \uC57D\uC740 \uC5C6\uB2C8?\""
    - language: 5
      text: "\"Il y a des m\xE9dicaments par ici ? C'est si grand.\""
    - language: 6
      text: '"Gibt es hier irgendwo Medikamente? Der Ort ist doch riesig."'
    - language: 7
      text: "\"\xBFHay medicinas por aqu\xED? Es un lugar enorme.\""
    - language: 8
      text: "\"Tem rem\xE9dios por aqui? Este lugar \xE9 enorme.\""
    - language: 9
      text: "\"\u0417\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u043D\u0438\u0431\u0443\u0434\u044C
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430? \u041C\u0435\u0441\u0442\u043E
        \u0432\u0435\u0434\u044C \u0431\u043E\u043B\u044C\u0448\u043E\u0435\"."
  - key: os.memory.1560.text
    values:
    - language: 0
      text: "\u5973\u4EBA\u54B3\u55FD\u7740\u6B63\u60F3\u8BF4\u8BDD\uFF0C\u5973\u5B69\u5148\u62A2\u7740\u56DE\u7B54\u4E86\uFF0C\"\u5728\u9644\u8FD1\u6709...\u5988\u5988\u4E0A\u6B21\u5E26\u56DE\u6765\u5F88\u591A\uFF0C\u90FD\u5206\u7ED9\u5927\u5BB6\u4E86....\""
    - language: 1
      text: "\u5973\u4EBA\u54B3\u55FD\u8457\u6B63\u60F3\u8AAA\u8A71\uFF0C\u5973\u5B69\u5148\u6436\u8457\u56DE\u7B54\u4E86\uFF0C\"\u5728\u9644\u8FD1\u6709...\u5ABD\u5ABD\u4E0A\u6B21\u5E36\u56DE\u4F86\u5F88\u591A\uFF0C\u90FD\u5206\u7D66\u5927\u5BB6\u4E86....\""
    - language: 2
      text: The woman coughs and starts to speak, but the girl answers first. "There's
        some nearby... Mum brought back lots last time. She gave it all to everyone...."
    - language: 3
      text: "\u5973\u306E\u4EBA\u304C\u54B3\u3092\u3057\u306A\u304C\u3089\u8A71\u305D\u3046\u3068\u3059\u308B\u3068\u3001\u5C11\u5973\u304C\u5148\u306B\u7B54\u3048\u305F\u3002\u300C\u3053\u306E\u8FD1\u304F\u306B\u3042\u308B\u3088...\u524D\u306B\u304A\u6BCD\u3055\u3093\u304C\u305F\u304F\u3055\u3093\u6301\u3063\u3066\u304D\u3066\u3001\u307F\u3093\u306A\u306B\u5168\u90E8\u3042\u3052\u305F\u306E....\u300D"
    - language: 4
      text: "\uC5EC\uC790\uAC00 \uAE30\uCE68\uD558\uBA70 \uB9D0\uD558\uB824 \uD558\uC790
        \uC544\uC774\uAC00 \uBA3C\uC800 \uB300\uB2F5\uD55C\uB2E4. \"\uADFC\uCC98\uC5D0
        \uC788\uC5B4\uC694... \uC5C4\uB9C8\uAC00 \uC800\uBC88\uC5D0 \uB9CE\uC774
        \uAC00\uC838\uC654\uB294\uB370, \uC0AC\uB78C\uB4E4\uD55C\uD14C \uB2E4 \uB098\uB220
        \uC92C\uC5B4\uC694....\""
    - language: 5
      text: "La femme tousse et s'appr\xEAte \xE0 parler, mais la fille r\xE9pond
        avant elle. \"Il y en a pr\xE8s d'ici... Maman en a rapport\xE9 beaucoup
        la derni\xE8re fois. Elle a tout distribu\xE9 aux autres....\""
    - language: 6
      text: "Die Frau hustet und will antworten, doch das M\xE4dchen kommt ihr zuvor.
        \"Hier in der N\xE4he gibt es welche... Mama hat letztes Mal ganz viel mitgebracht
        und alles an die anderen verteilt....\""
    - language: 7
      text: "La mujer tose e intenta hablar, pero la ni\xF1a se adelanta. \"Hay por
        aqu\xED cerca... Mam\xE1 trajo mucha la \xFAltima vez. La reparti\xF3 toda
        entre los dem\xE1s....\""
    - language: 8
      text: "A mulher tosse e tenta falar, mas a menina responde primeiro. \"Tem
        por aqui perto... Mam\xE3e trouxe bastante da \xFAltima vez. Deu tudo para
        as outras pessoas....\""
    - language: 9
      text: "\u0416\u0435\u043D\u0449\u0438\u043D\u0430 \u043A\u0430\u0448\u043B\u044F\u0435\u0442
        \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C,
        \u043D\u043E \u0434\u0435\u0432\u043E\u0447\u043A\u0430 \u043E\u043F\u0435\u0440\u0435\u0436\u0430\u0435\u0442
        \u0435\u0451. \"\u0422\u0443\u0442 \u0440\u044F\u0434\u043E\u043C \u0435\u0441\u0442\u044C...
        \u041C\u0430\u043C\u0430 \u0432 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
        \u0440\u0430\u0437 \u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
        \u0438 \u0432\u0441\u0451 \u0440\u0430\u0437\u0434\u0430\u043B\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C....\""
  - key: os.memory.1570.text
    values:
    - language: 0
      text: "<color=red>\"\u591A\u597D\u7684\u95FA\u5973\u554A...\u771F\u53EF\u60DC\u54C8\u54C8\u54C8\"</color>\uFF0C\u6211\u8111\u5B50\u91CC\u7684\u90A3\u4E2A\u4EBA\u53C8\u5F00\u59CB\u8BF4\u8BDD\u4E86\uFF0C\u90FD\u602A\u5979\uFF0C\u8FD9\u4FE9\u4EBA\u770B\u6211\u7684\u773C\u795E\u90FD\u6709\u4E9B\u602A\u5F02\u4E86."
    - language: 1
      text: "<color=red>\"\u591A\u597D\u7684\u95A8\u5973\u554A...\u771F\u53EF\u60DC\u54C8\u54C8\u54C8\"</color>\uFF0C\u6211\u8166\u5B50\u88E1\u7684\u90A3\u500B\u4EBA\u53C8\u958B\u59CB\u8AAA\u8A71\u4E86\uFF0C\u90FD\u602A\u5979\uFF0C\u9019\u5006\u4EBA\u770B\u6211\u7684\u773C\u795E\u90FD\u6709\u4E9B\u602A\u7570\u4E86."
    - language: 2
      text: <color=red>"What a sweet daughter... Such a pity. Hahaha."</color> The
        person in my head starts talking again. Thanks to her, those two are looking
        at me rather strangely.
    - language: 3
      text: "<color=red>\u300C\u306A\u3093\u3066\u3044\u3044\u5A18\u306A\u306E...\u304B\u308F\u3044\u305D\u3046\u306B\u3001\u3042\u306F\u306F\u300D</color>\u982D\u306E\u4E2D\u306E\u3042\u3044\u3064\u304C\u307E\u305F\u558B\u308A\u3060\u3057\u305F\u3002\u305D\u306E\u305B\u3044\u3067\u3001\u4E8C\u4EBA\u3068\u3082\u79C1\u3092\u5C11\u3057\u5909\u306A\u76EE\u3067\u898B\u3066\u3044\u308B\u3002"
    - language: 4
      text: "<color=red>\"\uCC38 \uCC29\uD55C \uB538\uC774\uB124... \uC548\uD0C0\uAE4C\uC6CC\uB77C,
        \uD558\uD558\uD558.\"</color> \uBA38\uB9BF\uC18D\uC758 \uADF8 \uC0AC\uB78C\uC774
        \uB610 \uB9D0\uC744 \uC2DC\uC791\uD55C\uB2E4. \uADF8 \uC5EC\uC790 \uB54C\uBB38\uC5D0
        \uB450 \uC0AC\uB78C\uC774 \uB098\uB97C \uC880 \uC774\uC0C1\uD558\uAC8C \uCCD0\uB2E4\uBCF8\uB2E4."
    - language: 5
      text: "<color=red>\"Quelle gentille fille... Quel dommage, hahaha.\"</color>
        La personne dans ma t\xEAte recommence. \xC0 cause d'elle, ces deux-l\xE0
        me regardent bizarrement."
    - language: 6
      text: "<color=red>\"Was f\xFCr ein liebes T\xF6chterchen... Wie schade, hahaha.\"</color>
        Die Person in meinem Kopf redet wieder. Ihretwegen sehen mich die beiden
        schon ganz seltsam an."
    - language: 7
      text: "<color=red>\"Qu\xE9 hija tan buena... Qu\xE9 l\xE1stima, jajaja.\"</color>
        La persona de mi cabeza vuelve a hablar. Por su culpa, las dos me est\xE1n
        mirando de una forma algo rara."
    - language: 8
      text: "<color=red>\"Que filha boazinha... Que pena, hahaha.\"</color> A pessoa
        na minha cabe\xE7a voltou a falar. Por culpa dela, as duas est\xE3o me olhando
        meio esquisito."
    - language: 9
      text: "<color=red>\"\u041A\u0430\u043A\u0430\u044F \u0445\u043E\u0440\u043E\u0448\u0430\u044F
        \u0434\u043E\u0447\u043A\u0430... \u041A\u0430\u043A \u0436\u0430\u043B\u044C,
        \u0445\u0430-\u0445\u0430-\u0445\u0430\"</color>. \u0422\u0430, \u0447\u0442\u043E
        \u0443 \u043C\u0435\u043D\u044F \u0432 \u0433\u043E\u043B\u043E\u0432\u0435,
        \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430.
        \u0418\u0437-\u0437\u0430 \u043D\u0435\u0451 \u044D\u0442\u0438 \u0434\u0432\u043E\u0435
        \u0443\u0436\u0435 \u043A\u0430\u043A-\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E
        \u043D\u0430 \u043C\u0435\u043D\u044F \u0441\u043C\u043E\u0442\u0440\u044F\u0442."
  - key: os.memory.1580.text
    values:
    - language: 0
      text: "\"....\u963F\u59E8..\u6C42\u6C42\u4F60..\u6551\u6551\u6211\u5988\u5988\u3002\"\uFF0C\u5973\u5B69\u6C34\u6C6A\u6C6A\u5730\u76EF\u7740\u6211\u7684\u773C\u775B\u4E5E\u6C42\u7740\uFF0C\u6211\u4E00\u8FB9\u65E0\u89C6\u7740\u8111\u5B50\u91CC\u53E6\u4E00\u4E2A\u4EBA\uFF0C\u4E00\u8FB9\u70B9\u7740\u5934\u3002\u5927\u6982\u6CA1\u6709\u6BCD\u4EB2\u80FD\u5728\u8FD9\u79CD\u60C5\u51B5\u4E0B\u62D2\u7EDD\u5427...\u6211\u60F3\u3002"
    - language: 1
      text: "\"....\u963F\u59E8..\u6C42\u6C42\u4F60..\u6551\u6551\u6211\u5ABD\u5ABD\u3002\"\uFF0C\u5973\u5B69\u6C34\u6C6A\u6C6A\u5730\u76EF\u8457\u6211\u7684\u773C\u775B\u4E5E\u6C42\u8457\uFF0C\u6211\u4E00\u908A\u7121\u8996\u8457\u8166\u5B50\u88E1\u53E6\u4E00\u500B\u4EBA\uFF0C\u4E00\u908A\u9EDE\u8457\u982D\u3002\u5927\u6982\u6C92\u6709\u6BCD\u89AA\u80FD\u5728\u9019\u7A2E\u60C5\u6CC1\u4E0B\u62D2\u7D55\u5427...\u6211\u60F3\u3002"
    - language: 2
      text: '"....Please, ma''am... Please save my mum." The girl stares into my
        eyes, pleading, her own eyes brimming. I nod and ignore the other person
        in my head. I doubt any mother could say no to that... I think.'
    - language: 3
      text: "\u300C....\u304A\u3070\u3055\u3093...\u304A\u9858\u3044...\u304A\u6BCD\u3055\u3093\u3092\u52A9\u3051\u3066\u300D\u5C11\u5973\u306F\u6F64\u3093\u3060\u76EE\u3067\u79C1\u3092\u898B\u3064\u3081\u3001\u61C7\u9858\u3057\u305F\u3002\u982D\u306E\u4E2D\u306E\u3082\u3046\u4E00\u4EBA\u3092\u7121\u8996\u3057\u3066\u3001\u79C1\u306F\u9837\u304F\u3002\u3053\u3093\u306A\u3068\u304D\u3001\u65AD\u308C\u308B\u6BCD\u89AA\u306F\u3044\u306A\u3044\u3060\u308D\u3046...\u305F\u3076\u3093\u3002"
    - language: 4
      text: "\"....\uC544\uC8FC\uBA38\uB2C8... \uC81C\uBC1C... \uC6B0\uB9AC \uC5C4\uB9C8\uB97C
        \uC0B4\uB824 \uC8FC\uC138\uC694.\" \uC544\uC774\uAC00 \uB208\uBB3C\uC774
        \uADF8\uB801\uADF8\uB801\uD55C \uB208\uC73C\uB85C \uB098\uB97C \uBC14\uB77C\uBCF4\uBA70
        \uBE48\uB2E4. \uB098\uB294 \uBA38\uB9BF\uC18D \uB2E4\uB978 \uC0AC\uB78C\uC744
        \uBB34\uC2DC\uD558\uBA70 \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4. \uC774\uB7F0
        \uC0C1\uD669\uC5D0\uC11C \uAC70\uC808\uD560 \uC218 \uC788\uB294 \uC5C4\uB9C8\uB294
        \uC5C6\uACA0\uC9C0... \uC544\uB9C8\uB3C4."
    - language: 5
      text: "\"....Madame... S'il vous pla\xEEt... Sauvez ma maman.\" La fille me
        supplie du regard, les yeux pleins de larmes. Je hoche la t\xEAte en ignorant
        l'autre personne dans ma t\xEAte. Aucune m\xE8re ne pourrait refuser \xE7a...
        enfin, je crois."
    - language: 6
      text: "\"....Bitte... Bitte retten Sie meine Mama.\" Das M\xE4dchen sieht mich
        mit tr\xE4nennassen Augen flehend an. Ich nicke und ignoriere die andere
        Person in meinem Kopf. Dazu k\xF6nnte wohl keine Mutter Nein sagen... glaube
        ich."
    - language: 7
      text: "\"....Se\xF1ora... Por favor... Salve a mi mam\xE1.\" La ni\xF1a me
        mira suplicante, con los ojos llenos de l\xE1grimas. Asiento e ignoro a la
        otra persona de mi cabeza. Supongo que ninguna madre podr\xEDa negarse ante
        algo as\xED..."
    - language: 8
      text: "\"....Mo\xE7a... Por favor... Salva a minha m\xE3e.\" A menina me encara,
        suplicante, com os olhos cheios de l\xE1grimas. Concordo com a cabe\xE7a
        e ignoro a outra pessoa na minha cabe\xE7a. Acho que nenhuma m\xE3e conseguiria
        recusar numa situa\xE7\xE3o dessas..."
    - language: 9
      text: "\"....\u0422\u0451\u0442\u0435\u043D\u044C\u043A\u0430... \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430...
        \u0421\u043F\u0430\u0441\u0438\u0442\u0435 \u043C\u043E\u044E \u043C\u0430\u043C\u0443\".
        \u0414\u0435\u0432\u043E\u0447\u043A\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
        \u043C\u043D\u0435 \u0432 \u0433\u043B\u0430\u0437\u0430, \u0443\u043C\u043E\u043B\u044F\u044F,
        \u0438 \u0435\u0451 \u0432\u0437\u0433\u043B\u044F\u0434 \u043F\u043E\u043B\u043E\u043D
        \u0441\u043B\u0451\u0437. \u042F \u043A\u0438\u0432\u0430\u044E, \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u044F
        \u0434\u0440\u0443\u0433\u0443\u044E \u0443 \u0441\u0435\u0431\u044F \u0432
        \u0433\u043E\u043B\u043E\u0432\u0435. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u043D\u0438 \u043E\u0434\u043D\u0430 \u043C\u0430\u0442\u044C \u043D\u0435
        \u0441\u043C\u043E\u0433\u043B\u0430 \u0431\u044B \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
        \u0432 \u0442\u0430\u043A\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438...
        \u0414\u0443\u043C\u0430\u044E, \u0442\u0430\u043A."
  - key: os.memory.1590.text
    values:
    - language: 0
      text: "\u6211\u63E3\u8D77\u88C5\u836F\u7684\u76D2\u5B50\uFF0C\u770B\u4E86\u770B\u91CC\u9762\u7684\u6210\u5206...\u6B62\u75BC\uFF0C\u53BB\u70ED\uFF0C\u55EF.....\u6211\u5927\u6982\u77E5\u9053\u8FD9\u662F\u4EC0\u4E48\u836F\u7269\u3002\u53CD\u6B63\u73B0\u5728\u7684\u4EBA\u548C\u81EA\u5DF1\u5F53\u5E74\u505A\u8BD5\u9A8C\u7684\u5C0F\u767D\u9F20\u5DEE\u4E0D\u4E86\u591A\u5C11\u3002"
    - language: 1
      text: "\u6211\u63E3\u8D77\u88DD\u85E5\u7684\u76D2\u5B50\uFF0C\u770B\u4E86\u770B\u88E1\u9762\u7684\u6210\u5206...\u6B62\u75BC\uFF0C\u53BB\u71B1\uFF0C\u55EF.....\u6211\u5927\u6982\u77E5\u9053\u9019\u662F\u4EC0\u9EBC\u85E5\u7269\u3002\u53CD\u6B63\u73FE\u5728\u7684\u4EBA\u548C\u81EA\u5DF1\u7576\u5E74\u505A\u8A66\u9A57\u7684\u5C0F\u767D\u9F20\u5DEE\u4E0D\u4E86\u591A\u5C11\u3002"
    - language: 2
      text: I pick up the medicine box and read the ingredients... Pain relief, fever
        reduction. Hmm..... I think I know what it is. People these days aren't all
        that different from the lab mice I used to experiment on anyway.
    - language: 3
      text: "\u85AC\u306E\u7BB1\u3092\u624B\u306B\u53D6\u308A\u3001\u6210\u5206\u3092\u898B\u308B...\u93AE\u75DB\u3001\u89E3\u71B1\u3002\u3046\u3093.....\u4F55\u306E\u85AC\u304B\u306F\u3060\u3044\u305F\u3044\u308F\u304B\u3063\u305F\u3002\u4ECA\u306E\u4EBA\u9593\u306A\u3093\u3066\u3001\u6614\u5B9F\u9A13\u306B\u4F7F\u3063\u3066\u3044\u305F\u30DE\u30A6\u30B9\u3068\u5927\u5DEE\u306A\u3044\u3002"
    - language: 4
      text: "\uC57D \uC0C1\uC790\uB97C \uC9D1\uC5B4 \uB4E4\uACE0 \uC131\uBD84\uC744
        \uC0B4\uD540\uB2E4... \uC9C4\uD1B5, \uD574\uC5F4. \uC74C..... \uB300\uCDA9
        \uBB34\uC2A8 \uC57D\uC778\uC9C0 \uC54C\uACA0\uB2E4. \uC5B4\uCC28\uD53C \uC9C0\uAE08
        \uC0AC\uB78C\uB4E4\uC740 \uC608\uC804\uC5D0 \uC2E4\uD5D8\uD558\uB358 \uC0DD\uC950\uC640
        \uBCC4\uB2E4\uB97C \uAC83\uB3C4 \uC5C6\uB2E4."
    - language: 5
      text: "Je prends la bo\xEEte de m\xE9dicaments et lis les ingr\xE9dients...
        Antidouleur, antipyr\xE9tique. Hmm..... Je crois savoir ce que c'est. De
        toute fa\xE7on, les gens ne sont plus tr\xE8s diff\xE9rents des souris de
        laboratoire sur lesquelles je travaillais."
    - language: 6
      text: "Ich nehme die Medikamentenschachtel und lese die Inhaltsstoffe... Schmerzstillend,
        fiebersenkend. Hm..... Ich glaube, ich wei\xDF, was das ist. Die Menschen
        unterscheiden sich heutzutage ohnehin kaum von meinen fr\xFCheren Laborm\xE4usen."
    - language: 7
      text: "Cojo la caja de medicamentos y leo los ingredientes... Analg\xE9sico,
        antipir\xE9tico. Mmm..... Creo que s\xE9 qu\xE9 es. Total, la gente de hoy
        apenas se diferencia de los ratones de laboratorio con los que experimentaba."
    - language: 8
      text: "Pego a caixa do rem\xE9dio e leio os ingredientes... Para dor, para
        febre. Hum..... Acho que sei o que \xE9. De qualquer modo, as pessoas de
        hoje n\xE3o s\xE3o muito diferentes dos camundongos que eu usava no laborat\xF3rio."
    - language: 9
      text: "\u0411\u0435\u0440\u0443 \u043A\u043E\u0440\u043E\u0431\u043A\u0443
        \u043E\u0442 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430 \u0438
        \u0447\u0438\u0442\u0430\u044E \u0441\u043E\u0441\u0442\u0430\u0432... \u041E\u0431\u0435\u0437\u0431\u043E\u043B\u0438\u0432\u0430\u044E\u0449\u0435\u0435,
        \u0436\u0430\u0440\u043E\u043F\u043E\u043D\u0438\u0436\u0430\u044E\u0449\u0435\u0435.
        \u0425\u043C..... \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
        \u0447\u0442\u043E \u044D\u0442\u043E. \u0412\u043F\u0440\u043E\u0447\u0435\u043C,
        \u043D\u044B\u043D\u0435\u0448\u043D\u0438\u0435 \u043B\u044E\u0434\u0438
        \u043D\u0435 \u0442\u0430\u043A \u0443\u0436 \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
        \u043E\u0442 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0445
        \u043C\u044B\u0448\u0435\u0439, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
        \u044F \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0442\u0430\u0432\u0438\u043B\u0430
        \u043E\u043F\u044B\u0442\u044B."
  - key: os.memory.1600.text
    values:
    - language: 0
      text: "\u90A3\u4E9B\u5F97\u5FC3\u810F\u75C5\u6BD2\u7684\u4EBA\u751A\u81F3\u90FD\u80FD\u957F\u5C3E\u5DF4\uFF0C\u957F\u517D\u8033\uFF0C\u957F\u9CDE\u7247\u4E86...\u6211\u65E0\u5948\u5730\u6447\u4E86\u6447\u5934\u3002"
    - language: 1
      text: "\u90A3\u4E9B\u5F97\u5FC3\u81DF\u75C5\u6BD2\u7684\u4EBA\u751A\u81F3\u90FD\u80FD\u9577\u5C3E\u5DF4\uFF0C\u9577\u7378\u8033\uFF0C\u9577\u9C57\u7247\u4E86...\u6211\u7121\u5948\u5730\u6416\u4E86\u6416\u982D\u3002"
    - language: 2
      text: People with the heart virus can even grow tails, animal ears and scales
        now... I shake my head helplessly.
    - language: 3
      text: "\u5FC3\u81D3\u30A6\u30A4\u30EB\u30B9\u306E\u60A3\u8005\u306F\u3001\u5C3B\u5C3E\u3084\u7363\u306E\u8033\u3001\u9C57\u307E\u3067\u751F\u3048\u308B\u3088\u3046\u306B\u306A\u3063\u305F...\u79C1\u306F\u3084\u308B\u305B\u306A\u304F\u9996\u3092\u632F\u3063\u305F\u3002"
    - language: 4
      text: "\uC2EC\uC7A5 \uBC14\uC774\uB7EC\uC2A4\uC5D0 \uAC78\uB9B0 \uC0AC\uB78C\uC740
        \uAF2C\uB9AC\uBA70 \uC9D0\uC2B9 \uADC0, \uBE44\uB298\uAE4C\uC9C0 \uC790\uB77C\uB098\uB2C8\uAE4C...
        \uB098\uB294 \uD798\uC5C6\uC774 \uACE0\uAC1C\uB97C \uC813\uB294\uB2E4."
    - language: 5
      text: "Les malades du virus cardiaque peuvent m\xEAme avoir une queue, des
        oreilles animales, des \xE9cailles... Je secoue la t\xEAte, impuissante."
    - language: 6
      text: "Den Erkrankten wachsen sogar Schw\xE4nze, Tierohren und Schuppen...
        Ich sch\xFCttle hilflos den Kopf."
    - language: 7
      text: "A los infectados del virus card\xEDaco incluso les salen colas, orejas
        de animal y escamas... Niego con la cabeza, impotente."
    - language: 8
      text: "As pessoas com o v\xEDrus card\xEDaco chegam a desenvolver caudas, orelhas
        de bicho e escamas... Balan\xE7o a cabe\xE7a, sem ter o que fazer."
    - language: 9
      text: "\u0423 \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0445
        \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u043C \u0432\u0438\u0440\u0443\u0441\u043E\u043C
        \u0434\u0430\u0436\u0435 \u0432\u044B\u0440\u0430\u0441\u0442\u0430\u044E\u0442
        \u0445\u0432\u043E\u0441\u0442\u044B, \u0437\u0432\u0435\u0440\u0438\u043D\u044B\u0435
        \u0443\u0448\u0438, \u0447\u0435\u0448\u0443\u044F... \u042F \u0431\u0435\u0441\u043F\u043E\u043C\u043E\u0449\u043D\u043E
        \u043A\u0430\u0447\u0430\u044E \u0433\u043E\u043B\u043E\u0432\u043E\u0439."
  - key: os.memory.1610.text
    values:
    - language: 0
      text: "\u6211\u770B\u5411\u540E\u9762\u7684\u90A3\u5806\u4E1C\u897F\u3002\u53C8\u770B\u4E86\u4E00\u773C\u5165\u53E3\u3002"
    - language: 1
      text: "\u6211\u770B\u5411\u5F8C\u9762\u7684\u90A3\u5806\u6771\u897F\u3002\u53C8\u770B\u4E86\u4E00\u773C\u5165\u53E3\u3002"
    - language: 2
      text: I look at the pile of stuff further in. Then glance back at the entrance.
    - language: 3
      text: "\u5965\u306E\u7269\u306E\u5C71\u3092\u898B\u308B\u3002\u305D\u308C\u304B\u3089\u3001\u3082\u3046\u4E00\u5EA6\u5165\u53E3\u306B\u76EE\u3092\u5411\u3051\u308B\u3002"
    - language: 4
      text: "\uC548\uCABD\uC5D0 \uC313\uC778 \uBB3C\uAC74\uB4E4\uC744 \uBCF8\uB2E4.
        \uADF8\uB9AC\uACE0 \uC785\uAD6C\uB97C \uB2E4\uC2DC \uD55C\uBC88 \uB3CC\uC544\uBCF8\uB2E4."
    - language: 5
      text: "Je regarde le tas d'affaires au fond. Puis je jette un \u0153il vers
        l'entr\xE9e."
    - language: 6
      text: Ich sehe zu dem Haufen weiter hinten. Dann werfe ich einen Blick zum
        Eingang.
    - language: 7
      text: "Miro el mont\xF3n de cosas del fondo. Despu\xE9s vuelvo la vista hacia
        la entrada."
    - language: 8
      text: Olho para o monte de coisas mais ao fundo. Depois volto os olhos para
        a entrada.
    - language: 9
      text: "\u0421\u043C\u043E\u0442\u0440\u044E \u043D\u0430 \u043A\u0443\u0447\u0443
        \u0432\u0435\u0449\u0435\u0439 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435.
        \u041F\u043E\u0442\u043E\u043C \u0435\u0449\u0451 \u0440\u0430\u0437 \u043D\u0430
        \u0432\u0445\u043E\u0434."
  - key: os.memory.1620.text
    values:
    - language: 0
      text: "\u4ECA\u5929\u51FA\u6765\u5230\u73B0\u5728\uFF0C\u8FD8\u662F\u4E00\u70B9\u6D88\u606F\u4E5F\u6CA1\u6709\u3002"
    - language: 1
      text: "\u4ECA\u5929\u51FA\u4F86\u5230\u73FE\u5728\uFF0C\u9084\u662F\u4E00\u9EDE\u6D88\u606F\u4E5F\u6C92\u6709\u3002"
    - language: 2
      text: I've been out all this time today, and still not a word about her.
    - language: 3
      text: "\u4ECA\u65E5\u3001\u5BB6\u3092\u51FA\u3066\u304B\u3089\u4ECA\u307E\u3067\u3001\u307E\u3060\u4F55\u306E\u77E5\u3089\u305B\u3082\u306A\u3044\u3002"
    - language: 4
      text: "\uC624\uB298 \uBC16\uC5D0 \uB098\uC628 \uB4A4\uB85C \uC9C0\uAE08\uAE4C\uC9C0,
        \uC544\uC9C1\uB3C4 \uC544\uBB34 \uC18C\uC2DD\uC774 \uC5C6\uB2E4."
    - language: 5
      text: Depuis que je suis sortie aujourd'hui, toujours pas la moindre nouvelle.
    - language: 6
      text: Seit ich heute losgegangen bin, habe ich immer noch nichts erfahren.
    - language: 7
      text: Llevo todo este rato fuera y sigo sin saber nada de ella.
    - language: 8
      text: "Sa\xED hoje e, at\xE9 agora, nenhuma not\xEDcia dela."
    - language: 9
      text: "\u0421 \u0442\u0435\u0445 \u043F\u043E\u0440 \u043A\u0430\u043A \u044F
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0448\u043B\u0430
        \u0438\u0437 \u0434\u043E\u043C\u0430, \u0442\u0430\u043A \u043D\u0438\u0447\u0435\u0433\u043E
        \u0438 \u043D\u0435 \u0443\u0437\u043D\u0430\u043B\u0430."
  - key: os.memory.1630.text
    values:
    - language: 0
      text: "\u2026\u2026\u4E0D\u8FC7\uFF0C\u521A\u624D\u7684\u95EE\u9898\u8FD8\u6CA1\u4EBA\u56DE\u7B54\u6211...\u6211\u603B\u5F97\u7B49\u5979\u80FD\u8BF4\u8BDD\u4E86\uFF0C\u518D\u95EE\u4E00\u904D\uFF0C\u597D\u6B79\u6211\u4E5F\u662F\u4E2A\u6BCD\u4EB2.."
    - language: 1
      text: "\u2026\u2026\u4E0D\u904E\uFF0C\u525B\u624D\u7684\u554F\u984C\u9084\u6C92\u4EBA\u56DE\u7B54\u6211...\u6211\u7E3D\u5F97\u7B49\u5979\u80FD\u8AAA\u8A71\u4E86\uFF0C\u518D\u554F\u4E00\u904D\uFF0C\u597D\u6B79\u6211\u4E5F\u662F\u500B\u6BCD\u89AA.."
    - language: 2
      text: ...Still, nobody's answered my question yet. I'll have to wait until
        she can talk, then ask again. I'm a mother too, after all...
    - language: 3
      text: "\u2026\u2026\u3067\u3082\u3001\u3055\u3063\u304D\u306E\u8CEA\u554F\u306B\u306F\u8AB0\u3082\u7B54\u3048\u3066\u3044\u306A\u3044\u3002\u8A71\u305B\u308B\u3088\u3046\u306B\u306A\u308B\u307E\u3067\u5F85\u3063\u3066\u3001\u3082\u3046\u4E00\u5EA6\u805E\u304B\u306A\u3044\u3068\u3002\u79C1\u3060\u3063\u3066\u6BCD\u89AA\u306A\u3093\u3060\u304B\u3089..."
    - language: 4
      text: "\u2026\u2026\uD558\uC9C0\uB9CC \uC544\uAE4C \uC9C8\uBB38\uC5D0\uB294
        \uC544\uC9C1 \uC544\uBB34\uB3C4 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4.
        \uB9D0\uC744 \uD560 \uC218 \uC788\uC744 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uB2E4\uAC00
        \uB2E4\uC2DC \uBB3C\uC5B4\uBD10\uC57C\uC9C0. \uB098\uB3C4 \uC5C4\uB9C8\uB2C8\uAE4C..."
    - language: 5
      text: "...Mais personne n'a encore r\xE9pondu \xE0 ma question. Il faut bien
        attendre qu'elle puisse parler, puis la reposer. Moi aussi, je suis m\xE8re..."
    - language: 6
      text: "...Allerdings hat noch niemand meine Frage beantwortet. Ich muss warten,
        bis sie sprechen kann, und noch einmal fragen. Schlie\xDFlich bin ich auch
        eine Mutter..."
    - language: 7
      text: "...Pero nadie ha respondido a mi pregunta. Tendr\xE9 que esperar a que
        pueda hablar y volver a preguntar. Al fin y al cabo, yo tambi\xE9n soy madre..."
    - language: 8
      text: "...Mas ningu\xE9m respondeu \xE0 minha pergunta. Tenho que esperar at\xE9
        ela conseguir falar e perguntar de novo. Afinal, tamb\xE9m sou m\xE3e..."
    - language: 9
      text: "...\u041D\u043E \u043D\u0430 \u043C\u043E\u0439 \u0432\u043E\u043F\u0440\u043E\u0441
        \u0442\u0430\u043A \u043D\u0438\u043A\u0442\u043E \u0438 \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B.
        \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0434\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F,
        \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u0441\u043C\u043E\u0436\u0435\u0442
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u0438 \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
        \u0435\u0449\u0451 \u0440\u0430\u0437. \u042F \u0432\u0435\u0434\u044C \u0442\u043E\u0436\u0435
        \u043C\u0430\u0442\u044C..."
  - key: os.memory.1640.text
    values:
    - language: 0
      text: "\"\u4F60\u5728\u8FD9\u91CC\u522B\u4E71\u8DD1\uFF0C\u522B\u7ED9\u5979\u4E71\u5403\u4E1C\u897F\u3002\u6211\u8FC7\u53BB\u770B\u770B\u3002\""
    - language: 1
      text: "\"\u4F60\u5728\u9019\u88E1\u5225\u4E82\u8DD1\uFF0C\u5225\u7D66\u5979\u4E82\u5403\u6771\u897F\u3002\u6211\u904E\u53BB\u770B\u770B\u3002\""
    - language: 2
      text: '"Stay here. Don''t wander off, and don''t give her anything at random.
        I''ll go and have a look."'
    - language: 3
      text: "\u300C\u3053\u3053\u306B\u3044\u3066\u3001\u52DD\u624B\u306B\u51FA\u6B69\u304B\u306A\u3044\u3067\u3002\u304A\u6BCD\u3055\u3093\u306B\u5909\u306A\u3082\u306E\u3092\u98F2\u307E\u305B\u306A\u3044\u3053\u3068\u3002\u3061\u3087\u3063\u3068\u898B\u3066\u304F\u308B\u300D"
    - language: 4
      text: "\"\uC5EC\uAE30\uC11C \uB3CC\uC544\uB2E4\uB2C8\uC9C0 \uB9D0\uACE0 \uC788\uC5B4.
        \uC544\uBB34\uAC70\uB098 \uBA39\uC774\uC9C0\uB3C4 \uB9D0\uACE0. \uB0B4\uAC00
        \uC800\uCABD\uC744 \uBCF4\uACE0 \uC62C\uAC8C.\""
    - language: 5
      text: "\"Reste ici, ne t'\xE9loigne pas. Et ne lui donne pas n'importe quoi.
        Je vais voir.\""
    - language: 6
      text: "\"Bleib hier und lauf nicht weg. Gib ihr nichts auf gut Gl\xFCck. Ich
        sehe mich dort mal um.\""
    - language: 7
      text: "\"Qu\xE9date aqu\xED, no te vayas. Y no le des cualquier cosa. Voy a
        echar un vistazo.\""
    - language: 8
      text: "\"Fique aqui, n\xE3o saia andando. E n\xE3o d\xEA qualquer coisa para
        ela. Vou dar uma olhada.\""
    - language: 9
      text: "\"\u041E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F \u0437\u0434\u0435\u0441\u044C,
        \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0443\u0445\u043E\u0434\u0438.
        \u0418 \u043D\u0435 \u0434\u0430\u0432\u0430\u0439 \u0435\u0439 \u0447\u0442\u043E
        \u043F\u043E\u043F\u0430\u043B\u043E. \u042F \u043F\u043E\u0439\u0434\u0443
        \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E\"."
  - key: os.memory.1640.option.1
    values:
    - language: 0
      text: "\u53BB\u627E\u836F"
    - language: 1
      text: "\u53BB\u627E\u85E5"
    - language: 2
      text: Look for medicine
    - language: 3
      text: "\u85AC\u3092\u63A2\u3059"
    - language: 4
      text: "\uC57D\uC744 \uCC3E\uB294\uB2E4"
    - language: 5
      text: "Chercher des m\xE9dicaments"
    - language: 6
      text: Medikamente suchen
    - language: 7
      text: Buscar medicinas
    - language: 8
      text: "Procurar rem\xE9dios"
    - language: 9
      text: "\u041F\u043E\u0439\u0442\u0438 \u0438\u0441\u043A\u0430\u0442\u044C
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430"
  - key: os.memory.1650.text
    values:
    - language: 0
      text: "\u6211\u5F80'\u5783\u573E\u573A'\u6DF1\u5904\u8D70\u4E86\u4F1A\u513F\uFF0C<color=red>\"\u8FD9\u7834\u5730\u65B9\u771F\u662F\u81ED\u5B8C\u4E86\uFF0C\u4F60\u600E\u4E48\u4F1A\u60F3\u5230\u8FD9\u79CD\u5730\u65B9\u6253\u6EDA\u3002\u8FD9\u91CC\u770B\u8D77\u6765\u50CF\u662F\u6709\u4F60\u5973\u513F\u7684\u5730\u65B9\u5417\uFF1F\"</color>"
    - language: 1
      text: "\u6211\u5F80'\u5783\u573E\u5834'\u6DF1\u8655\u8D70\u4E86\u6703\u5152\uFF0C<color=red>\"\u9019\u7834\u5730\u65B9\u771F\u662F\u81ED\u5B8C\u4E86\uFF0C\u4F60\u600E\u9EBC\u6703\u60F3\u5230\u9019\u7A2E\u5730\u65B9\u6253\u6EFE\u3002\u9019\u88E1\u770B\u8D77\u4F86\u50CF\u662F\u6709\u4F60\u5973\u5152\u7684\u5730\u65B9\u55CE\uFF1F\"</color>"
    - language: 2
      text: I walk deeper into the 'dump'. <color=red>"This place stinks to high
        heaven. What possessed you to go rooting around here? Does this look like
        somewhere your daughter would be?"</color>
    - language: 3
      text: "\u300C\u30B4\u30DF\u6368\u3066\u5834\u300D\u306E\u5965\u3078\u3057\u3070\u3089\u304F\u6B69\u304F\u3002<color=red>\u300C\u3053\u3053\u3001\u3072\u3069\u3044\u81ED\u3044\u306D\u3002\u3088\u304F\u3053\u3093\u306A\u5834\u6240\u3092\u6F01\u308D\u3046\u3068\u601D\u3063\u305F\u3082\u306E\u3060\u308F\u3002\u5A18\u304C\u3044\u305D\u3046\u306A\u5834\u6240\u306B\u898B\u3048\u308B\uFF1F\u300D</color>"
    - language: 4
      text: "\uB098\uB294 '\uC4F0\uB808\uAE30\uC7A5' \uC548\uCABD\uC73C\uB85C \uC870\uAE08
        \uAC77\uB294\uB2E4. <color=red>\"\uC774\uB7F0 \uB370\uB294 \uB0C4\uC0C8\uAC00
        \uC9C0\uB3C5\uD558\uB124. \uB300\uCCB4 \uBB34\uC2A8 \uC0DD\uAC01\uC73C\uB85C
        \uC5EC\uAE38 \uB4A4\uC9C0\uB824\uB294 \uAC70\uC57C? \uB124 \uB538\uC774 \uC788\uC744
        \uB9CC\uD55C \uACF3\uC73C\uB85C \uBCF4\uC5EC?\"</color>"
    - language: 5
      text: "Je m'enfonce dans la \xAB d\xE9charge \xBB. <color=red>\"\xC7a pue \xE0
        mourir ici. Qu'est-ce qui t'a pris de venir fouiller l\xE0-dedans ? Tu crois
        vraiment que ta fille serait dans un endroit pareil ?\"</color>"
    - language: 6
      text: "Ich gehe tiefer in die \u201EM\xFCllhalde\u201C. <color=red>\"Hier stinkt
        es zum Himmel. Wie kommst du darauf, hier herumzuw\xFChlen? Sieht das aus
        wie ein Ort, an dem deine Tochter w\xE4re?\"</color>"
    - language: 7
      text: "Me adentro en el \xABvertedero\xBB. <color=red>\"Esto apesta. \xBFC\xF3mo
        se te ocurre revolcarte en un sitio as\xED? \xBFTe parece un lugar donde
        estar\xEDa tu hija?\"</color>"
    - language: 8
      text: "Ando mais para dentro do \"lix\xE3o\". <color=red>\"Este lugar fede
        demais. Como voc\xEA foi inventar de se enfiar aqui? Isso parece um lugar
        onde sua filha estaria?\"</color>"
    - language: 9
      text: "\u0418\u0434\u0443 \u0432\u0433\u043B\u0443\u0431\u044C \xAB\u0441\u0432\u0430\u043B\u043A\u0438\xBB.
        <color=red>\"\u0417\u0434\u0435\u0441\u044C \u0436\u0435 \u0432\u043E\u043D\u044F\u0435\u0442
        \u0434\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438.
        \u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0448\u043B\u043E
        \u0432 \u0433\u043E\u043B\u043E\u0432\u0443 \u043A\u043E\u043F\u0430\u0442\u044C\u0441\u044F
        \u0432 \u0442\u0430\u043A\u043E\u043C \u043C\u0435\u0441\u0442\u0435? \u0414\u0443\u043C\u0430\u0435\u0448\u044C,
        \u0437\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
        \u0442\u0432\u043E\u044F \u0434\u043E\u0447\u044C?\"</color>"
  - key: os.memory.1660.text
    values:
    - language: 0
      text: "\"\u95ED\u5634\u3002\""
    - language: 1
      text: "\"\u9589\u5634\u3002\""
    - language: 2
      text: '"Shut up."'
    - language: 3
      text: "\u300C\u9ED9\u3063\u3066\u300D"
    - language: 4
      text: "\"\uB2E5\uCCD0.\""
    - language: 5
      text: '"Tais-toi."'
    - language: 6
      text: '"Halt den Mund."'
    - language: 7
      text: "\"C\xE1llate.\""
    - language: 8
      text: '"Cala a boca."'
    - language: 9
      text: "\"\u0417\u0430\u0442\u043A\u043D\u0438\u0441\u044C\"."
  - key: os.memory.1670.text
    values:
    - language: 0
      text: "\u5979\u53C8\u5728\u53D6\u7B11\u6211\u4E86...\u597D\u70E6\u4EBA\u3002"
    - language: 1
      text: "\u5979\u53C8\u5728\u53D6\u7B11\u6211\u4E86...\u597D\u7169\u4EBA\u3002"
    - language: 2
      text: She's making fun of me again... So annoying.
    - language: 3
      text: "\u307E\u305F\u79C1\u3092\u304B\u3089\u304B\u3063\u3066\u3044\u308B...\u9B31\u9676\u3057\u3044\u3002"
    - language: 4
      text: "\uB610 \uB098\uB97C \uBE44\uC6C3\uB294\uB2E4... \uC815\uB9D0 \uC131\uAC00\uC2DC\uB2E4."
    - language: 5
      text: Elle se moque encore de moi... Quelle plaie.
    - language: 6
      text: "Sie macht sich wieder \xFCber mich lustig... Wie l\xE4stig."
    - language: 7
      text: "Vuelve a burlarse de m\xED... Qu\xE9 pesada."
    - language: 8
      text: "Ela est\xE1 zombando de mim de novo... Que irritante."
    - language: 9
      text: "\u041E\u043F\u044F\u0442\u044C \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439
        \u043D\u0430\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F... \u041A\u0430\u043A
        \u0436\u0435 \u043D\u0430\u0434\u043E\u0435\u043B\u0430."
  - key: os.memory.1680.text
    values:
    - language: 0
      text: "\u6211\u6380\u5F00\u6700\u4E0A\u9762\u7684\u4E00\u53EA\u7BB1\u5B50\uFF0C\u91CC\u9762\u4E1C\u897F\u653E\u5F97\u8FD8\u7B97\u6574\u9F50...\u6216\u8BB8\u4E1C\u897F\u5C31\u5728\u9644\u8FD1\u4E86\uFF0C\u6211\u62C9\u4E86\u62C9\u4E0B\u9762\u8FD9\u4E2A\u9501\u4F4F\u7684\u62BD\u5C49."
    - language: 1
      text: "\u6211\u6380\u958B\u6700\u4E0A\u9762\u7684\u4E00\u96BB\u7BB1\u5B50\uFF0C\u88E1\u9762\u6771\u897F\u653E\u5F97\u9084\u7B97\u6574\u9F4A...\u6216\u8A31\u6771\u897F\u5C31\u5728\u9644\u8FD1\u4E86\uFF0C\u6211\u62C9\u4E86\u62C9\u4E0B\u9762\u9019\u500B\u9396\u4F4F\u7684\u62BD\u5C5C."
    - language: 2
      text: I open the box on top. Its contents are fairly neat... Perhaps what I
        need is nearby. I tug at the locked drawer underneath.
    - language: 3
      text: "\u4E00\u756A\u4E0A\u306E\u7BB1\u3092\u958B\u3051\u308B\u3002\u4E2D\u8EAB\u306F\u610F\u5916\u3068\u6574\u3063\u3066\u3044\u305F...\u63A2\u3057\u3066\u3044\u308B\u7269\u306F\u8FD1\u304F\u306B\u3042\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u305D\u306E\u4E0B\u306E\u3001\u9375\u306E\u304B\u304B\u3063\u305F\u5F15\u304D\u51FA\u3057\u3092\u5F15\u3044\u3066\u307F\u308B\u3002"
    - language: 4
      text: "\uB9E8 \uC704\uC758 \uC0C1\uC790\uB97C \uC5F0\uB2E4. \uC548\uC758 \uBB3C\uAC74\uB4E4\uC740
        \uAF64 \uAC00\uC9C0\uB7F0\uD558\uB2E4... \uCC3E\uB294 \uBB3C\uAC74\uC774
        \uADFC\uCC98\uC5D0 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uC544\uB798\uCABD\uC758
        \uC7A0\uAE34 \uC11C\uB78D\uC744 \uB2F9\uACA8 \uBCF8\uB2E4."
    - language: 5
      text: "J'ouvre la caisse du dessus. Son contenu est assez bien rang\xE9...
        Ce que je cherche est peut-\xEAtre tout pr\xE8s. Je tire sur le tiroir ferm\xE9
        \xE0 cl\xE9 juste en dessous."
    - language: 6
      text: "Ich \xF6ffne die oberste Kiste. Der Inhalt ist recht ordentlich verstaut...
        Vielleicht liegt das Gesuchte ganz in der N\xE4he. Ich ziehe an der verschlossenen
        Schublade darunter."
    - language: 7
      text: "Abro la caja de arriba. Dentro est\xE1 todo bastante ordenado... Quiz\xE1
        lo que busco est\xE9 cerca. Tiro del caj\xF3n cerrado con llave que hay debajo."
    - language: 8
      text: "Abro a caixa de cima. As coisas l\xE1 dentro est\xE3o at\xE9 arrumadas...
        Talvez o que eu preciso esteja por perto. Puxo a gaveta trancada logo abaixo."
    - language: 9
      text: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u044E \u0432\u0435\u0440\u0445\u043D\u044E\u044E
        \u043A\u043E\u0440\u043E\u0431\u043A\u0443. \u0412\u0435\u0449\u0438 \u0432\u043D\u0443\u0442\u0440\u0438
        \u0441\u043B\u043E\u0436\u0435\u043D\u044B \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
        \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E... \u041C\u043E\u0436\u0435\u0442,
        \u043D\u0443\u0436\u043D\u043E\u0435 \u0433\u0434\u0435-\u0442\u043E \u0440\u044F\u0434\u043E\u043C.
        \u0414\u0451\u0440\u0433\u0430\u044E \u0437\u0430\u043F\u0435\u0440\u0442\u044B\u0439
        \u044F\u0449\u0438\u043A \u043F\u043E\u0434 \u043D\u0435\u0439."
  - key: os.memory.1690.text
    values:
    - language: 0
      text: "\u5C31\u5728\u8FD9\u65F6\u5019\uFF0C\u4E0B\u9762\u6709\u4EC0\u4E48\u4E1C\u897F\u54CD\u4E86\u4E00\u58F0\u3002"
    - language: 1
      text: "\u5C31\u5728\u9019\u6642\u5019\uFF0C\u4E0B\u9762\u6709\u4EC0\u9EBC\u6771\u897F\u97FF\u4E86\u4E00\u8072\u3002"
    - language: 2
      text: Just then, something makes a noise below.
    - language: 3
      text: "\u305D\u306E\u3068\u304D\u3001\u4E0B\u3067\u4F55\u304B\u304C\u97F3\u3092\u7ACB\u3066\u305F\u3002"
    - language: 4
      text: "\uBC14\uB85C \uADF8\uB54C \uC544\uB798\uC5D0\uC11C \uBB34\uC5B8\uAC00
        \uC18C\uB9AC\uB97C \uB0B8\uB2E4."
    - language: 5
      text: "\xC0 ce moment-l\xE0, quelque chose fait du bruit en dessous."
    - language: 6
      text: "Genau da gibt etwas darunter ein Ger\xE4usch von sich."
    - language: 7
      text: "Justo entonces, algo hace un ruido ah\xED abajo."
    - language: 8
      text: "\xC9 a\xED que alguma coisa faz barulho l\xE1 embaixo."
    - language: 9
      text: "\u0418 \u0442\u0443\u0442 \u0432\u043D\u0438\u0437\u0443 \u0447\u0442\u043E-\u0442\u043E
        \u0438\u0437\u0434\u0430\u0451\u0442 \u0437\u0432\u0443\u043A."
  - key: os.memory.1700.text
    values:
    - language: 0
      text: "\u201C\u2026\u2026\u8BF7\u2026\u2026\u201D"
    - language: 1
      text: "\u201C\u2026\u2026\u8ACB\u2026\u2026\u201D"
    - language: 2
      text: '"...Please..."'
    - language: 3
      text: "\u300C\u2026\u2026\u3069\u3046\u305E\u2026\u2026\u300D"
    - language: 4
      text: "\"\u2026\u2026\uBD80\uB514\u2026\u2026\""
    - language: 5
      text: '"...Veuillez..."'
    - language: 6
      text: '"...Bitte..."'
    - language: 7
      text: '"...Por favor..."'
    - language: 8
      text: '"...Por favor..."'
    - language: 9
      text: "\"...\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430...\""
  - key: os.memory.1710.text
    values:
    - language: 0
      text: "...\u673A\u68B0\u58F0\uFF1F\u6211\u4FA7\u7740\u5934\u542C\u4E86\u51E0\u79D2\uFF0C\u6CA1\u6709\u4E0B\u6587\uFF0C\u8FD9\u4E2A\u5783\u573E\u573A\u600E\u4E48\u53EF\u80FD\u6709\u52A9\u624B\u673A\u5668\u4EBA\u8FD9\u6837\u7684\u4E8B\u60C5...\u5C31\u7B97\u5F53\u5E74\u8FD8\u662F\u4E2A\u7814\u7A76\u5458\u7684\u65F6\u5019\uFF0C\u6211\u7684\u5DE5\u8D44\u4E5F\u6512\u4E0D\u51FA\u6765\u4E70\u52A9\u624B\u673A\u5668\u4EBA\u7684\u3002"
    - language: 1
      text: "...\u6A5F\u68B0\u8072\uFF1F\u6211\u5074\u8457\u982D\u807D\u4E86\u5E7E\u79D2\uFF0C\u6C92\u6709\u4E0B\u6587\uFF0C\u9019\u500B\u5783\u573E\u5834\u600E\u9EBC\u53EF\u80FD\u6709\u52A9\u624B\u6A5F\u5668\u4EBA\u9019\u6A23\u7684\u4E8B\u60C5...\u5C31\u7B97\u7576\u5E74\u9084\u662F\u500B\u7814\u7A76\u54E1\u7684\u6642\u5019\uFF0C\u6211\u7684\u5DE5\u8CC7\u4E5F\u6522\u4E0D\u51FA\u4F86\u8CB7\u52A9\u624B\u6A5F\u5668\u4EBA\u7684\u3002"
    - language: 2
      text: ...A mechanical voice? I tilt my head and listen for a few seconds. Nothing
        more. An assistant robot in a dump like this? Impossible... Even when I was
        a researcher, I couldn't have saved up enough on my salary to buy one.
    - language: 3
      text: "...\u6A5F\u68B0\u306E\u58F0\uFF1F\u3000\u9996\u3092\u50BE\u3051\u3066\u6570\u79D2\u805E\u304F\u304C\u3001\u7D9A\u304D\u306F\u306A\u3044\u3002\u3053\u3093\u306A\u30B4\u30DF\u6368\u3066\u5834\u306B\u52A9\u624B\u30ED\u30DC\u30C3\u30C8\u304C\u3044\u308B\u306A\u3093\u3066...\u7814\u7A76\u54E1\u3060\u3063\u305F\u3053\u308D\u3067\u3055\u3048\u3001\u79C1\u306E\u7D66\u6599\u3067\u306F\u8CB7\u3046\u304A\u91D1\u3092\u8CAF\u3081\u3089\u308C\u306A\u304B\u3063\u305F\u306E\u306B\u3002"
    - language: 4
      text: "...\uAE30\uACC4\uC74C? \uACE0\uAC1C\uB97C \uAE30\uC6B8\uC5EC \uBA87
        \uCD08 \uB4E4\uC5B4 \uBCF4\uC9C0\uB9CC \uB2E4\uC74C \uB9D0\uC740 \uC5C6\uB2E4.
        \uC774\uB7F0 \uC4F0\uB808\uAE30\uC7A5\uC5D0 \uBCF4\uC870 \uB85C\uBD07\uC774\uB77C\uB2C8...
        \uC5F0\uAD6C\uC6D0\uC73C\uB85C \uC77C\uD560 \uB54C\uC870\uCC28 \uB0B4 \uC6D4\uAE09\uC744
        \uBAA8\uC544\uC11C\uB294 \uC0B4 \uC218 \uC5C6\uB358 \uBB3C\uAC74\uC774\uB2E4."
    - language: 5
      text: "...Une voix m\xE9canique ? Je tends l'oreille quelques secondes. Plus
        rien. Un robot assistant dans une d\xE9charge pareille ? Impossible... M\xEAme
        quand j'\xE9tais chercheuse, mon salaire ne m'aurait jamais permis d'en acheter
        un."
    - language: 6
      text: "...Eine mechanische Stimme? Ich neige den Kopf und lausche ein paar
        Sekunden. Nichts mehr. Ein Assistenzroboter auf so einer M\xFCllhalde? Unm\xF6glich...
        Nicht einmal als Forscherin h\xE4tte ich von meinem Gehalt genug f\xFCr einen
        sparen k\xF6nnen."
    - language: 7
      text: "...\xBFUna voz mec\xE1nica? Inclino la cabeza y escucho unos segundos.
        Nada m\xE1s. \xBFUn robot asistente en este vertedero? Imposible... Ni cuando
        era investigadora habr\xEDa podido ahorrar suficiente con mi sueldo para
        comprar uno."
    - language: 8
      text: "...Uma voz mec\xE2nica? Inclino a cabe\xE7a e escuto por alguns segundos.
        Nada mais. Um rob\xF4 assistente num lix\xE3o desses? Imposs\xEDvel... Nem
        quando eu era pesquisadora conseguiria juntar dinheiro do sal\xE1rio para
        comprar um."
    - language: 9
      text: "...\u041C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0433\u043E\u043B\u043E\u0441? \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044E\u0441\u044C,
        \u0441\u043A\u043B\u043E\u043D\u0438\u0432 \u0433\u043E\u043B\u043E\u0432\u0443.
        \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F \u043D\u0435\u0442.
        \u041E\u0442\u043A\u0443\u0434\u0430 \u043D\u0430 \u0442\u0430\u043A\u043E\u0439
        \u0441\u0432\u0430\u043B\u043A\u0435 \u0440\u043E\u0431\u043E\u0442-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A?..
        \u0414\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430 \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430
        \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C,
        \u0441 \u043C\u043E\u0435\u0439 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u043E\u0439
        \u043D\u0430 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u043E \u043D\u0435
        \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u044C."
  - key: os.memory.1720.text
    values:
    - language: 0
      text: "\u6211\u7ED5\u5230\u53E6\u4E00\u8FB9\uFF0C\u6380\u5F00\u6302\u5728\u4E0A\u9762\u7684\u7834\u5E03\u3002\u90A3\u6709\u4E00\u622A\u624B\u81C2\uFF0C\u5173\u8282\u5904\u7684\u5916\u58F3\u5DF2\u7ECF\u88C2\u5F00\u4E86\uFF0C\u51E0\u6839\u7EBF\u4ECE\u91CC\u9762\u5782\u51FA\u6765....\u54C8\uFF1F\u771F\u662F\u673A\u5668\u4EBA\u3002"
    - language: 1
      text: "\u6211\u7E5E\u5230\u53E6\u4E00\u908A\uFF0C\u6380\u958B\u639B\u5728\u4E0A\u9762\u7684\u7834\u5E03\u3002\u90A3\u6709\u4E00\u622A\u624B\u81C2\uFF0C\u95DC\u7BC0\u8655\u7684\u5916\u6BBC\u5DF2\u7D93\u88C2\u958B\u4E86\uFF0C\u5E7E\u6839\u7DDA\u5F9E\u88E1\u9762\u5782\u51FA\u4F86....\u54C8\uFF1F\u771F\u662F\u6A5F\u5668\u4EBA\u3002"
    - language: 2
      text: I go around the other side and lift the rag hanging over it. There's
        part of an arm. The casing at the joint is cracked, with a few wires dangling
        out.... Huh? It really is a robot.
    - language: 3
      text: "\u53CD\u5BFE\u5074\u3078\u56DE\u308A\u3001\u639B\u304B\u3063\u3066\u3044\u305F\u307C\u308D\u5E03\u3092\u3081\u304F\u308B\u3002\u8155\u306E\u4E00\u90E8\u304C\u3042\u3063\u305F\u3002\u95A2\u7BC0\u306E\u5916\u88C5\u304C\u5272\u308C\u3001\u6570\u672C\u306E\u7DDA\u304C\u5782\u308C\u3066\u3044\u308B....\u306F\uFF1F\u3000\u672C\u5F53\u306B\u30ED\u30DC\u30C3\u30C8\u3060\u3002"
    - language: 4
      text: "\uBC18\uB300\uD3B8\uC73C\uB85C \uB3CC\uC544\uAC00 \uB36E\uC5EC \uC788\uB358
        \uCC9C \uC870\uAC01\uC744 \uB4E4\uCD98\uB2E4. \uD314 \uC77C\uBD80\uAC00 \uBCF4\uC778\uB2E4.
        \uAD00\uC808\uC758 \uC678\uC7A5\uC774 \uAC08\uB77C\uC9C0\uACE0 \uC804\uC120
        \uBA87 \uAC00\uB2E5\uC774 \uB298\uC5B4\uC838 \uC788\uB2E4.... \uC5B4? \uC9C4\uC9DC
        \uB85C\uBD07\uC774\uB2E4."
    - language: 5
      text: "Je passe de l'autre c\xF4t\xE9 et soul\xE8ve le chiffon pos\xE9 dessus.
        Un morceau de bras. La coque de l'articulation est fendue, quelques fils
        pendent.... Hein ? C'est vraiment un robot."
    - language: 6
      text: "Ich gehe auf die andere Seite und hebe den Fetzen an, der dar\xFCberh\xE4ngt.
        Ein St\xFCck Arm. Das Geh\xE4use am Gelenk ist aufgebrochen, ein paar Kabel
        h\xE4ngen heraus.... H\xE4? Es ist wirklich ein Roboter."
    - language: 7
      text: "Rodeo el mont\xF3n y levanto el trapo que lo cubre. Hay parte de un
        brazo, con la carcasa de la articulaci\xF3n agrietada y unos cables colgando....
        \xBFEh? S\xED que es un robot."
    - language: 8
      text: "Dou a volta e levanto o pano que cobre o monte. H\xE1 parte de um bra\xE7o,
        com a carca\xE7a da junta rachada e alguns fios pendurados.... H\xE3? \xC9
        mesmo um rob\xF4."
    - language: 9
      text: "\u041E\u0431\u0445\u043E\u0436\u0443 \u0441 \u0434\u0440\u0443\u0433\u043E\u0439
        \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0438 \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E
        \u0441\u0432\u0438\u0441\u0430\u044E\u0449\u0443\u044E \u0442\u0440\u044F\u043F\u043A\u0443.
        \u0412\u0438\u0434\u043D\u0430 \u0447\u0430\u0441\u0442\u044C \u0440\u0443\u043A\u0438.
        \u041A\u043E\u0440\u043F\u0443\u0441 \u0443 \u0441\u0443\u0441\u0442\u0430\u0432\u0430
        \u0442\u0440\u0435\u0441\u043D\u0443\u043B, \u043D\u0430\u0440\u0443\u0436\u0443
        \u0441\u0432\u0438\u0441\u0430\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043F\u0440\u043E\u0432\u043E\u0434\u043E\u0432.... \u0410? \u0418 \u043F\u0440\u0430\u0432\u0434\u0430
        \u0440\u043E\u0431\u043E\u0442."
  - key: os.memory.1730.text
    values:
    - language: 0
      text: "\u6211\u642C\u5F00\u4E0A\u9762\u7684\u6742\u7269\uFF0C\u770B\u8D77\u6765\u662F\u4E00\u53F0\u770B\u62A4\u578B\u7684\u5E9F\u54C1...\u5B83\u7684\u4E0B\u534A\u8EAB\u90FD\u538B\u5728\u5E95\u4E0B\u4E86\uFF0C\u6E05\u7406\u51FA\u6765\u8981\u82B1\u70B9\u65F6\u95F4\u3002"
    - language: 1
      text: "\u6211\u642C\u958B\u4E0A\u9762\u7684\u96DC\u7269\uFF0C\u770B\u8D77\u4F86\u662F\u4E00\u81FA\u770B\u8B77\u578B\u7684\u5EE2\u54C1...\u5B83\u7684\u4E0B\u534A\u8EAB\u90FD\u58D3\u5728\u5E95\u4E0B\u4E86\uFF0C\u6E05\u7406\u51FA\u4F86\u8981\u82B1\u9EDE\u6642\u9593\u3002"
    - language: 2
      text: I move the junk on top of it. Looks like a scrapped care robot... Its
        whole lower body is buried. Getting it out will take a while.
    - language: 3
      text: "\u4E0A\u306E\u304C\u3089\u304F\u305F\u3092\u3069\u304B\u3059\u3002\u770B\u8B77\u7528\u306E\u5EC3\u68C4\u54C1\u3089\u3057\u3044...\u4E0B\u534A\u8EAB\u304C\u3059\u3063\u304B\u308A\u57CB\u307E\u3063\u3066\u3044\u308B\u3002\u6398\u308A\u51FA\u3059\u306B\u306F\u6642\u9593\u304C\u304B\u304B\u308B\u3002"
    - language: 4
      text: "\uC704\uC5D0 \uC313\uC778 \uC7A1\uB3D9\uC0AC\uB2C8\uB97C \uCE58\uC6B4\uB2E4.
        \uAC04\uBCD1\uC6A9\uC73C\uB85C \uC4F0\uB358 \uD3D0\uD488 \uAC19\uB2E4...
        \uD558\uBC18\uC2E0\uC774 \uC804\uBD80 \uBC11\uC5D0 \uAE54\uB824 \uC788\uB2E4.
        \uAEBC\uB0B4\uB824\uBA74 \uC2DC\uAC04\uC774 \uC880 \uAC78\uB9AC\uACA0\uB2E4."
    - language: 5
      text: "Je d\xE9gage les objets qui le recouvrent. On dirait une \xE9pave de
        robot soignant... Toute la partie inf\xE9rieure est coinc\xE9e dessous. Le
        d\xE9gager prendra du temps."
    - language: 6
      text: "Ich r\xE4ume den Kram \xFCber ihm weg. Sieht nach einem ausrangierten
        Pflegeroboter aus... Sein ganzer Unterk\xF6rper ist versch\xFCttet. Ihn freizulegen
        wird dauern."
    - language: 7
      text: "Aparto los trastos de encima. Parece un robot de cuidados desechado...
        Tiene toda la parte inferior atrapada. Sacarlo llevar\xE1 tiempo."
    - language: 8
      text: "Tiro os trastes de cima. Parece uma sucata de rob\xF4 cuidador... A
        parte de baixo inteira est\xE1 presa. Vai dar trabalho tirar."
    - language: 9
      text: "\u0423\u0431\u0438\u0440\u0430\u044E \u0445\u043B\u0430\u043C \u0441\u0432\u0435\u0440\u0445\u0443.
        \u041F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u0441\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0433\u043E
        \u0440\u043E\u0431\u043E\u0442\u0430-\u0441\u0438\u0434\u0435\u043B\u043A\u0443...
        \u041D\u0438\u0436\u043D\u044F\u044F \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
        \u0446\u0435\u043B\u0438\u043A\u043E\u043C \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u0430.
        \u0427\u0442\u043E\u0431\u044B \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C,
        \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0432\u0440\u0435\u043C\u044F."
  - key: os.memory.1740.text
    values:
    - language: 0
      text: "\u201C\u8BF7\u2026\u2026\u5750\u2026\u2026\u201D"
    - language: 1
      text: "\u201C\u8ACB\u2026\u2026\u5750\u2026\u2026\u201D"
    - language: 2
      text: '"Please... sit..."'
    - language: 3
      text: "\u300C\u3069\u3046\u305E\u2026\u2026\u304A\u639B\u3051\u306B\u2026\u2026\u300D"
    - language: 4
      text: "\"\uBD80\uB514\u2026\u2026\uC549\uC73C\uC138\uC694\u2026\u2026\""
    - language: 5
      text: '"Veuillez... vous asseoir..."'
    - language: 6
      text: '"Bitte... setzen..."'
    - language: 7
      text: "\"Por favor... si\xE9ntese...\""
    - language: 8
      text: '"Por favor... sente-se..."'
    - language: 9
      text: "\"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430... \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C...\""
  - key: os.memory.1750.text
    values:
    - language: 0
      text: "\u5B83\u53C8\u54CD\u4E86\u4E00\u4E0B...\u54C8\uFF1F\u539F\u6765\u662F\u8BF7\u5750\u5417\uFF1F\u6211\u6709\u70B9\u4E0D\u77E5\u9053\u8BF4\u4EC0\u4E48...\u6211\u8FD8\u4EE5\u4E3A\u662F\u8BF7\u5E2E\u5E2E\u6211\u4EC0\u4E48\u7684\uFF0C\u641E\u4EC0\u4E48\u554A\u3002\u600E\u4E48\u662F\u8BF7\u5750\u3002\u8822\u7206\u4E86\u3002"
    - language: 1
      text: "\u5B83\u53C8\u97FF\u4E86\u4E00\u4E0B...\u54C8\uFF1F\u539F\u4F86\u662F\u8ACB\u5750\u55CE\uFF1F\u6211\u6709\u9EDE\u4E0D\u77E5\u9053\u8AAA\u4EC0\u9EBC...\u6211\u9084\u4EE5\u70BA\u662F\u8ACB\u5E6B\u5E6B\u6211\u4EC0\u9EBC\u7684\uFF0C\u641E\u4EC0\u9EBC\u554A\u3002\u600E\u9EBC\u662F\u8ACB\u5750\u3002\u8822\u7206\u4E86\u3002"
    - language: 2
      text: It speaks again... Huh? 'Please sit'? I don't know what to say... I thought
        it was going to ask for help. What the hell? Why 'please sit'? How stupid.
    - language: 3
      text: "\u307E\u305F\u58F0\u304C\u3057\u305F...\u306F\uFF1F\u3000\u300C\u3069\u3046\u305E\u304A\u639B\u3051\u306B\u300D\u306A\u306E\uFF1F\u3000\u8A00\u8449\u304C\u51FA\u306A\u3044...\u52A9\u3051\u3066\u307B\u3057\u3044\u306E\u304B\u3068\u601D\u3063\u305F\u3002\u4F55\u306A\u306E\u3088\u3002\u3069\u3046\u3057\u3066\u5EA7\u308C\u306A\u306E\u3002\u99AC\u9E7F\u307F\u305F\u3044\u3002"
    - language: 4
      text: "\uB2E4\uC2DC \uC18C\uB9AC\uAC00 \uB09C\uB2E4... \uC5B4? '\uC549\uC73C\uC138\uC694'\uC600\uC5B4?
        \uD560 \uB9D0\uC744 \uBAA8\uB974\uACA0\uB2E4... \uB3C4\uC640 \uB2EC\uB77C\uB294
        \uB9D0\uC778 \uC904 \uC54C\uC558\uB294\uB370. \uBB50\uC57C, \uB300\uCCB4.
        \uC65C \uC549\uC73C\uB77C\uB294 \uAC70\uC57C. \uBA4D\uCCAD\uD558\uAE30\uB294."
    - language: 5
      text: "Il reparle... Hein ? \xAB Veuillez vous asseoir \xBB ? Je ne sais pas
        quoi dire... Je pensais qu'il allait demander de l'aide. C'est quoi, ce d\xE9lire
        ? Pourquoi m'asseoir ? Compl\xE8tement idiot."
    - language: 6
      text: "Er spricht wieder... H\xE4? \u201EBitte setzen\u201C? Ich wei\xDF nicht,
        was ich sagen soll... Ich dachte, er w\xFCrde um Hilfe bitten. Was soll der
        Mist? Wieso setzen? Wie d\xE4mlich."
    - language: 7
      text: "Vuelve a hablar... \xBFEh? \xBF\xABPor favor, si\xE9ntese\xBB? No s\xE9
        qu\xE9 decir... Cre\xEDa que iba a pedir ayuda. \xBFQu\xE9 demonios? \xBFPor
        qu\xE9 sentarse? Menuda estupidez."
    - language: 8
      text: "Ele fala de novo... H\xE3? \"Sente-se\"? N\xE3o sei o que dizer... Achei
        que ia pedir ajuda. Que hist\xF3ria \xE9 essa? Por que sentar? Que coisa
        idiota."
    - language: 9
      text: "\u041E\u043D \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0434\u0430\u0451\u0442
        \u0433\u043E\u043B\u043E\u0441... \u0410? \xAB\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
        \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C\xBB? \u0414\u0430\u0436\u0435
        \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C...
        \u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u0442
        \u043F\u043E\u043C\u043E\u0447\u044C. \u0427\u0442\u043E \u0437\u0430 \u0431\u0440\u0435\u0434?
        \u041F\u043E\u0447\u0435\u043C\u0443 \xAB\u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C\xBB?
        \u0421\u043E\u0432\u0441\u0435\u043C \u0442\u0443\u043F\u043E\u0439."
  - key: os.memory.1760.text
    values:
    - language: 0
      text: "\u6211\u6309\u4E86\u6309\u5B83\u6643\u52A8\u7684\u5916\u58F3\uFF0C\u5B83\u597D\u50CF\u6709\u53CD\u5E94...\u96BE\u4EE5\u7F6E\u4FE1\uFF0C\u8FD9\u73A9\u610F\u5C45\u7136\u8FD8\u5728\u8FD0\u884C\u3002"
    - language: 1
      text: "\u6211\u6309\u4E86\u6309\u5B83\u6643\u52D5\u7684\u5916\u6BBC\uFF0C\u5B83\u597D\u50CF\u6709\u53CD\u61C9...\u96E3\u4EE5\u7F6E\u4FE1\uFF0C\u9019\u73A9\u610F\u5C45\u7136\u9084\u5728\u904B\u884C\u3002"
    - language: 2
      text: I press on its loose casing. It seems to respond... Unbelievable. This
        thing is still running.
    - language: 3
      text: "\u3050\u3089\u3064\u304F\u5916\u88C5\u3092\u62BC\u3059\u3068\u3001\u53CD\u5FDC\u304C\u3042\u308B\u3089\u3057\u3044...\u4FE1\u3058\u3089\u308C\u306A\u3044\u3002\u307E\u3060\u52D5\u3044\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uD754\uB4E4\uB9AC\uB294 \uC678\uC7A5\uC744 \uB20C\uB7EC \uBCF4\uC790
        \uBC18\uC751\uD558\uB294 \uAC83 \uAC19\uB2E4... \uBBFF\uAE30\uC9C0 \uC54A\uB294\uB2E4.
        \uC774\uAC8C \uC544\uC9C1 \uC791\uB3D9\uD558\uACE0 \uC788\uB2E4\uB2C8."
    - language: 5
      text: "J'appuie sur sa coque branlante. Il semble r\xE9agir... Incroyable.
        Ce machin fonctionne encore."
    - language: 6
      text: "Ich dr\xFCcke auf sein lockeres Geh\xE4use. Er scheint zu reagieren...
        Unglaublich. Das Ding l\xE4uft tats\xE4chlich noch."
    - language: 7
      text: "Presiono su carcasa suelta. Parece reaccionar... Incre\xEDble. Este
        cacharro todav\xEDa funciona."
    - language: 8
      text: "Aperto a carca\xE7a bamba. Ele parece reagir... Inacredit\xE1vel. Este
        tro\xE7o ainda est\xE1 funcionando."
    - language: 9
      text: "\u041D\u0430\u0436\u0438\u043C\u0430\u044E \u043D\u0430 \u0431\u043E\u043B\u0442\u0430\u044E\u0449\u0443\u044E\u0441\u044F
        \u043E\u0431\u0448\u0438\u0432\u043A\u0443. \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442... \u041D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E.
        \u042D\u0442\u0430 \u0448\u0442\u0443\u043A\u0430 \u0434\u043E \u0441\u0438\u0445
        \u043F\u043E\u0440 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
  - key: os.memory.1760.option.1
    values:
    - language: 0
      text: "\u628A\u5979\u5F04\u51FA\u6765"
    - language: 1
      text: "\u628A\u5979\u5F04\u51FA\u4F86"
    - language: 2
      text: Pull her out
    - language: 3
      text: "\u5F7C\u5973\u3092\u5F15\u3063\u5F35\u308A\u51FA\u3059"
    - language: 4
      text: "\uADF8\uB140\uB97C \uAEBC\uB0B8\uB2E4"
    - language: 5
      text: "La d\xE9gager"
    - language: 6
      text: Sie herausholen
    - language: 7
      text: Sacarla
    - language: 8
      text: "Tirar ela de l\xE1"
    - language: 9
      text: "\u0412\u044B\u0442\u0430\u0449\u0438\u0442\u044C \u0435\u0451"
  - key: os.memory.1760.option.2
    values:
    - language: 0
      text: "\u5148\u627E\u836F"
    - language: 1
      text: "\u5148\u627E\u85E5"
    - language: 2
      text: Look for the medicine first
    - language: 3
      text: "\u5148\u306B\u85AC\u3092\u63A2\u3059"
    - language: 4
      text: "\uBA3C\uC800 \uC57D\uC744 \uCC3E\uB294\uB2E4"
    - language: 5
      text: "Chercher d'abord les m\xE9dicaments"
    - language: 6
      text: Zuerst nach Medikamenten suchen
    - language: 7
      text: Buscar primero la medicina
    - language: 8
      text: "Procurar o rem\xE9dio primeiro"
    - language: 9
      text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0439\u0442\u0438
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E"
  - key: os.memory.1770.text
    values:
    - language: 0
      text: "\u6211\u627E\u4E86\u5757\u6728\u5934\uFF0C\u628A\u90A3\u4E2A\u53EF\u80FD\u4F1A\u677E\u52A8\u7684\u5730\u65B9\u67B6\u4F4F\uFF0C\u81F3\u5C11\u522B\u8BA9\u6211\u628A\u5B83\u5F04\u51FA\u6765\u7684\u65F6\u5019\u7ED9\u6211\u4E5F\u538B\u91CC\u9762\u4E86...\u628A\u5B83\u6574\u51FA\u6765\u975E\u5E38\u8D39\u52B2\uFF0C\u5B83\u8EAB\u4F53\u5361\u7684\u4F4D\u7F6E\u5F88\u6DF1\uFF0C\u6709\u70B9\u5927\u4EF6\u8D27\u8981\u5F04\u5F00\u3002\u641E\u5F97\u6211\u50CF\u4EC0\u4E48\u70ED\u9505\u4E0A\u7684\u8682\u8681\u3002"
    - language: 1
      text: "\u6211\u627E\u4E86\u584A\u6728\u982D\uFF0C\u628A\u90A3\u500B\u53EF\u80FD\u6703\u9B06\u52D5\u7684\u5730\u65B9\u67B6\u4F4F\uFF0C\u81F3\u5C11\u5225\u8B93\u6211\u628A\u5B83\u5F04\u51FA\u4F86\u7684\u6642\u5019\u7D66\u6211\u4E5F\u58D3\u88E1\u9762\u4E86...\u628A\u5B83\u6574\u51FA\u4F86\u975E\u5E38\u8CBB\u52C1\uFF0C\u5B83\u8EAB\u9AD4\u5361\u7684\u4F4D\u7F6E\u5F88\u6DF1\uFF0C\u6709\u9EDE\u5927\u4EF6\u8CA8\u8981\u5F04\u958B\u3002\u641E\u5F97\u6211\u50CF\u4EC0\u9EBC\u71B1\u934B\u4E0A\u7684\u879E\u87FB\u3002"
    - language: 2
      text: I find a piece of wood to prop up the part that looks liable to shift.
        I'd rather not get buried myself while pulling it out... It's a struggle.
        Its body is wedged deep in there, and some big pieces need moving. I'm running
        around like an ant on a hot pan.
    - language: 3
      text: "\u6728\u5207\u308C\u3092\u898B\u3064\u3051\u3001\u5D29\u308C\u305D\u3046\u306A\u3068\u3053\u308D\u3092\u652F\u3048\u308B\u3002\u5F15\u304D\u51FA\u3059\u3068\u304D\u306B\u79C1\u307E\u3067\u4E0B\u6577\u304D\u306B\u306A\u3063\u3066\u306F\u305F\u307E\u3089\u306A\u3044...\u6398\u308A\u51FA\u3059\u306E\u306F\u3072\u3069\u304F\u9AA8\u304C\u6298\u308C\u305F\u3002\u4F53\u304C\u5965\u6DF1\u304F\u306B\u631F\u307E\u308A\u3001\u5927\u304D\u306A\u7269\u3092\u3044\u304F\u3064\u3082\u3069\u304B\u3055\u306A\u3044\u3068\u3044\u3051\u306A\u3044\u3002\u71B1\u3057\u305F\u934B\u306E\u4E0A\u306E\u87FB\u307F\u305F\u3044\u306B\u52D5\u304D\u56DE\u308B\u3002"
    - language: 4
      text: "\uB098\uBB34\uD1A0\uB9C9\uC744 \uCC3E\uC544 \uC6C0\uC9C1\uC77C \uB9CC\uD55C
        \uBD80\uBD84\uC744 \uBC1B\uCE5C\uB2E4. \uAEBC\uB0B4\uB2E4\uAC00 \uB098\uAE4C\uC9C0
        \uBC11\uC5D0 \uAE54\uB9AC\uBA74 \uACE4\uB780\uD558\uB2C8\uAE4C... \uB044\uC9D1\uC5B4\uB0B4\uB294
        \uAC74 \uC815\uB9D0 \uD798\uB4E4\uB2E4. \uBAB8\uC774 \uAE4A\uC219\uC774 \uB07C\uC5B4
        \uC788\uACE0 \uD070 \uBB3C\uAC74\uB4E4\uB3C4 \uC62E\uACA8\uC57C \uD55C\uB2E4.
        \uB728\uAC70\uC6B4 \uC1A5 \uC704\uC758 \uAC1C\uBBF8\uCC98\uB7FC \uC815\uC2E0\uC5C6\uC774
        \uC6C0\uC9C1\uC778\uB2E4."
    - language: 5
      text: "Je trouve un bout de bois pour \xE9tayer la partie qui risque de bouger.
        Je pr\xE9f\xE9rerais ne pas finir ensevelie en le d\xE9gageant... C'est un
        travail \xE9puisant. Il est profond\xE9ment coinc\xE9, avec de gros objets
        \xE0 d\xE9placer. Je m'agite dans tous les sens."
    - language: 6
      text: "Ich suche ein St\xFCck Holz und st\xFCtze die Stelle ab, die verrutschen
        k\xF6nnte. Ich will schlie\xDFlich nicht selbst versch\xFCttet werden, wenn
        ich ihn herausziehe... Es ist furchtbar m\xFChsam. Er steckt tief fest, und
        ein paar gro\xDFe Teile m\xFCssen weg. Ich hetze herum wie eine Ameise auf
        einer hei\xDFen Herdplatte."
    - language: 7
      text: "Busco un trozo de madera para apuntalar la parte que podr\xEDa moverse.
        No quiero acabar enterrada al sacarlo... Cuesta much\xEDsimo. Est\xE1 encajado
        muy al fondo y hay varios trastos grandes que mover. Voy de un lado a otro
        como una hormiga en una sart\xE9n caliente."
    - language: 8
      text: "Pego um peda\xE7o de madeira para escorar a parte que pode se mexer.
        Pelo menos assim n\xE3o vou acabar soterrada ao tirar ele... \xC9 um esfor\xE7o
        enorme. Est\xE1 preso bem no fundo e h\xE1 umas coisas grandes para mover.
        Fico indo de um lado para o outro, que nem formiga numa chapa quente."
    - language: 9
      text: "\u041D\u0430\u0445\u043E\u0436\u0443 \u0434\u0435\u0440\u0435\u0432\u044F\u0448\u043A\u0443
        \u0438 \u043F\u043E\u0434\u043F\u0438\u0440\u0430\u044E \u0442\u043E, \u0447\u0442\u043E
        \u043C\u043E\u0436\u0435\u0442 \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F.
        \u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u043B\u043E \u0435\u0449\u0451
        \u0441\u0430\u043C\u043E\u0439 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
        \u043F\u043E\u0434 \u0437\u0430\u0432\u0430\u043B\u043E\u043C, \u043F\u043E\u043A\u0430
        \u0435\u0433\u043E \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u044E...
        \u0420\u0430\u0431\u043E\u0442\u0430 \u0441\u0442\u0440\u0430\u0448\u043D\u043E
        \u0442\u044F\u0436\u0451\u043B\u0430\u044F. \u041E\u043D \u0437\u0430\u0441\u0442\u0440\u044F\u043B
        \u0433\u043B\u0443\u0431\u043E\u043A\u043E, \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u0434\u0432\u0438\u0433\u0430\u0442\u044C \u043A\u0440\u0443\u043F\u043D\u044B\u0435
        \u0432\u0435\u0449\u0438. \u041C\u0435\u0447\u0443\u0441\u044C, \u043A\u0430\u043A
        \u043C\u0443\u0440\u0430\u0432\u0435\u0439 \u043D\u0430 \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u043E\u0439
        \u0441\u043A\u043E\u0432\u043E\u0440\u043E\u0434\u0435."
  - key: os.memory.1780.text
    values:
    - language: 0
      text: "\u7D2F\u6B7B\u6211\u4E86...\u6211\u6562\u6253\u4FDD\u7968\uFF0C\u8981\u662F\u88AB\u8111\u5B50\u91CC\u53E6\u5916\u7684\u90A3\u4E2A\u4EBA\u77A7\u89C1\uFF0C\u5979\u53C8\u5F97\u7B11\u8BDD\u4E2A\u4E0D\u505C\u4E86\uFF0C\u597D\u5728\u6211\u5FD9\u6D3B\u7684\u65F6\u5019\u5979\u901A\u5E38\u90FD\u4F1A\u95ED\u5634\u3002"
    - language: 1
      text: "\u7D2F\u6B7B\u6211\u4E86...\u6211\u6562\u6253\u4FDD\u7968\uFF0C\u8981\u662F\u88AB\u8166\u5B50\u88E1\u53E6\u5916\u7684\u90A3\u500B\u4EBA\u77A7\u898B\uFF0C\u5979\u53C8\u5F97\u7B11\u8A71\u500B\u4E0D\u505C\u4E86\uFF0C\u597D\u5728\u6211\u5FD9\u6D3B\u7684\u6642\u5019\u5979\u901A\u5E38\u90FD\u6703\u9589\u5634\u3002"
    - language: 2
      text: I'm exhausted... I swear, if the other person in my head saw this, she'd
        never stop laughing. Luckily, she usually shuts up while I'm busy.
    - language: 3
      text: "\u304F\u305F\u304F\u305F\u3060...\u982D\u306E\u4E2D\u306E\u3082\u3046\u4E00\u4EBA\u306B\u898B\u3089\u308C\u305F\u3089\u3001\u7D76\u5BFE\u306B\u7B11\u3044\u3082\u306E\u306B\u3055\u308C\u308B\u3002\u5E78\u3044\u3001\u79C1\u304C\u5FD9\u3057\u3044\u3068\u304D\u306F\u305F\u3044\u3066\u3044\u9ED9\u3063\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uC8FD\uB3C4\uB85D \uD798\uB4E4\uB2E4... \uBA38\uB9BF\uC18D\uC758 \uB2E4\uB978
        \uC0AC\uB78C\uC774 \uC774\uAC78 \uBD24\uB2E4\uBA74 \uB05D\uC5C6\uC774 \uBE44\uC6C3\uC5C8\uACA0\uC9C0.
        \uB2E4\uD589\uD788 \uB0B4\uAC00 \uBC14\uC058\uAC8C \uC6C0\uC9C1\uC77C \uB54C\uB294
        \uB300\uAC1C \uC785\uC744 \uB2E4\uBB38\uB2E4."
    - language: 5
      text: "Je suis ext\xE9nu\xE9e... Je parie que si l'autre dans ma t\xEAte me
        voyait, elle se moquerait sans fin. Heureusement, elle se tait g\xE9n\xE9ralement
        quand je suis occup\xE9e."
    - language: 6
      text: "Ich bin v\xF6llig erledigt... Wenn die andere in meinem Kopf das s\xE4he,
        w\xFCrde sie sich garantiert endlos dar\xFCber lustig machen. Zum Gl\xFCck
        h\xE4lt sie meistens den Mund, wenn ich besch\xE4ftigt bin."
    - language: 7
      text: "Estoy agotada... Si la otra persona de mi cabeza viera esto, seguro
        que no parar\xEDa de re\xEDrse. Por suerte, suele callarse cuando estoy ocupada."
    - language: 8
      text: "Estou acabada... Aposto que, se a outra pessoa na minha cabe\xE7a visse
        isso, n\xE3o ia parar de rir. Por sorte, ela costuma ficar quieta quando
        estou ocupada."
    - language: 9
      text: "\u042F \u0432\u044B\u043C\u043E\u0442\u0430\u043B\u0430\u0441\u044C...
        \u0414\u0430\u044E \u0441\u043B\u043E\u0432\u043E, \u0435\u0441\u043B\u0438
        \u0431\u044B \u0442\u0430, \u0434\u0440\u0443\u0433\u0430\u044F, \u0432 \u043C\u043E\u0435\u0439
        \u0433\u043E\u043B\u043E\u0432\u0435 \u044D\u0442\u043E \u0443\u0432\u0438\u0434\u0435\u043B\u0430,
        \u0441\u043C\u0435\u044F\u043B\u0430\u0441\u044C \u0431\u044B \u0431\u0435\u0437
        \u043A\u043E\u043D\u0446\u0430. \u0425\u043E\u0440\u043E\u0448\u043E \u0445\u043E\u0442\u044C
        \u043E\u0431\u044B\u0447\u043D\u043E \u043E\u043D\u0430 \u043C\u043E\u043B\u0447\u0438\u0442,
        \u043F\u043E\u043A\u0430 \u044F \u0437\u0430\u043D\u044F\u0442\u0430."
  - key: os.memory.1790.text
    values:
    - language: 0
      text: "\u6211\u626F\u7740\u90A3\u53F0\u62A5\u5E9F\u7684\u673A\u5668\u4EBA\uFF0C\u5B83\u5947\u8FF9\u822C\u5730\u8FD8\u80FD\u7AD9\u7A33\uFF0C\u5C31\u662F\u4E0D\u77E5\u9053\u8111\u5B50\u8FD8\u6B63\u5E38\u4E0D\u6B63\u5E38\u3002\u6211\u6253\u91CF\u7740\u5B83..."
    - language: 1
      text: "\u6211\u626F\u8457\u90A3\u81FA\u5831\u5EE2\u7684\u6A5F\u5668\u4EBA\uFF0C\u5B83\u5947\u8E5F\u822C\u5730\u9084\u80FD\u7AD9\u7A69\uFF0C\u5C31\u662F\u4E0D\u77E5\u9053\u8166\u5B50\u9084\u6B63\u5E38\u4E0D\u6B63\u5E38\u3002\u6211\u6253\u91CF\u8457\u5B83..."
    - language: 2
      text: I tug the scrapped robot along. Miraculously, it can still stand, though
        who knows if its brain works. I look it over...
    - language: 3
      text: "\u5EC3\u68C4\u3055\u308C\u305F\u30ED\u30DC\u30C3\u30C8\u3092\u5F15\u3063\u5F35\u308B\u3002\u5947\u8DE1\u7684\u306B\u3001\u307E\u3060\u3061\u3083\u3093\u3068\u7ACB\u3066\u308B\u3002\u982D\u307E\u3067\u6B63\u5E38\u304B\u306F\u308F\u304B\u3089\u306A\u3044\u3002\u79C1\u306F\u305D\u308C\u3092\u89B3\u5BDF\u3057\u305F..."
    - language: 4
      text: "\uD3D0\uD488 \uB85C\uBD07\uC744 \uC7A1\uC544\uB2F9\uAE34\uB2E4. \uAE30\uC801\uCC98\uB7FC
        \uC544\uC9C1 \uB611\uBC14\uB85C \uC124 \uC218 \uC788\uB2E4. \uBA38\uB9AC\uB3C4
        \uBA40\uCA61\uD55C\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC. \uB098\uB294
        \uB85C\uBD07\uC744 \uC0B4\uD3B4\uBCF8\uB2E4..."
    - language: 5
      text: "Je tire cette \xE9pave de robot. Miraculeusement, il tient debout. Quant
        \xE0 son cerveau, myst\xE8re. Je l'examine..."
    - language: 6
      text: Ich zerre den schrottreifen Roboter mit. Wie durch ein Wunder kann er
        noch stehen. Ob sein Gehirn funktioniert, ist eine andere Frage. Ich mustere
        ihn...
    - language: 7
      text: "Tiro de aquel robot desechado. Milagrosamente, a\xFAn se sostiene de
        pie. A saber si el cerebro sigue funcionando. Lo examino..."
    - language: 8
      text: "Puxo aquele rob\xF4 sucateado. Milagrosamente, ele ainda fica de p\xE9.
        Se o c\xE9rebro funciona, a\xED j\xE1 n\xE3o sei. Dou uma boa olhada..."
    - language: 9
      text: "\u0422\u044F\u043D\u0443 \u0441\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0433\u043E
        \u0440\u043E\u0431\u043E\u0442\u0430. \u0427\u0443\u0434\u043E\u043C \u043E\u043D
        \u0435\u0449\u0451 \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u0441\u0442\u043E\u044F\u0442\u044C.
        \u0410 \u0432\u043E\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
        \u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u0430 \u2014 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.
        \u042F \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E \u0435\u0433\u043E..."
  - key: os.memory.1800.text
    values:
    - language: 0
      text: "\"....\u9700\u8981..\u5E2E\u52A9\" \u6211...\u8FD9\u73A9\u610F\u73B0\u5728\u624D\u53CD\u5E94\u8FC7\u6765\uFF1F\u6211\u6709\u70B9\u6293\u72C2\uFF0C\u6211\u662F\u72AF\u4E86\u4EC0\u4E48\u75C5\u60F3\u628A\u8FD9\u4E1C\u897F\u5E26\u56DE\u5BB6\u5F53\u52A9\u624B\uFF0C\u6211\u5973\u513F\u5C0F\u65F6\u5019\u53EF\u80FD\u90FD\u77A7\u4E0D\u4E0A\u8FD9\u4E2A\u73A9\u5177\u3002"
    - language: 1
      text: "\"....\u9700\u8981..\u5E6B\u52A9\" \u6211...\u9019\u73A9\u610F\u73FE\u5728\u624D\u53CD\u61C9\u904E\u4F86\uFF1F\u6211\u6709\u9EDE\u6293\u72C2\uFF0C\u6211\u662F\u72AF\u4E86\u4EC0\u9EBC\u75C5\u60F3\u628A\u9019\u6771\u897F\u5E36\u56DE\u5BB6\u7576\u52A9\u624B\uFF0C\u6211\u5973\u5152\u5C0F\u6642\u5019\u53EF\u80FD\u90FD\u77A7\u4E0D\u4E0A\u9019\u500B\u73A9\u5177\u3002"
    - language: 2
      text: '"....Need... help." I... Is this thing only reacting now? I''m losing
        my mind. What possessed me to want to bring it home as an assistant? Even
        my daughter as a child might have turned her nose up at this toy.'
    - language: 3
      text: "\u300C....\u52A9\u3051\u304C...\u5FC5\u8981\u300D\u79C1...\u4ECA\u306B\u306A\u3063\u3066\u53CD\u5FDC\u3057\u305F\u306E\uFF1F\u3000\u982D\u304C\u304A\u304B\u3057\u304F\u306A\u308A\u305D\u3046\u3002\u3053\u3093\u306A\u3082\u306E\u3092\u5BB6\u306B\u9023\u308C\u3066\u5E30\u3063\u3066\u52A9\u624B\u306B\u3057\u3088\u3046\u3060\u306A\u3093\u3066\u3001\u4F55\u3092\u8003\u3048\u305F\u3093\u3060\u308D\u3046\u3002\u5A18\u3060\u3063\u3066\u3001\u5C0F\u3055\u3044\u3053\u308D\u3067\u3082\u3053\u3093\u306A\u304A\u3082\u3061\u3083\u306F\u898B\u5411\u304D\u3082\u3057\u306A\u304B\u3063\u305F\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
    - language: 4
      text: "\"....\uB3C4\uC6C0\uC774... \uD544\uC694\uD569\uB2C8\uB2E4.\" \uB098...
        \uC774\uAC70 \uC774\uC81C\uC57C \uBC18\uC751\uD558\uB294 \uAC70\uC57C? \uBBF8\uCE58\uACA0\uB2E4.
        \uBB34\uC2A8 \uC0DD\uAC01\uC73C\uB85C \uC774\uAC78 \uC9D1\uC5D0 \uB370\uB824\uAC00
        \uC870\uC218\uB85C \uC4F0\uB824 \uD588\uC744\uAE4C. \uB0B4 \uB538\uB3C4 \uC5B4\uB9B4
        \uB54C \uC774\uB7F0 \uC7A5\uB09C\uAC10\uC740 \uCCD0\uB2E4\uBCF4\uC9C0\uB3C4
        \uC54A\uC558\uC744\uC9C0 \uBAA8\uB978\uB2E4."
    - language: 5
      text: "\"....Besoin... d'aide.\" Je... Ce machin ne r\xE9agit que maintenant
        ? Je deviens folle. Quelle id\xE9e de vouloir le ramener comme assistant
        ! M\xEAme ma fille, petite, aurait peut-\xEAtre d\xE9daign\xE9 ce jouet."
    - language: 6
      text: "\"....Brauche... Hilfe.\" Ich... Reagiert dieses Ding erst jetzt? Ich
        drehe durch. Was hat mich geritten, ihn als Assistenten mit nach Hause nehmen
        zu wollen? Selbst meine Tochter h\xE4tte dieses Spielzeug als kleines Kind
        vielleicht verschm\xE4ht."
    - language: 7
      text: "\"....Necesito... ayuda.\" Yo... \xBFEste trasto reacciona ahora? Me
        va a volver loca. \xBFQu\xE9 me dio para querer llev\xE1rmelo a casa como
        asistente? Puede que ni mi hija de peque\xF1a hubiera querido este juguete."
    - language: 8
      text: "\"....Preciso... de ajuda.\" Eu... Este tro\xE7o s\xF3 reagiu agora?
        Vou enlouquecer. Que ideia foi essa de levar isso para casa como assistente?
        Talvez nem minha filha pequena quisesse um brinquedo desses."
    - language: 9
      text: "\"....\u041D\u0443\u0436\u043D\u0430... \u043F\u043E\u043C\u043E\u0449\u044C\".
        \u042F... \u041E\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u0439\u0447\u0430\u0441
        \u043E\u0442\u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043B?
        \u042F \u0441\u043E\u0439\u0434\u0443 \u0441 \u0443\u043C\u0430. \u0427\u0442\u043E
        \u043D\u0430 \u043C\u0435\u043D\u044F \u043D\u0430\u0448\u043B\u043E \u2014
        \u0437\u0430\u0445\u043E\u0442\u0435\u0442\u044C \u0432\u0437\u044F\u0442\u044C
        \u044D\u0442\u043E \u0434\u043E\u043C\u043E\u0439 \u0432 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0438?
        \u0414\u0430\u0436\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
        \u0434\u043E\u0447\u044C, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u043D\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u0431\u044B \u043D\u0430 \u0442\u0430\u043A\u0443\u044E \u0438\u0433\u0440\u0443\u0448\u043A\u0443."
  - key: os.memory.1810.text
    values:
    - language: 0
      text: "\"\u4F60\u8981\u662F\u6709\u80FD\u8010\u8DDF\u7740\u6211\u5C31\u8C22\u5929\u8C22\u5730\u4E86\uFF0C\u6211\u624D\u9700\u8981\u4F60\u5E2E\u52A9\"\uFF0C\u6211\u5410\u69FD\u7740\uFF0C\u671B\u4E86\u671B\u56DB\u5468\u3002"
    - language: 1
      text: "\"\u4F60\u8981\u662F\u6709\u80FD\u8010\u8DDF\u8457\u6211\u5C31\u8B1D\u5929\u8B1D\u5730\u4E86\uFF0C\u6211\u624D\u9700\u8981\u4F60\u5E6B\u52A9\"\uFF0C\u6211\u5410\u69FD\u8457\uFF0C\u671B\u4E86\u671B\u56DB\u5468\u3002"
    - language: 2
      text: '"I''ll be grateful if you can manage to follow me. As if I need your
        help," I grumble, looking around.'
    - language: 3
      text: "\u300C\u3064\u3044\u3066\u3053\u3089\u308C\u308B\u3060\u3051\u3067\u5341\u5206\u3088\u3002\u3042\u3093\u305F\u306E\u52A9\u3051\u306A\u3093\u3066\u3044\u3089\u306A\u3044\u300D\u79C1\u306F\u611A\u75F4\u308A\u306A\u304C\u3089\u8FBA\u308A\u3092\u898B\u308B\u3002"
    - language: 4
      text: "\"\uB530\uB77C\uC62C \uC218\uB9CC \uC788\uC5B4\uB3C4 \uACE0\uB9D9\uACA0\uB2E4.
        \uB124 \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uAE34 \uBB50\uAC00 \uD544\uC694\uD574.\"
        \uD22C\uB35C\uAC70\uB9AC\uBA70 \uC8FC\uC704\uB97C \uB458\uB7EC\uBCF8\uB2E4."
    - language: 5
      text: "\"Si tu arrives \xE0 me suivre, ce sera d\xE9j\xE0 un miracle. Comme
        si j'avais besoin de ton aide\", je marmonne en regardant autour de moi."
    - language: 6
      text: "\"Ich bin schon froh, wenn du mir \xFCberhaupt folgen kannst. Als ob
        ich deine Hilfe br\xE4uchte\", meckere ich und sehe mich um."
    - language: 7
      text: "\"Con que puedas seguirme ya me doy por satisfecha. Como si necesitara
        tu ayuda\", refunfu\xF1o, mirando alrededor."
    - language: 8
      text: "\"Se conseguir me seguir, j\xE1 dou gra\xE7as a Deus. Como se eu precisasse
        da sua ajuda\", resmungo, olhando em volta."
    - language: 9
      text: "\"\u0415\u0441\u043B\u0438 \u0441\u043C\u043E\u0436\u0435\u0448\u044C
        \u0437\u0430 \u043C\u043D\u043E\u0439 \u0438\u0434\u0442\u0438, \u0438 \u0442\u043E
        \u0441\u043F\u0430\u0441\u0438\u0431\u043E. \u0411\u0443\u0434\u0442\u043E
        \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u0442\u0432\u043E\u044F
        \u043F\u043E\u043C\u043E\u0449\u044C\", \u2014 \u0432\u043E\u0440\u0447\u0443
        \u044F, \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C."
  - key: os.memory.1820.text
    values:
    - language: 0
      text: "\"......\u65B0\u4EFB\u52A1.....\u8DDF\u5BFB...\u4E3B\u4EBA\u3002\""
    - language: 1
      text: "\"......\u65B0\u4EFB\u52D9.....\u8DDF\u96A8...\u4E3B\u4EBA\u3002\""
    - language: 2
      text: '"......New task..... follow... master."'
    - language: 3
      text: "\u300C......\u65B0\u3057\u3044\u4EFB\u52D9.....\u4E3B\u4EBA\u306B...\u8FFD\u5F93\u300D"
    - language: 4
      text: "\"......\uC0C8 \uC784\uBB34..... \uC8FC\uC778... \uB530\uB77C\uAC00\uAE30.\""
    - language: 5
      text: "\"......Nouvelle t\xE2che..... suivre... ma\xEEtresse.\""
    - language: 6
      text: '"......Neue Aufgabe..... Herrin... folgen."'
    - language: 7
      text: '"......Nueva tarea..... seguir... ama."'
    - language: 8
      text: '"......Nova tarefa..... seguir... dona."'
    - language: 9
      text: "\"......\u041D\u043E\u0432\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430.....
        \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C... \u0437\u0430 \u0445\u043E\u0437\u044F\u0439\u043A\u043E\u0439\"."
  - key: os.memory.1830.text
    values:
    - language: 0
      text: ".......\u6211\u9760\u3002"
    - language: 1
      text: ".......\u6211\u9760\u3002"
    - language: 2
      text: .......Oh, shit.
    - language: 3
      text: ".......\u3046\u308F\u3001\u30DE\u30B8\u304B\u3002"
    - language: 4
      text: ".......\uC544, \uC820\uC7A5."
    - language: 5
      text: .......Oh, merde.
    - language: 6
      text: ".......Ach, Schei\xDFe."
    - language: 7
      text: .......Joder.
    - language: 8
      text: .......Puta merda.
    - language: 9
      text: ".......\u0412\u043E\u0442 \u0447\u0451\u0440\u0442."
  - key: os.memory.1840.text
    values:
    - language: 0
      text: "\u6211\u5C1D\u8BD5\u6027\u5730\u5F80\u5916\u8FC8\u4E86\u51E0\u6B65\uFF0C\u5B83\u5C45\u7136\u771F\u7684\u80FD\u6643\u60A0\u60A0\u5730\u8DDF\u4E0A\u6765....\u55EF..\u770B\u6765\u8FD9\u4E1C\u897F\u6CA1\u6709\u6211\u60F3\u8C61\u4E2D\u90A3\u4E48..\u5443..\u5E9F\u54C1\u3002"
    - language: 1
      text: "\u6211\u5617\u8A66\u6027\u5730\u5F80\u5916\u9081\u4E86\u5E7E\u6B65\uFF0C\u5B83\u5C45\u7136\u771F\u7684\u80FD\u6643\u60A0\u60A0\u5730\u8DDF\u4E0A\u4F86....\u55EF..\u770B\u4F86\u9019\u6771\u897F\u6C92\u6709\u6211\u60F3\u8C61\u4E2D\u90A3\u9EBC..\u5443..\u5EE2\u54C1\u3002"
    - language: 2
      text: I try taking a few steps away. It actually manages to totter after me....
        Hmm... Perhaps this thing isn't quite as... uh... useless as I thought.
    - language: 3
      text: "\u8A66\u3057\u306B\u4F55\u6B69\u304B\u9032\u3080\u3068\u3001\u672C\u5F53\u306B\u3088\u308D\u3088\u308D\u3068\u3064\u3044\u3066\u304D\u305F....\u3046\u3093...\u601D\u3063\u3066\u3044\u305F\u307B\u3069...\u3048\u3048\u3068...\u304C\u3089\u304F\u305F\u3067\u3082\u306A\u3044\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
    - language: 4
      text: "\uC2DC\uD5D8 \uC0BC\uC544 \uBA87 \uAC78\uC74C \uAC00 \uBCF4\uB2C8 \uC815\uB9D0
        \uBE44\uD2C0\uBE44\uD2C0 \uB530\uB77C\uC628\uB2E4.... \uC74C... \uC0DD\uAC01\uB9CC\uD07C...
        \uC5B4... \uBABB \uC4F8 \uD3D0\uD488\uC740 \uC544\uB2CC\uAC00 \uBCF4\uB2E4."
    - language: 5
      text: "Je fais quelques pas pour voir. Il arrive vraiment \xE0 me suivre en
        titubant.... Hmm... Finalement, il n'est peut-\xEAtre pas aussi... euh...
        inutile que je le pensais."
    - language: 6
      text: "Versuchsweise gehe ich ein paar Schritte. Tats\xE4chlich kann er mir
        schwankend folgen.... Hm... Vielleicht ist das Ding doch nicht ganz so...
        \xE4h... nutzlos wie gedacht."
    - language: 7
      text: "Doy unos pasos para probar. De verdad consigue seguirme tambale\xE1ndose....
        Mmm... Quiz\xE1 este cacharro no sea tan... eh... in\xFAtil como pensaba."
    - language: 8
      text: "Dou uns passos para testar. Ele consegue mesmo vir cambaleando atr\xE1s
        de mim.... Hum... Talvez este tro\xE7o n\xE3o seja t\xE3o... ah... in\xFAtil
        quanto eu pensava."
    - language: 9
      text: "\u041F\u0440\u043E\u0431\u0443\u044E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0448\u0430\u0433\u043E\u0432.
        \u041E\u043D \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u043A\u043E\u0432\u044B\u043B\u044F\u0435\u0442
        \u0441\u043B\u0435\u0434\u043E\u043C.... \u0425\u043C... \u041C\u043E\u0436\u0435\u0442,
        \u043E\u043D \u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E...
        \u044D-\u044D... \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439
        \u0445\u043B\u0430\u043C, \u043A\u0430\u043A \u044F \u0434\u0443\u043C\u0430\u043B\u0430."
  - key: os.memory.1840.option.1
    values:
    - language: 0
      text: "\u5BFB\u627E\u836F\u7269"
    - language: 1
      text: "\u5C0B\u627E\u85E5\u7269"
    - language: 2
      text: Search for medicine
    - language: 3
      text: "\u85AC\u3092\u63A2\u3059"
    - language: 4
      text: "\uC57D\uC744 \uCC3E\uB294\uB2E4"
    - language: 5
      text: "Chercher des m\xE9dicaments"
    - language: 6
      text: Medikamente suchen
    - language: 7
      text: Buscar medicinas
    - language: 8
      text: "Procurar rem\xE9dios"
    - language: 9
      text: "\u0418\u0441\u043A\u0430\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430"
  - key: os.memory.1850.text
    values:
    - language: 0
      text: "\u6211\u4EEC\u6643\u60A0\u4E86\u6BB5\u65F6\u95F4\uFF0C\u597D\u5728\u89D2\u843D\u91CC\u53D1\u73B0\u4E86\u4E00\u5305\u7C7B\u4F3C\u529F\u6548\u7684\u836F\u7269\uFF0C\u867D\u7136\u4E0D\u662F\u540C\u6B3E\uFF0C\u4F46\u662F\u836F\u7406\u5DEE\u4E0D\u591A..."
    - language: 1
      text: "\u6211\u5011\u6643\u60A0\u4E86\u6BB5\u6642\u9593\uFF0C\u597D\u5728\u89D2\u843D\u88E1\u767C\u73FE\u4E86\u4E00\u5305\u985E\u4F3C\u529F\u6548\u7684\u85E5\u7269\uFF0C\u96D6\u7136\u4E0D\u662F\u540C\u6B3E\uFF0C\u4F46\u662F\u85E5\u7406\u5DEE\u4E0D\u591A..."
    - language: 2
      text: We wander around for a while. Luckily, I find a packet of medicine with
        a similar effect in a corner. It isn't the same brand, but it works much
        the same way...
    - language: 3
      text: "\u3057\u3070\u3089\u304F\u63A2\u3057\u56DE\u308B\u3068\u3001\u9685\u3067\u4F3C\u305F\u52B9\u304D\u76EE\u306E\u85AC\u3092\u4E00\u888B\u898B\u3064\u3051\u305F\u3002\u540C\u3058\u88FD\u54C1\u3067\u306F\u306A\u3044\u3051\u308C\u3069\u3001\u85AC\u7406\u4F5C\u7528\u306F\u8FD1\u3044..."
    - language: 4
      text: "\uD55C\uB3D9\uC548 \uB3CC\uC544\uB2E4\uB2CC \uB05D\uC5D0 \uAD6C\uC11D\uC5D0\uC11C
        \uBE44\uC2B7\uD55C \uD6A8\uB2A5\uC758 \uC57D \uD55C \uBD09\uC9C0\uB97C \uCC3E\uC558\uB2E4.
        \uAC19\uC740 \uC81C\uD488\uC740 \uC544\uB2C8\uC9C0\uB9CC \uC57D\uB9AC \uC791\uC6A9\uC740
        \uBE44\uC2B7\uD558\uB2E4..."
    - language: 5
      text: "Nous cherchons un moment. Par chance, je trouve dans un coin un sachet
        de m\xE9dicaments aux effets similaires. Pas la m\xEAme marque, mais des
        propri\xE9t\xE9s assez proches..."
    - language: 6
      text: "Wir suchen eine Weile herum. Zum Gl\xFCck entdecke ich in einer Ecke
        eine Packung mit \xE4hnlicher Wirkung. Nicht dasselbe Pr\xE4parat, aber pharmakologisch
        vergleichbar..."
    - language: 7
      text: Buscamos un rato. Por suerte, encuentro en una esquina un paquete de
        medicamentos de efecto parecido. No es la misma marca, pero sus propiedades
        son similares...
    - language: 8
      text: "Procuramos por um tempo. Por sorte, acho num canto um pacote de rem\xE9dios
        com efeito parecido. N\xE3o \xE9 a mesma marca, mas as propriedades s\xE3o
        semelhantes..."
    - language: 9
      text: "\u041C\u044B \u0431\u0440\u043E\u0434\u0438\u043C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
        \u0432\u0440\u0435\u043C\u044F. \u041A \u0441\u0447\u0430\u0441\u0442\u044C\u044E,
        \u0432 \u0443\u0433\u043B\u0443 \u043D\u0430\u0445\u043E\u0436\u0443 \u043F\u0430\u0447\u043A\u0443
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430 \u0441 \u043F\u043E\u0445\u043E\u0436\u0438\u043C
        \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C. \u041D\u0435 \u0442\u043E
        \u0436\u0435 \u0441\u0430\u043C\u043E\u0435, \u043D\u043E \u0444\u0430\u0440\u043C\u0430\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u0431\u043B\u0438\u0437\u043A\u0438..."
  - key: os.memory.1860.text
    values:
    - language: 0
      text: "\u90A3\u5973\u5B69\u8FD8\u8E72\u5728\u539F\u6765\u7684\u5730\u65B9\u3002\u6211\u4E00\u8D70\u8FD1\uFF0C\u5979\u5C31\u7AD9\u8D77\u6765\uFF0C\u5148\u770B\u4E86\u770B\u624B\u91CC\u63D0\u7740\u7684\u836F\uFF0C\u518D\u770B\u4E86\u770B\u6211\u540E\u9762\u7684\u62A5\u5E9F\u673A\u5668\u4EBA\u3002\u5979\u7684\u6BCD\u4EB2\u5DF2\u7ECF\u7F13\u8FC7\u795E\u6765\u4E86\uFF0C\u597D\u6B79\u662F\u80FD\u8BF4\u4E0A\u8BDD\u4E86\u3002"
    - language: 1
      text: "\u90A3\u5973\u5B69\u9084\u8E72\u5728\u539F\u4F86\u7684\u5730\u65B9\u3002\u6211\u4E00\u8D70\u8FD1\uFF0C\u5979\u5C31\u7AD9\u8D77\u4F86\uFF0C\u5148\u770B\u4E86\u770B\u624B\u88E1\u63D0\u8457\u7684\u85E5\uFF0C\u518D\u770B\u4E86\u770B\u6211\u5F8C\u9762\u7684\u5831\u5EE2\u6A5F\u5668\u4EBA\u3002\u5979\u7684\u6BCD\u89AA\u5DF2\u7D93\u7DE9\u904E\u795E\u4F86\u4E86\uFF0C\u597D\u6B79\u662F\u80FD\u8AAA\u4E0A\u8A71\u4E86\u3002"
    - language: 2
      text: The girl is still crouching in the same spot. As I approach, she stands
        up, looks at the medicine in my hand, then at the scrapped robot behind me.
        Her mother has recovered a little; at least she can speak now.
    - language: 3
      text: "\u5C11\u5973\u306F\u3055\u3063\u304D\u3068\u540C\u3058\u5834\u6240\u306B\u3057\u3083\u304C\u3093\u3067\u3044\u305F\u3002\u79C1\u304C\u8FD1\u3065\u304F\u3068\u7ACB\u3061\u4E0A\u304C\u308A\u3001\u624B\u306B\u6301\u3063\u305F\u85AC\u3092\u898B\u3066\u3001\u305D\u308C\u304B\u3089\u5F8C\u308D\u306E\u5EC3\u68C4\u30ED\u30DC\u30C3\u30C8\u3092\u898B\u305F\u3002\u6BCD\u89AA\u306F\u5C11\u3057\u6301\u3061\u76F4\u3057\u3001\u3069\u3046\u306B\u304B\u8A71\u305B\u308B\u3088\u3046\u306B\u306A\u3063\u3066\u3044\u308B\u3002"
    - language: 4
      text: "\uC544\uC774\uB294 \uC5EC\uC804\uD788 \uAC19\uC740 \uC790\uB9AC\uC5D0
        \uCABC\uADF8\uB824 \uC549\uC544 \uC788\uB2E4. \uB0B4\uAC00 \uB2E4\uAC00\uAC00\uC790
        \uC77C\uC5B4\uB098\uC11C \uC190\uC5D0 \uB4E0 \uC57D\uC744 \uBA3C\uC800 \uBCF4\uACE0,
        \uB4A4\uC758 \uD3D0\uD488 \uB85C\uBD07\uC744 \uBCF8\uB2E4. \uC5C4\uB9C8\uB294
        \uC870\uAE08 \uC815\uC2E0\uC744 \uCC28\uB824 \uC774\uC81C \uB9D0\uC740 \uD560
        \uC218 \uC788\uB2E4."
    - language: 5
      text: "La fille est toujours accroupie au m\xEAme endroit. Elle se l\xE8ve
        \xE0 mon approche, regarde les m\xE9dicaments dans ma main, puis le robot
        d\xE9glingu\xE9 derri\xE8re moi. Sa m\xE8re a repris ses esprits ; elle peut
        enfin parler."
    - language: 6
      text: "Das M\xE4dchen hockt noch am selben Ort. Als ich n\xE4her komme, steht
        sie auf, sieht erst die Medikamente in meiner Hand an und dann den Schrottroboter
        hinter mir. Ihre Mutter hat sich etwas erholt. Wenigstens kann sie wieder
        sprechen."
    - language: 7
      text: "La ni\xF1a sigue agachada en el mismo sitio. Al acercarme, se levanta
        y mira primero las medicinas que llevo y luego al robot destartalado que
        me sigue. Su madre se ha recuperado un poco. Por lo menos ya puede hablar."
    - language: 8
      text: "A menina continua agachada no mesmo lugar. Quando chego perto, ela se
        levanta, olha os rem\xE9dios na minha m\xE3o e depois o rob\xF4 sucateado
        atr\xE1s de mim. A m\xE3e j\xE1 se recuperou um pouco. Pelo menos consegue
        falar."
    - language: 9
      text: "\u0414\u0435\u0432\u043E\u0447\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
        \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u043A\u043E\u0440\u0442\u043E\u0447\u043A\u0430\u0445
        \u0442\u0430\u043C \u0436\u0435. \u041A\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u0434\u0445\u043E\u0436\u0443,
        \u043E\u043D\u0430 \u0432\u0441\u0442\u0430\u0451\u0442, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
        \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430
        \u0443 \u043C\u0435\u043D\u044F \u0432 \u0440\u0443\u043A\u0435, \u043F\u043E\u0442\u043E\u043C
        \u043D\u0430 \u0441\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0433\u043E
        \u0440\u043E\u0431\u043E\u0442\u0430 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.
        \u0415\u0451 \u043C\u0430\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u043F\u0440\u0438\u0448\u043B\u0430 \u0432 \u0441\u0435\u0431\u044F. \u041F\u043E
        \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435, \u0443\u0436\u0435
        \u043C\u043E\u0436\u0435\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
  - key: os.memory.1870.text
    values:
    - language: 0
      text: "\u6211\u786E\u8BA4\u4E86\u836F\u7269\u7684\u60C5\u51B5\uFF0C\u5E2E\u5979\u670D\u4E0B\uFF0C\u53C8\u628A\u80FD\u7528\u7684\u4E1C\u897F\u653E\u5230\u5973\u5B69\u591F\u5F97\u7740\u7684\u5730\u65B9....\u7EC8\u4E8E\u53EF\u4EE5\u56DE\u5230\u6211\u60F3\u95EE\u7684\u4E1C\u897F\u4E86..."
    - language: 1
      text: "\u6211\u78BA\u8A8D\u4E86\u85E5\u7269\u7684\u60C5\u6CC1\uFF0C\u5E6B\u5979\u670D\u4E0B\uFF0C\u53C8\u628A\u80FD\u7528\u7684\u6771\u897F\u653E\u5230\u5973\u5B69\u5920\u5F97\u8457\u7684\u5730\u65B9....\u7D42\u65BC\u53EF\u4EE5\u56DE\u5230\u6211\u60F3\u554F\u7684\u6771\u897F\u4E86..."
    - language: 2
      text: I check the medicine, help her take it, then leave the useful supplies
        within the girl's reach.... Finally, I can get back to what I wanted to ask...
    - language: 3
      text: "\u85AC\u3092\u78BA\u8A8D\u3057\u3066\u98F2\u3080\u306E\u3092\u624B\u4F1D\u3044\u3001\u4F7F\u3048\u305D\u3046\u306A\u7269\u3092\u5C11\u5973\u306E\u624B\u306E\u5C4A\u304F\u5834\u6240\u3078\u7F6E\u304F....\u3088\u3046\u3084\u304F\u3001\u805E\u304D\u305F\u304B\u3063\u305F\u3053\u3068\u306B\u623B\u308C\u308B..."
    - language: 4
      text: "\uC57D\uC744 \uD655\uC778\uD558\uACE0 \uBA39\uB294 \uAC78 \uB3C4\uC640\uC900
        \uB4A4, \uC4F8 \uB9CC\uD55C \uBB3C\uAC74\uC744 \uC544\uC774 \uC190\uC774
        \uB2FF\uB294 \uACF3\uC5D0 \uB454\uB2E4.... \uB4DC\uB514\uC5B4 \uB0B4\uAC00
        \uBB3C\uC73C\uB824\uB358 \uC774\uC57C\uAE30\uB85C \uB3CC\uC544\uAC08 \uC218
        \uC788\uACA0\uB2E4..."
    - language: 5
      text: "Je v\xE9rifie les m\xE9dicaments, l'aide \xE0 les prendre, puis laisse
        les affaires utiles \xE0 port\xE9e de la fille.... Enfin, je peux revenir
        \xE0 ma question..."
    - language: 6
      text: "Ich pr\xFCfe die Medikamente, helfe ihr bei der Einnahme und lege alles
        Brauchbare in Reichweite des M\xE4dchens.... Endlich kann ich zu meiner Frage
        zur\xFCckkommen..."
    - language: 7
      text: "Compruebo las medicinas, la ayudo a tomarlas y dejo lo \xFAtil al alcance
        de la ni\xF1a.... Por fin puedo volver a lo que quer\xEDa preguntar..."
    - language: 8
      text: "Confiro os rem\xE9dios, ajudo a mulher a tom\xE1-los e deixo o que pode
        servir ao alcance da menina.... Finalmente posso voltar ao que queria perguntar..."
    - language: 9
      text: "\u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E,
        \u043F\u043E\u043C\u043E\u0433\u0430\u044E \u0435\u0433\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u044C
        \u0438 \u043A\u043B\u0430\u0434\u0443 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435
        \u0432\u0435\u0449\u0438 \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
        \u0434\u0435\u0432\u043E\u0447\u043A\u0430 \u043C\u043E\u0433\u043B\u0430
        \u0434\u043E\u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F.... \u041D\u0430\u043A\u043E\u043D\u0435\u0446
        \u043C\u043E\u0436\u043D\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
        \u043A \u043C\u043E\u0435\u043C\u0443 \u0432\u043E\u043F\u0440\u043E\u0441\u0443..."
  - key: os.memory.1880.text
    values:
    - language: 0
      text: "\u4F46\u90A3\u4E2A\u5973\u4EBA\u76EF\u7740\u6211\u5148\u53EB\u51FA\u4E86\u58F0..."
    - language: 1
      text: "\u4F46\u90A3\u500B\u5973\u4EBA\u76EF\u8457\u6211\u5148\u53EB\u51FA\u4E86\u8072..."
    - language: 2
      text: But the woman stares at me and speaks first...
    - language: 3
      text: "\u3067\u3082\u3001\u305D\u306E\u5973\u306E\u4EBA\u304C\u79C1\u3092\u898B\u3064\u3081\u3001\u5148\u306B\u58F0\u3092\u4E0A\u3052\u305F..."
    - language: 4
      text: "\uD558\uC9C0\uB9CC \uC5EC\uC790\uAC00 \uB098\uB97C \uB6AB\uC5B4\uC838\uB77C
        \uBCF4\uB2E4\uAC00 \uBA3C\uC800 \uC18C\uB9AC\uB97C \uB0B8\uB2E4..."
    - language: 5
      text: Mais la femme me fixe et s'exclame avant moi...
    - language: 6
      text: Doch die Frau starrt mich an und ruft zuerst etwas...
    - language: 7
      text: Pero la mujer me mira fijamente y exclama antes que yo...
    - language: 8
      text: Mas a mulher me encara e fala primeiro...
    - language: 9
      text: "\u041D\u043E \u0436\u0435\u043D\u0449\u0438\u043D\u0430 \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E
        \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043C\u0435\u043D\u044F
        \u0438 \u0432\u043E\u0441\u043A\u043B\u0438\u0446\u0430\u0435\u0442 \u043F\u0435\u0440\u0432\u043E\u0439..."
  - key: os.memory.1890.text
    values:
    - language: 0
      text: "\"\u7B49\u7B49..\u60A8\u4EE5\u524D...\u5728\u7814\u7A76\u6240\uFF0C\u662F\u4E0D\u662F\uFF1F\"\u5979\u5FEB\u54ED\u51FA\u6765\u4E86...\u5979\u600E\u4E48\u77E5\u9053\u8FD9\u79CD\u8001\u9EC4\u5386\uFF1F\u6211\u6709\u4E00\u79CD\u4E0D\u597D\u7684\u9884\u611F\u3002"
    - language: 1
      text: "\"\u7B49\u7B49..\u60A8\u4EE5\u524D...\u5728\u7814\u7A76\u6240\uFF0C\u662F\u4E0D\u662F\uFF1F\"\u5979\u5FEB\u54ED\u51FA\u4F86\u4E86...\u5979\u600E\u9EBC\u77E5\u9053\u9019\u7A2E\u8001\u9EC3\u66C6\uFF1F\u6211\u6709\u4E00\u7A2E\u4E0D\u597D\u7684\u9810\u611F\u3002"
    - language: 2
      text: '"Wait... You used to... work at the institute, didn''t you?" She''s
        on the verge of tears... How does she know about something so long ago? I
        have a bad feeling.'
    - language: 3
      text: "\u300C\u5F85\u3063\u3066...\u3042\u306A\u305F\u306F\u6614...\u7814\u7A76\u6240\u306B\u3044\u3089\u3057\u305F\u65B9\u3067\u306F\uFF1F\u300D\u4ECA\u306B\u3082\u6CE3\u304D\u305D\u3046\u3060...\u3069\u3046\u3057\u3066\u305D\u3093\u306A\u6614\u306E\u3053\u3068\u3092\u77E5\u3063\u3066\u3044\u308B\u306E\uFF1F\u3000\u5ACC\u306A\u4E88\u611F\u304C\u3057\u305F\u3002"
    - language: 4
      text: "\"\uC7A0\uAE50... \uC608\uC804\uC5D0... \uC5F0\uAD6C\uC18C\uC5D0 \uACC4\uC168\uC8E0?\"
        \uAE08\uBC29\uC774\uB77C\uB3C4 \uC6B8 \uAC83 \uAC19\uB2E4... \uC5B4\uB5BB\uAC8C
        \uADF8\uB7F0 \uC61B\uB0A0 \uC77C\uC744 \uC54C\uC9C0? \uBD88\uAE38\uD55C \uC608\uAC10\uC774
        \uB4E0\uB2E4."
    - language: 5
      text: "\"Attendez... Vous travailliez... \xE0 l'institut, autrefois ?\" Elle
        est au bord des larmes... Comment conna\xEEt-elle cette vieille histoire
        ? J'ai un mauvais pressentiment."
    - language: 6
      text: "\"Warten Sie... Sie waren fr\xFCher... am Institut, oder?\" Sie ist
        den Tr\xE4nen nahe... Woher wei\xDF sie von dieser uralten Geschichte? Ich
        habe ein ungutes Gef\xFChl."
    - language: 7
      text: "\"Espere... Usted antes... trabajaba en el instituto, \xBFverdad?\"
        Est\xE1 a punto de llorar... \xBFC\xF3mo sabe algo de hace tanto tiempo?
        Tengo un mal presentimiento."
    - language: 8
      text: "\"Espere... A senhora trabalhava... no instituto, n\xE3o \xE9?\" Ela
        est\xE1 quase chorando... Como sabe dessa hist\xF3ria t\xE3o antiga? Tenho
        um mau pressentimento."
    - language: 9
      text: "\"\u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435... \u0412\u044B
        \u0440\u0430\u043D\u044C\u0448\u0435... \u0432 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435
        \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438, \u0434\u0430?\" \u041E\u043D\u0430
        \u0432\u043E\u0442-\u0432\u043E\u0442 \u0437\u0430\u043F\u043B\u0430\u0447\u0435\u0442...
        \u041E\u0442\u043A\u0443\u0434\u0430 \u0435\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430
        \u0442\u0430\u043A\u0430\u044F \u0434\u0430\u0432\u043D\u044F\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F?
        \u0423 \u043C\u0435\u043D\u044F \u0434\u0443\u0440\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435."
  - key: os.memory.1900.text
    values:
    - language: 0
      text: "\u89C1\u6211\u6CA1\u6709\u56DE\u7B54\uFF0C\u5979\u8DEA\u5728\u6211\u9762\u524D\uFF0C\"\u6211\u89C1\u8FC7\u60A8\u7684\u62A5\u9053\uFF0C\u6211\u4EE5\u524D\u4E5F\u662F\u4E2A\u533B\u5B66\u751F....\u545C..\u6211\u7684\u5973\u513F\u5F97\u4E86\u90A3\u4E2A\u8BE5\u6B7B\u7684\u5FC3\u810F\u75C5\u6BD2\uFF0C\u60A8\u8FD8\u5728\u7814\u7A76\u6240\u5DE5\u4F5C\u5417\uFF1F\u8FD9\u91CC\u6765\u8FC7\u4E0D\u5C11\u8FD9\u6837\u5F97\u5FC3\u810F\u75C5\u6BD2\u7684\u4EBA\uFF0C\u6211\u6C42\u6C42\u4F60\u4E86.....\u5E2E\u5E2E\u6211\u4EEC\u7684\u5B69\u5B50....\""
    - language: 1
      text: "\u898B\u6211\u6C92\u6709\u56DE\u7B54\uFF0C\u5979\u8DEA\u5728\u6211\u9762\u524D\uFF0C\"\u6211\u898B\u904E\u60A8\u7684\u5831\u9053\uFF0C\u6211\u4EE5\u524D\u4E5F\u662F\u500B\u91AB\u5B78\u751F....\u55DA..\u6211\u7684\u5973\u5152\u5F97\u4E86\u90A3\u500B\u8A72\u6B7B\u7684\u5FC3\u81DF\u75C5\u6BD2\uFF0C\u60A8\u9084\u5728\u7814\u7A76\u6240\u5DE5\u4F5C\u55CE\uFF1F\u9019\u88E1\u4F86\u904E\u4E0D\u5C11\u9019\u6A23\u5F97\u5FC3\u81DF\u75C5\u6BD2\u7684\u4EBA\uFF0C\u6211\u6C42\u6C42\u4F60\u4E86.....\u5E6B\u5E6B\u6211\u5011\u7684\u5B69\u5B50....\""
    - language: 2
      text: When I don't answer, she kneels in front of me. "I've seen reports about
        you. I used to study medicine too.... My daughter has that damned heart virus.
        Are you still working at the institute? So many people with that virus have
        come through here. I'm begging you..... Help our children...."
    - language: 3
      text: "\u79C1\u304C\u7B54\u3048\u306A\u3044\u3068\u3001\u5F7C\u5973\u306F\u76EE\u306E\u524D\u3067\u819D\u3092\u3064\u3044\u305F\u3002\u300C\u3042\u306A\u305F\u306E\u5831\u9053\u3092\u898B\u305F\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\u79C1\u3082\u6614\u306F\u533B\u5B66\u751F\u3067....\u5A18\u304C\u3001\u3042\u306E\u5FCC\u3005\u3057\u3044\u5FC3\u81D3\u30A6\u30A4\u30EB\u30B9\u306B\u611F\u67D3\u3057\u305F\u3093\u3067\u3059\u3002\u307E\u3060\u7814\u7A76\u6240\u306B\u304A\u52E4\u3081\u3067\u3059\u304B\uFF1F\u3000\u3053\u3053\u306B\u3082\u60A3\u8005\u304C\u5927\u52E2\u6765\u307E\u3057\u305F\u3002\u304A\u9858\u3044\u3057\u307E\u3059.....\u79C1\u305F\u3061\u306E\u5B50\u4F9B\u3092\u52A9\u3051\u3066....\u300D"
    - language: 4
      text: "\uB0B4\uAC00 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC790 \uC5EC\uC790\uAC00
        \uB0B4 \uC55E\uC5D0 \uBB34\uB98E\uC744 \uAFC7\uB294\uB2E4. \"\uBCF4\uB3C4\uC5D0\uC11C
        \uBD24\uC5B4\uC694. \uC800\uB3C4 \uC608\uC804\uC5D0 \uC758\uB300\uC0DD\uC774\uC5C8\uC5B4\uC694....
        \uC81C \uB538\uC774 \uADF8 \uBE4C\uC5B4\uBA39\uC744 \uC2EC\uC7A5 \uBC14\uC774\uB7EC\uC2A4\uC5D0
        \uAC78\uB838\uC5B4\uC694. \uC544\uC9C1 \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uC77C\uD558\uC2DC\uB098\uC694?
        \uC5EC\uAE30\uC5D0\uB3C4 \uADF8\uB7F0 \uD658\uC790\uAC00 \uB9CE\uC774 \uC654\uC5B4\uC694.
        \uC81C\uBC1C..... \uC6B0\uB9AC \uC544\uC774\uB4E4\uC744 \uB3C4\uC640\uC8FC\uC138\uC694....\""
    - language: 5
      text: "Comme je ne r\xE9ponds pas, elle s'agenouille devant moi. \"J'ai vu
        des reportages sur vous. J'\xE9tudiais aussi la m\xE9decine.... Ma fille
        a ce fichu virus cardiaque. Vous travaillez encore \xE0 l'institut ? Tant
        de malades sont pass\xE9s ici. Je vous en supplie..... Aidez nos enfants....\""
    - language: 6
      text: "Als ich nicht antworte, kniet sie sich vor mich. \"Ich habe Berichte
        \xFCber Sie gesehen. Ich habe fr\xFCher auch Medizin studiert.... Meine Tochter
        hat dieses verdammte Herzvirus. Arbeiten Sie noch am Institut? Hier waren
        schon so viele Erkrankte. Ich flehe Sie an..... Helfen Sie unseren Kindern....\""
    - language: 7
      text: "Como no contesto, se arrodilla ante m\xED. \"He visto reportajes sobre
        usted. Yo tambi\xE9n estudiaba medicina.... Mi hija tiene ese maldito virus
        card\xEDaco. \xBFSigue trabajando en el instituto? Han pasado muchos enfermos
        de ese virus por aqu\xED. Se lo suplico..... Ayude a nuestros ni\xF1os....\""
    - language: 8
      text: "Como n\xE3o respondo, ela se ajoelha na minha frente. \"Vi reportagens
        sobre a senhora. Eu tamb\xE9m estudava medicina.... Minha filha pegou aquele
        maldito v\xEDrus card\xEDaco. A senhora ainda trabalha no instituto? J\xE1
        passaram tantos doentes por aqui. Eu imploro..... Ajude nossas crian\xE7as....\""
    - language: 9
      text: "\u041D\u0435 \u0434\u043E\u0436\u0434\u0430\u0432\u0448\u0438\u0441\u044C
        \u043E\u0442\u0432\u0435\u0442\u0430, \u043E\u043D\u0430 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
        \u043F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439 \u043D\u0430
        \u043A\u043E\u043B\u0435\u043D\u0438. \"\u042F \u0432\u0438\u0434\u0435\u043B\u0430
        \u0440\u0435\u043F\u043E\u0440\u0442\u0430\u0436\u0438 \u043E \u0432\u0430\u0441.
        \u042F \u0442\u043E\u0436\u0435 \u0440\u0430\u043D\u044C\u0448\u0435 \u0443\u0447\u0438\u043B\u0430\u0441\u044C
        \u043D\u0430 \u0432\u0440\u0430\u0447\u0430.... \u0423 \u043C\u043E\u0435\u0439
        \u0434\u043E\u0447\u0435\u0440\u0438 \u044D\u0442\u043E\u0442 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0439
        \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u0439 \u0432\u0438\u0440\u0443\u0441.
        \u0412\u044B \u0435\u0449\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435
        \u0432 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435? \u0417\u0434\u0435\u0441\u044C
        \u043F\u043E\u0431\u044B\u0432\u0430\u043B\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E
        \u0431\u043E\u043B\u044C\u043D\u044B\u0445. \u0423\u043C\u043E\u043B\u044F\u044E
        \u0432\u0430\u0441..... \u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435
        \u043D\u0430\u0448\u0438\u043C \u0434\u0435\u0442\u044F\u043C....\""
  - key: os.memory.1910.text
    values:
    - language: 0
      text: "\u6211\u4E0D\u81EA\u5728\u5730\u63E3\u4E86\u63E3\u624B..\u6211\u8BE5\u600E\u4E48\u529E......\u6211\u65E9\u5728\u6218\u4E89\u5F00\u59CB\u65F6\u5C31\u88AB\u89E3\u96C7\u4E86\uFF0C\u867D\u7136\u6211\u786E\u5B9E\u8FD8\u5728\u7814\u7A76\u8FD9\u4E2A\u75C5\u6BD2...\u4F46\u6211..\u6211\u600E\u4E48\u53EF\u80FD\u4FDD\u8BC1\u8FD9\u6837\u7684\u4E8B\u60C5\u3002"
    - language: 1
      text: "\u6211\u4E0D\u81EA\u5728\u5730\u63E3\u4E86\u63E3\u624B..\u6211\u8A72\u600E\u9EBC\u8FA6......\u6211\u65E9\u5728\u6230\u722D\u958B\u59CB\u6642\u5C31\u88AB\u89E3\u50F1\u4E86\uFF0C\u96D6\u7136\u6211\u78BA\u5BE6\u9084\u5728\u7814\u7A76\u9019\u500B\u75C5\u6BD2...\u4F46\u6211..\u6211\u600E\u9EBC\u53EF\u80FD\u4FDD\u8B49\u9019\u6A23\u7684\u4E8B\u60C5\u3002"
    - language: 2
      text: I tuck my hands away awkwardly. What should I do......? I was fired as
        soon as the war started. Yes, I'm still researching the virus... but I...
        How could I promise anything like that?
    - language: 3
      text: "\u5C45\u5FC3\u5730\u60AA\u304F\u624B\u3092\u3057\u307E\u3046\u3002\u3069\u3046\u3057\u3088\u3046......\u6226\u4E89\u304C\u59CB\u307E\u3063\u305F\u3068\u304D\u306B\u306F\u3001\u3082\u3046\u89E3\u96C7\u3055\u308C\u3066\u3044\u305F\u3002\u78BA\u304B\u306B\u4ECA\u3082\u30A6\u30A4\u30EB\u30B9\u306E\u7814\u7A76\u306F\u3057\u3066\u3044\u308B...\u3067\u3082\u3001\u79C1...\u305D\u3093\u306A\u7D04\u675F\u304C\u3067\u304D\u308B\u306F\u305A\u306A\u3044\u3002"
    - language: 4
      text: "\uBD88\uD3B8\uD55C \uB9C8\uC74C\uC5D0 \uC190\uC744 \uAC10\uCD98\uB2E4.
        \uC5B4\uB5A1\uD558\uC9C0......? \uB098\uB294 \uC804\uC7C1\uC774 \uC2DC\uC791\uB420
        \uB54C \uBC8C\uC368 \uD574\uACE0\uB2F9\uD588\uB2E4. \uC9C0\uAE08\uB3C4 \uBC14\uC774\uB7EC\uC2A4\uB97C
        \uC5F0\uAD6C\uD558\uB294 \uAC74 \uB9DE\uC9C0\uB9CC... \uB0B4\uAC00... \uC5B4\uB5BB\uAC8C
        \uADF8\uB7F0 \uAC78 \uC7A5\uB2F4\uD558\uACA0\uC5B4."
    - language: 5
      text: "Je rentre maladroitement les mains dans mes poches. Que faire......
        ? On m'a renvoy\xE9e d\xE8s le d\xE9but de la guerre. Je continue certes
        mes recherches sur le virus... mais je... Comment pourrais-je promettre une
        chose pareille ?"
    - language: 6
      text: "Unbehaglich vergrabe ich die H\xE4nde. Was soll ich tun......? Ich wurde
        schon zu Kriegsbeginn entlassen. Ich erforsche das Virus zwar noch... aber
        ich... Wie k\xF6nnte ich so etwas versprechen?"
    - language: 7
      text: "Escondo las manos, inc\xF3moda. \xBFQu\xE9 hago......? Me despidieron
        al empezar la guerra. Es verdad que sigo investigando el virus... pero yo...
        \xBFC\xF3mo voy a prometer algo as\xED?"
    - language: 8
      text: "Guardo as m\xE3os, sem jeito. O que eu fa\xE7o......? Fui demitida quando
        a guerra come\xE7ou. \xC9 verdade que continuo pesquisando o v\xEDrus...
        mas eu... Como posso prometer uma coisa dessas?"
    - language: 9
      text: "\u041D\u0435\u043B\u043E\u0432\u043A\u043E \u043F\u0440\u044F\u0447\u0443
        \u0440\u0443\u043A\u0438. \u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C......?
        \u041C\u0435\u043D\u044F \u0443\u0432\u043E\u043B\u0438\u043B\u0438 \u0435\u0449\u0451
        \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0432\u043E\u0439\u043D\u044B.
        \u0414\u0430, \u044F \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
        \u0438\u0437\u0443\u0447\u0430\u044E \u0432\u0438\u0440\u0443\u0441... \u043D\u043E
        \u044F... \u041A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0442\u0430\u043A\u043E\u0435
        \u043E\u0431\u0435\u0449\u0430\u0442\u044C?"
  - key: os.memory.1920.text
    values:
    - language: 0
      text: "\"...\u6211...\u7684\u4E3B\u4EBA....\u4E0D\u60F3\u63A5\u4E0B.\u8FD9\u4E2A..\u8BF7\u6C42.\""
    - language: 1
      text: "\"...\u6211...\u7684\u4E3B\u4EBA....\u4E0D\u60F3\u63A5\u4E0B.\u9019\u500B..\u8ACB\u6C42.\""
    - language: 2
      text: '"...My... master.... does not wish. To accept.. this request."'
    - language: 3
      text: "\u300C...\u79C1...\u306E\u4E3B\u4EBA\u306F....\u3053\u306E..\u4F9D\u983C\u3092.\u5F15\u304D\u53D7\u3051\u305F\u304F\u3042\u308A\u307E\u305B\u3093\u300D"
    - language: 4
      text: "\"...\uC81C... \uC8FC\uC778\uC740.... \uC774.. \uC694\uCCAD\uC744. \uBC1B\uC544\uB4E4\uC774\uACE0
        \uC2F6\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\""
    - language: 5
      text: "\"...Ma... ma\xEEtresse.... ne souhaite pas. Accepter.. cette demande.\""
    - language: 6
      text: "\"...Meine... Herrin.... m\xF6chte. Diese Bitte.. nicht annehmen.\""
    - language: 7
      text: "\"...Mi... ama.... no desea. Aceptar.. esta petici\xF3n.\""
    - language: 8
      text: "\"...Minha... dona.... n\xE3o deseja. Aceitar.. este pedido.\""
    - language: 9
      text: "\"...\u041C\u043E\u044F... \u0445\u043E\u0437\u044F\u0439\u043A\u0430....
        \u043D\u0435 \u0436\u0435\u043B\u0430\u0435\u0442. \u041F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C..
        \u044D\u0442\u0443 \u043F\u0440\u043E\u0441\u044C\u0431\u0443\"."
  - key: os.memory.1930.text
    values:
    - language: 0
      text: "\"...\u60A8\u522B\u7BA1\u8FD9\u4E2A\u5E9F\u54C1\uFF0C\u6211\u5C3D\u529B....\u6211\u73B0\u5728\u662F\u5728\u8FDB\u884C\u8FD9\u65B9\u9762\u7684\u7814\u7A76..\u4F46\u662F\u8FDB\u5EA6\u5F88\u6162....\"\u6211\u5C0F\u5FC3\u7FFC\u7FFC\u5730\u5BF9\u5979\u8BF4\u7740\uFF0C\u4E0D\u8FC7\u5979\u5973\u513F\u770B\u8D77\u6765\u5012\u662F\u5F88\u5065\u5EB7...\u4E5F\u5BF9..\u6BD5\u7ADF\u517D\u5316\u75C5\u6BD2\u5E76\u6CA1\u6709\u591A\u9AD8\u7684\u81F4\u6B7B\u6027\u3002"
    - language: 1
      text: "\"...\u60A8\u5225\u7BA1\u9019\u500B\u5EE2\u54C1\uFF0C\u6211\u76E1\u529B....\u6211\u73FE\u5728\u662F\u5728\u9032\u884C\u9019\u65B9\u9762\u7684\u7814\u7A76..\u4F46\u662F\u9032\u5EA6\u5F88\u6162....\"\u6211\u5C0F\u5FC3\u7FFC\u7FFC\u5730\u5C0D\u5979\u8AAA\u8457\uFF0C\u4E0D\u904E\u5979\u5973\u5152\u770B\u8D77\u4F86\u5012\u662F\u5F88\u5065\u5EB7...\u4E5F\u5C0D..\u7562\u7ADF\u7378\u5316\u75C5\u6BD2\u4E26\u6C92\u6709\u591A\u9AD8\u7684\u81F4\u6B7B\u6027\u3002"
    - language: 2
      text: '"...Don''t mind this piece of junk. I''ll try.... I''m researching it
        now, but progress is very slow...." I choose my words carefully. Her daughter
        looks quite healthy, though... Right... The beastification virus isn''t all
        that lethal, after all.'
    - language: 3
      text: "\u300C...\u3053\u306E\u304C\u3089\u304F\u305F\u306F\u6C17\u306B\u3057\u306A\u3044\u3067\u3002\u3067\u304D\u308B\u3060\u3051\u306E\u3053\u3068\u306F....\u4ECA\u3082\u7814\u7A76\u3057\u3066\u3044\u307E\u3059\u304C\u3001\u9032\u307F\u306F\u3068\u3066\u3082\u9045\u304F\u3066....\u300D\u614E\u91CD\u306B\u8A00\u8449\u3092\u9078\u3076\u3002\u305F\u3060\u3001\u5A18\u3055\u3093\u306F\u5065\u5EB7\u305D\u3046\u306B\u898B\u3048\u308B...\u305D\u3046\u3060\u3001\u7363\u5316\u30A6\u30A4\u30EB\u30B9\u306F\u305D\u308C\u307B\u3069\u81F4\u6B7B\u7387\u304C\u9AD8\u3044\u308F\u3051\u3067\u306F\u306A\u3044\u3002"
    - language: 4
      text: "\"...\uC774 \uD3D0\uD488 \uB9D0\uC740 \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8\uC138\uC694.
        \uCD5C\uC120\uC744 \uB2E4\uD560\uAC8C\uC694.... \uC9C0\uAE08\uB3C4 \uC5F0\uAD6C\uD558\uACE0
        \uC788\uC9C0\uB9CC, \uC9C4\uC804\uC774 \uC544\uC8FC \uB290\uB824\uC11C....\"
        \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB9D0\uD55C\uB2E4. \uB538\uC740 \uAF64 \uAC74\uAC15\uD574
        \uBCF4\uC774\uB294\uB370... \uADF8\uB807\uC9C0, \uC57C\uC218\uD654 \uBC14\uC774\uB7EC\uC2A4\uB294
        \uCE58\uC0AC\uC728\uC774 \uADF8\uB9AC \uB192\uC9C0\uB294 \uC54A\uB2E4."
    - language: 5
      text: "\"...Ne faites pas attention \xE0 cette ferraille. Je ferai de mon mieux....
        Je travaille sur le sujet, mais \xE7a avance tr\xE8s lentement....\" Je choisis
        mes mots. Sa fille semble pourtant en bonne sant\xE9... C'est vrai, le virus
        de bestialisation n'est pas si mortel."
    - language: 6
      text: "\"...H\xF6ren Sie nicht auf diesen Schrotthaufen. Ich versuche es....
        Ich forsche daran, aber es geht sehr langsam voran....\" Ich w\xE4hle meine
        Worte vorsichtig. Ihre Tochter sieht allerdings ziemlich gesund aus... Stimmt,
        das Bestialisierungsvirus ist ja nicht besonders t\xF6dlich."
    - language: 7
      text: "\"...No haga caso a esta chatarra. Har\xE9 lo que pueda.... Sigo investigando
        esto, pero avanzo muy despacio....\" Mido mis palabras. Aunque su hija parece
        bastante sana... Claro, el virus de bestializaci\xF3n no tiene una mortalidad
        tan alta."
    - language: 8
      text: "\"...N\xE3o ligue para essa sucata. Vou tentar.... Estou pesquisando
        isso, mas o progresso \xE9 muito lento....\" Escolho as palavras com cuidado.
        A filha dela at\xE9 parece saud\xE1vel... \xC9 mesmo, o v\xEDrus da bestializa\xE7\xE3o
        n\xE3o tem uma mortalidade t\xE3o alta."
    - language: 9
      text: "\"...\u041D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0439\u0442\u0435
        \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u043D\u0430 \u044D\u0442\u043E\u0442
        \u0445\u043B\u0430\u043C. \u042F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C....
        \u0421\u0435\u0439\u0447\u0430\u0441 \u044F \u0442\u043E\u0436\u0435 \u044D\u0442\u0438\u043C
        \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0441\u044C, \u043D\u043E \u0432\u0441\u0451
        \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
        \u043E\u0447\u0435\u043D\u044C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E....\"
        \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044E
        \u0441\u043B\u043E\u0432\u0430. \u0425\u043E\u0442\u044F \u0435\u0451 \u0434\u043E\u0447\u044C
        \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0432\u043F\u043E\u043B\u043D\u0435
        \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u0439... \u041D\u0443 \u0434\u0430,
        \u0443 \u0432\u0438\u0440\u0443\u0441\u0430 \u043E\u0437\u0432\u0435\u0440\u0435\u043D\u0438\u044F
        \u043D\u0435 \u0442\u0430\u043A\u0430\u044F \u0443\u0436 \u0432\u044B\u0441\u043E\u043A\u0430\u044F
        \u0441\u043C\u0435\u0440\u0442\u043D\u043E\u0441\u0442\u044C."
  - key: os.memory.1940.text
    values:
    - language: 0
      text: "\u201C\u4E0D\u8FC7\u60A8\u89C1\u8FC7\u6211\u7684\u5973\u513F\u5417\uFF1F\u5927\u6982\u8FD9\u4E48\u9AD8\u3002\u201D\u6211\u6BD4\u5212\u7740\u3002\u201C\u4E0D\u7B97\u5C0F\u5B69\u4E86\u2026\u2026\u5979\u6709\u4E2A\u670B\u53CB\u53EB\u827E\u4E39\uFF0C\u60A8\u89C1\u8FC7\u4ED6\u4EEC\u5417\uFF1F\u201D"
    - language: 1
      text: "\u300C\u4E0D\u904E\u60A8\u898B\u904E\u6211\u7684\u5973\u5152\u55CE\uFF1F\u5927\u6982\u9019\u9EBC\u9AD8\u3002\u300D\u6211\u6BD4\u5283\u8457\u3002\u300C\u4E0D\u7B97\u5C0F\u5B69\u4E86\u2026\u2026\u5979\u6709\u500B\u670B\u53CB\u53EB\u827E\u4E39\uFF0C\u60A8\u898B\u904E\u4ED6\u5011\u55CE\uFF1F\u300D"
    - language: 2
      text: "\u201CBut have you happened to see my daughter? About this tall.\u201D
        I gesture. \u201CShe's not a little child anymore\u2026 She has a friend
        called Aidan. Have you seen either of them?\u201D"
    - language: 3
      text: "\u300C\u3068\u3053\u308D\u3067\u3001\u79C1\u306E\u5A18\u3092\u3054\u89A7\u306B\u306A\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u304B\uFF1F\u3000\u80CC\u306F\u3053\u306E\u304F\u3089\u3044\u3067\u3059\u300D\u624B\u3067\u9AD8\u3055\u3092\u793A\u3059\u3002\u300C\u3082\u3046\u5C0F\u3055\u306A\u5B50\u4F9B\u3067\u306F\u306A\u304F\u3066\u2026\u2026\u30A8\u30A4\u30C0\u30F3\u3068\u3044\u3046\u53CB\u9054\u304C\u3044\u308B\u3093\u3067\u3059\u3002\u4E8C\u4EBA\u3092\u3054\u89A7\u306B\u306A\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u304B\uFF1F\u300D"
    - language: 4
      text: "\u201C\uADF8\uB7F0\uB370 \uC81C \uB538\uC744 \uBCF4\uC2E0 \uC801 \uC788\uB098\uC694?
        \uD0A4\uB294 \uC774 \uC815\uB3C4\uC608\uC694.\u201D \uC190\uC73C\uB85C \uD0A4\uB97C
        \uAC00\uB9AC\uD0A8\uB2E4. \u201C\uC5B4\uB9B0\uC560\uB294 \uC544\uB2C8\uACE0\uC694\u2026\u2026
        \uC5D0\uC774\uB4E0\uC774\uB77C\uB294 \uCE5C\uAD6C\uAC00 \uC788\uB294\uB370,
        \uADF8 \uB458\uC744 \uBCF4\uC168\uB098\uC694?\u201D"
    - language: 5
      text: "\xAB Mais avez-vous vu ma fille ? \xC0 peu pr\xE8s de cette taille.
        \xBB Je fais un geste. \xAB Ce n'est plus une petite\u2026 Elle a un ami
        qui s'appelle Aidan. Les avez-vous vus ? \xBB"
    - language: 6
      text: "\u201EAber haben Sie meine Tochter gesehen? Ungef\xE4hr so gro\xDF.\u201C
        Ich zeige ihre Gr\xF6\xDFe mit der Hand. \u201ESie ist kein kleines Kind
        mehr\u2026 Sie hat einen Freund namens Aidan. Haben Sie die beiden gesehen?\u201C"
    - language: 7
      text: "\xABPero \xBFha visto a mi hija? M\xE1s o menos de esta altura\xBB.
        Hago un gesto. \xABYa no es una ni\xF1a peque\xF1a\u2026 Tiene un amigo que
        se llama Aidan. \xBFHa visto a alguno de los dos?\xBB"
    - language: 8
      text: "\u201CMas a senhora viu minha filha? Mais ou menos desta altura.\u201D
        Fa\xE7o um gesto. \u201CEla n\xE3o \xE9 mais uma criancinha\u2026 Tem um
        amigo chamado Aidan. A senhora viu algum dos dois?\u201D"
    - language: 9
      text: "\xAB\u041D\u043E \u0432\u044B \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438
        \u043C\u043E\u044E \u0434\u043E\u0447\u044C? \u041F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
        \u0442\u0430\u043A\u043E\u0433\u043E \u0440\u043E\u0441\u0442\u0430\xBB.
        \u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E \u0440\u0443\u043A\u043E\u0439.
        \xAB\u0423\u0436\u0435 \u043D\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F\u2026
        \u0423 \u043D\u0435\u0451 \u0435\u0441\u0442\u044C \u0434\u0440\u0443\u0433
        \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u042D\u0439\u0434\u0430\u043D.
        \u0412\u044B \u0438\u0445 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438?\xBB"
  - key: os.memory.1950.text
    values:
    - language: 0
      text: "\u201C\u827E\u4E39\u6211\u8BA4\u8BC6\u2026\u2026\u4E0D\u8FC7\u8FD9\u51E0\u5929\u6CA1\u89C1\u8FC7\u4ED6\u3002\u60A8\u8BF4\u7684\u90A3\u4E2A\u5973\u5B69\uFF0C\u6211\u4E5F\u6CA1\u6709\u89C1\u5230\u2026\u2026\u5BF9\u4E0D\u4F4F\u3002\u201D"
    - language: 1
      text: "\u300C\u827E\u4E39\u6211\u8A8D\u8B58\u2026\u2026\u4E0D\u904E\u9019\u5E7E\u5929\u6C92\u898B\u904E\u4ED6\u3002\u60A8\u8AAA\u7684\u90A3\u500B\u5973\u5B69\uFF0C\u6211\u4E5F\u6C92\u6709\u898B\u5230\u2026\u2026\u5C0D\u4E0D\u4F4F\u3002\u300D"
    - language: 2
      text: "\u201CI know Aidan\u2026 but I haven't seen him these past few days.
        That girl you mentioned, I haven't seen her either\u2026 I'm sorry.\u201D"
    - language: 3
      text: "\u300C\u30A8\u30A4\u30C0\u30F3\u306A\u3089\u77E5\u3063\u3066\u3044\u307E\u3059\u2026\u2026\u3067\u3082\u3001\u3053\u3053\u6570\u65E5\u306F\u898B\u3066\u3044\u307E\u305B\u3093\u3002\u304A\u3063\u3057\u3083\u308B\u5973\u306E\u5B50\u3082\u3001\u898B\u304B\u3051\u3066\u3044\u307E\u305B\u3093\u2026\u2026\u3059\u307F\u307E\u305B\u3093\u300D"
    - language: 4
      text: "\u201C\uC5D0\uC774\uB4E0\uC740 \uC54C\uC544\uC694\u2026\u2026 \uD558\uC9C0\uB9CC
        \uC694 \uBA70\uCE60\uC740 \uBABB \uBD24\uC5B4\uC694. \uB9D0\uC500\uD558\uC2E0
        \uADF8 \uC5EC\uC790\uC560\uB3C4 \uBABB \uBD24\uACE0\uC694\u2026\u2026 \uBBF8\uC548\uD574\uC694.\u201D"
    - language: 5
      text: "\xAB Aidan, je le connais\u2026 Mais je ne l'ai pas vu ces derniers
        jours. La fille dont vous parlez, je ne l'ai pas vue non plus\u2026 Je suis
        d\xE9sol\xE9e. \xBB"
    - language: 6
      text: "\u201EAidan kenne ich\u2026 Aber in den letzten Tagen habe ich ihn nicht
        gesehen. Das M\xE4dchen, von dem Sie sprechen, habe ich auch nicht gesehen\u2026
        Tut mir leid.\u201C"
    - language: 7
      text: "\xABA Aidan lo conozco\u2026 pero no lo he visto estos \xFAltimos d\xEDas.
        A la chica que me dice tampoco la he visto\u2026 Lo siento\xBB."
    - language: 8
      text: "\u201CO Aidan eu conhe\xE7o\u2026 mas n\xE3o tenho visto ele nestes
        \xFAltimos dias. A mo\xE7a de quem a senhora falou, tamb\xE9m n\xE3o vi\u2026
        Sinto muito.\u201D"
    - language: 9
      text: "\xAB\u042D\u0439\u0434\u0430\u043D\u0430 \u044F \u0437\u043D\u0430\u044E\u2026
        \u041D\u043E \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0434\u043D\u0438 \u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430.
        \u0414\u0435\u0432\u0443\u0448\u043A\u0443, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439
        \u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435, \u044F \u0442\u043E\u0436\u0435
        \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430\u2026 \u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435\xBB."
  - key: os.memory.1960.text
    values:
    - language: 0
      text: "\u2026\u2026\u8FD8\u662F\u6CA1\u6709\u6D88\u606F\u3002\u6211\u4E0B\u610F\u8BC6\u76B1\u7740\u7709\u5934\uFF0C\u5634\u91CC\u8FD8\u60F3\u95EE\u70B9\u4EC0\u4E48\u3002\u5979\u90A3\u4E48\u5927\u4E00\u4E2A\u4EBA\uFF0C\u603B\u8BE5\u6709\u4EBA\u89C1\u8FC7\u5427"
    - language: 1
      text: "\u2026\u2026\u9084\u662F\u6C92\u6709\u6D88\u606F\u3002\u6211\u4E0B\u610F\u8B58\u76BA\u8457\u7709\u982D\uFF0C\u5634\u88E1\u9084\u60F3\u554F\u9EDE\u4EC0\u9EBC\u3002\u5979\u90A3\u9EBC\u5927\u4E00\u500B\u4EBA\uFF0C\u7E3D\u8A72\u6709\u4EBA\u898B\u904E\u5427"
    - language: 2
      text: "\u2026Still nothing. I find myself frowning, still wanting to ask something.
        She's a grown girl. Surely someone must have seen her."
    - language: 3
      text: "\u2026\u2026\u3084\u3063\u3071\u308A\u3001\u4F55\u306E\u77E5\u3089\u305B\u3082\u306A\u3044\u3002\u601D\u308F\u305A\u7709\u3092\u3072\u305D\u3081\u3001\u307E\u3060\u4F55\u304B\u805E\u3053\u3046\u3068\u3057\u3066\u3057\u307E\u3046\u3002\u3042\u3093\u306A\u306B\u5927\u304D\u304F\u306A\u3063\u305F\u5B50\u306A\u3093\u3060\u304B\u3089\u3001\u8AB0\u304B\u898B\u304B\u3051\u305F\u4EBA\u304C\u3044\u308B\u306F\u305A\u3067\u3057\u3087\u3046"
    - language: 4
      text: "\u2026\u2026\uC5EC\uC804\uD788 \uC544\uBB34 \uC18C\uC2DD\uB3C4 \uC5C6\uB2E4.
        \uB098\uB3C4 \uBAA8\uB974\uAC8C \uBBF8\uAC04\uC744 \uCC0C\uD478\uB9AC\uACE0,
        \uBB54\uAC00 \uB354 \uBB3C\uC5B4\uBCF4\uB824 \uC785\uC744 \uB2EC\uC2F9\uC778\uB2E4.
        \uADF8\uB807\uAC8C \uB2E4 \uD070 \uC560\uC778\uB370, \uB204\uAD70\uAC00\uB294
        \uBD24\uC744 \uAC70 \uC544\uB0D0"
    - language: 5
      text: "\u2026 Toujours aucune nouvelle. Je fronce instinctivement les sourcils,
        cherchant encore quelque chose \xE0 demander. C'est une grande fille, tout
        de m\xEAme. Quelqu'un a bien d\xFB la voir."
    - language: 6
      text: "\u2026 Immer noch nichts. Unwillk\xFCrlich runzle ich die Stirn und
        suche nach einer weiteren Frage. Sie ist doch kein kleines Kind mehr, irgendjemand
        muss sie doch gesehen haben."
    - language: 7
      text: "\u2026Sigo sin saber nada. Frunzo el ce\xF1o sin darme cuenta y a\xFAn
        quiero preguntar algo m\xE1s. No es precisamente una ni\xF1a peque\xF1a.
        Alguien tiene que haberla visto."
    - language: 8
      text: "\u2026Ainda nenhuma not\xEDcia. Franzo a testa sem perceber, ainda querendo
        perguntar mais alguma coisa. Ela j\xE1 \xE9 uma mo\xE7a. Algu\xE9m deve ter
        visto."
    - language: 9
      text: "\u2026 \u0421\u043D\u043E\u0432\u0430 \u043D\u0438\u043A\u0430\u043A\u0438\u0445
        \u0432\u0435\u0441\u0442\u0435\u0439. \u042F \u043D\u0435\u0432\u043E\u043B\u044C\u043D\u043E
        \u0445\u043C\u0443\u0440\u044E\u0441\u044C, \u0432\u0441\u0451 \u0435\u0449\u0451
        \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u044C,
        \u043E \u0447\u0451\u043C \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C.
        \u041E\u043D\u0430 \u0432\u0435\u0434\u044C \u0443\u0436\u0435 \u043D\u0435
        \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F, \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0435\u0451 \u0432\u0438\u0434\u0435\u0442\u044C."
  - key: os.memory.1970.text
    values:
    - language: 0
      text: "\u5148\u56DE\u53BB\u5427\u2026\u2026\u5BB6\u91CC\u8FD8\u6709\u4E9B\u7F13\u89E3\u75C5\u6BD2\u7684\u836F\uFF0C\u6216\u8BB8\u53EF\u4EE5\u62FF\u7ED9\u8FD9\u4F4D\u6BCD\u4EB2\u3002\u53EF\u6211\u5973\u513F\u5462\uFF0C\u600E\u4E48\u529E\u2026\u2026\u5979\u73B0\u5728\u8FD8\u6709\u6CA1\u6709\u836F\uFF1F\u5979\u7684\u517D\u5316\u75C5\u6BD2\u8FDB\u7A0B\u6BD4\u8FD9\u4E2A\u5C0F\u5973\u5B69\u4E25\u91CD\u5F97\u591A\uFF0C\u6211\u53EF\u662F\u7B54\u5E94\u4E86\u5979\uFF0C\u600E\u4E48\u4F1A\u8FD9\u6837\u2026\u2026"
    - language: 1
      text: "\u5148\u56DE\u53BB\u5427\u2026\u2026\u5BB6\u88E1\u9084\u6709\u4E9B\u7DE9\u89E3\u75C5\u6BD2\u7684\u85E5\uFF0C\u6216\u8A31\u53EF\u4EE5\u62FF\u7D66\u9019\u4F4D\u6BCD\u89AA\u3002\u53EF\u6211\u5973\u5152\u5462\uFF0C\u600E\u9EBC\u8FA6\u2026\u2026\u5979\u73FE\u5728\u9084\u6709\u6C92\u6709\u85E5\uFF1F\u5979\u7684\u7378\u5316\u75C5\u6BD2\u9032\u7A0B\u6BD4\u9019\u500B\u5C0F\u5973\u5B69\u56B4\u91CD\u5F97\u591A\uFF0C\u6211\u53EF\u662F\u7B54\u61C9\u4E86\u5979\uFF0C\u600E\u9EBC\u6703\u9019\u6A23\u2026\u2026"
    - language: 2
      text: "I should go home for now\u2026 I've still got some medicine there to
        ease the virus. Maybe I could bring some to this mother. But what about my
        daughter? What do I do\u2026 does she have any medicine left? Her beastification
        is much further along than this little girl's. I promised her. How did it
        come to this\u2026"
    - language: 3
      text: "\u3072\u3068\u307E\u305A\u5E30\u308D\u3046\u2026\u2026\u5BB6\u306B\u306F\u307E\u3060\u3001\u30A6\u30A4\u30EB\u30B9\u306E\u75C7\u72B6\u3092\u548C\u3089\u3052\u308B\u85AC\u304C\u5C11\u3057\u3042\u308B\u3002\u3053\u306E\u6BCD\u89AA\u306B\u6301\u3063\u3066\u304D\u3066\u3042\u3052\u3089\u308C\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u3067\u3082\u3001\u79C1\u306E\u5A18\u306F\uFF1F\u3000\u3069\u3046\u3059\u308C\u3070\u3044\u3044\u306E\u2026\u2026\u4ECA\u3001\u3042\u306E\u5B50\u306E\u624B\u5143\u306B\u85AC\u306F\u6B8B\u3063\u3066\u3044\u308B\u306E\uFF1F\u3000\u3042\u306E\u5B50\u306E\u7363\u5316\u30A6\u30A4\u30EB\u30B9\u306F\u3001\u3053\u306E\u5C0F\u3055\u306A\u5973\u306E\u5B50\u3088\u308A\u305A\u3063\u3068\u9032\u884C\u3057\u3066\u3044\u308B\u3002\u3042\u306E\u4EBA\u306B\u7D04\u675F\u3057\u305F\u306E\u306B\u3001\u3069\u3046\u3057\u3066\u3053\u3093\u306A\u3053\u3068\u306B\u2026\u2026"
    - language: 4
      text: "\uC77C\uB2E8 \uB3CC\uC544\uAC00\uC790\u2026\u2026 \uC9D1\uC5D0 \uBC14\uC774\uB7EC\uC2A4
        \uC99D\uC0C1\uC744 \uC644\uD654\uD558\uB294 \uC57D\uC774 \uC870\uAE08 \uB0A8\uC544
        \uC788\uC73C\uB2C8, \uC774 \uC5C4\uB9C8\uC5D0\uAC8C \uAC00\uC838\uB2E4\uC904
        \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uADF8\uB7F0\uB370 \uB0B4
        \uB538\uC740, \uC5B4\uB5A1\uD558\uC9C0\u2026\u2026 \uC9C0\uAE08 \uADF8 \uC560\uC5D0\uAC8C
        \uC57D\uC774 \uB0A8\uC544 \uC788\uC744\uAE4C? \uB538\uC758 \uC57C\uC218\uD654
        \uBC14\uC774\uB7EC\uC2A4\uB294 \uC774 \uC5B4\uB9B0 \uC5EC\uC790\uC544\uC774\uBCF4\uB2E4
        \uD6E8\uC52C \uB9CE\uC774 \uC9C4\uD589\uB410\uB2E4. \uADF8 \uC0AC\uB78C\uC5D0\uAC8C
        \uC57D\uC18D\uD588\uB294\uB370, \uC5B4\uCA4C\uB2E4 \uC774\uB807\uAC8C\u2026\u2026"
    - language: 5
      text: "Il vaut mieux rentrer pour l'instant\u2026 Il reste \xE0 la maison des
        m\xE9dicaments pour att\xE9nuer les sympt\xF4mes du virus. Je pourrais peut-\xEAtre
        en apporter \xE0 cette m\xE8re. Mais ma fille, que faire pour elle\u2026
        Lui reste-t-il des m\xE9dicaments ? Le virus de bestialisation a bien plus
        progress\xE9 chez elle que chez cette petite. Je le lui avais promis, \xE0
        elle. Comment en est-on arriv\xE9 l\xE0\u2026"
    - language: 6
      text: "Ich sollte erst einmal nach Hause gehen\u2026 Dort habe ich noch Medikamente,
        die die Symptome des Virus lindern. Vielleicht k\xF6nnte ich dieser Mutter
        etwas davon bringen. Aber was ist mit meiner Tochter? Was soll ich tun\u2026
        Hat sie \xFCberhaupt noch Medikamente? Ihre Infektion mit dem Bestialisierungsvirus
        ist viel weiter fortgeschritten als bei diesem kleinen M\xE4dchen. Ich habe
        es ihr doch versprochen. Wie konnte es so weit kommen\u2026"
    - language: 7
      text: "Ser\xE1 mejor que vuelva a casa por ahora\u2026 A\xFAn tengo medicinas
        para aliviar el virus. Quiz\xE1 pueda traerle algunas a esta madre. Pero
        \xBFy mi hija? \xBFQu\xE9 hago\u2026? \xBFLe quedar\xE1n medicinas? Su bestializaci\xF3n
        est\xE1 mucho m\xE1s avanzada que la de esta ni\xF1a. Se lo promet\xED a
        ella. \xBFC\xF3mo hemos llegado a esto\u2026?"
    - language: 8
      text: "\xC9 melhor voltar para casa por enquanto\u2026 Ainda tenho uns rem\xE9dios
        l\xE1 para aliviar o v\xEDrus. Talvez possa trazer alguns para esta m\xE3e.
        Mas e minha filha? O que eu fa\xE7o\u2026 ser\xE1 que ela ainda tem rem\xE9dio?
        A bestializa\xE7\xE3o dela est\xE1 muito mais avan\xE7ada que a desta menininha.
        Eu prometi a ela. Como isso foi acontecer\u2026"
    - language: 9
      text: "\u041F\u043E\u043A\u0430 \u0432\u0435\u0440\u043D\u0443\u0441\u044C
        \u0434\u043E\u043C\u043E\u0439\u2026 \u0422\u0430\u043C \u0435\u0449\u0451
        \u0435\u0441\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430,
        \u043E\u0431\u043B\u0435\u0433\u0447\u0430\u044E\u0449\u0438\u0435 \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u044B
        \u0432\u0438\u0440\u0443\u0441\u0430. \u041C\u043E\u0436\u0435\u0442, \u043F\u0440\u0438\u043D\u0435\u0441\u0443
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u044D\u0442\u043E\u0439 \u043C\u0430\u0442\u0435\u0440\u0438.
        \u041D\u043E \u043A\u0430\u043A \u0436\u0435 \u043C\u043E\u044F \u0434\u043E\u0447\u044C,
        \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C\u2026 \u0415\u0441\u0442\u044C
        \u043B\u0438 \u0443 \u043D\u0435\u0451 \u0435\u0449\u0451 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430?
        \u0423 \u043D\u0435\u0451 \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u0435
        \u0432\u0438\u0440\u0443\u0441\u043E\u043C \u043E\u0437\u0432\u0435\u0440\u0435\u043D\u0438\u044F
        \u0437\u0430\u0448\u043B\u043E \u0433\u043E\u0440\u0430\u0437\u0434\u043E
        \u0434\u0430\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0443 \u044D\u0442\u043E\u0439
        \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439 \u0434\u0435\u0432\u043E\u0447\u043A\u0438.
        \u042F \u0432\u0435\u0434\u044C \u043E\u0431\u0435\u0449\u0430\u043B\u0430
        \u0435\u0439. \u041A\u0430\u043A \u0432\u0441\u0451 \u043C\u043E\u0433\u043B\u043E
        \u0442\u0430\u043A \u043E\u0431\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F\u2026"
