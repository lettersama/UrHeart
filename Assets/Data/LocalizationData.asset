    - language: 7
      text: "Haz clic o pulsa Espacio para reintentar"
    - language: 8
      text: "Clique ou pressione Espa\u00e7o para tentar novamente"
    - language: 9
      text: "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u043c\u044b\u0448\u0438 \u0438\u043b\u0438 \u043f\u0440\u043e\u0431\u0435\u043b, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c"
