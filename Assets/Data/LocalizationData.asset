    - language: 2
      text: 'System Control

'
    - language: 3
      text: "\u30B7\u30B9\u30C6\u30E0\u5236\u5FA1\n"
    - language: 4
      text: "\uC2DC\uC2A4\uD15C \uC81C\uC5B4\n"
    - language: 5
      text: "Contr\xF4le syst\xE8me\n"
    - language: 6
      text: 'Systemsteuerung

'
    - language: 7
      text: 'Control del sistema

'
    - language: 8
      text: 'Controle do sistema

'
