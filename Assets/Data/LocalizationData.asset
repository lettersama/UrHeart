    - language: 3
      text: "\u66F2\u304C\u9078\u3070\u308C\u3066\u3044\u307E\u305B\u3093"
    - language: 4
      text: "\uC120\uD0DD\uB41C \uACE1 \uC5C6\uC74C"
    - language: 5
