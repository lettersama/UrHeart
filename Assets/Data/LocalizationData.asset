  - key: ui.addition.paper.headline
    values:
    - language: 0
      text: "R\u53F7\u5FC3\u810F\u75C5\u6BD2!\u6CBB\u6108\u53EF\u80FD!"
    - language: 1
      text: "R\u865F\u5FC3\u81DF\u75C5\u6BD2\uFF01\u6CBB\u7652\u6709\u671B\uFF01"
    - language: 2
      text: R-Strain Heart Virus! A Cure Within Reach!
    - language: 3
      text: "R\u578B\u5FC3\u81D3\u30A6\u30A4\u30EB\u30B9\u306B\u6CBB\u7652\u306E\u5146\u3057\uFF01"
    - language: 4
      text: "R\uD615 \uC2EC\uC7A5 \uBC14\uC774\uB7EC\uC2A4! \uC644\uCE58\uC758 \uAE38\uC774
        \uC5F4\uB9AC\uB2E4!"
    - language: 5
      text: "Virus cardiaque de type R ! La gu\xE9rison en vue !"
    - language: 6
      text: Herzvirus Typ R! Heilung in Sicht!
    - language: 7
      text: "\xA1Virus card\xEDaco tipo R! \xA1La cura es posible!"
    - language: 8
      text: "V\xEDrus card\xEDaco tipo R! A cura \xE9 poss\xEDvel!"
    - language: 9
      text: "\u0421\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u0439 \u0432\u0438\u0440\u0443\u0441
        \u0442\u0438\u043F\u0430 R! \u0418\u0437\u043B\u0435\u0447\u0435\u043D\u0438\u0435
        \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E!"
