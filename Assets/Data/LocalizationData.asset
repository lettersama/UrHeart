  - key: os.chapter03.option.return.understand
    values:
    - language: 0
      text: "1.\u6211\u80FD\u7406\u89E3\u4F60..\u771F\u7684."
    - language: 1
      text: "1.\u6211\u80FD\u7406\u89E3\u4F60..\u771F\u7684."
    - language: 2
      text: 1.I understand.. I really do.
    - language: 3
      text: "1.\u308F\u304B\u308B\u3088..\u672C\u5F53\u306B."
    - language: 4
      text: "1.\uC774\uD574\uD574..\uC815\uB9D0\uC774\uC57C."
    - language: 5
      text: 1.Je te comprends.. Vraiment.
    - language: 6
      text: 1.Ich verstehe dich.. Wirklich.
    - language: 7
      text: 1.Te entiendo... De verdad.
    - language: 8
      text: "1.Eu entendo voc\xEA... De verdade."
    - language: 9
      text: "1.\u042F \u0442\u0435\u0431\u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E..\u041F\u0440\u0430\u0432\u0434\u0430."
  - key: os.chapter03.option.return.pause_after_07
    values:
    - language: 0
      text: 1......
    - language: 1
      text: 1......
    - language: 2
      text: 1......
    - language: 3
      text: 1......
    - language: 4
      text: 1......
    - language: 5
