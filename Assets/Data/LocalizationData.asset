  - key: ui.os.heart_heal.target
    values:
    - language: 0
      text: "\u76EE\u6807:<br><size=8>      \u7A7A\u683C\u51FB\u4E2D\u8282\u62CD\uFF0C\u6062\u590D\u5FC3\u810F\u72B6\u6001\u3002"
    - language: 1
      text: "\u76EE\u6A19:<br><size=8>      \u6309\u7A7A\u767D\u9375\u64CA\u4E2D\u7BC0\u62CD\uFF0C\u6062\u5FA9\u5FC3\u81DF\u72C0\u614B\u3002"
    - language: 2
      text: Objective:<br><size=8>      Press Space on the beat to stabilize the
        heart.
    - language: 3
      text: "\u76EE\u6A19:<br><size=8>      \u62CD\u52D5\u306B\u5408\u308F\u305B\u3066\u30B9\u30DA\u30FC\u30B9\u30AD\u30FC\u3092\u62BC\u3057\u3001\u5FC3\u62CD\u3092\u5B89\u5B9A\u3055\u305B\u308B\u3002"
    - language: 4
      text: "\uBAA9\uD45C:<br><size=8>      \uBC15\uC790\uC5D0 \uB9DE\uCDB0 \uC2A4\uD398\uC774\uC2A4\uBC14\uB97C
        \uB20C\uB7EC \uC2EC\uBC15\uC744 \uC548\uC815\uC2DC\uD0A4\uC138\uC694."
    - language: 5
      text: "Objectif :<br><size=8>      Appuyez sur Espace en rythme pour stabiliser
        le c\u0153ur."
    - language: 6
      text: 'Ziel:<br><size=8>      Leertaste im Takt: Herz stabilisieren.'
    - language: 7
      text: "Objetivo:<br><size=8>      Pulsa Espacio al ritmo para estabilizar el
        coraz\xF3n."
    - language: 8
      text: "Objetivo:<br><size=8>      Aperte Espa\xE7o no ritmo para estabilizar
        o cora\xE7\xE3o."
    - language: 9
      text: "\u0426\u0435\u043B\u044C:<br><size=8>      \u041D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435
        \u041F\u0440\u043E\u0431\u0435\u043B \u0432 \u0442\u0430\u043A\u0442, \u0447\u0442\u043E\u0431\u044B
        \u0432\u044B\u0440\u043E\u0432\u043D\u044F\u0442\u044C \u043F\u0443\u043B\u044C\u0441."
