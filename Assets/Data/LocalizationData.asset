    - language: 1
      text: "\u907a\u66f8\u95dc\u9589\u5f8c"
    - language: 2
      text: "After closing letter"
    - language: 3
      text: "\u907a\u66f8\u3092\u9589\u3058\u305f\u5f8c"
    - language: 4
      text: "\uc720\uc11c\ub97c \ub2eb\uc740 \ud6c4"
    - language: 5
