    values:
    - language: 0
      text: "\u5145\u7535\u5668\u5F85\u673A"
    - language: 2
      text: Charger idle
    - language: 1
      text: "\u5145\u96FB\u5668\u5F85\u6A5F"
    - language: 3
      text: "\u5145\u96FB\u5668\u5F85\u6A5F\u4E2D"
    - language: 4
      text: "\uCDA9\uC804\uAE30 \uB300\uAE30"
    - language: 5
      text: Chargeur en veille
    - language: 6
      text: "Ladeger\xE4t bereit"
    - language: 7
      text: Cargador en espera
    - language: 8
      text: Carregador em espera
    - language: 9
      text: "\u0417\u0430\u0440\u044F\u0434\u043D\u0438\u043A \u043E\u0436\u0438\u0434\u0430\u0435\u0442"
  - key: ui.os.paper_push.start
    values:
    - language: 0
      text: "\u5F00\u59CB"
    - language: 2
      text: Start
    - language: 1
      text: "\u958B\u59CB"
    - language: 3
