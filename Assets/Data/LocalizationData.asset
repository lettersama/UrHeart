    - language: 8
      text: "Vit\xF3rias {0} / Derrotas {1}"
    - language: 9
      text: "\u041F\u043E\u0431\u0435\u0434 {0} / \u041F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0439
        {1}"
