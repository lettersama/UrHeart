    - language: 6
      text: '"<color=#68C83B>Start</color>"'
    - language: 7
      text: '"<color=#68C83B>Iniciar</color>"'
    - language: 8
      text: '"<color=#68C83B>Iniciar</color>"'
    - language: 9
      text: "\"<color=#68C83B>\u041D\u0430\u0447\u0430\u0442\u044C</color>\""
  - key: ui.os.character.link_message.event01.heart_heal.option.start_treatment
    values:
    - language: 0
      text: "\u5F00\u59CB"
    - language: 1
      text: "\u958B\u59CB"
    - language: 2
      text: Start
    - language: 3
      text: "\u958B\u59CB"
    - language: 4
      text: "\uC2DC\uC791"
    - language: 5
      text: "D\xE9marrer"
    - language: 6
      text: Start
    - language: 7
      text: Iniciar
    - language: 8
      text: Iniciar
    - language: 9
      text: "\u041D\u0430\u0447\u0430\u0442\u044C"
  - key: ui.os.heart_heal.wait_live_reply
    values:
    - language: 0
      text: "\u7B49\u5F85 Live \u56DE\u590D"
    - language: 1
      text: "\u7B49\u5F85 Live \u56DE\u8986"
    - language: 2
      text: Waiting for Live to respond
    - language: 3
      text: "Live\u306E\u8FD4\u4FE1\u3092\u5F85\u6A5F\u4E2D"
    - language: 4
      text: "Live \uC751\uB2F5 \uB300\uAE30 \uC911"
    - language: 5
      text: "En attente de la r\xE9ponse de Live"
    - language: 6
      text: Warte auf Antwort von Live
    - language: 7
      text: Esperando respuesta de Live
    - language: 8
      text: Aguardando resposta do Live
    - language: 9
      text: "\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u043E\u0442\u0432\u0435\u0442\u0430
        \u043E\u0442 Live"
  - key: ui.os.character.link_message.global.first_live_reconnect
    values:
    - language: 0
      text: "\u5947\u602A\uFF1F\u6211\u7684live\u8F6F\u4EF6\u574F\u6389\u4E86\u5417\uFF1F"
    - language: 1
      text: "\u5947\u602A\uFF1F\u6211\u7684Live\u8EDF\u9AD4\u58DE\u6389\u4E86\u55CE\uFF1F"
    - language: 2
      text: Strange... is my Live app broken?
    - language: 3
      text: "\u304A\u304B\u3057\u3044\u306A\uFF1F\u79C1\u306ELive\u30BD\u30D5\u30C8\u3001\u58CA\u308C\u305F\u306E\uFF1F"
    - language: 4
      text: "\uC774\uC0C1\uD558\uB124? \uB0B4 Live \uC18C\uD504\uD2B8\uC6E8\uC5B4\uAC00
        \uACE0\uC7A5 \uB0AC\uB098?"
    - language: 5
      text: Bizarre... mon logiciel Live est en panne ?
    - language: 6
      text: Seltsam... ist meine Live-Software kaputt?
    - language: 7
      text: "Qu\xE9 raro... \xBFse ha estropeado mi aplicaci\xF3n Live?"
    - language: 8
      text: "Estranho... ser\xE1 que meu aplicativo Live quebrou?"
    - language: 9
      text: "\u0421\u0442\u0440\u0430\u043D\u043D\u043E... \u043C\u043E\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430
        Live \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C?"
  - key: ui.os.character.link_message.global.gramophone_first_open
    values:
    - language: 0
      text: "\u54E6\uFF01\u662F\u7559\u58F0\u673A\u5440...\u6211\u597D\u50CF\u633A\u559C\u6B22\u8FD9\u79CD\u4E1C\u897F\u7684\uFF0C\u653E\u9996\u6B4C\u542C\u542C\u5427\uFF1F"
    - language: 1
      text: "\u54E6\uFF01\u662F\u7559\u8072\u6A5F\u5440...\u6211\u597D\u50CF\u633A\u559C\u6B61\u9019\u7A2E\u6771\u897F\u7684\uFF0C\u653E\u9996\u6B4C\u807D\u807D\u5427\uFF1F"
    - language: 2
      text: Oh! A gramophone... I think I kind of like these things. Shall we put
        a song on?
    - language: 3
      text: "\u3042\uFF01\u84C4\u97F3\u6A5F\u3060\u2026\u306A\u3093\u3060\u304B\u3001\u3053\u3046\u3044\u3046\u306E\u597D\u304D\u3060\u3063\u305F\u6C17\u304C\u3059\u308B\u3002\u4E00\u66F2\u304B\u3051\u3066\u307F\u3088\u3063\u304B\uFF1F"
    - language: 4
      text: "\uC624! \uCD95\uC74C\uAE30\uB124... \uB098 \uC774\uB7F0 \uAC70 \uAF64
        \uC88B\uC544\uD588\uB358 \uAC83 \uAC19\uC544. \uB178\uB798 \uD55C \uACE1
        \uD2C0\uC5B4\uBCFC\uAE4C?"
    - language: 5
      text: Oh ! Un gramophone... Je crois que j'aime bien ce genre de choses. On
        met une chanson ?
    - language: 6
      text: Oh! Ein Grammophon... Ich glaube, ich mag solche Dinger. Sollen wir ein
        Lied auflegen?
    - language: 7
      text: "\xA1Oh! Un gram\xF3fono... Creo que me gustan bastante estas cosas.
        \xBFPonemos una canci\xF3n?"
    - language: 8
      text: "Oh! Um gramofone... Acho que eu gosto desse tipo de coisa. Vamos colocar
        uma m\xFAsica?"
    - language: 9
      text: "\u041E! \u0413\u0440\u0430\u043C\u043C\u043E\u0444\u043E\u043D... \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F \u0442\u0430\u043A\u0438\u0435
        \u0448\u0442\u0443\u043A\u0438. \u041F\u043E\u0441\u0442\u0430\u0432\u0438\u043C
        \u043F\u0435\u0441\u043D\u044E?"
  - key: ui.os.character.live.typing
    values:
    - language: 0
      text: "Live \u8F93\u5165\u4E2D"
    - language: 1
      text: "Live \u8F38\u5165\u4E2D"
    - language: 2
      text: Live is typing
    - language: 3
      text: "Live \u304C\u5165\u529B\u4E2D"
    - language: 4
      text: "Live \uC785\uB825 \uC911"
    - language: 5
      text: "Live \xE9crit"
    - language: 6
      text: Live schreibt
    - language: 7
      text: "Live est\xE1 escribiendo"
    - language: 8
      text: "Live est\xE1 digitando"
    - language: 9
      text: "Live \u043F\u0435\u0447\u0430\u0442\u0430\u0435\u0442"
