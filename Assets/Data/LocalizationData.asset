      text: "\u96E8\u306E\u4E2D\u306E\u63A2\u3057\u3082\u306E"
    - language: 4
      text: "\uBE57\uC18D\uC744 \uD5E4\uB9E4\uBA70"
    - language: 5
      text: "Qu\xEAte sous la pluie"
    - language: 6
      text: Suche im Regen
    - language: 7
      text: Buscando bajo la lluvia
    - language: 8
      text: "\xC0 procura na chuva"
    - language: 9
