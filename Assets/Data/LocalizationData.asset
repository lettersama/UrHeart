    values:
    - language: 0
      text: "\u7A0B\u5E8F\u5DF2\u5B89\u88C5\uFF1A{0}"
    - language: 1
      text: "\u7A0B\u5F0F\u5DF2\u5B89\u88DD\uFF1A{0}"
