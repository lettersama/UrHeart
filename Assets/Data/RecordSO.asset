  - recordIndex: 2
    recordName: "\u673A\u5668\u4EBA\u7EB8\u5076"
    recordIcon: {fileID: 21300000, guid: 52efa8b807ffe4f4e88aaee538a65f14, type: 3}
    recordDescription: "\u4E00\u4E2A\u6BCD\u4EB2\u968F\u624B\u7ED9\u81EA\u5DF1\u526A\u7684\u7EB8\u5076\u3002\u539F\u672C\u62FF\u5757\u65B9\u65B9\u6B63\u6B63\u7684\u7EB8\u5C31\u80FD\u73A9\uFF0C\u504F\u504F\u5973\u513F\u5ACC\u5979\u592A\u5E94\u4ED8\uFF0C\u53EA\u597D\u53C8\u62FF\u8D77\u526A\u5200\u4FEE\u4E86\u4FEE...\u8FD9\u4E0B\u603B\u80FD\u770B\u51FA\u6765\u662F\u4E2A\u673A\u5668\u4EBA\u4E86\u5427\u3002\u4E0D\u8FC7\u662F\u63A8\u7740\u73A9\u7684\u4E1C\u897F\uFF0C\u8FD8\u975E\u5F97\u8BB2\u7A76\u957F\u76F8\u5417\u3002"
    recordSprite: {fileID: 21300000, guid: dbe13a8a502b8be4b946d4e22e59e97e, type: 3}
    attachmentType: 0
    detailPresentationType: 1
  - recordIndex: 3
    recordName: "\u7814\u7A76\u5458\u7EB8\u5076"
    recordIcon: {fileID: 21300000, guid: 3009d6319bea06f4e8424684f7b4e696, type: 3}
    recordDescription: "\u4E00\u4E2A\u5973\u5B69\u5F88\u559C\u6B22\u7684\u7EB8\u5076\uFF0C\u7167\u7740\u5979\u6BCD\u4EB2\u7684\u6837\u5B50\u526A\u7684\u3002\u5979\u8BA4\u5B9A\u81EA\u5DF1\u7684\u5988\u5988\u662F\u4E16\u754C\u4E0A\u6700\u4F1F\u5927\u7684\u7814\u7A76\u5458\uFF0C\u8C01\u90FD\u6BD4\u4E0D\u8FC7...\u7814\u7A76\u5458\u672C\u4EBA\u5012\u662F\u60F3\u8C26\u865A\u4E24\u53E5\uFF0C\u53EF\u60DC\u8FD9\u4E8B\u597D\u50CF\u8F6E\u4E0D\u5230\u5979\u8BF4\u4E86\u7B97\u3002"
