  - recordIndex: 0
    recordName: "\u65E7\u65E5\u62A5\u7EB8"
    recordIcon: {fileID: 21300000, guid: 87c6550cc5826224098ece3e5c8b423f, type: 3}
    recordDescription: "\u4E00\u4EFD\u6700\u8FD1\u7684\u62A5\u7EB8\uFF0C\u91CC\u9762\u8BB0\u5F55\u7740\u4E00\u4E9B\u6D89\u5ACC\u7092\u4F5C\u7684\u65B0\u95FB\uFF0C\u90A3\u5BB6\u5B9E\u9A8C\u5BA4\u65E9\u5C31\u88AB\u66DD\u5149\u4E86\u6709\u7092\u4F5C\u7684\u5ACC\u7591\uFF0C\u5C31\u50CF\u8352\u539F\u7684\u90A3\u4E9B\u516C\u53F8\u6B8B\u515A\u559C\u6B22\u5E72\u7684\u4E8B\u60C5\u4E00\u6837\u3002\u4F46\u4F20\u95FB\u6709\u65B0\u5B9E\u9A8C\u5BA4\u5728\u63A7\u5236\u5FC3\u810F\u75C5\u6BD2\u7684\u65B9\u5411\u7814\u7A76\u6709\u91CD\u5927\u7684\u7A81\u7834\uFF0C\u77E5\u60C5\u4EBA\u6240\u8A00\uFF0C\u65B0\u5B9E\u9A8C\u5BA4\u6210\u5458\u90FD\u662F\u4E9B\u4E0D\u53EF\u601D\u8BAE\u7684\u7406\u60F3\u4E3B\u4E49\u8005\u3002"
    recordSprite: {fileID: 0}
    attachmentType: 1
    detailPresentationType: 0
  - recordIndex: 1
    recordName: "\"\u70B9\u8D5E\""
    recordIcon: {fileID: 21300000, guid: 17c03929224dd37458c8b853bd6d256b, type: 3}
    recordDescription: "\u6765\u81EA\u672A\u77E5\u4EBA\u58EB\u7684\u70B9\u8D5E."
